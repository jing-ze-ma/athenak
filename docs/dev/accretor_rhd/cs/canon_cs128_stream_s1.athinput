# csacc-1031 N=128 (USER 11-01: matches the sp wedge resolution): = canon_cs96_stream_s1 with nx2=nx3=128, MeshBlock 64x64 (24 blocks; 4 H200 = 6 per GPU; 2 H200 runs out of memory) + time2_floor_eint = 1.0e-7   # csacc-1031 (20b3b78d, 11-01): floor-class gas (rho < 1e-7 = env_sponge_rho x rho_amb) keeps the stage start in the hesdirk2 old vector; cs96 stream t 0.01-0.02 vs canon: BE steps 2 vs 465 of ~1500, dt min 1.17e-5 vs 3.9e-6, wall / 1.64, L/Ltop/Min/Mnzf means within 2e-4, R_ph rms 4e-4, tip metric equal
# (time2_auto_be = 16 is the code default since defaults-1029; it stays on as the safety net)
marshak_q        = 0.5
implicit_bc_x1min = flux   # ACC: accretor-specific (units / floor / BC) (prod flux)
implicit_flux_x1min = 1453030.128124   # s1stream-1031 (USER 10-31 "full-sphere version of the stream run", run12 spin 1): spin-1 full-sphere bottom flux (= mkramp.py flux0)
implicit_bc_x1max = marshak   # ACC: accretor-specific (units / floor / BC) (prod marshak)
implicit_flux_x1max = 0.0   # ACC: accretor-specific (units / floor / BC) (prod 0.0)
