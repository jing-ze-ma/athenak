f_stretch_r_c7            = 3.715116397871e+03  
f_stretch_r_c8            = -1.113061527953e+03 
f_stretch_r_b1_amp        = -9.491339281175e-01 
f_stretch_r_b1_x          = 2.407883898117e-01  
f_stretch_r_b1_w          = 7.665554490394e-02  
f_stretch_r_b2_amp        = -2.998805320338e+00  
f_stretch_r_b2_x          = 9.487473032261e-01  
f_stretch_r_b2_w          = 5.791462410538e-02  
f_stretch_r_p_amp         = -9.989996883444e-01 
f_stretch_r_p_xa          = 1.952251964931e-01  
f_stretch_r_p_xb          = 9.869232597656e-01  
f_stretch_r_p_w           = 2.647092631281e-03  
use_cubed_sphere          = 0                   # Default value added at run time
use_grid_stretch_r        = 0                   # Default value added at run time
use_grid_stretch_theta    = 0                   # Default value added at run time
use_polar_boundary        = 0                   # Default value added at run time
polar_quadratic_recon     = 0                   # Default value added at run time
polar_x3_shift            = rotate              # Default value added at run time
use_polar_average_eresist = 1                   # Default value added at run time
<meshblock>
nx1 = 897 
nx2 = 64  # 4 blocks of 445 x 64 x 64: 32 x 32 blocks fail vet_gd (clamped lateral reads, smoke 12108597)
nx3 = 64  
<time>
evolution             = dynamic 
integrator            = rk2     
cfl_number            = 0.3     # radiation-dominated (user rule)
nlim                  = -1      
tlim                  = 2.592e6 # 30 d (user GO 10-07)
ndiag                 = 50      
start_time            = 0       # Default value added at run time
nan_check_cycles      = 100     # Default value added at run time
dt_min                = 0       # Default value added at run time
restart_refill_ghosts = 0       # Default value added at run time
<units>
length_cgs = 1.0 
mass_cgs   = 1.0 
time_cgs   = 1.0 
mu         = 1.0 # general EOS: T_unit : m_u/k_B
<hydro>
eos                        = general                
general_eos                = table                  
gamma                      = 1.6666666667           
eos_h2                     = false                  
eos_ionization             = true                   
eos_metal_ionization       = false                  
eos_radiation              = false                  # MANDATORY with <rad_m1>: the module evolves E
eos_xh                     = 0.0                    
eos_yhe                    = 0.9265                 # Z : 0.0735 : the TOPS envelope mixture
eos_a_metal                = 1.77                   # metals FULLY IONIZED: Z/a : sum X_i (1+Z_i)/A_i (exact in the deep envelope)
eos_logd_min               = -21.0                  # covers dfloor 1e-20 (: he_opac_logd_min)
eos_logd_max               = -1.0                   
eos_logt_min               = 3.5                    # below tfloor 4e3 K
eos_logt_max               = 6.8                    
eos_dlog                   = 0.02                   
rad_signal_speed           = true                   
reconstruct                = plm                    
rsolver                    = hllc                   # near-sonic convection (He presn rule)
fofc                       = true                   
etotgrav                   = true                   
wellbalance_dynamic        = true                   
wb_x1                      = true                   
wb_option                  = polytropic             
wb_cache_every             = 0                      
