diff --git a/src/nr_radiation/implicit/rad_line_solve.cpp b/src/nr_radiation/implicit/rad_line_solve.cpp
new file mode 100644
index 00000000..4565f497
--- /dev/null
+++ b/src/nr_radiation/implicit/rad_line_solve.cpp
@@ -0,0 +1,233 @@
+//======================================================================================
+// Athena++ astrophysical MHD code
+// Copyright (C) 2014 James M. Stone  <jmstone@princeton.edu>
+// See LICENSE file for full public license information.
+//======================================================================================
+//! \file rad_line_solve.cpp
+//  \brief conv-fix: x1-line implicit solve of the linearised implicit transport +
+//  absorption/scattering system (radiation/sweep = 2).
+//
+//  For every (k,j) line of a MeshBlock, the per-angle equations that CalSourceTerms
+//  solves cell by cell (with the neighbours, the own-cell explicit split exp_coef_ and
+//  the implicit angular-flux neighbour lagged) are assembled for ALL cells and angles of
+//  the line and solved directly with a block-tridiagonal (block Thomas) elimination:
+//    row (i,n):  [(imcoef_n + s' tcoef_n) cm_n + cm_n exp_n] I_{i,n}
+//              + cm_n coefang_n I_{i,n+1} - tcoef_n (a + b beta) sum_m wcm_m cm_m I_{i,m}
+//              + cm_n coefl_n I_{i-1,n} + cm_n coefr_n I_{i+1,n}
+//              = cm_n (I_ini + adv + lagged x2/x3 terms)_n + tcoef_n b alpha
+//  where T^4 = alpha + beta J is the gas-energy equation linearised about the current
+//  gas temperature iterate. Ghost cells (MeshBlock boundaries) and x2/x3 neighbours are
+//  taken from the current iterate (lagged). The exact non-linear relation (quartic
+//  for T, floors) is then restored by the normal Athena++ sweep that follows, so the
+//  fixed point is identical to the Jacobi fixed point; only the path is different.
+//  Supports nfreq == 1, npsi == 0, compton_flag == 0 (otherwise returns false and
+//  the caller falls back to the default iteration).
+//======================================================================================
+
+// C++ headers
+#include <algorithm>
+#include <cmath>
+#include <vector>
+
+// Athena++ headers
+#include "../../athena.hpp"
+#include "../../athena_arrays.hpp"
+#include "../../eos/eos.hpp"
+#include "../../mesh/mesh.hpp"
+#include "../integrators/rad_integrators.hpp"
+#include "../radiation.hpp"
+#include "radiation_implicit.hpp"
+
+namespace {
+// in-place LU with partial pivoting of an n x n row-major matrix; returns false if
+// singular
+bool LUDecomp(int n, Real *a, int *piv) {
+  for (int c=0; c<n; ++c) {
+    int p = c;
+    Real amax = std::abs(a[c*n+c]);
+    for (int r=c+1; r<n; ++r) {
+      if (std::abs(a[r*n+c]) > amax) { amax = std::abs(a[r*n+c]); p = r; }
+    }
+    piv[c] = p;
+    if (amax == 0.0) return false;
+    if (p != c) {
+      for (int q=0; q<n; ++q) std::swap(a[c*n+q], a[p*n+q]);
+    }
+    Real inv = 1.0/a[c*n+c];
+    for (int r=c+1; r<n; ++r) {
+      Real f = a[r*n+c]*inv;
+      a[r*n+c] = f;
+      if (f != 0.0) {
+        for (int q=c+1; q<n; ++q) a[r*n+q] -= f*a[c*n+q];
+      }
+    }
+  }
+  return true;
+}
+
+void LUSolve(int n, const Real *lu, const int *piv, Real *b) {
+  for (int c=0; c<n; ++c) {
+    if (piv[c] != c) std::swap(b[c], b[piv[c]]);
+  }
+  for (int r=1; r<n; ++r) {
+    Real s = b[r];
+    for (int q=0; q<r; ++q) s -= lu[r*n+q]*b[q];
+    b[r] = s;
+  }
+  for (int r=n-1; r>=0; --r) {
+    Real s = b[r];
+    for (int q=r+1; q<n; ++q) s -= lu[r*n+q]*b[q];
+    b[r] = s/lu[r*n+r];
+  }
+}
+} // namespace
+
+bool RadIntegrator::LineSolveX1(MeshBlock *pmb, const Real dt, AthenaArray<Real> &u,
+                                AthenaArray<Real> &ir_ini, AthenaArray<Real> &ir) {
+  NRRadiation *prad = pmy_rad;
+  const int nang = prad->nang;
+  if (prad->nfreq != 1 || prad->npsi != 0 || compton_flag_ != 0) return false;
+
+  const Real invcrat = 1.0/prad->crat;
+  const Real prat = prad->prat;
+  const Real ct = dt*prad->crat;
+  const Real redfactor = prad->reduced_c/prad->crat;
+  const Real gamma = pmb->peos->GetGamma();
+  const bool af = (prad->angle_flag == 1);
+  const int nzeta = prad->nzeta;
+
+  int is = pmb->is, ie = pmb->ie, js = pmb->js, je = pmb->je;
+  int ks = pmb->ks, ke = pmb->ke;
+  const int ncell = ie - is + 1;
+  const int nn = nang*nang;
+
+  // work arrays (per line)
+  std::vector<Real> blk(nn), lu(static_cast<size_t>(ncell)*nn);
+  std::vector<int> piv(static_cast<size_t>(ncell)*nang);
+  std::vector<Real> cmat(static_cast<size_t>(ncell)*nn);   // A'^-1 U  (column-major n)
+  std::vector<Real> y(static_cast<size_t>(ncell)*nang);
+  std::vector<Real> lo(static_cast<size_t>(ncell)*nang), up(static_cast<size_t>(ncell)*nang);
+  std::vector<Real> tcoef(nang), wcm(nang), cm(nang), col(nang);
+
+  for (int k=ks; k<=ke; ++k) {
+    for (int j=js; j<=je; ++j) {
+      // ---- assemble + forward elimination
+      for (int ic=0; ic<ncell; ++ic) {
+        const int i = is + ic;
+        Real rho = u(IDN,k,j,i);
+        Real vx = vel_source_(k,j,i,0), vy = vel_source_(k,j,i,1);
+        Real vz = vel_source_(k,j,i,2);
+        Real vsq = vx*vx + vy*vy + vz*vz;
+        Real lorz = std::sqrt(1.0/(1.0 - vsq*invcrat*invcrat));
+        Real numsum = 0.0;
+        for (int n=0; n<nang; ++n) {
+          Real vdotn = vx*prad->mu(0,k,j,i,n) + vy*prad->mu(1,k,j,i,n)
+                       + vz*prad->mu(2,k,j,i,n);
+          tcoef[n] = lorz*(1.0 - vdotn*invcrat);
+          wcm[n] = prad->wmu(n)/(tcoef[n]*tcoef[n]);
+          numsum += wcm[n];
+          cm[n] = tcoef[n]*tcoef[n]*tcoef[n]*tcoef[n];
+        }
+        for (int n=0; n<nang; ++n) wcm[n] /= numsum;
+
+        const Real sa = prad->sigma_a(k,j,i,0), ss = prad->sigma_s(k,j,i,0);
+        const Real sp = prad->sigma_p(k,j,i,0), se = prad->sigma_pe(k,j,i,0);
+        const Real rsr = redfactor*ct*sa, rss = redfactor*ct*ss;
+        const Real rsp = redfactor*ct*sp, rse = redfactor*ct*se;
+        const Real acoef = rss + rsr - rse;
+        const Real bcoef = rsp;
+        // gas energy equation linearised about T0
+        Real t0 = tgas_new_(k,j,i);
+        if (!(t0 > 0.0)) t0 = tgas_(k,j,i);
+        const Real pg = prat*(gamma - 1.0)/rho;
+        const Real hp = ct*sp, he = ct*se;
+        const Real t03 = t0*t0*t0, t04 = t03*t0;
+        const Real d0 = 1.0 + 4.0*pg*hp*t03;
+        const Real alpha = -3.0*t04 + 4.0*t03*(tgas_(k,j,i) + 3.0*pg*hp*t04)/d0;
+        const Real beta = 4.0*t03*pg*he/d0;
+
+        Real *a = &(blk[0]);
+        Real *rhs = &(y[ic*nang]);
+        for (int q=0; q<nn; ++q) a[q] = 0.0;
+        for (int n=0; n<nang; ++n) {
+          Real imcoef = 1.0 + const_coef_(k,j,i,n);
+          if (af) imcoef += imp_ang_coef_(k,j,i,n);
+          Real g = tcoef[n]*(acoef + bcoef*beta);
+          if (lclip_(k,j,i,n) > 0.0) {
+            // the last cell update floored this angle's RHS: mirror the floor
+            // (row has no transport coupling; RHS = TINY in the co-moving frame)
+            a[n*nang+n] = (imcoef + (rsr + rss)*tcoef[n])*cm[n];
+            for (int m=0; m<nang; ++m) a[n*nang+m] -= g*wcm[m]*cm[m];
+            lo[ic*nang+n] = 0.0;
+            up[ic*nang+n] = 0.0;
+            rhs[n] = TINY_NUMBER + tcoef[n]*bcoef*alpha;
+            continue;
+          }
+          a[n*nang+n] = (imcoef + (rsr + rss)*tcoef[n])*cm[n] + cm[n]*exp_coef_(k,j,i,n);
+          for (int m=0; m<nang; ++m) a[n*nang+m] -= g*wcm[m]*cm[m];
+          if (af && n < 2*nzeta-1) a[n*nang+n+1] += cm[n]*imp_ang_coef_r_(k,j,i,n);
+          // right-hand side
+          Real r = ir_ini(k,j,i,n);
+          if (adv_flag_ > 0) r += adv_flx_(k,j,i,n);
+          if (pmb->block_size.nx2 > 1) {
+            r -= const_coef2_l_(k,j,i,n)*ir(k,j-1,i,n)
+                 + const_coef2_r_(k,j,i,n)*ir(k,j+1,i,n);
+          }
+          if (pmb->block_size.nx3 > 1) {
+            r -= const_coef3_l_(k,j,i,n)*ir(k-1,j,i,n)
+                 + const_coef3_r_(k,j,i,n)*ir(k+1,j,i,n);
+          }
+          lo[ic*nang+n] = cm[n]*const_coef1_l_(k,j,i,n);
+          up[ic*nang+n] = cm[n]*const_coef1_r_(k,j,i,n);
+          if (ic == 0) r -= const_coef1_l_(k,j,i,n)*ir(k,j,i-1,n);
+          if (ic == ncell-1) r -= const_coef1_r_(k,j,i,n)*ir(k,j,i+1,n);
+          rhs[n] = cm[n]*r + tcoef[n]*bcoef*alpha;
+        }
+        // Schur update with the previous cell: A' = A - L C_{i-1}, y' = y - L y'_{i-1}
+        if (ic > 0) {
+          const Real *cp = &(cmat[(ic-1)*nn]);
+          const Real *yp = &(y[(ic-1)*nang]);
+          for (int n=0; n<nang; ++n) {
+            Real l = lo[ic*nang+n];
+            if (l == 0.0) continue;
+            for (int m=0; m<nang; ++m) a[n*nang+m] -= l*cp[n*nang+m];
+            rhs[n] -= l*yp[n];
+          }
+        }
+        Real *luc = &(lu[ic*nn]);
+        for (int q=0; q<nn; ++q) luc[q] = a[q];
+        if (!LUDecomp(nang, luc, &(piv[ic*nang]))) return false;
+        LUSolve(nang, luc, &(piv[ic*nang]), rhs);   // y'_i = A'^-1 y'
+        if (ic < ncell-1) {
+          // C_i = A'^-1 diag(up_i); stored row-major (row n, column m)
+          Real *cc = &(cmat[ic*nn]);
+          for (int m=0; m<nang; ++m) {
+            for (int n=0; n<nang; ++n) col[n] = 0.0;
+            col[m] = up[ic*nang+m];
+            if (col[m] != 0.0) LUSolve(nang, luc, &(piv[ic*nang]), &(col[0]));
+            for (int n=0; n<nang; ++n) cc[n*nang+m] = col[n];
+          }
+        }
+      }
+      // ---- back substitution: x_i = y'_i - C_i x_{i+1}
+      for (int ic=ncell-2; ic>=0; --ic) {
+        const Real *cc = &(cmat[ic*nn]);
+        const Real *xn = &(y[(ic+1)*nang]);
+        Real *xi = &(y[ic*nang]);
+        for (int n=0; n<nang; ++n) {
+          Real s = 0.0;
+          for (int m=0; m<nang; ++m) s += cc[n*nang+m]*xn[m];
+          xi[n] -= s;
+        }
+      }
+      for (int ic=0; ic<ncell; ++ic) {
+        for (int n=0; n<nang; ++n) {
+          Real x = y[ic*nang+n];
+          if (!(x == x)) return false;
+          ir(k,j,is+ic,n) = std::max(x, static_cast<Real>(TINY_NUMBER));
+        }
+      }
+    }
+  }
+  return true;
+}
