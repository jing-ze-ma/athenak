<comment>
problem   = Blue Supergiant Envelope
reference = 
configure = --prob = bsg_star


<job>
problem_id = output/bsg                # problem ID: basename of output filenames

<output1>
file_type   = hdf5               # Binary data dump
data_format = fp64
dt          = 0.2                # time increment between outputs, previously 5.0
variable    = prim,d,p,uov       # primitive variables, gas density, gas pressure, user_defined_variable
xdmf        = 1

<output2>
file_type  = rst                # restart file
dt         = 100.0              # time increment between outputs, previously 5.0

<output3>
file_type  = hst                # history file
dt         = 0.1

<time>
cfl_number = 0.3                # The Courant, Friedrichs, & Lewy (CFL) Number, used to ensure numerical stability for propagating props
nlim       = -1                 # time step limit, -1 = no limit
tlim       = 10000.0            # time limit
rad_xorder = 2
xorder     = 2

<mesh>
nx1        = 192               # num of zones in X1-direction, python generated, should have 6/10 cells per scale height for rad/conv zones in quality runs
x1min      = 20.0              # minimum value of X1, location of the bottom in code units ("length unit" below)
x1max      = 80.0              # maximum value of X1, in code units, some expected extension of envelope
ix1_bc     = user              # inner-X1 boundary flag
ox1_bc     = user              # outer-X1 boundary flag
x1rat      = 1.000000          # ratio between cell sizes for log-space grid, for this star we can use linear grids because Hp is roughly constant

nx2        = 128                # num of zones in X2-direction
x2min      = 1.047198           # minimum value of X2, pi/3
x2max      = 2.094395           # maximum value of X2, 2pi/3
ix2_bc     = periodic           # inner-X2 boundary flag
ox2_bc     = periodic           # outer-X2 boundary flag


nx3        = 128                # num of zones in X3-direction
x3min      = 0.0                # minimum value of X3
x3max      = 1.047198           # maximum value of X3, pi/3
ix3_bc     = periodic           # inner-X3 boundary flag
ox3_bc     = periodic           # outer-X3 boundary flag

refinement = static

<meshblock>
nx1         = 16                 # cells per block, in X1 direction
nx2         = 16                 # cells per block, in X2 direction
nx3         = 16                 # cells per block, in X3 direction

# 16**3 meshblock size is about 1GB memory as a safe estimate

<refinement1>
x1min       = 38.0              # bottom of refinement, should be conv zone boundary
x1max       = 55.0              # top of refinement, should be conv zone boundary
x2min       = 1.047198          # refine in all theta direction
x2max       = 2.094395          # refine in all theta direction
x3min       = 0.0               # refine in all phi direction
x3max       = 1.047198          # refine in all phi direction
level       = 1                 # calculated from python code

<hydro>
gamma           = 1.66666666666667   # gas gamma = C_p/C_v, Lars suggested 5/3
dfloor          = 1.e-9              # density floor values
pfloor          = 1.e-12             #

<problem>

GM           = 2.60795e+02      # enable central gravity by G*M_bottom in code units

<radiation>
nmu          = 4                # default angular system with 80 angles per cell in 3D

unit         = 1                # prat and crat will be automatically calculated, otherwise (0) we have to provide prat and crat
density_unit = 6.15245e-5       # set to cgs value of density at the bottom
length_unit  = 6.95700e+10      # simply the solar radius
T_unit        = 1.07887e+06     # set to cgs value of temperature at the bottom
molecular_weight = 0.62         # mean molecular weight, I added this, from MESA model, or 1/(2X+3Y/4), i.e. H and He fully ionized

Compton      = 0                # no Compton scattering, temperature is not that high, only Thomson
tfloor       = 0.0001           # temperature floor value
reduced_factor = 1.0
angle_flag   = 1
nzeta        = 5                # should set bigger than 2, otherwise will be bug
npsi         = 6                # should set bigger than 2, otherwise will be bug
error_limit  = 1.e-6
taucell      = 4
cfl_rad      = 0.025            # previously 0.05

