subcycle = true
opacity = const
kappa_p = 0.10000000000000001
kappa_e = 0.10000000000000001
kappa_f = 0.10000000000000001
kappa_s = 0.0
arad = 1
coupling = true
gas_feedback = true
transport = implicit
implicit_cfl = 3.9281024242698006
implicit_tol = 1.0e-11
implicit_maxit = 200
implicit_lin_tol = 1.0e-13
implicit_lin_maxit = 400
implicit_solver = bicgstab
implicit_offdiag = operator
implicit_closure_lag = step
implicit_recon = dc
