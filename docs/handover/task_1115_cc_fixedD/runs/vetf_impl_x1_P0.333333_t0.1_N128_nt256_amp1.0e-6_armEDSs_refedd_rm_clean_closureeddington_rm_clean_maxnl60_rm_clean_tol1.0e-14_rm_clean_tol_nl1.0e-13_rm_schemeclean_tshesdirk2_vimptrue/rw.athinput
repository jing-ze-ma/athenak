<comment>
problem = runs_3r_radwave vetf_impl_x1_P0.333333_t0.1_N128_nt256_amp1.0e-6_armEDSs_refedd_rm_clean_closureeddington_rm_clean_maxnl60_rm_clean_tol1.0e-14_rm_clean_tol_nl1.0e-13_rm_schemeclean_tshesdirk2_vimptrue

<job>
basename = rw

<mesh>
nghost = 2
nx1 = 128
