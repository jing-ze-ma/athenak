<comment>
problem = BSG envelope (Ma, Bildsten & Jiang 2026), 20 Msun, log L 5.161, Teff 15835 K;
          3-D wedge, ARM 2 (lower top 61 Rsun, hydrostatic top BC, RE atmosphere IC from the relaxed
          1-D column, radial sponge): grid B' 206 x 256 x 256, 2 nodes x 2 GPUs = 4 MeshBlocks
<job>
basename = bsg3d
<mesh>
nghost    = 3
nx1       = 206
x1min     = 1.391400e12          # 20 Rsun
x1max     = 4.243770e12          # 61 Rsun (arm 2)
ix1_bc    = user
ox1_bc    = user
nx2       = 256
x2min     = 1.0471975511965976    # pi/3
x2max     = 2.0943951023931953    # 2 pi/3
ix2_bc    = periodic
ox2_bc    = periodic
nx3       = 256
x3min     = 0.0
x3max     = 1.0471975511965976    # pi/3
ix3_bc    = periodic
ox3_bc    = periodic
use_spherical_polar = true
use_grid_stretch_r_poly = true
f_stretch_r_p_amp = -7.687317073171e-01   # arm2/grid/design_plateau_top.py 206 34.0 0.5 61.0
f_stretch_r_p_xa  = 2.234698172087e-01
f_stretch_r_p_xb  = 9.226258550419e-01
f_stretch_r_p_w   = 7.931975379148e-03
<meshblock>
nx1       = 206
nx2       = 128
nx3       = 128
<time>
evolution  = dynamic
integrator = rk2
cfl_number = 0.3           # user 10-01: radiation-dominated runs at 0.3 (the paper), with hydro/rad_signal_speed
nlim       = -1
tlim       = 4.96e6              # 57.4 d
ndiag      = 50
<units>
length_cgs = 1.0
mass_cgs   = 1.0
time_cgs   = 1.0
mu         = 0.62
<hydro>
eos         = ideal
rad_signal_speed = true     # radiation-modified CFL signal speed (default on with implicit M1; named for clarity)
gamma       = 1.6666666666666667
reconstruct = plm
rsolver     = hllc
fofc        = true
fofc_report = 206
fofc_report_dt = 4.32e4
etotgrav    = true
wellbalance_dynamic = true
wb_x1               = true
wb_option           = polytropic
wb_cache_every      = 0
dfloor  = 1.0e-20                # arm 2 (the M1 coupling stalls below ~1e-20)
tfloor_kelvin = 5.0e3
pfloor  = 1.0e-12
dfloor_keep_velocity = true
vceil   = 1.0e8
<rad_m1>
report_newton_fb = true
c_light          = 2.99792458e10
arad             = 2.3392742567e-47   # a_cgs*T_unit^4, T_unit = 0.62 m_u/k_B = 7.4568864364e-9 K
chat_over_c      = 1.0
closure          = vet_col
opacity          = table
temp_unit_kelvin = 7.4568864364e-9
rho_unit_cgs     = 1.0
kappa_unit       = 1.0
e_floor          = 1.0e-4
coupling         = true
gas_feedback     = true
force_reference  = wb_arad
force_reference_work = split
transport        = implicit
implicit_solver  = bicgstab
implicit_offdiag = auto
implicit_closure_lag = step
implicit_lin_maxit = 200
implicit_lin_tol = 1.0e-10
implicit_lin_cnorm = 1.0e-10   # user 10-01: per-cell relative inner test (PICARD.md): cures the Picard stall at tol 1e-8
implicit_tol     = 1.0e-8       # user 10-01: keep 1e-8 (module default / He value)
implicit_resid_fatal = 1.0e-2   # blow-up 10-01: FATAL on a diverged Picard solve
implicit_maxit   = 200
implicit_one_pass = 0
implicit_opac_update = true
implicit_opac_newton = true
implicit_opac_newton_guard_mode = 6
implicit_gas_newton = true
implicit_eos_cache  = true
implicit_flux    = central
implicit_enthalpy = plm
implicit_vimp    = false
implicit_predictor = step
implicit_lin_ew_max = 1.0e-2
implicit_closure_thin_relax = 1.5
implicit_g0_exchange = true
implicit_g0_limit = 1.0
implicit_pos_gas = true
implicit_pos_floor = true
time_scheme      = be
vet_col_every    = 1
time2_vet_col    = predict
marshak_q        = 0.5
implicit_bc_x1min   = flux
implicit_flux_x1min = 2.2795969490e13   # L/(4 pi r_in^2), L = 5.5458987e38, r_in = 20 Rsun
implicit_bc_x1max   = marshak
implicit_flux_x1max = 0.0
<problem>
he_seed     = 1.0e-3            # entropy seed in the Fe CZ (paper: none, grows from noise)
he_seed_nk   = 16
he_seed_kmin = 1
he_seed_kmax = 2
he_seed_rad  = true
he_seed_rlo  = 2.52e12          # 36.2 Rsun
he_seed_rhi  = 3.05e12          # 43.8 Rsun
user_srcs   = true
user_bcs    = true
user_hist   = true
he_gm       = 2.6542488e27          # G M, M = 20 Msun (point mass)
he_ic_file  = @BUNDLE@/ic_bsg_arm2.txt
he_opac_table   = @BUNDLE@/rosseland_tops_x0.7_z0.008.txt
he_planck_table = @BUNDLE@/planck_tops_x0.7_z0.008.txt
he_opac_logd_min = -21.0
he_nfine    = 262144
he_tau_int  = 1.0
he_ic_cols  = 5
he_wall_zero_flux = true
he_ic_balance = true
he_ic_balance_rmax = 1.73925e12  # 25 Rsun: the IC is the RELAXED column; re-balance only near the wall (arm2/col ver_r25)
mlt_flux_frozen = true
he_wall_closed = true
he_sponge_rate = 1.0e-3            # 1/s at the top, w = ((r-r0)/(rtop-r0))^2
he_sponge_r0   = 4.1185e12         # 59.2 Rsun: outer 1.8 Rsun
he_sponge_mode = radial            # v_r only
he_sponge_dmax = 1.0e-17           # also damp v_r of the floor gas (rho < 1e3 dfloor) at the full rate
he_bc_outer    = hse              # arm 2: hydrostatic top ghosts, g (1 - Gamma) from the M1 force; + marshak
mlt_ramp_start = 3.0e5            # s: backstop cosine ramp of the scaffold from 3e5 s (2 turnovers of 1.5e5 s) ...
mlt_ramp_time  = 3.0e5            # ... to zero at 6e5 s (7 d)
mlt_closure    = adaptive         # shell-mean deficit: the scaffold retreats as resolved convection carries flux (He runs)
mlt_relax_time = 5.0e4            # s, 1/3 turnover (He wind run: 1500 s = 0.32 turnover)
mlt_closure_every = 1
mlt_closure_taper = 0.01
mlt_closure_dout  = 4.32e4         # s: fsub/lrad/lconv profiles every 0.5 d
<output1>
file_type   = hst
dt          = 2000.0
data_format = %24.16e
<output2>
file_type = bin
variable  = hydro_w
dt = 4.32e4                      # 0.5 d
<output3>
file_type = bin
variable  = m1
dt = 4.32e4
<output4>
file_type = log
dt = 1.0e4
<output5>
file_type = rst
dt = 8.64e4
<output6>
file_type = bin
variable  = m1_vet
dt = 4.32e4
