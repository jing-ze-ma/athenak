-KOKKOS_INLINE_FUNCTION
-static Real Extrap3(const Real q0, const Real q1, const Real q2) {
-  return 3.0*q0 - 3.0*q1 + q2;
-}
-
-KOKKOS_INLINE_FUNCTION
-static Real MagE(const DvceArray5D<Real> &b, const int m, const int k, const int j,
