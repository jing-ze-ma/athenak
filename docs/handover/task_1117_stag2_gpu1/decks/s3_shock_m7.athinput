<comment>
problem = Lowrie & Edwards radiative shock M0 = 7 (clean scheme, stag2 dp)

<job>
basename = rs

<mesh>
nghost = 2
nx1 = 256
x1min = 0.0
x1max = 1.82513930e+00
ix1_bc = user
ox1_bc = user
nx2 = 4
x2min = 0.0
x2max = 1.82513930e+00
ix2_bc = periodic
ox2_bc = periodic
nx3 = 1
x3min = -0.5
x3max = 0.5
ix3_bc = periodic
ox3_bc = periodic

<meshblock>
nx1 = 256
nx2 = 4
nx3 = 1

<time>
evolution = dynamic
integrator = rk2
cfl_number = 0.4
nlim = -1
tlim = 4e-9
ndiag = 1000000

<hydro>
eos = ideal
reconstruct = plm
rsolver = hllc
gamma = 1.666666666666667

<rad_m1>
clean_pos_limit = false
clean_layout = staggered
clean_stag_split = true
clean_stag_fsolve = true
clean_stag_fkin = true
clean_stag_fwork = true
clean_consistency = true
clean_stag_gflux = true
clean_stag_vimp = true
clean_stag_upwind = true
clean_stag_pc = mg
c_light = 2.99792458e10
chat_over_c = 1.0
cfl_rad = 0.4
thick_flux = none
closure = vet_sc
e_floor = 1.0e-30
subcycle = true
opacity = powerlaw
kappa_p = 577.16
kappa_e = 577.16
kappa_f = 577.16
kappa_s = 0.0
rho_ref = 1.0
t_ref = 1.0
opac_a = -1.0
opac_b = 0.0
arad = 1.6332399e-42
coupling = true
gas_feedback = true
transport = implicit
implicit_cfl = -1.0
implicit_bc_x1min = marshak
implicit_ebath_x1min = 1.70873641e+15
implicit_bc_x1max = marshak
implicit_ebath_x1max = 1.57702159e+17
time_scheme = hesdirk2
scheme = clean
vet_nmu = 4
vet_nphi = 8
vet_tensor = full
clean_closure = eddington

<problem>
pgen_name = rad_m1_beam
m1_test = radshock
user_bcs = true
m1_shock_tunit = 82499208.0
m1_shock_ref = ../../decks/ref_m7.txt
m1_shock_w = 2.0
m1_shock_rho_l = 5.69000000e+00
m1_shock_v_l = 1.21192446e+08
m1_shock_t_l = 2.18000000e+06
m1_shock_rho_r = 3.19609192e+01
m1_shock_v_r = 2.15758819e+07
m1_shock_t_r = 6.75689446e+06
m1_shock_xs = 1.79427684e+00

<output1>
file_type = tab
variable = m1
data_format = %.16e
dt = 1e-09
slice_x2 = 2.28142413e-01

<output2>
file_type = tab
variable = hydro_w
data_format = %.16e
dt = 1e-09
slice_x2 = 2.28142413e-01
