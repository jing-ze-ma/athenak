+                                                 n3, n2, n1);
+            }
+            auto khs = *rt_khs_ptr;
+            // chi over the active cells AND the angular ghosts.  A cell that takes no
+            // part in this call -- below its column's cut, or with no usable EOS state,
+            // or in the inert corona where kappa is 0 -- is marked with -1 and is left
+            // out of every neighbourhood: it has no extinction to lend.  The top slot
+            // i = ie+1 is the unresolved column above the domain, whose kappa is read
+            // WITHOUT a density (RTTopDtau uses p/g), so it is deliberately not smeared.
+            par_for("rt_hs_chi", DevExeSpace(), 0, nmb1, ks-kg_hs, ke+kg_hs,
+                    js-jg_hs, je+jg_hs, is, ie,
+            KOKKOS_LAMBDA(const int m, const int k, const int j, const int i) {
+              const bool ok = (i >= icut_g(m,k,j)) && (T_g(m,k,j,i) > 0.0);
+              const Real ch = ok ? kc_g(m,0,i,k,j)*rhoN(m,k,j,i) : -1.0;
+              khs(m,k,j,i) = (ch > 0.0) ? ch : -1.0;
+            });
+            const Real hsfac = rt_kappa_hsmooth_fac;
+            const int njh = jg_hs, nkh = kg_hs;
+            par_for("rt_hs_put", DevExeSpace(), 0, nmb1, ks, ke, js, je, is, ie,
+            KOKKOS_LAMBDA(const int m, const int k, const int j, const int i) {
+              const Real c0 = khs(m,k,j,i);
+              if (!(c0 > 0.0)) return;
+              const Real d2 = DX2(m,k,j,i), d3 = DX3(m,k,j,i);
+              // the shortest step to a neighbour that exists in this geometry
+              Real dmin;
+              if (njh > 0 && nkh > 0) {
+                dmin = (d2 < d3) ? d2 : d3;
+              } else {
