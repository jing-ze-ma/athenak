 rt_force_tau_lo    = 0.3
 rt_force_tau_hi    = 3.0
+# problem/rt_kappa_hsmooth: the POROSITY CORRECTION.  The radial sweep is per column, so
+# a shell of inhomogeneous rho at uniform T transports <1/(kappa rho)> and not
+# 1/<kappa rho>: 1.1-1.5x too much flux once convection is developed.  With this on, the
+# extinction chi = kappa rho the sweep builds its optical depths from is replaced by its
+# ARITHMETIC horizontal mean over a disc of radius rt_kappa_hsmooth_fac photon mean free
+# paths (arc length, capped at 3 cells) -- the sideways wandering a real photon does
+# before it is reabsorbed.  Density, temperature and the deposit's bookkeeping are
+# untouched, and cells thicker than one mean free path per cell are left bitwise alone,
+# so the deep diffusion limit does not move.  Listed (not left to its default) so that it
+# can be overridden from the command line.
+rt_kappa_hsmooth     = false
+rt_kappa_hsmooth_fac = 1.0
 # OPERATOR SPLITTING: the radiation operator is Strang-split around the time integrator
 # (dt/2 before, dt/2 after) instead of applied once per RK stage.
 rt_strang          = true
