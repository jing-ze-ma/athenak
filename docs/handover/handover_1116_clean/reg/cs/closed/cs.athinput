<job>
basename = cs

<mesh>
nghost = 2
nx1 = 32
x1min = 1.0
x1max = 20.0
ix1_bc = outflow
ox1_bc = outflow
nx2 = 8
x2min = -1.0
x2max = 1.0
ix2_bc = panel
ox2_bc = panel
nx3 = 8
x3min = -1.0
x3max = 1.0
ix3_bc = panel
ox3_bc = panel
use_cubed_sphere = true

<meshblock>
nx1 = 32
nx2 = 8
nx3 = 8

<time>
evolution = dynamic
integrator = rk2
cfl_number = 0.3
nlim = -1
tlim = 1.0
ndiag = 1000000

<hydro>
eos = ideal
reconstruct = plm
rsolver = hllc
gamma = 1.666666666666667
rad_signal_speed = false

<rad_m1>
c_light = 1.0
chat_over_c = 1.0
closure = eddington
e_floor = 1.0e-30
opacity = const
kappa_p = 0.0
kappa_e = 0.0
kappa_f = 0.0
kappa_s = 1e-10
arad = 1.0
coupling = true
gas_feedback = false
transport = implicit
implicit_cfl = 1.5119719593730057
implicit_solver = bicgstab
implicit_precond = mg
implicit_krylov_fuse = 1
implicit_recon = dc
implicit_bc_x1min = reflect
implicit_bc_x1max = reflect
implicit_ebath_x1min = 0.0
implicit_ebath_x1max = 0.0
time_scheme = hesdirk2
ic_rad = none
scheme = clean
clean_layout = cell
clean_closure = eddington
clean_sphere_radius = 0.0
clean_tol = 1.0e-14
clean_tol_nl = 1.0e-13
clean_maxnl = 60

<problem>
pgen_name = rad_m1_beam
m1_test = sph_shell
gas_rho = 1.0
gas_temp = 1e-16
e_out = 0.0
e_amp = 1.0
r0 = 10.5
width = 0.4
lat_amp = 0.9
lat_l = 1
lat_axis = vertex

<output1>
file_type = bin
bin_double = true
variable = m1
dt = 0.999999999

<output2>
file_type = bin
bin_double = true
variable = hydro_u
dt = 0.999999999
