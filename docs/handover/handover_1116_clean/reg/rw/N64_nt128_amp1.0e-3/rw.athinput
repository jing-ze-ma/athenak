<comment>
problem = runs_3r_radwave vetf_impl_x1_P3.33333_t0.1_N64_nt128_amp1.0e-3_armCLN_refvetqs_d_rm_clean_layoutcell_rm_schemeclean_tshesdirk2_vimptrue

<job>
basename = rw

<mesh>
nghost = 2
nx1 = 64
x1min = 0.0
x1max = 1.0
