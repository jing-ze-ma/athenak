diff --git a/src/pgen/tests/rad_m1_clump.cpp b/src/pgen/tests/rad_m1_clump.cpp
new file mode 100644
index 000000000..811d67b97
--- /dev/null
+++ b/src/pgen/tests/rad_m1_clump.cpp
@@ -0,0 +1,195 @@
+//========================================================================================
+// AthenaK astrophysical fluid dynamics and numerical relativity code
+// Copyright(C) 2020 James M. Stone <jmstone@ias.edu> and the Athena code team
+// Licensed under the 3-clause BSD License (the "LICENSE")
+//========================================================================================
+//! \file rad_m1_clump.cpp
+//! \brief <problem>/m1_test = clump: a porous (clumpy) photosphere.  A static held gas
+//! (pure absorption and emission, gas_feedback = false) on a uniform mesh, x1 = height
+//! h, x2 = horizontal y (periodic): an optically thick base h < cl_base_h at
+//! cl_base_t, above it a thin atmosphere (cl_atm_rho, cl_atm_t) holding cl_n circular
+//! clumps of density cl_rho at the same temperature.  On a spherical-polar mesh
+//! (x1 = r, x2 = theta) h = r - x1min and y = x1min (theta - x2min): a thin shell at
+//! large radius is the same plane-parallel problem.
+//!
+//! Clump centres and radii come from a splitmix64 stream seeded by cl_seed: centre h in
+//! [cl_h0, cl_h1], y in [0, P) (P the horizontal period), radius in [cl_r0, cl_r1].
+//! Every rank generates the whole list and every cell takes the fraction of its
+//! cl_nsub^2 sub-cell points (from its global index) that lie in a clump, so the field
+//! is the same bitwise for any MeshBlock layout or thread count.  The density of a cell
+//! is cl_atm_rho + (cl_rho - cl_atm_rho) times that fraction; with cl_smooth = true the
+//! fraction is its mean over the cell's row (the smooth layer of the same mean opacity).
+//! The gas (also in the ghost cells) is re-imposed every stage.
+
+#include <cmath>
+#include <cstdint>
+#include <iostream>
+#include <vector>
+
+#include "athena.hpp"
+#include "parameter_input.hpp"
+#include "mesh/mesh.hpp"
+#include "eos/eos.hpp"
+#include "hydro/hydro.hpp"
+#include "rad_m1/rad_m1.hpp"
+#include "pgen/pgen.hpp"
+
+namespace {
+constexpr int kClMax = 128;
+
+//! the clump list and the sub-cell sampling of the uniform mesh
+struct ClumpSet {
+  int n, ns;
+  Real per, d1, d2;                  // period in y, cell size in h and y
+  Real h[kClMax], y[kClMax], r[kClMax];
+};
+
+DvceArray5D<Real> cl_hold;           // the held gas (conserved, ghosts included)
+
+//! next number of the splitmix64 stream, as a double in [0, 1)
+double SplitMix(uint64_t &s) {
+  uint64_t z = (s += 0x9e3779b97f4a7c15ULL);
+  z = (z ^ (z >> 30))*0xbf58476d1ce4e5b9ULL;
+  z = (z ^ (z >> 27))*0x94d049bb133111ebULL;
+  z ^= z >> 31;
+  return static_cast<double>(z >> 11)*0x1.0p-53;
+}
+
+//! fraction of the sub-cell points of the cell with global index (gi, gj) in a clump
+KOKKOS_INLINE_FUNCTION
+Real ClumpFrac(const ClumpSet &c, const int gi, const int gj) {
+  int in = 0;
+  for (int a = 0; a < c.ns; ++a) {
+    const Real hh = (gi + (a + 0.5)/c.ns)*c.d1;
+    for (int b = 0; b < c.ns; ++b) {
+      const Real yy = (gj + (b + 0.5)/c.ns)*c.d2;
+      for (int q = 0; q < c.n; ++q) {
+        Real dy = yy - c.y[q];
+        dy -= c.per*round(dy/c.per);
+        if ((hh - c.h[q])*(hh - c.h[q]) + dy*dy < c.r[q]*c.r[q]) {
+          ++in;
+          break;
+        }
+      }
+    }
+  }
+  return static_cast<Real>(in)/(c.ns*c.ns);
+}
+
+void ClumpHold(Mesh *pm, const Real bdt);
+}  // namespace
+
+//----------------------------------------------------------------------------------------
+//! \fn void ProblemGenerator::RadiationM1Clump
+//! \brief m1_test = clump, see the file header
+
+void ProblemGenerator::RadiationM1Clump(ParameterInput *pin, const bool restart) {
+  MeshBlockPack *pmbp = pmy_mesh_->pmb_pack;
+  radm1::RadiationM1 *pm1 = pmbp->pradm1;
+  hydro::Hydro *ph = pmbp->phydro;
+  if (ph == nullptr || pm1 == nullptr || pm1->gas_feedback) {
+    std::cout << "### FATAL ERROR in " << __FILE__ << " at line " << __LINE__
+              << std::endl << "<problem>/m1_test = clump needs <hydro>, <rad_m1> and "
+              << "<rad_m1>/gas_feedback = false" << std::endl;
+    std::exit(EXIT_FAILURE);
+  }
+  auto &ms = pmy_mesh_->mesh_size;
+  const int nx1m = pmy_mesh_->mesh_indcs.nx1, nx2m = pmy_mesh_->mesh_indcs.nx2;
+  const bool sph = pmy_mesh_->use_spherical_polar;
+  ClumpSet c;
+  c.n = pin->GetOrAddInteger("problem","cl_n",24);
+  c.ns = pin->GetOrAddInteger("problem","cl_nsub",8);
+  c.d1 = (ms.x1max - ms.x1min)/nx1m;
+  c.d2 = (sph ? ms.x1min : 1.0)*(ms.x2max - ms.x2min)/nx2m;
+  c.per = c.d2*nx2m;
+  const Real h0 = pin->GetOrAddReal("problem","cl_h0",0.35);
+  const Real h1 = pin->GetOrAddReal("problem","cl_h1",0.65);
+  const Real r0 = pin->GetOrAddReal("problem","cl_r0",0.03);
+  const Real r1 = pin->GetOrAddReal("problem","cl_r1",0.05);
+  uint64_t s = static_cast<uint64_t>(pin->GetOrAddInteger("problem","cl_seed",20261116));
+  if (c.n < 0 || c.n > kClMax || c.ns < 1) {
+    std::cout << "### FATAL ERROR in " << __FILE__ << " at line " << __LINE__
+              << std::endl << "<problem>/cl_n must be 0.." << kClMax
+              << " and cl_nsub >= 1" << std::endl;
+    std::exit(EXIT_FAILURE);
+  }
+  for (int q = 0; q < c.n; ++q) {
+    c.h[q] = h0 + (h1 - h0)*SplitMix(s);
+    c.y[q] = c.per*SplitMix(s);
+    c.r[q] = r0 + (r1 - r0)*SplitMix(s);
+  }
+  const Real rhoc = pin->GetOrAddReal("problem","cl_rho",250.0);
+  const Real rhoa = pin->GetOrAddReal("problem","cl_atm_rho",0.1);
+  const Real ta = pin->GetOrAddReal("problem","cl_atm_t",0.5);
+  const Real rhob = pin->GetOrAddReal("problem","cl_base_rho",1000.0);
+  const Real tb = pin->GetOrAddReal("problem","cl_base_t",1.0);
+  const Real hb = pin->GetOrAddReal("problem","cl_base_h",0.25);
+  // cl_smooth: the row means of the clump fraction (every rank, all rows)
+  DvceArray1D<Real> rowf("cl_rowf", nx1m);
+  if (pin->GetOrAddBoolean("problem","cl_smooth",false)) {
+    auto hrow = Kokkos::create_mirror_view(rowf);
+    for (int gi = 0; gi < nx1m; ++gi) {
+      Real sum = 0.0;
+      for (int gj = 0; gj < nx2m; ++gj) sum += ClumpFrac(c, gi, gj);
+      hrow(gi) = sum/nx2m;
+    }
+    Kokkos::deep_copy(rowf, hrow);
+  } else {
+    Kokkos::deep_copy(rowf, -1.0);
+  }
+  if (global_variable::my_rank == 0) {
+    std::cout << "clump field: seed " << pin->GetInteger("problem","cl_seed") << ", "
+              << c.n << " clumps, period " << c.per << std::endl;
+  }
+
+  auto &indcs = pmy_mesh_->mb_indcs;
+  const int is = indcs.is, js = indcs.js, ng = indcs.ng, nmb1 = pmbp->nmb_thispack - 1;
+  const int n1 = indcs.nx1 + 2*ng, n2 = indcs.nx2 + 2*ng;
+  const int n3 = (indcs.nx3 > 1) ? indcs.nx3 + 2*ng : 1;
+  auto &size = pmbp->pmb->mb_size;
+  const Real x1a = ms.x1min, x2a = ms.x2min;
+  const Real dx1 = (ms.x1max - ms.x1min)/nx1m, dx2 = (ms.x2max - ms.x2min)/nx2m;
+  const Real gm1 = ph->peos->eos_data.gamma - 1.0, ar = pm1->arad;
+  auto uh = ph->u0;
+  auto u0 = pm1->u0;
+  par_for("clump_ic", DevExeSpace(), 0, nmb1, 0, n3-1, 0, n2-1, 0, n1-1,
+  KOKKOS_LAMBDA(const int m, const int k, const int j, const int i) {
+    // global indices from the MeshBlock's position (exact for any layout)
+    const int gi = static_cast<int>(round((size.d_view(m).x1min - x1a)/dx1)) + i - is;
+    const int gj = static_cast<int>(round((size.d_view(m).x2min - x2a)/dx2)) + j - js;
+    const int gw = gj - nx2m*static_cast<int>(floor(static_cast<Real>(gj)/nx2m));
+    const bool base = ((gi + 0.5)*c.d1 < hb);
+    Real f = 0.0;
+    if (!base && gi >= 0 && gi < nx1m) f = (rowf(gi) >= 0.0) ? rowf(gi)
+                                                               : ClumpFrac(c, gi, gw);
+    const Real d = base ? rhob : rhoa + (rhoc - rhoa)*f;
+    const Real t = base ? tb : ta;
+    uh(m,IDN,k,j,i) = d;
+    uh(m,IM1,k,j,i) = 0.0;
+    uh(m,IM2,k,j,i) = 0.0;
+    uh(m,IM3,k,j,i) = 0.0;
+    uh(m,IEN,k,j,i) = d*t/gm1;
+    if (!restart) {
+      u0(m,radm1::M1_E,k,j,i) = ar*SQR(SQR(t));
+      u0(m,radm1::M1_F1,k,j,i) = 0.0;
+      u0(m,radm1::M1_F2,k,j,i) = 0.0;
+      u0(m,radm1::M1_F3,k,j,i) = 0.0;
+    }
+  });
+  cl_hold = DvceArray5D<Real>("cl_hold", uh.extent(0), uh.extent(1), uh.extent(2),
+                              uh.extent(3), uh.extent(4));
+  Kokkos::deep_copy(cl_hold, uh);
+  Kokkos::push_finalize_hook([]() {cl_hold = DvceArray5D<Real>();});
+  user_srcs_func = ClumpHold;
+}
+
+namespace {
+//----------------------------------------------------------------------------------------
+//! \fn void ClumpHold
+//! \brief the held gas back into the conserved state, every stage
+
+void ClumpHold(Mesh *pm, const Real bdt) {
+  (void) bdt;
+  Kokkos::deep_copy(pm->pmb_pack->phydro->u0, cl_hold);
+}
+}  // namespace
