+<comment>
+problem   = porous (clumpy) photosphere, clean scheme with SC rays (vet_sc), 2-D Cartesian
+reference = exact long-characteristics formal solution of the same cell field
+            (held gas, pure absorption: x1 = height, x2 periodic)
+arms      = clean_face_model = milne, clean_pos_limit = false; nx1 = nx2 = 32 .. 256
+            (clump radius 1 .. 13 cells); <problem>/cl_smooth = true: the smooth layer
+            of the same row-mean opacity
+
+<job>
+basename = clump
+
+<mesh>
+nghost = 2
+nx1 = 128
+x1min = 0.0
+x1max = 1.0
+ix1_bc = outflow
+ox1_bc = outflow
+nx2 = 128
+x2min = 0.0
+x2max = 1.0
+ix2_bc = periodic
+ox2_bc = periodic
+nx3 = 1
+x3min = -0.5
+x3max = 0.5
+ix3_bc = periodic
+ox3_bc = periodic
+
+<meshblock>
+nx1 = 128
+nx2 = 128
+nx3 = 1
+
+<time>
+evolution = dynamic
+integrator = rk2
+cfl_number = 0.3
+nlim = 20
+tlim = 1.0e30
+ndiag = 1
+
+<hydro>
+eos = ideal
+reconstruct = plm
+rsolver = hllc
+gamma = 1.666666666666667
+rad_signal_speed = false
+
+<rad_m1>
+c_light = 1.0
+chat_over_c = 1.0
+e_floor = 1.0e-30
+opacity = const
+kappa_p = 1.0
+kappa_e = 1.0
+kappa_f = 1.0
+kappa_s = 0.0
+arad = 1.0e24
+coupling = true
+gas_feedback = false
+transport = implicit
+implicit_cfl = 128.0
+implicit_solver = bicgstab
+implicit_precond = line
+implicit_recon = dc
+implicit_bc_x1min = reflect
+implicit_bc_x1max = marshak
+implicit_ebath_x1min = 0.0
+implicit_ebath_x1max = 0.0
+time_scheme = hesdirk2
+ic_rad = none
+scheme = clean
+clean_layout = cell
+clean_init = steady
+closure = vet_sc
+vet_tensor = full
+vet_nmu = 8
+vet_nphi = 32
+
+<problem>
+pgen_name = rad_m1_beam
+m1_test = clump
+user_srcs = true
+cl_seed = 20261116
+cl_n = 24
+cl_nsub = 8
+cl_h0 = 0.35
+cl_h1 = 0.65
+cl_r0 = 0.03
+cl_r1 = 0.05
+cl_rho = 250.0
+cl_atm_rho = 0.1
+cl_atm_t = 5.0e-7
+cl_base_rho = 1000.0
+cl_base_t = 1.0e-6
+cl_base_h = 0.25
+cl_smooth = false
+
+<output1>
+file_type = bin
+bin_double = true
+variable = m1
+dt = 9.999999990000001
+
+<output2>
+file_type = bin
+bin_double = true
+variable = hydro_w
+dt = 200.0
