   } else if (test.compare("rhse") == 0) {
     RadiationM1Rhse(pin, restart);   // rad_m1_rhse.cpp
+  } else if (test.compare("clump") == 0) {
+    RadiationM1Clump(pin, restart);   // rad_m1_clump.cpp
   } else {
     std::cout << "### FATAL ERROR in " << __FILE__ << " at line " << __LINE__
