<comment>
problem                  = suite-1011 crooked pipe (JSD12 Sect 5.2, Gentile 2001 geometry in Cartesian): 7 opaque walls (rho 10, sigma 2000) via m1_test=cyl rects, pipe rho 0.01 sigma 0.2, isotropic T = 1 (0.5 keV) bath on x1min, static gas (kinematic + advect, no gas force), c = 300, units cm, 1e-8 s, 0.5 keV

<job>
basename = pipe

<mesh>
nghost    = 2
nx1                      = 512
x1min                    = 0.0
x1max                    = 7.0
ix1_bc                   = outflow
ox1_bc                   = outflow
nx2                      = 256
x2min                    = -2.0
x2max                    = 2.0
ix2_bc    = periodic
ox2_bc    = periodic
nx3       = 1
x3min     = -0.5
x3max     = 0.5
ix3_bc    = periodic
ox3_bc    = periodic

<meshblock>
nx1                      = 512
nx2                      = 256
nx3       = 1

<time>
evolution  = kinematic
integrator = rk2
cfl_number = 0.4
nlim                     = -1
tlim                     = 10.0
ndiag      = 1

<hydro>
eos         = ideal
reconstruct = plm
rsolver     = advect
gamma                    = 1.017147

<rad_m1>
implicit_thin_hcsf       = j
implicit_thin_js_gd      = x1
implicit_thin_bq_gd      = cell
implicit_thin_hcface     = tau
implicit_thin_hcface_gd  = x1
vet_seg                  = jump
vet_bc_diff              = face
vet_gd_symref            = col
time2_vet_col_source     = blend
implicit_gas_src         = conservative2
implicit_cs2_hll         = drag
implicit_cs2_shift       = false
implicit_vimp_bc         = true
time2_vet_sc             = predict
time2_vet_col            = predict
time2_vstage             = true
time2_pred_cap           = 0.5
time2_start              = be
implicit_thin_js_face    = hcface
vet_rotate_avg           = 4
implicit_vimp            = false
implicit_predictor_frozen = false
implicit_blend_xthin_mode = all
implicit_hr_recon = dc
implicit_hr_recon_fresh = 2
implicit_hr_damp = 0.0
implicit_hr_recon_qs = 0.0
implicit_hr_recon_qs_rel = 0.0
implicit_hr_pos = kill
implicit_accel = none
implicit_blend_xthin_wmin = 0.0
c_light                  = 300.0
chat_over_c  = 1.0
arad         = 1.0
e_floor      = 1.0e-30
closure      = m1
opacity                  = powerlaw
kappa_p                  = 200.0
kappa_e                  = 200.0
kappa_f                  = 200.0
kappa_s                  = 0.0
coupling                 = true
gas_feedback             = true
transport             = implicit
implicit_solver       = bicgstab
implicit_offdiag      = auto
implicit_closure_lag  = step
implicit_lin_maxit    = 200
implicit_lin_tol      = 1.0e-10
implicit_tol          = 1.0e-8
implicit_res_floor    = 0.0
implicit_maxit        = 200
implicit_flux         = central
implicit_flux_faces   = x1
implicit_flux_beam    = closure
implicit_blend        = tau_f
implicit_blend_flo    = 0.6
implicit_blend_tau0   = 1.0
implicit_blend_alpha  = 1.0
implicit_blend_r0     = 1.5
implicit_blend_xthin = 0.0
implicit_blend_fhi    = 0.9
time_scheme           = be
implicit_bc_x1min     = marshak
implicit_bc_x1max     = marshak
marshak_q             = 0.5
implicit_ebath_x1min  = 1.0
implicit_ebath_x1max  = 0.0
vet_nmu      = 8
vet_nphi     = 32
vet_sc_order = 1
vet_tensor   = full
vet_source_noesrc = false
implicit_cfl             = 22.0
rho_ref                  = 10.0
t_ref                    = 1.0
opac_a                   = 0.3333333333333333
opac_b                   = 0.0
dbg_gas_force            = false
dbg_gas_force_trans      = false

implicit_thin_switch     = none
implicit_thin_corr       = none
implicit_thin_recon      = dc
implicit_thin_bq         = cell
<problem>
pgen_name  = rad_m1_beam
m1_test    = cyl
user_srcs  = false
cyl_n      = 7
cyl_rho_bg = 0.01
cyl_t_bg   = 0.1
cyl0_shape = rect
cyl0_x = 3.5
cyl0_y = 0
cyl0_r = 0.0
cyl0_hl = 0.5
cyl0_hw = 1
cyl0_ang = 0.0
cyl0_rho = 10.0
cyl0_t = 0.1
cyl1_shape = rect
cyl1_x = 1.25
cyl1_y = -1.25
cyl1_r = 0.0
cyl1_hl = 1.25
cyl1_hw = 0.75
cyl1_ang = 0.0
cyl1_rho = 10.0
cyl1_t = 0.1
cyl2_shape = rect
cyl2_x = 1.25
cyl2_y = 1.25
cyl2_r = 0.0
cyl2_hl = 1.25
cyl2_hw = 0.75
cyl2_ang = 0.0
cyl2_rho = 10.0
cyl2_t = 0.1
cyl3_shape = rect
cyl3_x = 5.75
cyl3_y = -1.25
cyl3_r = 0.0
cyl3_hl = 1.25
cyl3_hw = 0.75
cyl3_ang = 0.0
cyl3_rho = 10.0
cyl3_t = 0.1
cyl4_shape = rect
cyl4_x = 5.75
cyl4_y = 1.25
cyl4_r = 0.0
cyl4_hl = 1.25
cyl4_hw = 0.75
cyl4_ang = 0.0
cyl4_rho = 10.0
cyl4_t = 0.1
cyl5_shape = rect
cyl5_x = 3.5
cyl5_y = -1.75
cyl5_r = 0.0
cyl5_hl = 1
cyl5_hw = 0.25
cyl5_ang = 0.0
cyl5_rho = 10.0
cyl5_t = 0.1
cyl6_shape = rect
cyl6_x = 3.5
cyl6_y = 2
cyl6_r = 0.0
cyl6_hl = 1
cyl6_hw = 0.5
cyl6_ang = 0.0
cyl6_rho = 10.0
cyl6_t = 0.1
<output1>
file_type   = bin
variable    = m1
dt          = 0.1
<output2>
file_type   = bin
variable    = hydro_w
dt          = 0.1
<output3>
file_type   = bin
variable    = m1_vsc
dt          = 0.1
