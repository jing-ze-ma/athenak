# RAVEN SMOKE variant of IA11_m35zams.athinput: Raven paths, meshblock nx3 64, no rst output
# M35ZAMS (= T42L5.0, Schultz, Bildsten & Jiang 2022 ApJL 924 L11) fresh IA9 deck, made 11-23 by
#   /viper/ptmp2/jinma/m35zams_1123/mkdeck_zams.py from Caltech's as-run IA9_m35mms.athinput (md5 52da1397) + the 4 IA11 keys (caltech-ia11-bd9553537):
#   every scheme / numerics key identical; star + grid keys replaced (S22 T42L5.0 grid, lateral wedge doubled
#   to 256 x 256 at the paper cell size, USER 11-23); ideal gas, IC fresh_prod_1120/m35zams/ic_m35zams_ideal.txt;
#   rays vet_gd_ls = 10 (S10, 120 directions) instead of GL 7x18 (USER 11-23).
# IA11 (USER 11-23): caltech-ia11-bd9553537 = Caltech as-run IA9_m35mms + the 4 IA11 keys of Orion ia11_m35mms.athinput
# FRESHGO 11-20 PRODUCTION recipe WN-GL (USER): WB on, NO rebalance, GL 7x18 fixed, THINF + maxit 800 + conv_max 1e-5, general gamma-law + floor_pay, 128x128 blocks, paper tlim, m1_vet/face x4; binary B_v203
# FRESHPREP 2026-11-20: fresh-production deck on v20.1 25ea76366, built by freshprep/build_decks.py
#   base viper1120/m35mms/m35mms.athinput + common_scheme (fixed rays: no ring keys) + keys/m35mms.txt keys/fixed_lq10.txt keys/wb.txt keys/wb_m35mms.txt
#   dropped: hydro/tfloor_kelvin problem/he_bc_linhao_diss problem/he_bc_linhao_fis problem/he_bc_linhao_mu1 problem/he_bc_linhao_rad problem/he_ic_linhao_file rad_m1/ic_rad rad_m1/implicit_blend rad_m1/implicit_blend_alpha rad_m1/implicit_blend_dtc rad_m1/implicit_blend_fhi rad_m1/implicit_blend_flo rad_m1/implicit_blend_tau0 rad_m1/implicit_blend_xthin rad_m1/implicit_closure_lag rad_m1/implicit_closure_thin_relax rad_m1/implicit_cs2_hll rad_m1/implicit_cs2_shift rad_m1/implicit_cs2_vimp_npass rad_m1/implicit_cs2_wbsolve rad_m1/implicit_f0_init rad_m1/implicit_face_mmat rad_m1/implicit_face_opac_n rad_m1/implicit_fb_local rad_m1/implicit_fb_local_rounds rad_m1/implicit_flux rad_m1/implicit_flux_beam rad_m1/implicit_flux_faces rad_m1/implicit_g0_exchange rad_m1/implicit_g0_limit rad_m1/implicit_gas_newton rad_m1/implicit_gas_newton_switch rad_m1/implicit_halo_direct rad_m1/implicit_halo_mpi rad_m1/implicit_halo_overlap rad_m1/implicit_hr_cmem rad_m1/implicit_hr_excess rad_m1/implicit_hr_face rad_m1/implicit_hr_face_gd rad_m1/implicit_krylov_fuse rad_m1/implicit_lin_cnorm rad_m1/implicit_lin_ew_max rad_m1/implicit_lin_tol rad_m1/implicit_lzx rad_m1/implicit_nofb_work rad_m1/implicit_od_cache rad_m1/implicit_offdiag rad_m1/implicit_one_pass rad_m1/implicit_op_stencil rad_m1/implicit_opac_lag_passes rad_m1/implicit_opac_newton rad_m1/implicit_opac_newton_guard_mode rad_m1/implicit_opac_update rad_m1/implicit_physflux rad_m1/implicit_precond rad_m1/implicit_predictor_frozen rad_m1/implicit_rad_inertia rad_m1/implicit_realisable_coupling rad_m1/implicit_solver rad_m1/implicit_thin_bq rad_m1/implicit_thin_bq_gd rad_m1/implicit_thin_corr rad_m1/implicit_thin_freeze rad_m1/implicit_thin_hcface rad_m1/implicit_thin_hcface_gd rad_m1/implicit_thin_hcsf rad_m1/implicit_thin_js_face rad_m1/implicit_thin_js_gd rad_m1/implicit_thin_recon rad_m1/implicit_thin_switch rad_m1/implicit_tol rad_m1/implicit_tsolve_opac rad_m1/implicit_tsolve_opac_mode rad_m1/implicit_vimp rad_m1/implicit_vimp_bc rad_m1/time2_adm_poslim rad_m1/time2_vet_col rad_m1/time2_vet_sc rad_m1/time2_vet_x2_fields rad_m1/vet_col_lat_posfix rad_m1/vet_gd_gl_nmu rad_m1/vet_gd_gl_nphi rad_m1/vet_gd_gl_stagger rad_m1/vet_gd_ls rad_m1/vet_gd_rotate_align rad_m1/vet_gd_rotate_dt rad_m1/vet_gd_rotate_slope rad_m1/vet_gd_rotate_stretch rad_m1/vet_gd_rotate_t0 rad_m1/vet_rotate_avg rad_m1/vet_source_noesrc rad_m1/zalesak_cap_rounds
# M35MMS = T35L5.2 (Schultz, Bildsten & Jiang 2022 ApJL 924 L11; Schultz+2023 ApJL 951 L42 Table 1) reproduction deck
# made by /viper/ptmp2/jinma/m35mms_1115/jobs/mkdeck.py from the T9L6.2 paper-BC deck t9l62_final.athinput; table in SETUP.md
# tags: [PAPER] [IC] [SCRIPT] [NS]=not stated (our choice) [RT]=radiation by necessity [PROD] [CANNOT];
# untagged keys = T9L6.2 paper-BC deck numerics (rk2, plm, hllc, no fofc, pointmass gravity, zero-contact inner ghosts +
# he_bc_linhao fixed rho/T/F_r ghosts with the half-range face, marshak top, vet_gd fixed rays, prod-1118 R136 sp key set).
<job>
basename                 = m35zams                # M35ZAMS = T42L5.0 (Schultz+2022)
<mesh>
nghost    = 3
nx1                      = 384                    # [PAPER] S22 sect 2.1 T42L5.0: 384 logarithmically spaced radial bins
x1min                    = 4.7294000000e+11       # [PAPER] S22: 6.798 Rsun
x1max                    = 5.7031000000e+11       # [PAPER] S22: 8.200 Rsun (1.0378 R_ph)
ix1_bc    = user
ox1_bc    = user
nx2                      = 256                    # [USER 11-23] 2 x S22 128: theta wedge doubled at the paper cell size
x2min                    = 1.50670783666166486    # [USER 11-23] pi/2 - 2 x S22 half-width (S22: 0.4898 pi)
x2max                    = 1.63488481692812826    # [USER 11-23] pi/2 + 2 x S22 half-width (S22: 0.5102 pi)
ix2_bc                   = periodic               # [PAPER] S22: periodic angular boundaries
ox2_bc                   = periodic               # [PAPER]
nx3                      = 256                    # [USER 11-23] 2 x S22 128
x3min                    = 0.0                    # [PAPER] S22: phi 0
x3max                    = 0.12800000000000000    # [USER 11-23] 2 x S22 0.064
ix3_bc                   = periodic               # [PAPER]
ox3_bc                   = periodic               # [PAPER]
use_spherical_polar = true
# (removed: BSG-only) use_grid_stretch_r_poly = true
# (removed: BSG-only) f_stretch_r_p_amp = -0.66666666666666667   # [PAPER, his SMR reconstructed] dr 0.3125 Rsun on 20-35 and 55-80, 0.15625 on 35-55 (refinement level 1)
# (removed: BSG-only) f_stretch_r_p_xa = 0.1875                    # = face 48/256 = 35 Rsun (his refined region starts at a base-block edge)
# (removed: BSG-only) f_stretch_r_p_xb = 0.6875                    # = face 176/256 = 55 Rsun
# (removed: BSG-only) f_stretch_r_p_w = 1.0e-12                    # sharp edges: every face equals his piecewise-uniform faces to < 1e-10 Rsun
use_grid_stretch_r       = true                   # [PAPER-ish] logarithmic radial grid (Schultz+2022 wedges: log bins; T9L6.2 not stated)
f_stretch_r              = -0.187211542088146     # [PAPER] log bins: = -ln(x1max/x1min) (dlnr = 4.875301e-04; dtheta = 5.006913e-04, dphi = 5.000000e-04)
layout_invariant = true   # FRESHPREP
layout_invariant_mode    = block                  # [PROD]
cs_seam_blockend = extend   # FRESHPREP
cs_vertex_3cell = true   # FRESHPREP
cs_seam_rho_guard = 4   # FRESHPREP
<meshblock>
nx1                      = 384                    # vet_gd: one x1 block
nx2                      = 128                    # 4 blocks = 1 per GPU on a 4-GPU node; 128 >= vet_gd near-tangent reach 127
nx3 = 64   # RAVEN A100 smoke layout (8 blocks, 40 GB); 64 < reach 127 in phi: clamped reads, allowed by vet_gd_allow_clamp
<time>
dt_retry = true   # FRESHPREP
evolution  = dynamic
integrator = rk2
cfl_number = 0.3   # CALSMOKE IA9 key (NOTE 23c; deck had: cfl_number = 0.3   # FRESHPREP)
nlim       = -1
tlim = 8.64e5   # PROD 11-21 (orion ig/ih), replaced: 8.64e5
ndiag      = 50
restart_refill_ghosts = false   # FRESHPREP
# ---- UNISET IA9-validated <time> keys (all three stars; D8, D14: dt_retry_t2_be 0 named) ----
dt_retry_fac             = 0.5        # UNISET IA9
dt_retry_fac_t2          = 0.9        # UNISET IA9
dt_retry_grow            = 1.1        # UNISET IA9
dt_retry_host            = false      # UNISET IA9
dt_retry_max             = 8          # UNISET IA9
dt_retry_ngood           = 20         # UNISET IA9
dt_retry_views           = minimal    # UNISET IA9
dt_retry_t2_be           = 0          # UNISET IA9
nan_check_cycles         = 100        # UNISET IA9
<units>
length_cgs = 1.0
mass_cgs   = 1.0
time_cgs   = 1.0
mu                       = 0.6220                 # [IC] ic_m35zams_ideal.txt (build_ic_ideal.py, total-pressure HSE fit); NOT stated in S22
<hydro>
# (removed: BSG-only) merge_lat_rc             = 2.43495e12,3.82635e12,5.5656e12   # USER 11-06 his SMR: 128^2 at 20-35, 256^2 at 35-55, 128^2 at 55-80 Rsun
# (removed: BSG-only) merge_lat_f              = 2,1,2
# (removed: BSG-only) merge_lat_mom            = rigid
# (removed: BSG-only) merge_lat_rad            = true            # USER 11-06: radiation also 128^2 in the merged shells, as his grid
# (removed: BSG-only) merge_lat_diag           = 1000
split_c2p_once = true   # FRESHPREP
am_transport   = true         # [OURS] numerical default kept (user 11-04); Athena++ (his code) has none
sp_x2_periodic_image = true   # theta-periodic wedge: seam mass/energy fix (mass_1009)
eos = general   # FRESHPREP
rad_signal_speed = true
gamma       = 1.6666666666666667
reconstruct = plm
rsolver     = hllc             # paper: HLLC
fofc        = false            # USER 11-06: as Linhao (no FOFC)
etotgrav = true   # FRESHPREP
wellbalance_dynamic = true   # FRESHPREP
dfloor                   = 1.0e-17                # [NS] = the IC density floor above the photosphere (r > 8.007 Rsun)
pfloor                   = 1.0e-12                # [NS]
dfloor_keep_velocity = true
vceil                    = 3.0e8                  # [NS] > escape speed at the base (1.4e+08)
wall_wb_onesided = true   # FRESHPREP
floor_pay = rad_column   # FRESHPREP
general_eos = gamma   # FRESHPREP
tfloor                   = 133673032492.78598     # 1000 K / temp_unit_kelvin (as M35MMS)
wb_x1 = true   # FRESHPREP
wb_option = polytropic   # FRESHPREP
wb_cache_every = 0   # FRESHPREP
wb_rmax                  = 6.691526e+11           # 1.25 x he_ic_balance_rmax (M35MMS / T19L6.4 FRESHPREP ratio); > x1max
<rad_m1>
floorcap_report = 25   # PROD 11-21 (orion ig/ih)
floorcap_v = 3e7   # PROD 11-21 (orion ig/ih)
floorcap_rho = 1e-14   # PROD 11-21 (orion ig/ih)
clean_stag_thinf_held            = false        # UNISET IA9: IA9 all three false (was true)
clean_stag_flim                  = false        # UNISET IA9: IA9 all three false; Caltech prod already moved to flim off (was true)
clean_init_dtfac = 1.0e6   # PROD 11-21 (orion ig/ih)
vet_gd_gl_nmu = 0   # USER 11-23: level-symmetric S10 (vet_gd_ls = 10, 120 directions) instead of GL 7x18: the GL product set needs a phi wedge that is a multiple of 20 deg
vet_gd_gl_nphi = 18   # inert (vet_gd_gl_nmu = 0)
vet_gd_gl_stagger = true   # inert (vet_gd_gl_nmu = 0)
clean_stag_thinf                 = false        # UNISET IA9: IA9 all three false (was true)
time2_enth_be            = true           # [RT] = the 10-14 binary's fresh default (named)
time2_fref_wacc          = true           # [RT] inert (force_reference = none)
# vet_gd_twin_state        = mean   # needed with twin off   # UNISET: dropped, listed under no effect in the CALSMOKE run.log
# vet_gd_twin_weight       = none           # FIN3 (prodswitch-1013, fin3-1012)   # UNISET: dropped, listed under no effect in the CALSMOKE run.log
vet_interp               = auto           # FIN3 (prodswitch-1013, fin3-1012)
vet_col_lat_cut_thin     = 1.0            # FIN3 (prodswitch-1013, fin3-1012)
vet_bc_inner             = auto           # FIN3 (prodswitch-1013, fin3-1012)
vet_bc_reflect           = auto           # FIN3 (prodswitch-1013, fin3-1012)
vet_source                       = relaxed_esc  # UNISET IA9: IA9 all three relaxed_esc (HG via alias vet_col_source); deck had relaxed (was relaxed)
time2_start              = be             # FIN
# time2_vstage             = true           # FIN   # UNISET: dropped, listed under no effect in the CALSMOKE run.log
# time2_pred_cap           = 0.5            # FIN   # UNISET: dropped, listed under no effect in the CALSMOKE run.log
time2_vet_col_source     = blend          # FIN (X sporder-1012)
implicit_gas_src         = conservative2  # FIN (consfix-1011; full BSG OK, DeltaAI 3363656)
vet_seg                  = jump           # FIN (coreL-1012; was emit)
vet_bc_diff              = face           # FIN
# vet_gd_symref            = none   # USER 11-06 twin off, as R136a1   # UNISET: dropped, listed under no effect in the CALSMOKE run.log
vet_source_noesrc_h2be   = true           # bsgrec-R
vet_gd_allow_clamp       = true           # [OURS-BIN] binary compatibility, not physics: the 10-14 binaries clamped the vet_gd lateral reach silently (band 64, needs 102); prod-1102 FATALs unless allowed (as bsgma-1104)
vet_gd_halo_ipc          = false                  # multi-node run (Caltech IPC key off)
# vet_gd_twin_fuse         = false  # twin off, as R136a1   # UNISET: dropped, listed under no effect in the CALSMOKE run.log
# vet_gd_twin_lowmem       = true           # Caltech: 8 blocks/GPU, as your BSG fin3 deck (bitwise vs false per DeltaAI mem2)   # UNISET: dropped, listed under no effect in the CALSMOKE run.log
# vet_gd_twin_det          = true   # accel-1009: fixed-order twin shell means (GPU run-to-run bitwise)   # UNISET: dropped, listed under no effect in the CALSMOKE run.log
# vet_gd_twin = false   # FRESHPREP   # UNISET: dropped, listed under no effect in the CALSMOKE run.log
implicit_pos_floor_solve = true   # F3 (needs implicit_pos_floor = true)
vet_scatter_form         = ma     # paper split (Jiang 2021 eq. 6)
vet_scatter_j            = relaxed
vet_scatter_kappa_e      = const                  # ideal gas, kappa_es const 0.34 (X 0.70)
# report_newton_fb = false   # rc-1009: no per-step iw host copy (F4 counters keep the count)   # UNISET: dropped, listed under no effect in the CALSMOKE run.log
c_light          = 2.99792458e10
arad                     = 2.3696042497e-47       # a_cgs (7.5657332e-15) T_unit^4, T_unit = mu m_u/k_B = 7.4809404811e-09 K
chat_over_c      = 1.0
closure          = vet_col          # vet_gd rides on the vet_col interface; vet_gd_replace drops the vet_col sweep
vet_gd           = true
vet_scatter      = true           # Ma+2026 kappa_a/kappa_e split in the closure source (Jiang 2021 eq. 6, form ma; VET_SCATTER.md: <= 6e-6 effect)
vet_gd_replace   = true
vet_col_lat_taucut = 30.0
# vet_gd_rotate_every = 10  # bsgprod-1012: DROPPED (vet_gd_rotate_dt in this block = the physical clock)
vet_col_lat_offdiag = operator       # T5wihc
vet_gd_tangential = true   # FRESHPREP
vet_gd_wall_interp  = true           # T5wihc
vet_gd_halo_compact = 2              # T5wihc
opacity          = table
temp_unit_kelvin         = 7.4809404811e-09       # mu 0.6220
rho_unit_cgs     = 1.0
kappa_unit       = 1.0
e_floor          = 1.0e-4
coupling         = true
gas_feedback     = true
force_reference = wb_arad   # FRESHPREP
transport        = implicit
implicit_lin_maxit = 200
implicit_resid_fatal = 1.0e-2
implicit_maxit   = 200
implicit_enthalpy = plm
implicit_predictor = step
implicit_pos_gas = true   # FRESHPREP
implicit_pos_floor = true
time_scheme              = hesdirk2       # FIN (was be in the 10-09 hr deck)
vet_col_every    = 1
marshak_q        = 0.5
implicit_bc_x1min = flux   # FRESHPREP
implicit_flux_x1min      = 2.3546330983e+14       # [IC] L/(4 pi r_in^2), L = MESA L 6.618281e38
implicit_bc_x1max   = marshak
implicit_flux_x1max = 0.0
implicit_predictor_tcap = 1.1   # FRESHPREP
time2_face_fct = true   # FRESHPREP
time2_k1_redist = 0   # FRESHPREP
time2_stage_local_be = false   # FRESHPREP
scheme = clean   # FRESHPREP
clean_layout = staggered   # FRESHPREP
clean_rays = sc   # FRESHPREP
zalesak_active = true   # FRESHPREP
clean_xt_exact = cons   # FRESHPREP
implicit_pos_floor_cons = true   # FRESHPREP
implicit_pos_floor_gas_keep = 1   # FRESHPREP
implicit_pos_gas_cons = true   # FRESHPREP
clean_stag_xdonor = lag   # FRESHPREP
clean_stag_xsrc = true   # FRESHPREP
clean_stag_mg_color = mirror   # FRESHPREP
time2_auto_be = 16   # FRESHPREP
time2_k1_stiff = 0   # CALSMOKE IA9 key (NOTE 23c; deck had: time2_k1_stiff = 0   # FRESHPREP)
time2_gtime_mom = true   # IA11 (CALQ: sdirk2 stage-2 flux momentum f = 1/g)
clean_conv_kappa = 1.0   # FRESHPREP
clean_w_fse_tau = true   # IA11 (EPSEFF: fse eps over the cell optical depth)
cs_vertex_mono = true   # FRESHPREP
cs_cross_mono = true   # FRESHPREP
clean_init = steady   # FRESHPREP
vet_rotate_avg_ema               = 0            # USER 11-23: rotation OFF for the Caltech stars (resolution choice), as J4
clean_cs_lz_tel                  = false        # spherical-polar deck: cs-only key (true FATALs); deck value kept (UNISET fix 08:15)
vet_gd_ls = 10   # USER 11-23: S10, 120 directions; phi walls via vet_gd_wall_interp
vet_rotate_avg                   = 0            # USER 11-23: rotation OFF for the Caltech stars (resolution choice), as J4
vet_gd_rotate_dt                 = 0            # USER 11-23: rotation OFF for the Caltech stars (resolution choice), as J4
force_reference_work = split   # FRESHPREP
clean_maxit                      = 200          # UNISET IA9: IA9 all three 200 (FLAG: deck had 800; fresh start may need more -> see FLAGS) (was 800)
clean_conv_max = 1.0e-5   # FRESHPREP
time2_tableau = sdirk2   # CALSMOKE IA9 key (NOTE 23c)
clean_stag_xdonor_freeze = 4   # CALSMOKE IA9 key (NOTE 23c)
time2_cfl_post = true   # CALSMOKE IA9 key (NOTE 23c)
clean_w_fse = true   # CALSMOKE IA9 key (NOTE 23c)
clean_face_hctau = true   # CALSMOKE IA9 key (NOTE 23c)
clean_face_jse = true   # CALSMOKE IA9 key (NOTE 23c)
clean_face_jse_cell = false   # CALSMOKE IA9 key (NOTE 23c)
clean_bc_area = true   # CALSMOKE IA9 key (NOTE 23c)
clean_stag_upwind_central = true   # CALSMOKE IA9 key (NOTE 23c)
vet_seg_plateau = false   # CALSMOKE IA9 key (NOTE 23c)
clean_rot_ring_fill_rst = true   # CALSMOKE IA9 key (NOTE 23c)
clean_rst_mshare = true   # CALSMOKE IA9 key (NOTE 23c)
# ---- UNISET IA9-validated keys not named before (D8: name every uniform key) ----
clean_bc                         = halfrange    # UNISET IA9 (all three stars)
clean_bicg_stall_fac             = 0.99         # UNISET IA9 (all three stars)
clean_bicg_stall_its             = 0            # UNISET IA9 (all three stars)
clean_closure                    = extrap1      # UNISET IA9 (all three stars)
clean_consistency                = 1            # UNISET IA9 (all three stars)
clean_conv                       = budget       # UNISET IA9 (all three stars)
clean_conv_est_f                 = 0            # UNISET IA9 (all three stars)
clean_face_area                  = 0            # UNISET IA9 (all three stars)
clean_face_hclat                 = 0            # UNISET IA9 (all three stars)
clean_face_opac                  = harmonic     # UNISET IA9 (all three stars)
clean_fill_cs_remap              = 0            # UNISET IA9 (all three stars)
clean_fill_passes                = 8            # UNISET IA9 (all three stars)
clean_gas_newton_switch          = 4            # UNISET IA9 (all three stars)
clean_gas_newton_switch_min      = 6            # UNISET IA9 (all three stars)
clean_halo_direct                = 1            # UNISET IA9 (all three stars)
clean_init_cnorm                 = 1e-10        # UNISET IA9 (all three stars)
clean_lin_cnorm                  = 1e-10        # UNISET IA9 (all three stars)
clean_lin_pass                   = true         # UNISET IA9 (all three stars)
clean_maxnl                      = 200          # UNISET IA9 (all three stars)
clean_maxpic                     = 12           # UNISET IA9 (all three stars)
clean_nl_norm                    = global       # UNISET IA9 (all three stars)
clean_pass_damp                  = 0            # UNISET IA9 (all three stars)
clean_pc_sweep                   = rb           # UNISET IA9 (all three stars)
clean_predict                    = 1            # UNISET IA9 (all three stars)
clean_ray_cut_margin             = 10           # UNISET IA9 (all three stars)
clean_ray_cut_r                  = 0.01         # UNISET IA9 (all three stars)
clean_ray_cut_taumin             = 0            # UNISET IA9 (all three stars)
clean_ray_cut_wait               = 10           # UNISET IA9 (all three stars)
clean_ray_min                    = 0.001        # UNISET IA9 (all three stars)
clean_ray_source_relaxed         = 0            # UNISET IA9 (all three stars)
clean_retry_budget               = 0            # UNISET IA9 (all three stars)
clean_ring_jmin                  = 1            # UNISET IA9 (all three stars)
clean_rot_fuse                   = true         # UNISET IA9 (all three stars)
clean_rot_ring                   = off          # rotation OFF (USER): live FATALs without rotating rays (UNISET fix 08:15)
clean_source_convex              = 1            # UNISET IA9 (all three stars)
clean_stag_fcone                 = true         # UNISET IA9 (all three stars)
clean_stag_fwb                   = true         # UNISET IA9 (all three stars)
clean_stag_fwb_ring              = 0            # UNISET IA9 (all three stars)
clean_stag_fwb_stage             = false        # IA11 (FDIP; IA9 had true)
clean_stag_fwb_t2                = false        # IA11 (FDIP; IA9 had true)
clean_stag_lat_sums              = 0            # UNISET IA9 (all three stars)
clean_stag_opac_drag             = 0            # UNISET IA9 (all three stars)
clean_stag_opac_passes           = 3            # UNISET IA9 (all three stars)
clean_stag_opac_update           = true         # UNISET IA9 (all three stars)
clean_stag_pcr                   = 1            # UNISET IA9 (all three stars)
clean_stag_rayratio              = 0            # UNISET IA9 (all three stars)
clean_stag_tie_gid               = 0            # UNISET IA9 (all three stars)
clean_stall_fac                  = 0.5          # UNISET IA9 (all three stars)
clean_thin_donor                 = 0            # UNISET IA9 (all three stars)
clean_tol                        = 1e-10        # UNISET IA9 (all three stars)
clean_tol_nl                     = 1e-11        # UNISET IA9 (all three stars)
