<time>
dt_retry_host         = false   # gpumem-1022 (USER 10-22, viper 9488ff21): dtr checkpoint in pinned host memory (H100 fit)
evolution             = dynamic 
integrator            = rk2     
cfl_number            = 0.3     # radiation-dominated (user rule)
nlim                  = -1      
tlim                       = 8.64e5                 # m35zams-mesaR-1115 10 model days (S23 sect 4)
ndiag                 = 50      
dt_retry              = true    # hg145-1015: hgF4w run.cfg XKEYS (production decks name it, NOTE-2026-10-15-raven-hegiant-large-fin51)
