<job>
basename                   = m35zams                # m35zams-mesaR-1115
<mesh>
cs_seam_flux              = shared              # csedge-1019 (USER 10-19 seam fix): ONE Riemann problem per seam face (= the new cs default; 09-26 positive drove the cube-edge instability)
nghost                    = 3                   
nx1                        = 384                    # m35zams-mesaR-1115 S22 T42L5.0 domain
x1min                      = 4.7294000000e+11       # m35zams-mesaR-1115 tool: explicit: 6.798 Rsun
x1max                      = 5.7031000000e+11       # m35zams-mesaR-1115 tool: 1.03779 R_ph (r_top rule)
ix1_bc                     = user                   # m35zams-mesaR-1115 tool: 
ox1_bc                     = user                   # m35zams-mesaR-1115 tool: 
nx2                        = 128                    # m35zams-mesaR-1115 S22 T42L5.0 domain
x2min                      = 1.53875208172828071    # m35zams-mesaR-1115 S22 T42L5.0 domain
x2max                      = 1.60284057186151241    # m35zams-mesaR-1115 S22 T42L5.0 domain
ix2_bc                     = periodic               # m35zams-mesaR-1115 S22 T42L5.0 domain
ox2_bc                     = periodic               # m35zams-mesaR-1115 S22 T42L5.0 domain
nx3                        = 128                    # m35zams-mesaR-1115 S22 T42L5.0 domain
x3min                      = 0.0                    # m35zams-mesaR-1115 S22 T42L5.0 domain
x3max                      = 0.064                  # m35zams-mesaR-1115 S22 T42L5.0 domain
ix3_bc                     = periodic               # m35zams-mesaR-1115 S22 T42L5.0 domain
ox3_bc                     = periodic               # m35zams-mesaR-1115 S22 T42L5.0 domain
use_grid_stretch_r_poly    = false                  # m35zams-mesaR-1115 S22 T42L5.0 domain
use_cubed_sphere           = false                  # m35zams-mesaR-1115 S22 T42L5.0 domain
cs_vertex_fill            = 1                   # Default value added at run time
cs_vertex_fill_cc         = 0                   # Default value added at run time
cs_seam_rho_guard         = 4                   # Default value added at run time
cs_seam_resample          = linear              # Default value added at run time
use_spherical_polar        = true                   # m35zams-mesaR-1115 S22 T42L5.0 domain
use_grid_stretch_r         = true                   # m35zams-mesaR-1115 S22 T42L5.0 domain
use_grid_stretch_theta    = 0                   # Default value added at run time
use_polar_boundary        = 0                   # Default value added at run time
polar_quadratic_recon     = 0                   # Default value added at run time
polar_x3_shift            = rotate              # Default value added at run time
use_polar_average_eresist = 1                   # Default value added at run time
theta_plateau             = 0                   # Default value added at run time
polar_ring_avg            = 0                   # Default value added at run time
cs_seam_blockend          = extend              # added on the command line of a restart
cs_vertex_3cell           = true                # added on the command line of a restart
layout_invariant          = true                # added on the command line of a restart
layout_invariant_mode     = block               # Default value added at run time
cs_seam_pos_global        = 1                   # Default value added at run time
f_stretch_r                = -0.187211542088146     # m35zams-mesaR-1115 S22 T42L5.0 domain
<meshblock>
nx1                        = 384                    # m35zams-mesaR-1115 1 block (vet_gd near-tangent reach = 127 lateral cells needs the whole 128 x 128 wedge per block; he_star_m1 needs 1 block in r)
nx2                        = 128                    # m35zams-mesaR-1115 1 block (vet_gd near-tangent reach = 127 lateral cells needs the whole 128 x 128 wedge per block; he_star_m1 needs 1 block in r)
