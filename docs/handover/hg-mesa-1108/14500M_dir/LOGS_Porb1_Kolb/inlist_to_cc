

&star_job
      show_log_description_at_start = .false.

      load_saved_model = .true.
      saved_model_name = 'lgTmax.mod'

      save_model_when_terminate = .true.
      save_model_filename = 'final.mod'
      required_termination_code_string = 'fe_core_infall_limit'

      set_initial_dt = .true.
      years_for_initial_dt = 1d-6

/ ! end of star_job namelist

&eos
/ ! end of eos namelist

&kap
/ ! end of kap namelist

&controls

      fe_core_infall_limit = 1d7

      ! limit max_model_number as part of test_suite
      max_model_number = 8000
      !max_number_retries = 37

! wind

! atmosphere

! rotation

! mlt

! mixing

! timesteps
      delta_HR_limit = 8d-3

      limit_for_rel_error_in_energy_conservation = 1d-4
      hard_limit_for_rel_error_in_energy_conservation = 1d-3

      delta_lgRho_cntr_limit = 0.01
      delta_lgRho_cntr_hard_limit = 0.1
      delta_lgRho_limit = 0.1 
      
      !delta_lgT_cntr_limit_only_after_near_zams = .true.
      delta_lgT_cntr_limit = 0.003
      delta_lgT_cntr_hard_limit = 0.1

      delta_lgT_max_limit_only_after_near_zams = .true.
      delta_lgT_max_limit = 0.003     
      delta_lgT_max_hard_limit = 0.1

      !delta_XSi_cntr_limit = 0.0003d0
      !delta_XSi_cntr_hard_limit = 0.03d0

! mesh

! solver
      
! output

      num_trace_history_values = 5
      trace_history_value_name(1) = 'Fe_core'
      trace_history_value_name(2) = 'fe_core_infall'
      trace_history_value_name(3) = 'rel_E_err'
      trace_history_value_name(4) = 'log_rel_run_E_err'
      trace_history_value_name(5) = 'dt_div_max_tau_conv'

      photo_interval = 10
      !profile_interval = 1
      !history_interval = 1
      terminal_interval = 1
      star_history_name = 'history4.data'



/ ! end of controls namelist



&pgstar
/ ! end of pgstar namelist
