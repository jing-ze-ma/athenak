<comment>
problem = rhse: spherical grey scattering envelope in hydrostatic + radiative equilibrium (clean wb test)
<job>
basename = rh
<mesh>
nghost = 2
nx1 = 548
x1min = 1.0
x1max = 2.0
ix1_bc = reflect
ox1_bc = reflect
nx2 = 64
x2min = 1.3089969389957472
x2max = 1.832595714594046
ix2_bc = reflect
ox2_bc = reflect
nx3 = 128
x3min = 0.0
x3max = 1.0471975511965976
ix3_bc = periodic
ox3_bc = periodic
use_spherical_polar = true
<meshblock>
nx1 = 548
nx2 = 64
nx3 = 64
<time>
evolution = dynamic
integrator = rk2
cfl_number = 0.3
nlim = 25
tlim = 1e30
ndiag = 1
<hydro>
eos = ideal
reconstruct = plm
rsolver = hllc
gamma = 1.666666666666667
rad_signal_speed = false
wellbalance_static = false
wellbalance_static_reconst = false
<rad_m1>
c_light = 40.0
chat_over_c = 1.0
closure = vet_col
vet_col_lat = true
vet_gd = true
vet_gd_twin = false
vet_gd_rotate_dt = 0
e_floor = 1.0e-30
opacity = const
kappa_p = 0.0
kappa_e = 0.0
kappa_f = 0.0
kappa_s = 500.0
arad = 1.0
coupling = true
gas_feedback = true
transport = implicit
implicit_cfl = 1.0e4
implicit_solver = bicgstab
implicit_precond = line
implicit_recon = dc
implicit_bc_x1min = marshak
implicit_bc_x1max = marshak
implicit_ebath_x1min = 0.0
implicit_ebath_x1max = 0.0
time_scheme = hesdirk2
ic_rad = none
vet_gd_gl_nmu = 10
vet_gd_gl_nphi = 12
<problem>
pgen_name = rad_m1_beam
m1_test = rhse
user_srcs = true
user_hist = true
rh_gm = 1.0
rh_eddf = 0.3
rh_rho0 = 1.0
rh_temp = 0.1
rh_seed = 0.0
<output1>
file_type = hst
dt = 1e30
data_format = %.16e
<output2>
file_type = bin
variable = hydro_w
dt = 1e30
