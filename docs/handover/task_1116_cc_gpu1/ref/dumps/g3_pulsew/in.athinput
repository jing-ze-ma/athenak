<job>
basename = sp

<mesh>
nghost = 2
nx1 = 256
x1min = 1.0
x1max = 24.0
ix1_bc = outflow
ox1_bc = outflow
nx2 = 1
x2min = 1.1707963267948966
x2max = 1.9707963267948967
ix2_bc = reflect
ox2_bc = reflect
nx3 = 1
x3min = 0.0
x3max = 1.0471975511965976
ix3_bc = periodic
ox3_bc = periodic
use_spherical_polar = true

<meshblock>
nx1 = 256
nx2 = 1
nx3 = 1

<time>
evolution = dynamic
integrator = rk2
cfl_number = 0.3
nlim = -1
tlim = 4.0
ndiag = 1000000

<hydro>
eos = ideal
reconstruct = plm
rsolver = hllc
gamma = 1.666666666666667
rad_signal_speed = false

<rad_m1>
c_light = 1.0
chat_over_c = 1.0
closure = eddington
e_floor = 1.0e-30
opacity = const
kappa_p = 0.0
kappa_e = 0.0
kappa_f = 0.0
kappa_s = 1e-10
arad = 1.0
coupling = true
gas_feedback = false
transport = implicit
implicit_cfl = 0.5
implicit_solver = bicgstab
implicit_precond = line
implicit_recon = dc
implicit_bc_x1min = reflect
implicit_bc_x1max = marshak
implicit_ebath_x1min = 0.0
implicit_ebath_x1max = 0.0
time_scheme = hesdirk2
ic_rad = none
scheme = clean
clean_layout = cell
clean_closure = sphere
clean_sphere_radius = 0.0
clean_tol = 1.0e-14
clean_tol_nl = 1.0e-13
clean_maxnl = 60
clean_w_c0 = 0.1
clean_w_c1 = 0.5
clean_maxit = 4000
clean_ray_min = 0.001
clean_fill_passes = 8
clean_predict = true
clean_bc = halfrange
clean_alpha = tau
clean_recon = plm
clean_consistency = false
clean_consistency_weight = true
clean_face_model = none
clean_psi_eps = 1e-12
clean_maxpic = 12
clean_pos_limit = true
clean_diag_cells = false
clean_pos_boundary = false
clean_pos_ghost = false
clean_vfreeze = 0
clean_maxpos = 3
clean_pc_sweeps = 1
<problem>
pgen_name = rad_m1_beam
m1_test = sph_shell
gas_rho = 1.0
gas_temp = 1.0e-16
e_out = 0.1
e_amp = 1.0
r0 = 12.0
width = 0.3

<output1>
file_type = tab
variable = m1
data_format = %24.16e
dt = 3.999999996

<output2>
file_type = bin
bin_double = true
variable = m1
dt = 3.999999996
