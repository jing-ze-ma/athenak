<job>
basename = cs

<mesh>
nghost = 2
nx1 = 64
x1min = 1.0
x1max = 10.0
ix1_bc = outflow
ox1_bc = outflow
nx2 = 8
x2min = -1.0
x2max = 1.0
ix2_bc = panel
ox2_bc = panel
nx3 = 8
x3min = -1.0
x3max = 1.0
ix3_bc = panel
ox3_bc = panel
use_cubed_sphere = true

<meshblock>
nx1 = 64
nx2 = 8
nx3 = 8

<time>
evolution = dynamic
integrator = rk2
cfl_number = 0.3
nlim = 100
tlim = 1e+30
ndiag = 1000000

<hydro>
eos = ideal
reconstruct = plm
rsolver = hllc
gamma = 1.666666666666667
rad_signal_speed = false

<rad_m1>
c_light = 1.0
chat_over_c = 1.0
closure = vet_col
e_floor = 1.0e-30
opacity = const
kappa_p = 0.0
kappa_e = 0.0
kappa_f = 0.0
kappa_s = 1e-10
arad = 1.0
coupling = true
gas_feedback = false
transport = implicit
implicit_cfl = 4.0
implicit_solver = bicgstab
implicit_precond = mg
implicit_krylov_fuse = 1
implicit_recon = dc
implicit_bc_x1min = marshak
implicit_bc_x1max = marshak
implicit_ebath_x1min = 4.0
implicit_ebath_x1max = 0.0
time_scheme = hesdirk2
ic_rad = none
scheme = clean
clean_layout = cell
clean_closure = extrap1
clean_sphere_radius = 1.0
clean_tol = 1.0e-14
clean_tol_nl = 1.0e-13
clean_maxnl = 60
vet_gd = true
clean_rays = fv1
vet_gd_gl_nmu = 8
vet_gd_gl_nphi = 16
vet_gd_twin = false
vet_gd_rotate_dt = 0
vet_col_lat = true
vet_gd_allow_clamp = true
clean_pos_limit = false
clean_consistency = true
clean_w_c0 = 0.1
clean_w_c1 = 0.5
clean_maxit = 4000
clean_ray_min = 0.001
clean_fill_passes = 8
clean_predict = true
clean_bc = halfrange
clean_alpha = tau
clean_recon = plm
clean_consistency_weight = true
clean_face_model = none
clean_psi_eps = 1e-12
clean_maxpic = 12
clean_diag_cells = false
clean_pos_boundary = false
clean_pos_ghost = false
clean_vfreeze = 0
clean_maxpos = 3
clean_pc_sweeps = 1
<problem>
pgen_name = rad_m1_beam
m1_test = sph_shell
gas_rho = 1.0
gas_temp = 1e-16
e_out = 1e-12
e_amp = 0.0
r0 = 0.0
width = 1.0

<output1>
file_type = bin
bin_double = true
variable = m1
dt = 1e+30

<output2>
file_type = bin
bin_double = true
variable = hydro_u
dt = 1e+30
