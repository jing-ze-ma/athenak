he_ic_rad_thin           = 0              # hg145-1015-e1: E1 deck value (binary default, named)
<output1>
file_type   = hst
dt          = 25.0                # as the He presn runs (~1 per step at dt ~20 s)
data_format = %24.16e
<output2>
file_type = bin
variable  = hydro_w
dt = 21600.0                      # 0.25 d
<output3>
file_type = bin
variable  = m1
dt = 21600.0
<output4>
file_type = log
dt = 1.0e4
<output5>
file_type = rst
dt = 43200.0                      # 0.5 d
<output6>
file_type = bin
variable  = m1_vet
dt = 21600.0
