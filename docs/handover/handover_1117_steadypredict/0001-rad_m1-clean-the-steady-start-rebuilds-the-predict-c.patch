From 8b69791033263e38eac61abf42edd647002ff782 Mon Sep 17 00:00:00 2001
From: Jingze Ma <jingzema0211@gmail.com>
Date: Mon, 16 Nov 2026 19:40:55 +0100
Subject: [PATCH] rad_m1 clean: the steady start rebuilds the predict closure
 every pass

clean_closure = predict (the staggered default) builds the closure once per (time, dt).
The steady start's passes keep time and dt, so they solved against the closure of the
first pass of each dt phase (2 formal solutions in 7 passes) and stopped at the steady
state of a stale closure; the run then relaxed towards the scheme's own one and
force_reference = clean lost the balance (wb cart deck, staggered: max v/c_s 4.2e-4;
cell with predict 3.8e-4).  Each pass now builds the closure of its own state, and the
first step that of the start's result: staggered 5.7e-9 (t = 4 and 20), cell with
predict 3.9e-8.  extrap* / iterate / sphere / eddington are untouched.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/rad_m1/rad_m1_clean.cpp | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/src/rad_m1/rad_m1_clean.cpp b/src/rad_m1/rad_m1_clean.cpp
index 436baf04f..c8491001e 100644
--- a/src/rad_m1/rad_m1_clean.cpp
+++ b/src/rad_m1/rad_m1_clean.cpp
@@ -539,6 +539,7 @@ void RadiationM1::CleanSteadyStart(Driver *pdrive) {
     pm->dt = big ? fac*dt0 : dt0;
     dt_sub = pm->dt;
     copy(true);
+    cln_tc = -1.0e300;   // (predict: the closure of this pass's state, not of the last dt's)
     const Real nf = cln_nfail + cln_nneg;
     // one radiation step: the ordinary m1 task lists (closure, solve, ghost exchange)
     for (int stage = 1; stage <= nstage; ++stage) {
@@ -592,6 +593,7 @@ void RadiationM1::CleanSteadyStart(Driver *pdrive) {
   t2_ok = false;
   dtr_fail = false;
   cln_have_n = cln_have_p = cln_have_c = cln_have_1 = false;
+  cln_tc = -1.0e300;
   pm->dt = dt0;
   (void) SetSubsteps(dt0);
   if (global_variable::my_rank == 0) {
-- 
2.51.0

