<job>
basename                           = so

<mesh>
nghost                             = 2
nx1                                = 128
x1min                              = 1.0
x1max                              = 3.0
ix1_bc                             = outflow
ox1_bc                             = outflow
nx2                                = 8
x2min                              = -1.0
x2max                              = 1.0
ix2_bc                             = panel
ox2_bc                             = panel
nx3                                = 8
x3min                              = -1.0
x3max                              = 1.0
ix3_bc                             = panel
ox3_bc                             = panel
use_cubed_sphere                   = true
cs_seam_flux                       = shared
cs_seam_blockend                   = extend
cs_vertex_3cell                    = true
layout_invariant                   = true
cs_seam_rho_guard                  = 4

<meshblock>
nx1                                = 128
nx2                                = 8
nx3                                = 8

<time>
evolution                          = dynamic
integrator                         = rk2
cfl_number                         = 0.95
nlim                               = -1
tlim                               = 1.0
ndiag                              = 1000000
dt_retry                           = false
dt_fixed                           = 0.0140625

<hydro>
eos                                = ideal
reconstruct                        = plm
rsolver                            = hllc
gamma                              = 1.666666666666667

<rad_m1>
c_light                            = 1.0
chat_over_c                        = 1.0
closure                            = vet_col
e_floor                            = 1.0e-30
opacity                            = const
kappa_p                            = 0.0
kappa_f                            = 0.0
kappa_s                            = 1.0
arad                               = 1.0
coupling                           = true
gas_feedback                       = false
transport                          = implicit
time_scheme                        = hesdirk2
implicit_cfl                       = 1.0e6
implicit_solver                    = bicgstab
implicit_maxit                     = 200
implicit_precond                   = mg
implicit_tol                       = 1e-10
implicit_lin_tol                   = 1.0e-10
implicit_bc_x1min                  = reflect
implicit_bc_x1max                  = marshak
vet_col_ncore                      = 64
marshak_q                          = 0.5
implicit_ebath_x1max               = 0.0
implicit_cs2_clip                  = rad
implicit_am_cs                     = true
vet_gd_twin_state                  = mean
vet_rotate_avg                     = 1
