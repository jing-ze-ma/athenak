<problem>
pgen_name                          = rad_m1_beam
m1_test                            = sph_shell
gas_rho                            = 1.0
gas_temp                           = 1.0e-16
e_out                              = 1.0e-8
e_amp                              = 1.0
r0                                 = 2.0
width                              = 0.2
shell_report                       = true
user_hist                          = true

<output1>
file_type                          = bin
variable                           = m1
dt                                 = 1.0

<output2>
file_type                          = hst
dt                                 = 1.0
data_format                        = %.17e

<output20>
file_type                          = bin
variable                           = m1_gw
dt                                 = 1.0
id                                 = gw

