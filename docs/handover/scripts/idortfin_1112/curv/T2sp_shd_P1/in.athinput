<comment>
problem = idortcurv-1112 T2sp_shd arm P1

<job>
basename = ta

<mesh>
nghost = 2
nx1 = 32
x1min = 1.0
x1max = 6.0
ix1_bc = outflow
ox1_bc = outflow
nx2 = 36
nx3 = 48
x2min = 0.9707963267948966
x2max = 2.1707963267948966
ix2_bc = periodic
ox2_bc = periodic
x3min = 0.0
x3max = 1.5707963267948966
ix3_bc = periodic
ox3_bc = periodic
use_spherical_polar = true

<meshblock>
nx1 = 32
nx2 = 36
nx3 = 48

<time>
evolution = dynamic
integrator = rk2
cfl_number = 0.3
nlim = -1
ndiag = 1
dt_retry = false
dt_fixed = 0.5
tlim = 15.0

<hydro>
eos = ideal
reconstruct = plm
rsolver = hllc
gamma = 1.666666666666667
rad_signal_speed = false
sp_x2_periodic_image = true

<rad_m1>
