# AthenaK input for gate G5 (T3 pulse, 2-D mesh), g5fix-1011.  Replaces the battery's
# pulse2d.athinput (generated from rad_m1_thick_pulse.athinput with nx2 = 4), which had
#   - an ISOTROPIC 2-D Gaussian of width 0.05 on dx2 = 0.25: the resolved peak was
#     exp(-6.25) = 1.9e-3 on a 1e-3 floor, so the variance hinged on the background
#     treatment (--subtract-min);
#   - at kappa_s = 12.8 a pulse 0.64 mean free paths wide that filled the periodic box
#     by t = 1; at kappa_s = 128 a fit through the free-streaming transient.
# Here the pulse is 1-D in x1 (problem/pulse_1d = true) on the same 2-D mesh, the floor
# is 1e-8 and is subtracted as the KNOWN background, and the box/width/tlim are set PER
# KAPPA on the command line so that (D = c/(3 rho kappa), sigma0^2 = w^2/2):
#   rho kappa w >= 5          (the pulse is diffusive: many mean free paths wide)
#   sigma^2(tlim) ~ 3 sigma0^2 (a fixed growth factor)
#   4 sigma(tlim) < half box   (the pulse never reaches the periodic edge)
# and the fit skips t < 10/(c rho kappa) (t3_pulse.py --tau-skip 10).
#
#  kappa_s  box x1     nx1  w     tlim  output1/dt  rho kappa w  sigma^2: 0 -> tlim
#  12.8     [0,4]      512  0.40  3.0   0.15        5.1          0.080 -> 0.232
#  128      [0,1]      128  0.05  0.5   0.025       6.4          1.25e-3 -> 3.81e-3
#  1280     [0,1]      128  0.05  5.0   0.25        64           1.25e-3 -> 3.85e-3
#  12800    [0,1]      128  0.05  50    2.5         640          1.25e-3 -> 3.85e-3
# dx1 = 1/128 (tau_cell = kappa/128 = 0.1 1 10 100) at every kappa.  kappa_s = 12.8
# cannot be diffusive in the [0,1] box (w >= 5/kappa = 0.39 > box/4), hence the [0,4] box.
# The defaults below are the kappa_s = 128 row.
#
# Analysis (per run):
#   python tests_m1/t3_pulse.py bin/*.bin --c 1 --rho 1 --kappa $k --background 1e-8 \
#          --tau-skip 10 --reduce mean --quiet

<comment>
problem = grey M1 static thick pulse, gate G5 (1-D pulse on a 2-D mesh)

<job>
basename = m1_thick_pulse

<mesh>
nghost    = 2
nx1       = 128
x1min     = 0.0
x1max     = 1.0
ix1_bc    = periodic
ox1_bc    = periodic

nx2       = 4
x2min     = -0.5
x2max     = 0.5
ix2_bc    = periodic
ox2_bc    = periodic

nx3       = 1
x3min     = -0.5
x3max     = 0.5
ix3_bc    = periodic
ox3_bc    = periodic

<meshblock>
nx1       = 128
nx2       = 4
nx3       = 1

<time>
cfl_number               = 1e6
tlim                     = 50.0
dt_retry                 = true
dt_retry_fac_t2          = 0.9
dt_retry_grow            = 1.1
dt_retry_ngood           = 20
evolution  = dynamic
integrator = rk2
nlim       = -1
ndiag      = 10000

<hydro>
eos         = ideal
reconstruct = plm
rsolver     = hllc
gamma       = 1.666666666666667

<rad_m1>
transport                = implicit
closure                  = vet_sc
vet_tensor               = full
implicit_flux_faces      = all
implicit_flux_beam       = halfrange
implicit_flux            = blend
implicit_blend           = idort_f
implicit_blend_tau0      = 1
implicit_blend_alpha     = 1
implicit_blend_flo       = 0.3
implicit_blend_fhi       = 0.6
implicit_blend_xthin     = 0
implicit_thin_switch     = fse
implicit_thin_corr       = hc
implicit_thin_hcsf       = j
implicit_thin_recon      = jse
implicit_thin_js_gd      = x1
implicit_thin_bq         = lin
implicit_thin_bq_gd      = cell
implicit_thin_hcface     = tau
implicit_thin_hcface_gd  = x1
vet_seg                  = jump
vet_bc_diff              = face
vet_gd_symref            = col
time2_vet_col_source     = blend
implicit_gas_src         = conservative2
implicit_cs2_hll         = drag
implicit_cs2_shift       = false
implicit_vimp_bc         = true
time2_start              = be
time2_vet_col            = predict
time2_pred_cap           = 0.5
time_scheme              = hesdirk2
time2_vet_sc             = predict
time2_vstage             = true
implicit_vimp            = false
implicit_thin_js_face    = hcface
vet_rotate_avg           = 4
implicit_predictor_frozen = false
implicit_cfl             = 1
kappa_s                  = 12800
implicit_am_cs           = true
vet_gd_twin_state        = trans
vet_gd_twin_weight       = none
vet_interp               = auto
vet_col_lat_cut_thin     = 1.0
implicit_hr_face_gd      = none
vet_gd_rotate_slope      = correct
vet_gd_rotate_stretch    = 0.02
vet_gd_rotate_t0         = 0.0
vet_gd_rotate_align      = true
implicit_hr_excess       = none
vet_gd_twin_fuse         = true
vet_gd_twin_det          = true
vet_source_noesrc        = true
vet_gd_twin              = true
vet_scatter              = true
vet_scatter_form         = ma
vet_scatter_j            = relaxed
implicit_face_opac_n     = true
implicit_pos_floor_solve = true
implicit_gas_newton_switch = 10
implicit_thin_freeze     = 1.0e-2
implicit_realisable_coupling = true
report_newton_fb         = false
vet_col_lat_taucut       = 30.0
vet_gd_gl_nmu            = 10
vet_gd_gl_nphi           = 12
vet_gd_gl_stagger        = true
vet_gd_rotate_every      = 10
vet_col_lat_offdiag      = operator
vet_gd_tangential        = false
vet_gd_wall_interp       = true
vet_gd_halo_compact      = 2
implicit_halo_direct     = true
implicit_od_cache        = true
implicit_krylov_fuse     = 1
implicit_precond         = mg
implicit_halo_mpi        = true
implicit_halo_overlap    = true
implicit_solver          = bicgstab
implicit_offdiag         = auto
implicit_closure_lag     = step
implicit_lin_maxit       = 200
implicit_lin_tol         = 1.0e-10
implicit_lin_cnorm       = 1.0e-10
implicit_tol             = 1.0e-8
implicit_resid_fatal     = 1.0e-2
implicit_maxit           = 200
implicit_one_pass        = 0
implicit_opac_update     = true
implicit_opac_newton     = true
implicit_opac_newton_guard_mode = 6
implicit_opac_newton_slope_max = 3
implicit_gas_newton      = true
implicit_enthalpy        = plm
implicit_predictor       = step
implicit_lin_ew_max      = 1.0e-2
implicit_closure_thin_relax = 1.5
implicit_g0_exchange     = true
implicit_g0_limit        = 1.0
implicit_pos_gas         = true
implicit_pos_floor       = true
vet_col_every            = 1
time2_reject             = retry
thick_flux               = none
ap_form                  = alpha2
scaled_prefactor         = 20
advect_split             = 0
split_vel                = recon
source_form              = full
f_source                 = cell
opac_freeze              = 0
rsla_warn                = 0.1
rsla_vmax                = -1
rsla_force               = 0
vet_col_ncore            = 8
vet_col_nsub             = 1
vet_col_nmu              = 4
vet_col_order2           = 1
vet_col_fk_min           = 0
vet_col_reflect_top      = 1
vet_col_surface_face     = 1
vet_col_surface_q        = 1
vet_col_surface_qmin     = 0.001
vet_col_surface_qmax     = 1
vet_source               = relaxed_esc
vet_col_team             = 1
vet_col_team_size        = 0
vet_col_chunk            = 0
vet_col_axis             = radial
reconstruct              = plm
implicit_closure_relax   = 1
implicit_closure_relax_thin = 0
implicit_trans_limit     = none
implicit_trans_fmax      = 1
implicit_accel           = none
implicit_eos_cache       = 0
implicit_eos_cache_nt    = 2
implicit_eos_cache_check = 1
implicit_line_solver     = pcr
implicit_pcr_team        = 0
implicit_pcr_check       = 0
implicit_bcg_sync        = 1
implicit_precond_float   = 0
implicit_op_team_red     = 0
implicit_mg_levels       = 3
implicit_mg_halo         = 1
implicit_krylov_pipe     = 0
implicit_halo_ipc        = 0
implicit_halo_ovl_faces  = 0
implicit_picard_log      = 0
implicit_lres_test       = 0
implicit_conv_est        = 1
implicit_src_stable      = 1
implicit_lin_ew_gamma    = 0.9
implicit_bcg_max_restarts = 2
implicit_bcg_fallback    = line
implicit_anderson_m      = 5
implicit_anderson_beta   = 1
implicit_anderson_start  = 1
implicit_opac_newton_guard = 0.5
implicit_allow_multid    = 0
implicit_hr_model        = 0
implicit_hr_face         = sf
implicit_blend_r0        = 1.5
implicit_blend_xthin_mode = all
implicit_blend_xthin_wmin = 0
implicit_thin_h0         = 0.3
implicit_thin_h1         = 0.6
implicit_thin_kn0        = 1
implicit_thin_knp        = 4
implicit_thin_fsa        = 0
implicit_thin_fsj        = 0
implicit_blend_fmode     = max
implicit_blend_mode      = flux
implicit_recon           = dc
implicit_fast_kernels    = 1
implicit_vimp_fold       = 0
implicit_predictor_order = 2
implicit_partition       = none
implicit_recon_w         = -1
implicit_res_floor       = 0
implicit_gas_newton_switch_min = 20
implicit_stall_fac       = 0.5
implicit_recon_lag       = step
implicit_recon_npass     = -1
implicit_bmom_half       = 1
implicit_rad_inertia     = 1
implicit_nofb_work       = 1
implicit_f0_init         = auto
implicit_bc_advect       = 1
time2_lin_tol_fac        = 1
time2_one_pass_safety    = 30
time2_enth_be            = true
implicit_tol_rel         = 0.1
implicit_tol_rel_max     = 1.0e-4
implicit_opac_lag        = pred
implicit_opac_lag_passes = 2
implicit_gas_newton_u4   = true
vet_gd_twin_lowmem       = true
c_light      = 1.0
chat_over_c  = 1.0
cfl_rad      = 0.4
e_floor      = 1.0e-30
subcycle     = true
opacity      = const
kappa_p      = 0.0      # pure scattering: no emission, no absorption
kappa_e      = 0.0
kappa_f      = 0.0
coupling     = true
gas_feedback = false    # static medium

# ---- MILESTONE 3a: implicit x1 transport (docs/dev/rad_m1_implicit_design.md).  Listed
# here at their DEFAULTS so that the gate scripts can override them on the command line
# (AthenaK only accepts a command-line override of a parameter the input file names).
implicit_hr_recon = dc
implicit_hr_recon_fresh = 2
implicit_hr_damp = 0.0
implicit_hr_recon_qs = 0.0
implicit_hr_recon_qs_rel = 0.0
implicit_hr_pos = kill
vet_nmu      = 8
vet_nphi     = 32
implicit_hr_recon_qs_mode = pass
implicit_hr_recon_pred = false   # central | ap_hll | berthon | blend
marshak_q             = 0.5
implicit_bc_x1min     = auto      # auto|marshak|flux|reflect|periodic|efix
implicit_bc_x1max     = auto
implicit_flux_x1min   = 0.0
implicit_flux_x1max   = 0.0
implicit_ebath_x1min   = 0.0
implicit_ebath_x1max   = 0.0

implicit_blend_aniso = 1.0
time2_k1_redist = 0
implicit_hr_cmem = false
implicit_hr_cmem_cap = 1.0
time2_vet_x2_fields = 15
implicit_physflux = false
implicit_physflux_mom = fa
time2_stage_local_be = true
time2_face_fct = true
implicit_face_mmat = true
implicit_cs2_wbsolve = true
implicit_blend_dtc = 1e-6
<problem>
pulse_width              = 0.05
pgen_name   = rad_m1_beam
m1_test     = thick_pulse
gas_rho     = 1.0
gas_eint    = 0.01
pulse_amp   = 1.0
pulse_x0    = 0.5
pulse_y0    = 0.0
pulse_z0    = 0.0
pulse_bg    = 1.0e-8
pulse_1d    = true
nyquist_amp = 0.0

<output1>
dt                       = 2.5
file_type   = bin
variable    = m1
