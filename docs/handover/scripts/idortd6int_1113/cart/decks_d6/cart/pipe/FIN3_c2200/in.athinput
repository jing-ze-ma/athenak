<comment>
problem                  = suite-1011 crooked pipe (JSD12 Sect 5.2, Gentile 2001 geometry in Cartesian): 7 opaque walls (rho 10, sigma 2000) via m1_test=cyl rects, pipe rho 0.01 sigma 0.2, isotropic T = 1 (0.5 keV) bath on x1min, static gas (kinematic + advect, no gas force), c = 300, units cm, 1e-8 s, 0.5 keV

<job>
basename = pipe

<mesh>
nghost    = 2
nx1                      = 512
x1min                    = 0.0
x1max                    = 7.0
ix1_bc                   = outflow
ox1_bc                   = outflow
nx2                      = 256
x2min                    = -2.0
x2max                    = 2.0
ix2_bc    = periodic
ox2_bc    = periodic
nx3       = 1
x3min     = -0.5
x3max     = 0.5
ix3_bc    = periodic
ox3_bc    = periodic

<meshblock>
nx1                      = 512
nx2                      = 256
nx3       = 1

<time>
dt_retry                 = true
dt_retry_fac_t2          = 0.9
dt_retry_grow            = 1.1
dt_retry_ngood           = 20
evolution  = kinematic
integrator = rk2
cfl_number = 0.4
nlim                     = -1
tlim                     = 10.0
ndiag      = 1

<hydro>
eos         = ideal
reconstruct = plm
rsolver     = advect
gamma                    = 1.017147

<rad_m1>
closure                  = vet_sc
vet_tensor               = full
implicit_flux_faces      = all
implicit_flux_beam       = halfrange
