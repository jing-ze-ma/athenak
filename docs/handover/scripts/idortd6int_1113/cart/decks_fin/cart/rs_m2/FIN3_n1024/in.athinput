# AthenaK input file for the grey M1 RADIATIVE SHOCK (design note T7; Lowrie & Edwards
# 2008, in the Skinner & Ostriker / QUOKKA cgs scaling).
#
# The parameter numbers below are the Mach 2 SUBCRITICAL set printed by
#   python3 tests_m1/t7_radshock.py --m0 2 --athinput
# (nondimensional P0 = 1e-4, sigma_a = 1e6, kappa = 1, gamma = 5/3).  For Mach 5 run the
# same script with --m0 5 and override the <problem> and <mesh> lines on the command
# line; tests_m1/runs_open/run_t7.sh does exactly that.
#
# UNITS: honest cgs for rho, v, e, E, F and x.  The ideal-gas EOS returns
# T_code = (gamma-1) e/rho = [k/(mu m_H)] T_kelvin, so <problem>/m1_shock_tunit is
# k/(mu m_H) = 8.2499208e7 with mu m_H = 1.67353e-24 g, and <rad_m1>/arad is
# a_cgs/tunit^4 = 1.6332399e-46 so that E = arad T_code^4 comes out in erg/cm^3 and the
# gas heat capacity is the cgs c_v = 1.2374881e8 erg/g/K that t7_radshock.py expects.
#
# OPACITY: the Lowrie-Edwards problem has a CONSTANT cross section per unit length,
# sigma_t = sigma_a = 577.35/L~ = 577.16 per cm, not a constant opacity per gram.  The
# powerlaw law with opac_a = -1 and rho_ref = 1 stores rho*kappa = kappa0 = 577.16
# independently of rho, which is what is wanted.  There is no scattering.
#
# INITIAL CONDITION: the semi-analytic profile itself, read from
# <problem>/m1_shock_ref (written by t7_radshock.py --write-ref; its x column is
# measured from the shock and is shifted by m1_shock_xs here).  Starting from the two
# far-field states with a smoothed jump instead (leave m1_shock_ref unset and set
# m1_shock_w) needs many flow-through times to build the precursor, which at the
# light-speed CFL is unaffordable on one core.  Both x1 faces are Dirichlet at the
# equilibrium states, i.e. the shock is held in its own frame, and the run measures
# whether the scheme KEEPS the semi-analytic solution.

<comment>
problem = grey M1 radiative shock (Lowrie & Edwards), M0 = 2

<job>
basename = m1_radshock

<mesh>
nx1                      = 1024
nghost    = 2
x1min     = 0.0
x1max     = 1.52978124e-02
ix1_bc    = user
ox1_bc    = user

nx2       = 4
x2min     = -6.0e-5
x2max     = 6.0e-5
ix2_bc    = periodic
ox2_bc    = periodic

nx3       = 1
x3min     = -0.5
x3max     = 0.5
ix3_bc    = periodic
ox3_bc    = periodic

<meshblock>
nx1                      = 1024
nx2       = 4
nx3       = 1

<time>
dt_retry                 = true
dt_retry_fac_t2          = 0.9
dt_retry_grow            = 1.1
dt_retry_ngood           = 20
evolution  = dynamic
integrator = rk2
cfl_number = 0.4
nlim       = -1
tlim       = 1.3254e-09
ndiag      = 20000

<hydro>
eos         = ideal
reconstruct = plm
rsolver     = hllc
gamma       = 1.666666666666667

<rad_m1>
closure                  = vet_sc
vet_tensor               = full
implicit_flux_faces      = all
implicit_flux_beam       = halfrange
implicit_flux            = blend
implicit_blend           = idort_f
implicit_blend_tau0      = 1
implicit_blend_alpha     = 1
implicit_blend_flo       = 0.3
implicit_blend_fhi       = 0.6
implicit_blend_xthin     = 0
implicit_thin_switch     = fse
implicit_thin_corr       = hc
implicit_thin_hcsf       = j
implicit_thin_recon      = jse
implicit_thin_js_gd      = x1
implicit_thin_bq         = lin
implicit_thin_bq_gd      = cell
implicit_thin_hcface     = tau
implicit_thin_hcface_gd  = x1
vet_seg                  = jump
vet_bc_diff              = face
vet_gd_symref            = col
time2_vet_col_source     = blend
implicit_gas_src         = conservative2
implicit_cs2_hll         = drag
implicit_cs2_shift       = false
implicit_vimp_bc         = true
time_scheme              = hesdirk2
time2_vet_sc             = predict
time2_vet_col            = predict
time2_vstage             = true
time2_pred_cap           = 0.5
time2_start              = be
implicit_thin_js_face    = hcface
vet_rotate_avg           = 4
implicit_vimp            = true
implicit_predictor_frozen = false
implicit_am_cs           = true
vet_gd_twin_state        = trans
vet_gd_twin_weight       = none
vet_interp               = auto
vet_col_lat_cut_thin     = 1.0
implicit_hr_face_gd      = none
vet_gd_rotate_slope      = correct
vet_gd_rotate_stretch    = 0.02
vet_gd_rotate_t0         = 0.0
vet_gd_rotate_align      = true
implicit_hr_excess       = none
vet_gd_twin_fuse         = true
vet_gd_twin_det          = true
vet_source_noesrc        = true
vet_gd_twin              = true
vet_scatter              = true
vet_scatter_form         = ma
vet_scatter_j            = relaxed
implicit_face_opac_n     = true
implicit_pos_floor_solve = true
implicit_gas_newton_switch = 10
implicit_thin_freeze     = 1.0e-2
implicit_realisable_coupling = true
report_newton_fb         = false
vet_col_lat_taucut       = 30.0
vet_gd_gl_nmu            = 10
vet_gd_gl_nphi           = 12
vet_gd_gl_stagger        = true
vet_gd_rotate_every      = 10
vet_col_lat_offdiag      = operator
vet_gd_tangential        = false
vet_gd_wall_interp       = true
vet_gd_halo_compact      = 2
implicit_halo_direct     = true
implicit_od_cache        = true
implicit_krylov_fuse     = 1
implicit_op_stencil      = true
implicit_precond         = mg
implicit_halo_mpi        = true
implicit_halo_overlap    = true
implicit_solver          = bicgstab
implicit_offdiag         = auto
implicit_closure_lag     = step
implicit_lin_maxit       = 200
implicit_lin_tol         = 1.0e-10
implicit_lin_cnorm       = 1.0e-10
implicit_tol             = 1.0e-8
implicit_resid_fatal     = 1.0e-2
implicit_maxit           = 200
implicit_one_pass        = 0
implicit_opac_update     = true
implicit_opac_newton     = true
implicit_opac_newton_guard_mode = 6
implicit_opac_newton_slope_max = 3
implicit_gas_newton      = true
implicit_enthalpy        = plm
implicit_predictor       = step
implicit_lin_ew_max      = 1.0e-2
implicit_closure_thin_relax = 1.5
implicit_g0_exchange     = true
implicit_g0_limit        = 1.0
implicit_pos_gas         = true
implicit_pos_floor       = true
vet_col_every            = 1
time2_reject             = retry
thick_flux               = none
ap_form                  = alpha2
scaled_prefactor         = 20
advect_split             = 0
split_vel                = recon
source_form              = full
f_source                 = cell
opac_freeze              = 0
rsla_warn                = 0.1
rsla_vmax                = -1
rsla_force               = 0
vet_col_ncore            = 8
vet_col_nsub             = 1
vet_col_nmu              = 4
vet_col_order2           = 1
vet_col_fk_min           = 0
vet_col_reflect_top      = 1
vet_col_surface_face     = 1
vet_col_surface_q        = 1
vet_col_surface_qmin     = 0.001
vet_col_surface_qmax     = 1
vet_source               = relaxed_esc
vet_col_team             = 1
vet_col_team_size        = 0
vet_col_chunk            = 0
vet_col_axis             = radial
reconstruct              = plm
implicit_closure_relax   = 1
implicit_closure_relax_thin = 0
implicit_trans_limit     = none
implicit_trans_fmax      = 1
implicit_accel           = none
implicit_eos_cache       = 0
implicit_eos_cache_nt    = 2
implicit_eos_cache_check = 1
implicit_line_solver     = pcr
implicit_pcr_team        = 0
implicit_pcr_check       = 0
implicit_bcg_sync        = 1
implicit_precond_float   = 0
implicit_op_team_red     = 0
implicit_mg_levels       = 3
implicit_mg_halo         = 1
implicit_krylov_pipe     = 0
implicit_halo_ipc        = 0
implicit_halo_ovl_faces  = 0
implicit_picard_log      = 0
implicit_lres_test       = 0
implicit_conv_est        = 1
implicit_src_stable      = 1
implicit_lin_ew_gamma    = 0.9
implicit_bcg_max_restarts = 2
implicit_bcg_fallback    = line
implicit_anderson_m      = 5
implicit_anderson_beta   = 1
implicit_anderson_start  = 1
implicit_opac_newton_guard = 0.5
implicit_allow_multid    = 0
implicit_hr_model        = 0
implicit_hr_face         = sf
implicit_blend_r0        = 1.5
implicit_blend_xthin_mode = all
implicit_blend_xthin_wmin = 0
implicit_thin_h0         = 0.3
implicit_thin_h1         = 0.6
implicit_thin_kn0        = 1
implicit_thin_knp        = 4
implicit_thin_fsa        = 0
implicit_thin_fsj        = 0
implicit_blend_fmode     = max
implicit_blend_mode      = flux
implicit_recon           = dc
implicit_fast_kernels    = 1
implicit_vimp_fold       = 0
implicit_predictor_order = 2
implicit_partition       = none
implicit_recon_w         = -1
implicit_res_floor       = 0
implicit_gas_newton_switch_min = 20
implicit_stall_fac       = 0.5
implicit_recon_lag       = step
implicit_recon_npass     = -1
implicit_bmom_half       = 1
implicit_rad_inertia     = 1
implicit_nofb_work       = 1
implicit_f0_init         = auto
implicit_bc_advect       = 1
time2_lin_tol_fac        = 1
time2_one_pass_safety    = 30
time2_enth_be            = true
implicit_cs2_vimp        = true
implicit_cs2_vimp_npass  = 3
implicit_tol_rel         = 0.1
implicit_tol_rel_max     = 1.0e-4
implicit_opac_lag        = pred
implicit_opac_lag_passes = 2
implicit_gas_newton_u4   = true
vet_gd_twin_lowmem       = true
c_light      = 2.99792458e10
chat_over_c  = 1.0
cfl_rad      = 0.4
arad         = 1.6332399e-46
e_floor      = 1.0e-30
subcycle     = false
opacity      = powerlaw
kappa_p      = 577.16
kappa_e      = 577.16
kappa_f      = 577.16
kappa_s      = 0.0
rho_ref      = 1.0
t_ref        = 1.0
opac_a       = -1.0
opac_b       = 0.0
coupling     = true
gas_feedback = true
transport             = implicit
implicit_cfl          = -1.0
implicit_bc_x1min     = marshak
implicit_ebath_x1min  = 1.70873641e+11
implicit_bc_x1max     = marshak
implicit_ebath_x1max  = 3.18344778e+12

implicit_blend_aniso = 1.0
time2_k1_redist = 0
implicit_hr_cmem = true
implicit_hr_cmem_cap = 1.0
time2_vet_x2_fields = 15
implicit_physflux = true
implicit_physflux_mom = fa
time2_stage_local_be = true
time2_face_fct = true
implicit_face_mmat = true
implicit_cs2_wbsolve = true
implicit_am_cs_fold = applied
<problem>
pgen_name       = rad_m1_beam
m1_test         = radshock
m1_shock_tunit  = 8.2499208e7
m1_shock_ref    = /orion/ptmp/jinma/idortd6int_1113/refs/caltech/ref_m2.txt
m1_shock_w      = 2.0
m1_shock_rho_l  = 5.69000000e+00
m1_shock_v_l    = 3.46264132e+07
m1_shock_t_l    = 2.18000000e+06
m1_shock_rho_r  = 1.30077662e+01
m1_shock_v_r    = 1.51466661e+07
m1_shock_t_r    = 4.52910259e+06
m1_shock_xs     = 1.00251232e-02

<output1>
file_type   = tab
variable    = m1
slice_x2    = 0.0
data_format = %26.17e
dt          = 2.2090e-10

<output2>
file_type   = tab
variable    = hydro_w
slice_x2    = 0.0
data_format = %26.17e
dt          = 2.2090e-10
