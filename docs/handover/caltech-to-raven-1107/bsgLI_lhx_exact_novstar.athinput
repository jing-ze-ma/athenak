implicit_blend_alpha     = 1              # FIN (as hr_lm)
implicit_blend_flo       = 0.3            # FIN (as hr_lm)
implicit_blend_fhi       = 0.6            # FIN (as hr_lm)
implicit_blend_xthin     = 0              # FIN (was 30 in the 10-09 hr deck)
implicit_enthalpy = plm
implicit_vimp            = true           # FIN (was false in the 10-09 hr deck)
implicit_predictor = step
implicit_lin_ew_max = 1.0e-2
implicit_closure_thin_relax = 1.5
implicit_g0_exchange = true
implicit_g0_limit = 1.0
implicit_pos_gas = true
implicit_pos_floor = true
time_scheme              = hesdirk2       # FIN (was be in the 10-09 hr deck)
vet_col_every    = 1
time2_vet_col            = predict        # FIN
marshak_q        = 0.5
implicit_bc_x1min   = flux
implicit_flux_x1min = 2.2942145641e+13   # L/(4 pi r_in^2), L = 5.581461e+38 (Ma file), r_in = 20 Rsun
implicit_bc_x1max   = marshak
implicit_flux_x1max = 0.0
<problem>
he_seed_band             = old            # no seed of ours (he_seed = 0 below); his 5 % perturbation only
he_seed                  = 0.0            # LI: the 1e-6 T seed is REPLACED by the Linhao perturbation
he_ic_linhao             = true           # LI: L. Ma bsg_star.cpp initial state (b5585cb8+)
he_ic_linhao_file        = /resnick/groups/carnegie_poc/jingze/bsgli_1014/files/linhao_profile_full.txt
he_ic_linhao_amp         = 0.05           # his rho *= 1 + 0.05 (U - 0.5)
he_ic_linhao_rho_thr     = 6.15245e-7     # his rho > 0.01 code x density_unit 6.15245e-5 (his athinput.bsg_star.rusty)
he_ic_linhao_seed_group = true   # lhxseed-1106: one deviate per merged group, as his coarse cells
he_ic_linhao_rng         = 0              # splitmix64(global cell index) seed
he_ic_linhao_gconst      = 6.67408e-8     # Athena++ Constants::grav_const_cgs (his g(rmax) = G M_rmax / rmax^2)
he_ic_linhao_gext        = invsq          # [USER 11-04] atmosphere above rmax hydrostatic in GM/r^2 (his cpp:429 r^+2 = r2)
he_bc_linhao             = true           # XB fin4-linhao-bc: L. Ma bsg_star.cpp inner BC (bd_data hydro ghosts + ghost-bath radiation)
he_bc_linhao_rad         = halfrange      # [HIS] cpp:969-1034 half-range ghost intensities, DO upwind face (M1 face flux + VET outward rays); <mu>_+ of his 120-angle LQ10 set
he_bc_linhao_diss        = none           # [USER 11-04] inner-face dissipation: none (central average; his stock Athena++ HLLE would add ~1/(taucell tau) x the E jump)
he_bc_linhao_fis = iter   # vstarfix-1106 (F_is = Picard iterate, not the shifted F0^n)
he_ic_rad_gas            = column         # ORIGINAL IC
he_ic_rad_hse            = false          # ORIGINAL IC
he_ic_rad                = file           # ORIGINAL IC (fresh default sph1d)
he_ic_eint_from_t        = false          # ORIGINAL IC (PIN defaults-1009)
user_srcs   = true
user_bcs    = true
user_hist   = true
he_gm       = 2.62502e27          # USER 11-06: his deck GM 260.795 code = 19.78 Msun (was 20 Msun)
he_gravity = pointmass   # Athena++ point-mass source (bsg-truerepro-1008)
he_ic_file = /resnick/groups/carnegie_poc/jingze/bsgli_1014/files/ic_ma2026_f0.txt   # ic_ma2026.txt with F_r = 0 above r_photo, md5 246a666e
he_opac_table = /resnick/groups/carnegie_poc/jingze/bsgli_1014/files/rosseland_ma2026_x0.7_z0.008_padded.txt   # md5 450bc0c1
he_planck_table = /resnick/groups/carnegie_poc/jingze/bsgli_1014/files/planck_ma2026_x0.7_z0.008_padded.txt      # md5 e18ca805
he_nfine    = 262144
he_tau_int  = 1.0
he_ic_cols  = 5
he_wall_zero_flux = false   # paper: no flux surgery (S_M = 0 makes the inner mass flux vanish)
he_ic_balance = false            # the Ma IC AS IS (paper: no re-balance)
mlt_flux_frozen = false          # radiative-only IC, no MLT deposit
he_wall_closed = false      # the zero-contact ghosts, not the mirror wall
mlt_closure    = frozen
he_grid_dump   = true
he_bc_outer = copy     # [HIS] cpp:916-931 with he_bc_outer_r2 below
he_bc_outer_r2 = true  # [HIS] Outflow_X1: outflow ghost rho ~ r^-2 (cpp:925), inflow rho copy + v_r 0
he_bc_inner = zerocontact   # paper: zero-mass-flux ghosts (HLLC S_M = 0)
