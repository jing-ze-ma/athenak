implicit_resid_fatal = 1.0e-2
implicit_maxit   = 200
implicit_one_pass = 0
implicit_opac_update = true
implicit_opac_newton = true
implicit_opac_newton_guard_mode = 6
implicit_gas_newton = true
implicit_flux            = blend          # FIN (as hr_lm)
implicit_flux_faces      = all            # FIN (as hr_lm)
implicit_flux_beam       = halfrange      # FIN (as hr_lm)
implicit_blend           = idort_f        # FIN (as hr_lm)
