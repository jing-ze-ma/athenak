# SCPR: PR #798 nr_radiation, homogeneous emitting sphere (R 0.6, sigma_a 5, S 1) in vacuum, [-1,1]^3
<job>
basename = prsph
<mesh>
nghost = 2
nx1 = 64
x1min = -1.0
x1max = 1.0
ix1_bc = inflow
ox1_bc = inflow
nx2 = 64
x2min = -1.0
x2max = 1.0
ix2_bc = inflow
ox2_bc = inflow
nx3 = 64
x3min = -1.0
x3max = 1.0
ix3_bc = inflow
ox3_bc = inflow
<meshblock>
nx1 = 64
nx2 = 64
nx3 = 64
<time>
evolution = dynamic
integrator = rk2
cfl_number = 0.3
nlim = 1
tlim = 1.0e5
ndiag = 1
<nr_radiation>
nmu = 6
prat = 1.0
crat = 1.0
sweep_kernel = plane
tile_size = 0
iter_min = 1
iter_max = 200
iter_tol = 1.0e-12
<problem>
pgen_name = sc_sphere
radius = 0.6
sigma_a = 5.0
source = 1.0
r_mask = 0.6
tol = 1.0e-1
<output1>
file_type = bin
variable = sc_rad_J
dt = 1.0e10
