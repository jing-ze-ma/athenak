<comment>
hegiant-1013 FIN3 PRODUCTION (HG, user 2026-10-13): this He giant (MESA r15140 M2pt754_Porb100 profile29 from S. Wu,
          IC column ic_giant_own.txt md5 ddc72692) on the FIN3 production method = the AG Car E1 FINAL <rad_m1> block
          (dic-prod-1013 dad00933) and the E1 IC/BC/floor recipe; every changed line is tagged hegiant-1013.
          Old method text below is HISTORY (10-09 deck).
problem = He GIANT envelope before core collapse (MESA r15140 M2pt754_Porb100 profile29, Wu grid: M 2.556 Msun,
          L_ph 1.62e4 Lsun, R_ph 61.78 Rsun, Teff 8.28 kK), FOLLOW THE EXPANSION. he_star_m1 on branch hegiant-1006:
          he_gm_column (enclosed-mass gravity of the IC column, static), he_base_heat (wall in the CZ: the
          scaffold's wall luminosity L_MLT(3 Rsun) 6.72e6 Lsun stays as a 0.5 Rsun base heating layer). IC : MESA T(r) + HSE with our EOS and
          our m(r) (ic/make_ic_giant_mesa.py --hse own), frozen MLT scaffold F - F_diff, RE atmosphere, floor 1e-20.
          General EOS X 0 Y 0.9265 (Z 0.0735 inert, a_metal 1.77 : fully ionized metals); TOPS tables of the
          envelope/surface mixtures blended in log T (tables/blend_tables.py). r 3-200 Rsun N445 (grid/fit_445:
          dr : max(0.015 r, 0.15 Rsun) deep, plateau ~0.039 Rsun : H_atm/3 over 60.3-64.2 Rsun, dr/r <: 0.01 to
          130 Rsun). pi/3 x pi/3 wedge, 128 x 128 SCOUT layout (16 blocks 445 x 32 x 32). See SETUP.md.
          FRESH N897 (10-09, user: start the He giant from fresh before the remap): t = 0 from the same IC
          column (rebuilt bitwise, md5 ddc72692) directly on the N897 grid (fine band 60-95 Rsun,
          grid/fit2_897.out), 4 blocks 897 x 64 x 64, with the 10-09 production radiation (half-range VET,
          BLENDALL.md idort_f36 x30; vet_gd_twin + noesrc + fuse/det; vet_scatter ma, kappa_e eos; F2/F3)
          and the N897 keys (implicit_opac_newton false: He cliff, HEGIANT_PICARD.md; sp_x2_periodic_image).
          See fresh_1009/FRESH_1009.md.
          LARGE DOMAIN (hegiant-large-1014, worker HGL, USER 10-14: fresh start from the MESA IC, larger x1max):
          x1max 700 Rsun (was 200), nx1 1697 (fine band dr = H_atm (r/61.78)^2/3 continued from 95 to 525 Rsun =
          the rmax-guard radius 0.75 x1max; grid fit_giant3.py), sponge r0 630 Rsun = 0.9 x1max, IC column ic_giant_own_x800.txt
          (= ddc72692 byte-identical to 230 Rsun + floor rows to 800 Rsun), tfloor 1.2e3 K/eos_logt_min 3.0 by the E1 rule at the new top, tlim 1e9.
          Everything else = the FIN4 deck (1b4d0592).
<job>
basename = hegiant
<mesh>
nghost    = 3
nx1       = 1697        # hegiant-large-1014: fit_giant3.py RTOP=700 (was 897)
x1min     = 2.087100e11          # 3 Rsun
x1max     = 4.869900e+13          # hegiant-large-1014: 700 Rsun (was 200; R_ph 61.78 Rsun at t = 0)
ix1_bc    = user
ox1_bc    = user
nx2       = 128
x2min     = 1.0471975511965976    # pi/3
x2max     = 2.0943951023931953    # 2 pi/3
ix2_bc    = periodic
ox2_bc    = periodic
nx3       = 128
x3min     = 0.0
x3max     = 1.0471975511965976    # pi/3
ix3_bc    = periodic
ox3_bc    = periodic
use_spherical_polar = true
use_grid_stretch_r_poly = true
f_stretch_r_c1       = -1.347359244595e+00   # hegiant-large-1014 grid/fit3_1697.out
f_stretch_r_c2       = -1.546360408013e+00   # hegiant-large-1014 grid/fit3_1697.out
f_stretch_r_c3       = 9.261077769394e+01   # hegiant-large-1014 grid/fit3_1697.out
f_stretch_r_c4       = -6.454027549981e+02   # hegiant-large-1014 grid/fit3_1697.out
f_stretch_r_c5       = 2.026848362195e+03   # hegiant-large-1014 grid/fit3_1697.out
f_stretch_r_c6       = -3.350052746748e+03   # hegiant-large-1014 grid/fit3_1697.out
f_stretch_r_c7       = 2.830587584935e+03   # hegiant-large-1014 grid/fit3_1697.out
f_stretch_r_c8       = -9.665498094054e+02   # hegiant-large-1014 grid/fit3_1697.out
f_stretch_r_b1_amp   = -2.514959582581e-01   # hegiant-large-1014 grid/fit3_1697.out
f_stretch_r_b1_x     = 1.680656038411e-01   # hegiant-large-1014 grid/fit3_1697.out
f_stretch_r_b1_w     = 6.664551046703e-02   # hegiant-large-1014 grid/fit3_1697.out
f_stretch_r_b2_amp   = 2.426099146303e+00   # hegiant-large-1014 grid/fit3_1697.out
f_stretch_r_b2_x     = 8.838595542139e-01   # hegiant-large-1014 grid/fit3_1697.out
f_stretch_r_b2_w     = 7.552410743693e-02   # hegiant-large-1014 grid/fit3_1697.out
f_stretch_r_p_amp    = -9.804185426393e-01   # hegiant-large-1014 grid/fit3_1697.out
f_stretch_r_p_xa     = 1.192283943784e-01   # hegiant-large-1014 grid/fit3_1697.out
f_stretch_r_p_xb     = 9.860793532956e-01   # hegiant-large-1014 grid/fit3_1697.out
f_stretch_r_p_w      = 6.686835504722e-03   # hegiant-large-1014 grid/fit3_1697.out
f_stretch_r_p2_amp   = -9.989996806179e-01   # hegiant-large-1014 grid/fit3_1697.out (2nd plateau)
f_stretch_r_p2_w     = 1.000000000000e-03   # hegiant-large-1014 grid/fit3_1697.out (2nd plateau)
f_stretch_r_p2_xa    = 9.450319910532e-01   # hegiant-large-1014 grid/fit3_1697.out (2nd plateau)
f_stretch_r_p2_xb    = 9.861773068347e-01   # hegiant-large-1014 grid/fit3_1697.out (2nd plateau)
<meshblock>
nx1       = 1697        # hegiant-large-1014: 1 block in r (4 blocks 1697 x 64 x 64, 1 per H200)
nx2       = 64      # 4 blocks of 445 x 64 x 64: 32 x 32 blocks fail vet_gd (clamped lateral reads, smoke 12108597)
nx3       = 64
<time>
evolution  = dynamic
integrator = rk2
cfl_number = 0.3           # radiation-dominated (user rule)
nlim       = -1
tlim       = 1.0e9         # hegiant-large-1014: long-tlim rule (USER 10-14): walltime-limited
ndiag      = 50
<units>
length_cgs = 1.0
mass_cgs   = 1.0
time_cgs   = 1.0
mu         = 1.0     # general EOS: T_unit : m_u/k_B
<hydro>
eos                  = general
general_eos          = table
gamma                = 1.6666666667
eos_h2               = false
eos_ionization       = true
eos_metal_ionization = false
eos_radiation        = false      # MANDATORY with <rad_m1>: the module evolves E
eos_xh               = 0.0
eos_yhe              = 0.9265     # Z : 0.0735 : the TOPS envelope mixture
eos_a_metal          = 1.77       # metals FULLY IONIZED: Z/a : sum X_i (1+Z_i)/A_i (exact in the deep envelope)
eos_logd_min         = -21.0      # covers dfloor 1e-20 (: he_opac_logd_min)
eos_logd_max         = -1.0
eos_logt_min             = 3.0            # hegiant-large-1014: covers tfloor 1.2e3 K (nodes aligned with 3.4: 20 x 0.02); was 3.4
eos_logt_max         = 6.8
eos_dlog             = 0.02
rad_signal_speed = true
reconstruct = plm
rsolver     = hllc                # near-sonic convection (He presn rule)
fofc        = true
etotgrav    = true
wellbalance_dynamic = true
wb_x1               = true
wb_option           = polytropic
wb_cache_every      = 0
dfloor  = 1.0e-20
tfloor_kelvin            = 1.2e3          # hegiant-large-1014: E1 rule at the new top: below T_rad at x1max (code gas T at 690 Rsun after ic_rad 1.53e3 K, smoke 12205903; (L_ph/16 pi sigma r^2)^1/4 = 1.74e3 K); was 3.0e3
pfloor  = 1.0e-12
dfloor_keep_velocity = true
vceil   = 1.0e8
sp_x2_periodic_image = true       # N897 seam-leak fix (36f18f1d)
fofc_report              = 512            # hegiant-1013: diagnostic only (as E1; bg check counts)
fofc_report_dt           = 3.6e3          # hegiant-1013: diagnostic only (as E1)
<rad_m1>
vet_gd_twin_state        = trans          # FIN3 (prodswitch-1013, fin3-1012)
vet_rotate_avg           = 4              # FIN3 (prodswitch-1013, fin3-1012)
vet_gd_twin_weight       = none           # FIN3 (prodswitch-1013, fin3-1012)
vet_interp               = auto           # FIN3 (prodswitch-1013, fin3-1012)
vet_col_lat_cut_thin     = 1.0            # FIN3 (prodswitch-1013, fin3-1012)
implicit_predictor_frozen = false          # FIN3: UN #10 dropped (frozen predictor costs Cartesian T-ladder order; inert on sp). coordinator 2026-10-13, reported to user
vet_bc_inner             = auto           # FIN3 (prodswitch-1013, fin3-1012)
vet_bc_reflect           = auto           # FIN3 (prodswitch-1013, fin3-1012)
implicit_hr_face_gd      = none           # FIN3 (prodswitch-1013, fin3-1012)
implicit_thin_js_face    = hcface         # jsfix 8bfeae8c, d3bf42d7 final method (user 2026-10-12)
vet_gd_rotate_slope      = correct        # d3bf42d7 final method (user 2026-10-12)
vet_gd_rotate_stretch    = 0.02           # one method: = BSG and fresh default (user 2026-10-12)
vet_gd_rotate_t0         = 0.0            # final_1012
vet_gd_rotate_align      = true           # final_1012
vet_gd_rotate_dt         = 4.0e2          # hegiant-1013: ~20 dt at dt ~20 s (BSG 1.75e3 = 20 x 87.5 s, E1 1.6e4 = 22 x 727 s)
vet_gd_halo_ipc          = false          # hegiant-1013: layout key: CUDA IPC halo is single-node CUDA only (Raven runs 2 nodes; HIP no)
time2_start              = be             # final_1012
time2_vet_sc             = predict        # final_1012
implicit_vimp_bc         = true           # final_1012
implicit_cs2_shift       = false          # final_1012
implicit_cs2_hll         = drag           # final_1012
time2_vet_col_source     = blend          # final_1012
vet_gd_symref            = col            # final_1012
implicit_thin_hcface_gd  = x1             # final_1012
implicit_thin_hcface     = tau            # final_1012
implicit_thin_bq_gd      = cell           # final_1012
implicit_thin_js_gd      = x1             # final_1012
implicit_thin_hcsf       = j              # final_1012
implicit_hr_excess       = none           # prodfinal-1011
time2_pred_cap           = 0.5            # final_1012
implicit_gas_src         = conservative2  # final_1012
vet_seg                  = jump           # final_1012
ic_rad                   = fs_relax       # prodfinal-1011
vet_bc_diff              = face           # final_1012
implicit_thin_corr       = hc             # final_1012
implicit_thin_switch     = fse            # final_1012
time2_vstage             = true           # final_1012
vet_gd_twin_fuse         = true   # accel-1009: twin in the main sweep (restart-exact cut, -15 %/cycle)
vet_gd_twin_det          = true   # accel-1009: fixed-order twin shell means (GPU run-to-run bitwise)
# rc-1009 keys (fixbundle-1009 beded6c6 + rad-beam-1008 twin): on
vet_source_noesrc        = true   # F1: never without vet_gd_twin
vet_gd_twin              = true   # with F1 (beam worker A3d twin, 10-09)
vet_scatter              = true   # Ma+2026 split, kappa_es from the EOS (user 10-09)
vet_scatter_form         = ma
