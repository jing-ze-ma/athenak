<job>
basename                     = sp

<mesh>
nghost                       = 2
nx1                          = 128
x1min                        = 1.0
x1max                        = 3.0
ix1_bc                       = reflect
ox1_bc                       = reflect
nx2                          = 4
x2min                        = -0.5
x2max                        = 0.5
ix2_bc                       = periodic
ox2_bc                       = periodic
nx3                          = 1
x3min                        = -0.5
x3max                        = 0.5
ix3_bc                       = periodic
ox3_bc                       = periodic

<meshblock>
nx1                          = 128
nx2                          = 4
nx3                          = 1

<time>
evolution                    = dynamic
integrator                   = rk2
cfl_number                   = 0.3
nlim                         = 1000000
tlim                         = 0.25
ndiag                        = 1000000

<hydro>
eos                          = ideal
reconstruct                  = plm
rsolver                      = hllc
gamma                        = 1.666666666666667

<rad_m1>
c_light                      = 30.0
chat_over_c                  = 1.0
e_floor                      = 1.0e-30
opacity                      = powerlaw
kappa_p                      = 30.0
kappa_e                      = 30.0
kappa_f                      = 30.0
kappa_s                      = 0.0
arad                         = 3.0e10
coupling                     = true
gas_feedback                 = true
transport                    = implicit
implicit_cfl                 = 0.9375
implicit_solver              = bicgstab
implicit_precond             = line
implicit_maxit               = 200
implicit_tol                 = 1.0e-10
implicit_lin_tol             = 1.0e-12
implicit_closure_lag         = step
marshak_q                    = 0.5
ic_rad                       = none
implicit_bc_x1min            = reflect
implicit_bc_x1max            = marshak
implicit_ebath_x1max         = 0.0019
rho_ref                      = 10.0
t_ref                        = 1.0e-3
opac_a                       = 1.0
opac_b                       = -3.5
closure                      = vet_sc
vet_tensor                   = full
vet_nmu                      = 8
vet_nphi                     = 32
implicit_flux                = blend
implicit_flux_faces          = all
implicit_flux_beam           = halfrange
implicit_blend               = idort_f
implicit_blend_tau0          = 1
implicit_blend_alpha         = 1
implicit_blend_flo           = 0.3
implicit_blend_fhi           = 0.6
implicit_blend_xthin         = 0
implicit_blend_xthin_mode    = all
implicit_blend_xthin_wmin    = 0.0
implicit_blend_xthin_r0      = 1.5
implicit_hr_recon            = dc
implicit_hr_recon_fresh      = 2
implicit_hr_damp             = 0.0
implicit_hr_pos              = kill
implicit_thin_switch         = fse
implicit_thin_corr           = hc
implicit_thin_recon          = jse
implicit_thin_bq             = lin
time_scheme                  = hesdirk2
implicit_vimp                = true
time2_vstage                 = true
time2_vet_sc                 = predict
vet_bc_diff                  = face
implicit_thin_hcsf           = j
implicit_thin_js_gd          = x1
implicit_thin_bq_gd          = cell
implicit_thin_hcface         = tau
implicit_thin_hcface_gd      = x1
vet_seg                      = jump
time2_vet_col_source         = blend
implicit_gas_src             = conservative2
implicit_cs2_hll             = drag
implicit_cs2_shift           = false
implicit_vimp_bc             = true
time2_vet_col                = predict
time2_pred_cap               = 0.5
time2_start                  = slope
implicit_opac_update         = true
implicit_opac_newton         = true
implicit_opac_newton_guard_mode = 6
implicit_opac_newton_slope_max = 3
implicit_gas_newton          = true
implicit_predictor           = step
implicit_predictor_order     = 2
implicit_cs2_vimp            = true
implicit_cs2_vimp_npass      = 3
implicit_conv_est            = true
implicit_tsolve_opac         = true
implicit_tsolve_opac_mode    = 1
implicit_gas_newton_switch   = 10

<problem>
pgen_name                    = rad_m1_beam
m1_test                      = sph_shell
gas_rho                      = 10.0
gas_temp                     = 1.0e-16
e_out                        = 0.0019
e_amp                        = 0.03
r0                           = 2.0
width                        = 0.15
gas_teq                      = true

<output1>
file_type                    = bin
variable                     = m1
dt                           = 0.125

<output2>
file_type                    = bin
variable                     = hydro_w
dt                           = 0.125

<output3>
file_type                    = bin
variable                     = hydro_u
dt                           = 0.125

