<problem>
he_ic_eint_from_t = true   # 10-09: eint from T_col with the code EOS (IC check: round trip 5e-14)
he_seed     = 1.0e-2            # SEED RULE: isotropic T seed 1e-2, 16 modes
he_seed_nk   = 16
he_seed_kmin = 1                # k by H_p,tot at 30 Rsun 1.0-1.5; by CZ depth < 1 (wedge-limited): SETUP.md
he_seed_kmax = 2
he_seed_signs = random
he_seed_rad  = true
he_seed_rlo  = 2.2262e11        # 3.2 Rsun
he_seed_rhi  = 3.8264e12        # 55 Rsun
user_srcs   = true
user_bcs    = true
user_hist   = true
he_gm       = 2.1708476572e+26  # G m(r_in), m(3 Rsun) : 1.63516 Msun (IC column col 8)
he_gm_column = true             # hegiant-1006: enclosed-mass gravity of the IC column (static)
he_base_heat   = 3.4785e10      # hegiant-1006: 0.5 Rsun (~H_p/2 at r_in) base heating layer keeps L_MLT(r_in) 6.72e6 Lsun when the scaffold ramps off
he_ic_file  = @FILES@/ic_giant_own.txt       # md5 ddc72692
he_opac_table   = @FILES@/rosseland_tops_hegiant_blend.txt   # md5 c1ef063c
he_planck_table = @FILES@/planck_tops_hegiant_blend.txt      # md5 b699c60d
he_opac_logd_min = -21.0
he_nfine    = 1048576
he_tau_int  = 1.0
he_ic_cols  = 5
he_wall_zero_flux = true
he_wall_closed = true
he_ic_balance = true
he_ic_balance_rmax = 4.24377e12  # 61.0 Rsun: march anchored below the photosphere (column already in HSE)
mlt_flux_frozen = true
mlt_ramp_start = 4.32e5          # 5 d: scaffold cosine ramp ...
mlt_ramp_time  = 4.32e5          # ... to zero at 10 d (user GO 10-07)
he_bc_outer    = outflow         # outflow top, no inflow: the envelope may expand
he_sponge_rate = 1.0e-3          # acts only on the floor gas (rho < dmax) and above r0 : 199 Rsun
he_sponge_r0             = 1.25226e13     # hegiant-1013: E1 rule r0 = 0.9 x1max (180 Rsun); was 199 Rsun (0.995 x1max)
he_sponge_mode = radial
he_sponge_dmax = 1.0e-17
he_grid_dump = true
he_ic_rad                = file           # hegiant-1013: NOT E1's sph1d: smoke 12179235 FATAL (sph1d HSE loop: Gamma>0.9 clamped, scaffold carries 78-99 % of F to R_ph); the column's own RE atmosphere
he_ic_rad_atm_post       = false          # hegiant-1013: superseded by he_ic_equil (exclusive in code)
he_ic_equil              = false          # hegiant-1013: DI IC OFF: bg check F (equil on) re-marched atmosphere falls back, 1.03-1.10 R_ph drho 0.41 vs 0.037 off (E0); ic_rad fs_relax kept
he_ic_equil_dtfac        = 1.0            # hegiant-1013: as E1
he_ic_equil_relax_n      = 40             # hegiant-1013: as E1
he_ic_equil_relax_tol    = 1.0e-4         # hegiant-1013: as E1
he_ic_equil_maxit        = 1              # hegiant-1013: as E1
he_ic_equil_tol          = 1.0e-9         # hegiant-1013: as E1
he_ic_equil_last_march   = true           # hegiant-1013: as E1 (v6 f1La)
mlt_closure              = frozen         # hegiant-1013: named as E1 (= mlt_flux_frozen)
he_gravity               = wb             # hegiant-1013: named (default; he_ic_equil needs it)
he_bc_inner              = wall           # hegiant-1013: named (default, as E1)
nan_report               = 0              # hegiant-1013: named at the binary default (E1 PAR_DUMP list)
hot_jupiter              = 0              # hegiant-1013: named at the binary default (E1 PAR_DUMP list)
he_wind_ic               = 0              # hegiant-1013: named at the binary default (E1 PAR_DUMP list)
mlt_closure_taper        = 0.01           # hegiant-1013: named at the binary default (E1 PAR_DUMP list)
he_esrc_const            = 0              # hegiant-1013: named at the binary default (E1 PAR_DUMP list)
he_seed_k                = 4              # hegiant-1013: named at the binary default (E1 PAR_DUMP list)
he_seed_rng              = 1234           # hegiant-1013: named at the binary default (E1 PAR_DUMP list)
he_seed_kdist            = box            # hegiant-1013: named at the binary default (E1 PAR_DUMP list)
