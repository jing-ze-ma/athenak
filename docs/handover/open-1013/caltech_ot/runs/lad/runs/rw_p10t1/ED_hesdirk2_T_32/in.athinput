subcycle = true
opacity = const
kappa_p = 1
kappa_e = 1
kappa_f = 1
kappa_s = 0.0
arad = 10
coupling = true
gas_feedback = true
transport                = implicit
implicit_tol             = 1.0e-12
implicit_maxit           = 200
implicit_lin_tol         = 1.0e-13
implicit_lin_maxit       = 400
implicit_solver          = bicgstab
implicit_offdiag = operator
implicit_closure_lag = step
implicit_recon = dc
implicit_vimp            = true
time_scheme              = hesdirk2
implicit_flux_faces      = all
implicit_flux_beam       = halfrange
implicit_flux            = blend
implicit_blend           = idort_f
implicit_blend_tau0      = 1.0
