<comment>
problem = runs_3r_radwave vetf_impl_x1_P3.33333_t1_N128_nt64_armtJe_rm_time2_vet_scpredict_rm_time2_vstagetrue_tshesdirk2_vimptrue

<job>
basename = rw

<mesh>
nghost = 2
nx1                      = 128
x1min = 0.0
x1max = 1.0
