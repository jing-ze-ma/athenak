<comment>
problem                  = littests-1011 non-LTE atmosphere eps=1e-4 (Ma+2025 4.1.3 / J21 4.5)

<job>
basename                 = nlte4

<mesh>
nghost    = 2
nx1                      = 1280
x1min                    = -10.0
x1max                    = 10.0
ix1_bc                   = outflow
ox1_bc                   = outflow
nx2                      = 4
x2min                    = -0.5
x2max                    = 0.5
ix2_bc    = periodic
ox2_bc    = periodic
nx3       = 1
x3min     = -0.5
x3max     = 0.5
ix3_bc    = periodic
ox3_bc    = periodic

<meshblock>
nx1                      = 1280
nx2                      = 4
nx3       = 1

<time>
evolution                = kinematic
integrator = rk2
cfl_number = 0.4
nlim                     = 60
tlim                     = 1.0e30
ndiag      = 1

<hydro>
eos         = ideal
reconstruct = plm
rsolver                  = advect
gamma                    = 1.000001

<rad_m1>
vet_path                 = cells
implicit_thin_hcsf       = j
implicit_thin_js_gd      = x1
implicit_thin_bq_gd      = cell
implicit_thin_hcface     = tau
implicit_thin_hcface_gd  = x1
vet_seg                  = jump
vet_bc_diff              = face
vet_gd_symref            = col
time2_vet_col_source     = blend
implicit_gas_src         = conservative2
implicit_cs2_hll         = drag
implicit_cs2_shift       = false
implicit_vimp_bc         = true
time2_vet_sc             = predict
time2_vet_col            = predict
time2_vstage             = true
time2_pred_cap           = 0.5
time2_start              = be
implicit_thin_js_face    = hcface
vet_rotate_avg           = 4
implicit_vimp            = false
implicit_predictor_frozen = false
implicit_blend_xthin_mode = all
implicit_hr_recon = dc
implicit_hr_recon_fresh = 2
implicit_hr_damp = 0.0
implicit_hr_recon_qs = 0.0
implicit_hr_recon_qs_rel = 0.0
implicit_hr_pos = kill
implicit_accel = none
implicit_blend_xthin_wmin = 0.0
c_light                  = 1.0
chat_over_c  = 1.0
arad         = 1.0
e_floor      = 1.0e-30
closure      = m1
opacity      = const
kappa_p                  = 0.0001
kappa_e                  = 0.0001
kappa_f                  = 0.0001
kappa_s                  = 0.9999
coupling                 = true
gas_feedback             = false
transport             = implicit
implicit_solver       = bicgstab
implicit_offdiag      = auto
implicit_closure_lag  = step
implicit_lin_maxit    = 200
implicit_lin_tol      = 1.0e-10
implicit_tol          = 1.0e-8
implicit_res_floor    = 0.0
implicit_maxit        = 200
implicit_flux         = central
implicit_flux_faces   = x1
implicit_flux_beam    = closure
implicit_blend        = tau_f
implicit_blend_flo    = 0.6
implicit_blend_tau0   = 1.0
implicit_blend_alpha  = 1.0
implicit_blend_r0     = 1.5
implicit_blend_xthin = 0.0
implicit_blend_fhi    = 0.9
time_scheme           = be
implicit_bc_x1min     = marshak
implicit_bc_x1max     = marshak
marshak_q             = 0.5
implicit_ebath_x1min     = 1.0
implicit_ebath_x1max     = 0.0
vet_nmu      = 8
vet_nphi     = 32
vet_sc_order = 1
vet_tensor   = full
vet_source_noesrc = false

implicit_cfl             = 1.0e6
implicit_thin_switch     = none
implicit_thin_corr       = none
implicit_thin_recon      = dc
implicit_thin_bq         = cell
<problem>
pgen_name  = rad_m1_beam
m1_test                  = atmosphere
user_srcs                = true

user_bcs                 = false
atm_rho_top              = 1.0e-3
atm_scale_h              = 1.0
atm_flux                 = 1.0e-8
atm_temp                 = 1.0
<output1>
file_type                = tab
variable    = m1
dt                       = 1.0e30

data_format              = %26.17e


slice_x2                 = 0.0

