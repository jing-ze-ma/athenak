<comment>
problem                  = jsfix-1012 slab: hot opaque x<0, thin gap 0..0.5 (exact E = 0.5), cold opaque absorber 0.5..1;  orig: littests-1011 static shadow (Ma+2025 Sect 4.1.4 / Jiang 2021 Sect 4.3): +-15 deg beams over the whole x1min face, D^2 tanh ellipse rho 1..10, P = 1, sigma = rho^2 T^-3.5, periodic x2

<job>
basename                 = slab

<mesh>
nghost    = 2
nx1                      = 64
x1min                    = -1.0
x1max                    = 1.0
ix1_bc                   = outflow
ox1_bc                   = outflow
nx2                      = 8
x2min                    = -0.125
x2max                    = 0.125
ix2_bc    = periodic
ox2_bc    = periodic
nx3       = 1
x3min     = -0.5
x3max     = 0.5
ix3_bc    = periodic
ox3_bc    = periodic

<meshblock>
nx1                      = 64
nx2                      = 8
nx3       = 1

<time>
evolution  = dynamic
integrator = rk2
cfl_number = 0.4
nlim                     = 64
tlim                     = 1.0e10
ndiag      = 1

<hydro>
eos         = ideal
reconstruct = plm
rsolver     = hllc
gamma                    = 1.000001

<rad_m1>
vet_path                 = cells
implicit_thin_hcsf       = j
implicit_thin_js_gd      = x1
implicit_thin_bq_gd      = cell
implicit_thin_hcface     = tau
implicit_thin_hcface_gd  = x1
vet_seg                  = jump
vet_bc_diff              = face
vet_gd_symref            = col
time2_vet_col_source     = blend
implicit_gas_src         = conservative2
implicit_cs2_hll         = drag
implicit_cs2_shift       = false
implicit_vimp_bc         = true
time2_vet_sc             = predict
time2_vet_col            = predict
time2_vstage             = true
time2_pred_cap           = 0.5
time2_start              = be
implicit_thin_js_face    = hcface
vet_rotate_avg           = 4
implicit_vimp            = false
implicit_predictor_frozen = false
implicit_blend_xthin_mode = all
implicit_hr_recon = dc
implicit_hr_recon_fresh = 2
implicit_hr_damp = 0.0
implicit_hr_recon_qs = 0.0
implicit_hr_recon_qs_rel = 0.0
implicit_hr_pos = kill
implicit_accel = none
implicit_blend_xthin_wmin = 0.0
c_light                  = 100.0
chat_over_c  = 1.0
arad         = 1.0
e_floor      = 1.0e-30
closure      = m1
opacity                  = const
kappa_p                  = 1.0
kappa_e                  = 1.0
kappa_f                  = 1.0
kappa_s                  = 0.0
coupling                 = true
gas_feedback             = false
transport             = implicit
implicit_solver       = bicgstab
implicit_offdiag      = auto
implicit_closure_lag  = step
implicit_lin_maxit    = 200
implicit_lin_tol      = 1.0e-10
implicit_tol          = 1.0e-8
implicit_res_floor    = 0.0
implicit_maxit        = 200
implicit_flux         = central
implicit_flux_faces   = x1
implicit_flux_beam    = closure
implicit_blend        = tau_f
implicit_blend_flo    = 0.6
implicit_blend_tau0   = 1.0
implicit_blend_alpha  = 1.0
implicit_blend_r0     = 1.5
implicit_blend_xthin = 0.0
implicit_blend_fhi    = 0.9
time_scheme           = be
implicit_bc_x1min     = marshak
implicit_bc_x1max     = marshak
marshak_q             = 0.5
implicit_ebath_x1min  = 0.0
implicit_ebath_x1max  = 0.0
vet_nmu      = 8
vet_nphi     = 32
vet_sc_order = 1
vet_tensor   = full
vet_source_noesrc = false
implicit_cfl             = 100.0

implicit_thin_switch     = none
implicit_thin_corr       = none
implicit_thin_recon      = dc
implicit_thin_bq         = cell
<problem>
pgen_name  = rad_m1_beam
m1_test    = cyl
user_srcs  = true
cyl_n      = 2
cyl_rho_bg = 1.0e-10
cyl_t_bg   = 1.0e-3
cyl0_x     = -0.5
cyl0_y     = 0.0
cyl0_r     = 0.0
cyl0_rho   = 10.0
cyl0_t     = 1.0
cyl0_shape = rect
cyl0_hl    = 0.5
cyl0_hw    = 10.0
cyl0_ang   = 0.0
cyl1_x     = 0.75
cyl1_y     = 0.0
cyl1_r     = 0.0
cyl1_rho   = 3200.0
cyl1_t     = 1.0e-3
cyl1_shape = rect
cyl1_hl    = 0.25
cyl1_hw    = 10.0
cyl1_ang   = 0.0
<output1>
file_type   = bin
variable    = m1
dt          = 0.5
<output3>
file_type   = bin
variable    = m1_vsc
dt          = 0.5
<output4>
file_type   = bin
variable    = m1_vet
dt          = 0.5
