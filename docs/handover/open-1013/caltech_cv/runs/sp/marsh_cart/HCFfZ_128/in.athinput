<job>
basename                     = sp

<mesh>
nghost                       = 2
nx1                          = 128
x1min                        = 1.0
x1max                        = 2.0
ix1_bc                       = reflect
ox1_bc                       = reflect
nx2                          = 4
x2min                        = -0.5
x2max                        = 0.5
ix2_bc                       = periodic
ox2_bc                       = periodic
nx3                          = 1
x3min                        = -0.5
x3max                        = 0.5
ix3_bc                       = periodic
ox3_bc                       = periodic

<meshblock>
nx1                          = 128
nx2                          = 4
nx3                          = 1

<time>
evolution                    = dynamic
integrator                   = rk2
cfl_number                   = 0.3
nlim                         = 1000000
tlim                         = 0.050000000000000003
ndiag                        = 1000000

<hydro>
eos                          = ideal
reconstruct                  = plm
rsolver                      = hllc
gamma                        = 1.666666666666667

<rad_m1>
c_light                      = 100.0
chat_over_c                  = 1.0
e_floor                      = 1.0e-30
opacity                      = const
kappa_p                      = 10.0
kappa_e                      = 10.0
kappa_f                      = 10.0
kappa_s                      = 0.0
arad                         = 1.0
coupling                     = true
gas_feedback                 = true
transport                    = implicit
implicit_cfl                 = 2.5
implicit_solver              = bicgstab
implicit_precond             = line
implicit_maxit               = 200
implicit_tol                 = 1.0e-12
implicit_lin_tol             = 1.0e-13
implicit_closure_lag         = step
marshak_q                    = 0.5
ic_rad                       = none
implicit_bc_x1min            = marshak
implicit_ebath_x1min         = 1.0
implicit_bc_x1max            = marshak
implicit_ebath_x1max         = 1.0e-12
implicit_gas_newton          = true
closure                      = vet_sc
vet_tensor                   = full
vet_nmu                      = 8
vet_nphi                     = 32
implicit_flux                = blend
implicit_flux_faces          = all
implicit_flux_beam           = halfrange
implicit_blend               = idort_f
implicit_blend_tau0          = 1
implicit_blend_alpha         = 1
implicit_blend_flo           = 0.3
implicit_blend_fhi           = 0.6
implicit_blend_xthin         = 0
implicit_blend_xthin_mode    = all
implicit_blend_xthin_wmin    = 0.0
implicit_blend_xthin_r0      = 1.5
implicit_hr_recon            = dc
implicit_hr_recon_fresh      = 2
implicit_hr_damp             = 0.0
implicit_hr_pos              = kill
implicit_thin_switch         = fse
implicit_thin_corr           = hc
implicit_thin_recon          = jse
implicit_thin_bq             = lin
time_scheme                  = hesdirk2
implicit_vimp                = true
time2_vstage                 = true
time2_vet_sc                 = predict
vet_bc_diff                  = face
implicit_thin_hcsf           = j
implicit_thin_js_gd          = x1
implicit_thin_bq_gd          = cell
implicit_thin_hcface         = tau
implicit_thin_hcface_gd      = x1
vet_seg                      = jump
time2_vet_col_source         = blend
implicit_gas_src             = conservative2
implicit_cs2_hll             = drag
implicit_cs2_shift           = false
implicit_vimp_bc             = true
time2_vet_col                = predict
time2_pred_cap               = 0.5
time2_start                  = be
vet_gd_rotate_stretch        = 0.02
vet_gd_rotate_slope          = correct
implicit_thin_js_face        = hcface
vet_rotate_avg               = 4
vet_gd_rotate_dt             = auto

<problem>
pgen_name                    = rad_m1_beam
m1_test                      = sph_shell
gas_rho                      = 1.0
gas_temp                     = 1.0e-3
e_out                        = 1.0e-12
e_amp                        = 0.0
r0                           = 2.0
width                        = 0.2

<output1>
file_type                    = tab
variable                     = m1
data_format                  = %24.16e
slice_x2                     = 0.1
dt                           = 0.012500000000000001

<output2>
file_type                    = tab
variable                     = hydro_w
data_format                  = %24.16e
slice_x2                     = 0.1
dt                           = 0.012500000000000001

<output3>
file_type                    = tab
variable                     = hydro_u
data_format                  = %24.16e
slice_x2                     = 0.1
dt                           = 0.012500000000000001

