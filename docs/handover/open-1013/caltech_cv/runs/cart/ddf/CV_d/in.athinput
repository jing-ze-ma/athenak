<comment>
problem                  = littests-1011 dynamic diffusion (J21 4.4 / Ma+2025 4.2.1)

<job>
basename                 = ddf

<mesh>
nghost    = 2
nx1                      = 1280
x1min                    = -10.0
x1max                    = 10.0
ix1_bc                   = periodic
ox1_bc                   = periodic
nx2                      = 4
x2min                    = -0.5
x2max                    = 0.5
ix2_bc    = periodic
ox2_bc    = periodic
nx3       = 1
x3min     = -0.5
x3max     = 0.5
ix3_bc    = periodic
ox3_bc    = periodic

<meshblock>
nx1                      = 1280
nx2                      = 4
nx3       = 1

<time>
evolution  = dynamic
integrator = rk2
cfl_number               = 0.4
nlim                     = -1
tlim                     = 16.0
ndiag      = 1

<hydro>
eos         = ideal
reconstruct              = plm
rsolver     = hllc
gamma       = 1.666666666666667

<rad_m1>
implicit_cs2_vimp        = false
implicit_thin_hcsf       = j
implicit_thin_js_gd      = x1
implicit_thin_bq_gd      = cell
implicit_thin_hcface     = tau
implicit_thin_hcface_gd  = x1
vet_seg                  = jump
vet_bc_diff              = face
vet_gd_symref            = col
time2_vet_col_source     = blend
implicit_gas_src         = conservative2
implicit_cs2_hll         = drag
implicit_cs2_shift       = false
implicit_vimp_bc         = true
time2_vet_sc             = predict
time2_vet_col            = predict
time2_vstage             = true
time2_pred_cap           = 0.5
time2_start              = be
implicit_thin_js_face    = hcface
vet_rotate_avg           = 4
implicit_vimp            = true
implicit_predictor_frozen = false
implicit_blend_xthin_mode = all
implicit_hr_recon = dc
implicit_hr_recon_fresh = 2
implicit_hr_damp = 0.0
implicit_hr_recon_qs = 0.0
implicit_hr_recon_qs_rel = 0.0
implicit_hr_pos = kill
implicit_accel = none
implicit_blend_xthin_wmin = 0.0
c_light                  = 1000.0
chat_over_c  = 1.0
arad         = 1.0
e_floor      = 1.0e-30
closure      = m1
opacity      = const
kappa_p                  = 0.0
kappa_e                  = 0.0
kappa_f                  = 0.0
kappa_s                  = 4.0e4
coupling                 = true
gas_feedback             = true
transport             = implicit
implicit_solver       = bicgstab
implicit_offdiag      = auto
implicit_closure_lag  = step
implicit_lin_maxit    = 200
implicit_lin_tol      = 1.0e-10
implicit_tol          = 1.0e-8
implicit_res_floor    = 0.0
implicit_maxit        = 200
implicit_flux         = central
implicit_flux_faces   = x1
implicit_flux_beam    = closure
implicit_blend        = tau_f
implicit_blend_flo    = 0.6
implicit_blend_tau0   = 1.0
implicit_blend_alpha  = 1.0
implicit_blend_r0     = 1.5
implicit_blend_xthin = 0.0
implicit_blend_fhi    = 0.9
time_scheme           = be
implicit_bc_x1min        = periodic
implicit_bc_x1max        = periodic
marshak_q             = 0.5
implicit_ebath_x1min  = 0.0
implicit_ebath_x1max  = 0.0
vet_nmu      = 8
vet_nphi     = 32
vet_sc_order = 1
vet_tensor   = full
vet_source_noesrc = false

implicit_thin_switch     = none
implicit_thin_corr       = none
implicit_thin_recon      = dc
implicit_thin_bq         = cell
vet_x1_periodic          = true
vet_x1_npass             = 2
<problem>
pgen_name  = rad_m1_beam
m1_test                  = thick_pulse
user_srcs                = false

pulse_amp                = 1.0
pulse_width              = 0.15811388300841897
pulse_x0                 = 0.0
pulse_bg                 = 4.5399929762484854e-05
pulse_1d                 = true
gas_rho                  = 1.0
gas_eint                 = 1.5
gas_vx                   = 1.0
<output1>
file_type                = tab
variable    = m1
dt                       = 4.0

data_format              = %26.17e
slice_x2                 = 0.0

<output4>
file_type                = tab
variable                 = hydro_w
dt                       = 4.0
data_format              = %26.17e
slice_x2                 = 0.0
