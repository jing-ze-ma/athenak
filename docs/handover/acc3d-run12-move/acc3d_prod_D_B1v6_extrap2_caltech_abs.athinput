implicit_opac_lag_passes = 2              # hg145-1015: ROL2U
implicit_gas_newton_u4   = true           # hg145-1015: ROL2U
vet_gd_twin_lowmem       = true           # hgprod-1018: LAYOUT/memory key as hegiant_fin4_raven (bitwise; 897x64x64 OOM on A100 40 GB without it)
implicit_bc_x2min = flux   # ACC: accretor-specific (units / floor / BC)
implicit_bc_x2max = flux   # ACC: accretor-specific (units / floor / BC)
vet_gd_halo_ipc = false   # ACC: CUDA-only IPC halo; HIP

<problem>
coriolis_lz = true   # acclzc-1020 (USER 10-20): conservative phi-Coriolis, inertial L_z (accretor axis) closes with am_transport
theta_bc  = hse   # USER 10-18: hse theta walls + <rad_m1>/implicit_bc_x2 = flux (bin v7: von Zeipel wall flux)
theta_wall_closed = true   # accwall-1019 (USER 10-19): hse theta walls exactly closed (no mass/energy/x1,x3-momentum flux; only the interface pressure); EBUD-1019 leak ~2x stream into the star
phys_3d   = true   # acc3d-1017: the 3-D physics
user_srcs   = true
user_hist   = true
thermo      = general                # accretor-rhd-1008 S2: general EOS, column IC
env_ic      = column                 # S3: the S0 radiative column (P_gas + P_rad), balanced with the radiation-force reference
env_ic_file = /resnick/groups/carnegie_poc/jingze/acc3d_run12_move/in/column_mesakap_z0.02_p381.txt   # USER 10-18: MESA-kap column (make_ic_accretor_column.py, same EOS dump, a_sep 33.2596; the old ext2 column is reproduced to print precision)
env_lin_band_factor = 0.963286       # (3.81 d; 3.69 d: 0.960504) L_in = band equivalent of the 2-D equatorial slab (user 10-08): the von
                                     # Zeipel band of the Roche-distorted gainer radiates 0.963286 (3.81 d) of the phi = 90
                                     # column's L at the photosphere (band_luminosity.py; geometric, table-independent);
                                     # the bottom flux must equal this factor x F_col(r_in) (checked to 1e-3).
                                     # MUST BE 1 IN 3-D (full theta): the band factor applies to the theta-thin slab only
env_opac_table   = /resnick/groups/carnegie_poc/jingze/acc3d_run12_move/in/rosseland_mesakap_gs98_x0.70_z0.02.txt   # USER 10-18: MESA r15140 kap defaults spliced into ext2 (mk/build_mk.py, md5 d81b7a46)
env_planck_table = /resnick/groups/carnegie_poc/jingze/acc3d_run12_move/in/planck_ext2_gs98_x0.70_z0.02.txt           # final: planck_ext2_gs98_x0.70_z0.02.txt (md5 99d668f6)
env_t_ph    = 28300.0                # K
env_t_amb   = 6.758e6                # K; unused with env_amb_mode = radeq (only the EOS range check)
env_t_stream = 72966.0              # K, one-zone core at r 14.5 along the true path (stream_path_1015.py; 13.79: 65743)
inner       = envelope
m_acc       = 16.0                   # Msun, Wade+2026 (gainer at the start of accretion)
m_don       = 18.0                   # Msun (M1,i = 18.2 less winds)
a_sep       = 33.2596                # Rsun, Kepler for 34 Msun at 3.81 d
period      = 3.81                   # d, Wade+2026 Sect. 5 (initial period)
r_acc       = 9.00129260997162       # Rsun, face 218 (quoted R ~ 9)
t_don       = 155115.0               # K: ONLY the ballistic launch speed, c_s,don = 45.45 km/s = c_T of the hot L1 state
                                     # (stream_physics_1009.py sect. 2, Ryu adiabatic Q; donor Teff 26.2 kK kept for the atmosphere)
mu_don      = 0.62
spin        = 1.0                    # Omega_* / Omega_orb (critical 4.72)
env_npoly   = 3.0
env_rho_ph  = 0.013224             # documentation only with env_ic = column (MESA-kap column rho_ph 6.7576e-10 g/cc / 5.11e-8)
env_cs_ph   = 19.4132                # km/s, gainer Teff 28.3 kK, mu 0.62
env_cs_stream = 18.6791              # km/s; unused with thermo = general (env_t_stream sets the stream T)
env_t_relax = 0.0                    # S5 radeq: no T relaxation anywhere (the M1 coupling sets T_gas = T_rad)
env_t_relax_env = 0.0                # inside: off (radiation)
env_t_relax_stream = 0.0             # dense atmosphere/stream gas outside the envelope: off (radiation)
env_top_mode = equipotential         # envelope ends on psi = -15 c_ph^2 at every phi
env_wb_depth = 0.396                 # WB off above the equipotential 1.5 d_pen (0.264, 3.81 d) below the photosphere
r_meas      = 9.572888               # MR/JR, Menv/Jenv: face 449, above max r_ph + 10 H_p (3.81 d)
env_amb_mode = radeq                 # S5: floor ambient at radiative equilibrium (absorption on, floor booked: hst Mfl)
env_cs_amb  = 300.0                  # km/s; radeq: only the stream/atmosphere-vs-ambient density class (unused: no relaxation)
env_amb_rho = 1.0e-7                 # radeq: only the density class (see env_cs_amb)
env_amb_k   = 3.0                    # rho > k rho_amb,hse(r,phi): stream/star gas, relaxed to c_ph^2
env_t_sponge = 1.0e-4                # code time, safety-net sponge on floor gas (rho < 10 rho_amb)
env_sponge_rho = 10.0
env_v_floor_max = 100.0              # km/s, |v| cap of sponge cells
env_r_spin  = 9.00129260997162       # rotation only below R_acc
env_wall_slip = free                 # free | noslip
stream    = true    # PROD: stream on (the chain runs a static phase to t 0.05 with problem/stream=false first)
stream_inject = volume               # bigdom-1015 (user 10-15): 2-cell nozzle inside L1 where the stream is supersonic
stream_r    = 14.5                   # inner face of the nozzle: Mach |v|/c_tot 2.20 (|v_r|/c_tot 2.00, |v_r|/c_gas 2.36), stream_path_1015
stream_mdot= 254.843   # 3-D: the FULL stream, 1e-4 Msun/yr = 6.3028e21 g/s (code mass 1.7206e25 g, time 6.957e5 s)
outer_rho   = copy                   # bigdom-1015: plain outflow at the new r_out
env_r_top_max = 13.7926              # WB top capped at the old r_out (no fake envelope in the donor lobe)
donor_mask  = roche                  # bigdom-1015: donor Roche lobe = sink (Mmsk, Emsk)
donor_irr = true    # PROD: donor light on (3-D: physical dilution, donor_irr_scale default; = the 10-17 stream smoke)
stream_sector_light = neck   # acc3d-held-1018 23e06019 (PL2 10-18): lobe-rule light only between the nozzle and L1 in the nozzle window; rest of the 3-D sector dark (surface: 3x the lobe's held surface, Ltop excess 8.7x the analytic budget)
donor_irr_scale = 0.35   # acc3d-held-1018: a held isotropic lobe cell emits ~cE/2 = 2 sigma T^4 (+ r_out vent); 0.32-0.35 matches the analytic in-domain donor light 1.78e4 Lsun (static 3-D, t 0.045)
env_ic_vz   = true   # USER 10-18 ("keep it on"): von Zeipel IC T in the atmosphere, T_col(psi) (g_ph/g_col(0))^(w/4), g at the ray photosphere, taper 3 c_ph^2 below it (code a6624af6)
donor_lum   = 69183.1                # Lsun, 10^4.84 (Wade+2026 track, this deck's header); T_d over 4 pi R_L^2 -> 26.0 kK
dt_report   = true
floor_keep_momentum = true
stream_back_sink = true
stream_rad  = true                   # S5: the window injects the stream's radiation, E = a T_s^4, F = (4/3) E v (inert while stream = false)
rho_stream  = 0.240807               # code (1.2305e-8 g/cc): one-zone core at r_out, Mdot 1e-4 Msun/yr, Ryu adiabatic Q 0.649
rho_amb     = 1.0e-8                 # FLOOR density (= hydro dfloor) = the ambient (5.1e-16 g/cc)
stream_nsig = 6.0   # vphi-1021: gas window out to the floor (rho_s e^-18 < dfloor)
stream_rad_nsig = 3.0   # vphi-1021 (f852977b): stream radiation + neck light window (optically thick)
stream_t_profile = diffusion        # user 10-09: T falls from the core (env_t_stream) to the surface as the lowest diffusion mode,
                                     # T^4 = T_c^4 cos(pi/2 erf(|x|/sqrt2)), x = dphi/sigma, clamped at stream_t_surf (stream_physics_1009.py sect. 6)
stream_t_surf = 19239.0              # K, thin radiative-equilibrium T at r_out with both stars (stream_physics_1009.py)
stream_width = 1.7200                # Rsun arc width at r 14.5 (stream_path_1015.py); was 1.5362 at r_out (sigma_phi 6.38 deg): sigma_perp 1.3850 / cos 25.6 deg (one-zone c_iso 34.96 km/s)
stream_sigma_z= 1.0054   # Rsun, one-zone core at r 14.5 (stream_path_1015: c_iso 39.19 km/s / (Omega sqrt Phi_zz 8.622)); L1 1.21

