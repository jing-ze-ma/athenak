<comment>
problem = runs_3r_radwave vetf_impl_x1_P100_t10_N128_nt200_ny4

<job>
basename = rw

<mesh>
nghost = 2
nx1 = 128
x1min = 0.0
x1max = 1.0
ix1_bc = periodic
ox1_bc = periodic
nx2 = 4
x2min = 0.0
x2max = 1.0
ix2_bc = periodic
ox2_bc = periodic
nx3 = 1
x3min = 0.0
x3max = 1.0
ix3_bc = periodic
ox3_bc = periodic

<meshblock>
nx1 = 128
nx2 = 4
nx3 = 1

<time>
evolution = dynamic
integrator = rk2
cfl_number = 0.8
nlim = -1
tlim = 1.0539300035820678
ndiag = 1000000

<hydro>
eos = ideal
reconstruct = plm
rsolver = hllc
gamma = 1.666666666666667

<rad_m1>
c_light = 1000
chat_over_c = 1.0
cfl_rad = 0.4
thick_flux = none
closure = vet_sc
e_floor = 1.0e-30
subcycle = true
opacity = const
kappa_p = 10
kappa_e = 10
kappa_f = 10
kappa_s = 0.0
arad = 300
coupling = true
gas_feedback = true
transport = implicit
implicit_cfl = 674.51520229252333
implicit_tol = 1.0e-11
implicit_maxit = 200
implicit_lin_tol = 1.0e-13
implicit_lin_maxit = 400
implicit_solver = bicgstab
implicit_offdiag = operator
implicit_closure_lag = step
implicit_flux = central
implicit_recon = dc
vet_nmu = 4
vet_nphi = 8
vet_tensor = full
vet_x1_periodic = true
vet_x1_npass = 3

<problem>
pgen_name = rad_m1_beam
m1_test = radwave
radwave_dir = x1
radwave_amp = 1.0000000000000001e-05
radwave_rho = 1.0
radwave_t = 1.0
radwave_eig = true
radwave_eig_e_im = -0.0065903226305727884
radwave_eig_e_re = -0.0021980362635095367
radwave_eig_f_im = -4.4842801070443747e-06
radwave_eig_f_re = -7.369288427840767e-06
radwave_eig_t_im = -0.001648078288835332
radwave_eig_t_re = -0.00054967606854965502
radwave_eig_v_im = -0.32103253217530658
radwave_eig_v_re = 0.94882961544017452

<output1>
file_type = tab
variable = hydro_w
data_format = %.16e
dt = 0.065870625223879237
slice_x2 = 0.125


<output2>
file_type = tab
variable = m1
data_format = %.16e
dt = 0.065870625223879237
slice_x2 = 0.125

