diff --git a/src/rad_vet/rays/sc_build.cpp b/src/rad_vet/rays/sc_build.cpp
index 026c1bbaf..e28a46128 100644
--- a/src/rad_vet/rays/sc_build.cpp
+++ b/src/rad_vet/rays/sc_build.cpp
@@ -55,9 +55,31 @@ void RadiationVet::ScSource() {
   vgd_cur = DevExeSpace();
   if (vgd_csg) {   // the cs band copies
     ScCsSource();
-    return;
+  } else {
+    ScHaloCs(vgd_cs, ilo, ie);
   }
-  ScHaloCs(vgd_cs, ilo, ie);
+  // per band cell: min and max of ln chi over the cells within 2 laterally, -+inf where
+  // that reaches past the band (ScLineRange: a chord near none of them has no lateral
+  // opacity change, ScPathSeg is not needed)
+  const int c3w = cw_.extent_int(2), c2w = cw_.extent_int(3);
+  par_for("vet_vgd_csb", DevExeSpace(), 0, pmy_pack->nmb_thispack - 1, 0, c3w - 1, 0,
+          c2w - 1, ilo, ie,
+  KOKKOS_LAMBDA(const int m, const int k, const int j, const int i) {
+    Real lmn = 1.0e300, lmx = -1.0e300;
+    if (k < 2 || k >= c3w - 2 || j < 2 || j >= c2w - 2) {
+      lmn = -1.0e300;
+      lmx = 1.0e300;
+    } else {
+      for (int kk = k - 2; kk <= k + 2; ++kk) {
+        for (int jj = j - 2; jj <= j + 2; ++jj) {
+          lmn = fmin(lmn, cw_(m,0,kk,jj,i));
+          lmx = fmax(lmx, cw_(m,0,kk,jj,i));
+        }
+      }
+    }
+    cw_(m,2,k,j,i) = lmn;
+    cw_(m,3,k,j,i) = lmx;
+  });
 }
 
