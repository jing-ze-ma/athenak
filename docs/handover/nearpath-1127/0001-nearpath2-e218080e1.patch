diff --git a/src/rad_vet/rays/sc_ray.hpp b/src/rad_vet/rays/sc_ray.hpp
index 6b57d756d..35135223b 100644
--- a/src/rad_vet/rays/sc_ray.hpp
+++ b/src/rad_vet/rays/sc_ray.hpp
@@ -187,6 +187,65 @@ Real ScSegFinish(const A &acc, const FI &fI, const FC &fC, const FE &edgef,
   }
 }
 
+//----------------------------------------------------------------------------------------
+//! \fn ScPathSeg
+//! \brief closing segment of a chord that crosses lateral cells (a near-tangent ray):
+//! chi and S of the cell holding each of n sub-points, piecewise constant, so an opaque
+//! cell between the upwind point and the node is seen (the ends alone miss it).
+//! cell(s, lc, ls, h): ln chi, ln S at distance s from the node and its shell h (0, 1, 2
+//! = i - 1, i, i + 1); iu: the upwind intensity.  Returns -1 where ln chi varies by less
+//! than lcr laterally (within a shell, the node lc0 in shell 1) along the chord: a radial
+//! change alone is ScSegFinish's segment, which stands there.
+template <typename FP>
+KOKKOS_INLINE_FUNCTION
+Real ScPathSeg(const FP &cell, const int n, const Real ds, const Real lc0, const Real lcr,
+               const Real iu) {
+  const Real hs = ds/n;
+  Real tau = 0.0, acc = 0.0;
+  Real lmn[3] = {1.0e300, lc0, 1.0e300}, lmx[3] = {-1.0e300, lc0, -1.0e300};
+  for (int q = 0; q < n; ++q) {
+    Real lc, ls;
+    int h;
+    cell((q + 0.5)*hs, lc, ls, h);
+    lmn[h] = fmin(lmn[h], lc);
+    lmx[h] = fmax(lmx[h], lc);
+    const Real dt = exp(lc)*hs;
+    acc += exp(-tau)*exp(ls)*(1.0 - exp(-dt));
+    tau += dt;
+  }
+  const bool lat = (lmx[0] - lmn[0] > lcr) || (lmx[1] - lmn[1] > lcr) ||
+                   (lmx[2] - lmn[2] > lcr);
+  return lat ? acc + iu*exp(-tau) : -1.0;
+}
+
+// the lateral range of ln chi near the line from cell (k, j) to (fk, fj) on shell ii,
+// from the band's per-cell bounds (fC components 2, 3: min, max of ln chi within 2 cells,
+// ScSource): checkpoints at most 3 cells apart cover every cell within 2 of the line.
+// The cheap test before ScPathSeg samples a chord (never smaller than its range)
+template <typename FC>
+KOKKOS_INLINE_FUNCTION
+Real ScLineRange(const FC &fC, const int k, const int j, const Real fk, const Real fj,
+                 const int ii) {
+  const int nc = 1 + static_cast<int>(ceil(fmax(fabs(fk - k), fabs(fj - j))/3.0));
+  Real lmn = 1.0e300, lmx = -1.0e300;
+  for (int q = 0; q <= nc; ++q) {
+    const Real t = static_cast<Real>(q)/nc;
+    const int kc = static_cast<int>(floor(k + t*(fk - k) + 0.5));
+    const int jc = static_cast<int>(floor(j + t*(fj - j) + 0.5));
+    lmn = fmin(lmn, fC(2, kc, jc, ii));
+    lmx = fmax(lmx, fC(3, kc, jc, ii));
+  }
+  return lmx - lmn;
+}
+
+// sub-points of ScPathSeg: kVetPathPerCell per lateral cell the chord spans, at most 16
+// (clump deck, E at 0-0.5 cell from the edge: 2 -> -7.8 % sp, -2.7 % cs; 4 -> -7.4, -2.0)
+constexpr Real kVetPathPerCell = 2.0;
+KOKKOS_INLINE_FUNCTION
+int ScPathN(const Real span) {
+  return (span > 1.0) ? static_cast<int>(fmin(kVetPathPerCell*ceil(span), 16.0)) : 0;
+}
+
 //----------------------------------------------------------------------------------------
 // spherical-polar theta helpers
 
