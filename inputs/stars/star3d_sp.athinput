# 3-D star test, spherical-polar wedge: a small blue-supergiant envelope (docs/vet_clean/STARS.md).
# The production BSG deck (star_bsg.athinput) at the production radial grid and 1/4 the
# lateral resolution: 256 x 64 x 64 cells, 20-80 Rsun, theta pi/3..2pi/3, phi 0..pi/3 (periodic
# lateral walls), 16 MeshBlocks of 256 x 16 x 16 (tile 16).  Same scheme as the
# production runs, incl. the Gauss-Legendre 7 x 18 ray set (azimuthal
# period 20 deg: the 60 deg periodic wedge is a whole number of periods, as it must be).
# Data (inputs/stars/star3d_data, linked into the run directory as star3d_data):
#   bsg_ic.txt, bsg_profile.txt (thinned copies of the production 1-D profiles),
#   bsg_rosseland.txt, bsg_planck.txt (opacity tables).
# Needs a binary built with -D PROBLEM=star_vet (docs/vet_clean/BUILD.md).

<job>
basename = bsg3d

<mesh>
nx1 = 256
x1min = 1.391400e12
x1max = 5.565600e12
ix1_bc = user
ox1_bc = user
nx2 = 64
x2min = 1.0471975511965976
x2max = 2.0943951023931953
ix2_bc = periodic
ox2_bc = periodic
nx3 = 64
x3min = 0.0
x3max = 1.0471975511965976
ix3_bc = periodic
ox3_bc = periodic
use_spherical_polar = true
use_grid_stretch_r_poly = true
f_stretch_r_p_amp = -0.66666666666666667
f_stretch_r_p_xa = 0.1875
f_stretch_r_p_xb = 0.6875
f_stretch_r_p_w = 1.0e-12
layout_invariant_mode = tile
layout_tile = 16

<meshblock>
nx1 = 256
nx2 = 16
nx3 = 16

<time>
integrator = rk2
nlim = 4000
tlim = 8.4672e5                   # 9.8 d
ndiag = 10
dt_retry_grow = 1.1
dt_retry_ngood = 20

<units>
length_cgs = 1.0
mass_cgs = 1.0
time_cgs = 1.0
mu = 0.62

<hydro>
dt_floor_courant = 0.6
rad_signal_speed_phase = true
merge_lat_rc = 2.43495e12,3.82635e12,5.5656e12
merge_lat_f = 2,1,2
merge_lat_diag = 1000
eos = general
rad_signal_speed_diff = true
gamma = 1.6666666666666667
dfloor = 6.15245e-14
pfloor = 8.9014e-3
vceil = 3.0e8
tfloor = 134104228155.32465
wb_rmax = 4.231839e+12
floor_pay_skip = true
dfloor_flux_limit = true

<rad_vet>
floorcap_report = 25
floorcap_v = 3e7
floorcap_lz = true
floorcap_lz_spin = true
floorcap_rho = 1e-14
vet_gd_halo_ipc = true
c_light = 2.99792458e10
arad = 2.3392742567e-47
vet_gd_wall_interp = true
vet_gd_wall_sym = true
vet_gd_theta_seam_sym = true
opacity = table
temp_unit_kelvin = 7.4568864364e-9
e_floor = 1.0e-4
implicit_flux_x1min = 2.2942145641e+13
vet_gd_band_ring = true            # band slabs lent per shell: bitwise, less GPU memory
clean_maxit = 200
clean_pc_sweep = rb
clean_wb_exch_local = true

<problem>
star_seed_band = old
star_seed = 0.0
star_ic_profile = true
star_ic_profile_file = star3d_data/bsg_profile.txt
star_ic_profile_rho_thr = 6.15245e-7
star_ic_profile_seed_group = true
star_ic_profile_gext = invsq
star_ic_rad = file
star_ic_eint_from_t = false
user_srcs = true
user_hist = true
star_gm = 2.62502e27
star_ic_file = star3d_data/bsg_ic.txt
star_opac_table = star3d_data/bsg_rosseland.txt
star_planck_table = star3d_data/bsg_planck.txt
star_nfine = 262144
star_ic_cols = 5
star_bc_outer = copy
star_bc_outer_r2 = true

<output1>
file_type = hst
dt = 0
dcycle = 1
data_format = %24.16e

<output2>
bin_double = true
file_type = bin
variable = hydro_w
dt = 0
dcycle = 1000

<output3>
bin_double = true
file_type = bin
variable = vet
dt = 0
dcycle = 1000

<output4>
file_type = log
dt = 0
dcycle = 10
