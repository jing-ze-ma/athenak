# Production star deck template: 35 Msun main-sequence star envelope.
# Only what differs from the code defaults is named (the scheme is the default), and the
# values the start-up decides (a restart with -i then takes none from the file); tile
# layout mode (layout_tile = the lateral MeshBlock size; change both together).
# Before running: replace TABLES/ in the star_* table / profile / IC file keys by the
# directory of your copies (the files are not in the repository), and set the run
# length and outputs.
# Needs a binary built with -D PROBLEM=star_vet (docs/vet_clean/BUILD.md).
# Key meanings: docs/vet_clean/KEYS.md.  Restart rule: docs/vet_clean/RUN.md.

<job>
basename = m35mms

<mesh>
nx1 = 336
x1min = 6.7463500000e+11
x1max = 1.0641150000e+12
ix1_bc = user
ox1_bc = user
nx2 = 256
x2min = 1.39626340159546358
x2max = 1.74532925199432953
ix2_bc = periodic
ox2_bc = periodic
nx3 = 256
x3min = 0.0
x3max = 0.34906585039886590
ix3_bc = periodic
ox3_bc = periodic
use_spherical_polar = true
use_grid_stretch_r = true
f_stretch_r = -0.455726942889053
layout_tile = 128
# the values the start-up decides (a restart with -i takes them from the deck)
nghost                = 3
layout_invariant_mode = tile

<meshblock>
nx1 = 336
nx2 = 128
nx3 = 128

<time>
nlim = -1
tlim = 8.64e5
ndiag = 50
# the values the start-up decides (a restart with -i takes them from the deck)
dt_retry_grow  = 1.1
dt_retry_ngood = 20

<units>
length_cgs = 1.0
mass_cgs = 1.0
time_cgs = 1.0
mu = 0.6215

<hydro>
eos = general
gamma = 1.6666666666666667
dfloor = 1.0e-17
pfloor = 1.0e-12
vceil = 3.0e8
floor_audit = 1
tfloor = 133780565496.86447
wb_rmax = 1.097072e+12
# the values the start-up decides (a restart with -i takes them from the deck)
wellbalance_dynamic  = true
wb_x1                = true
sp_x2_periodic_image = true
etotgrav             = true

<rad_vet>
clean_stag_mg_levels = 4
floorcap_report = 25
floorcap_v = 3e7
floorcap_lz = true
floorcap_lz_spin = true
floorcap_rho = 1e-14
vet_gd_halo_ipc = false
c_light = 2.99792458e10
arad = 2.3619941258e-47
temp_unit_kelvin = 7.4749268633e-09
e_floor = 1.0e-4
implicit_flux_x1min = 1.8587122274e+14
clean_verbose = 1                   # the per-solve CLEAN diagnostic lines (scorers, reports)
clean_pc_sweep = rb
# the values the start-up decides (a restart with -i takes them from the deck)
force_reference       = wb_arad
clean_init            = steady
implicit_bc_x1min     = flux
clean_maxit           = 200
opacity               = table
vet_scatter           = true
closure               = sc
vet_gd_gl_nphi        = 18
vet_gd_wall_interp    = true
vet_gd_wall_sym       = true
vet_gd_theta_seam_sym = true
time_scheme           = hesdirk2

<problem>
star_ic_rad = file
star_ic_eint_from_t = true
user_srcs = true
user_hist = true
star_gm = 4.6449357021e+27
star_ic_file = TABLES/m35mms/ic_m35mms.txt
star_opac_table = TABLES/tables/rosseland_mesakap_gs98_x0.70_z0.02.txt
star_planck_table = TABLES/tables/planck_ext2_gs98_x0.70_z0.02.txt
star_nfine = 262144
star_ic_cols = 5
star_grid_dump = true
star_bc_outer = copy
# the values the start-up decides (a restart with -i takes them from the deck)
star_sponge_form = lawson

<output1>
file_type = hst
dt = 0
dcycle = 1
data_format = %24.16e

<output2>
file_type = bin
variable = hydro_w
dt = 1800.0

<output3>
file_type = bin
variable = vet
dt = 1800.0

<output4>
file_type = log
dt = 1.0e4

<output5>
file_type = rst
dt = 21600.0

<output6>
file_type = bin
variable = vet_vet
dt = 43200

<output7>
file_type = bin
variable = vet_face
dt = 43200
