f_stretch_r_b1_w = 8.434333965941e-02
f_stretch_r_b2_amp = -2.863911494909e+00
f_stretch_r_b2_x = 5.304082849728e-01
f_stretch_r_b2_w = 1.571731948484e-01
f_stretch_r_p_amp = -9.989999521912e-01
f_stretch_r_p_xa = 4.731830055582e-01
f_stretch_r_p_xb = 8.875035394912e-01
f_stretch_r_p_w = 9.865863707866e-03
f_stretch_r_p2_amp = -9.197856064985e-01
f_stretch_r_p2_xa = 9.762679326491e-01
f_stretch_r_p2_xb = 9.999727563837e-01
f_stretch_r_p2_w = 1.970196534328e-02
f_stretch_r_head_nin = 591
f_stretch_r_head_ij = 110
cs_vertex_fill_cc = 0  # Default value added at run time
cs_seam_rho_guard = 4
use_spherical_polar = 0  # Default value added at run time
use_grid_stretch_r = 0  # Default value added at run time
use_grid_stretch_theta = 0  # Default value added at run time
use_polar_boundary = 0  # Default value added at run time
use_polar_average_eresist = 1  # Default value added at run time
theta_plateau = 0  # Default value added at run time
polar_ring_avg = 0  # Default value added at run time
cs_seam_blockend = extend
cs_vertex_3cell = true
layout_invariant = true
layout_invariant_mode = tile
layout_tile = 16

<meshblock>
nx1 = 548
nx2 = 16
nx3 = 16

<time>
dt_retry_t2_be = 0
