# 3-D star test, cubed sphere: a small red-supergiant envelope (docs/vet_clean/STARS.md).
# The production RSG deck (20.5 Msun, MESA profile) on the full sphere at N = 32 cells per
# cube face (2.8 deg) instead of 128: 548 radial cells (stretched, 25-2530 Rsun; photosphere 834 Rsun; incl. the
# atmosphere), 6 faces x 32 x 32, 24 MeshBlocks of 548 x 16 x 16 (tile 16).  Scheme keys:
# the production runs.  Fresh start from the 1-D profile.
# Data (inputs/stars/star3d_data, linked into the run directory as star3d_data):
#   rsg_ic.txt (1-D IC profile), rsg_rosseland.txt, rsg_planck.txt (opacity tables).
#   The gas EOS table is built at start-up from the <hydro> eos_* keys (no file).
# Needs a binary built with -D PROBLEM=star_vet (docs/vet_clean/BUILD.md).
# Lines ending "# Default value added at run time" are code defaults recorded by the production
# run: the code treats them as not set by the input (keep that comment on them).

<job>
basename = rsg

<mesh>
nghost = 3
nx1 = 548
x1min = 1.7610000000e+12
x1max = 1.7610893676e+14
ix1_bc = user
ox1_bc = user
nx2 = 32
x2min = -1.0
x2max = 1.0
ix2_bc = panel
ox2_bc = panel
nx3 = 32
x3min = -1.0
x3max = 1.0
ix3_bc = panel
ox3_bc = panel
use_grid_stretch_r_poly = true
use_cubed_sphere = true
f_stretch_r_c1 = -2.379490646660e+00
f_stretch_r_c2 = -2.403770168268e+00
f_stretch_r_c3 = 1.415809802100e+01
f_stretch_r_c4 = -1.665097461225e+02
