# Production star deck template: T = 9 kK, log L/Lsun = 6.2 envelope.
# Only what differs from the code defaults is named (the scheme is the default), and the
# values the start-up decides (a restart with -i then takes none from the file); tile
# layout mode (layout_tile = the lateral MeshBlock size; change both together).
# Before running: replace TABLES/ in the star_* table / profile / IC file keys by the
# directory of your copies (the files are not in the repository), and set the run
# length and outputs.
# Needs a binary built with -D PROBLEM=star_vet (docs/vet_clean/BUILD.md).
# Key meanings: docs/vet_clean/KEYS.md.  Restart rule: docs/vet_clean/RUN.md.

<job>
basename = t9l62

<mesh>
nx1 = 512
x1min = 1.6850984345e+12
x1max = 5.6321590000e+13
ix1_bc = user
ox1_bc = user
nx2 = 256
x2min = 0.78539816339744831
x2max = 2.3561944901923448
ix2_bc = periodic
ox2_bc = periodic
nx3 = 512
x3min = 0.0
x3max = 3.1415926535897931
ix3_bc = periodic
ox3_bc = periodic
use_spherical_polar = true
use_grid_stretch_r = true
f_stretch_r = -3.509253962786431
layout_tile = 128
# the values the start-up decides (a restart with -i takes them from the deck)
nghost                = 3
layout_invariant_mode = tile

<meshblock>
nx1 = 512
nx2 = 128
nx3 = 128

<time>
nlim = -1
tlim = 2.682e6
ndiag = 50
# the values the start-up decides (a restart with -i takes them from the deck)
dt_retry_grow  = 1.1
dt_retry_ngood = 20

<units>
length_cgs = 1.0
mass_cgs = 1.0
time_cgs = 1.0
mu = 0.674

<hydro>
eos = general
gamma = 1.6666666666666667
dfloor = 3.6e-19
pfloor = 1.0e-12
vceil = 3.0e8
floor_audit = 1
tfloor = 123359972487.0939
wb_rmax = 7.504290e+12
# the values the start-up decides (a restart with -i takes them from the deck)
wellbalance_dynamic  = true
wb_x1                = true
sp_x2_periodic_image = true
etotgrav             = true

<rad_vet>
floorcap_v = 3e7
floorcap_rho = 1e-14
vet_gd_halo_ipc = false
c_light = 2.99792458e10
arad = 3.2670356041e-47
temp_unit_kelvin = 8.1063567271e-09
e_floor = 1.0e-4
implicit_flux_x1min = 6.9466003350e+13
verbose = 1                   # the per-solve CLEAN diagnostic lines (scorers, reports)
# the values the start-up decides (a restart with -i takes them from the deck)
force_reference       = wb_arad
steady_init            = steady
implicit_bc_x1min     = flux
solver_maxit           = 200
opacity               = table
vet_scatter           = true
closure               = sc
vet_gd_gl_nphi        = 18
vet_gd_wall_interp    = true
vet_gd_wall_sym       = true
vet_gd_theta_seam_sym = true
time_scheme           = sdirk2

<problem>
star_ic_rad = file
star_ic_eint_from_t = true
user_srcs = true
user_hist = true
star_gm = 7.4033817458e+27
star_ic_file = TABLES/t9l62/ic_t9l62_LIC.txt
star_opac_table = TABLES/tables/rosseland_mesakap_gs98_x0.70_z0.02.txt
star_planck_table = TABLES/tables/planck_ext2_gs98_x0.70_z0.02.txt
star_nfine = 262144
star_ic_cols = 5
star_grid_dump = true
star_bc_outer = copy
# the values the start-up decides (a restart with -i takes them from the deck)
star_sponge_form = lawson

<output1>
file_type = hst
dt = 0
dcycle = 1
data_format = %24.16e

<output2>
file_type = bin
variable = hydro_w
dt = 10800.0

<output3>
file_type = bin
variable = vet
dt = 10800.0

<output4>
file_type = log
dt = 1.0e4

<output5>
file_type = rst
dt = 43200.0

<output6>
file_type = bin
variable = vet_vet
dt = 43200

<output7>
file_type = bin
variable = vet_face
dt = 43200
