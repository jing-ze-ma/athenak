# Production star deck template: blue supergiant envelope (fresh start from a 1-D profile file; GL 7x18 rays).
# Only what differs from the code defaults is named (the scheme is the default); tile
# layout mode (layout_tile = the lateral MeshBlock size; change both together).
# Before running: replace TABLES/ in the star_* table / profile / IC file keys by the
# directory of your copies (the files are not in the repository), and set the run
# length and outputs.
# star_ic_profile_file (the full MESA profile) is not in the repository: for a test run
# star3d_data/bsg_profile.txt, a thinned copy of 1796 of its 327682 rows, can stand in.
# Needs a binary built with -D PROBLEM=star_vet (docs/vet_clean/BUILD.md).
# Key meanings: docs/vet_clean/KEYS.md.  Restart rule: docs/vet_clean/RUN.md.

<job>
basename = bsg3d

<mesh>
nx1 = 256
x1min = 1.391400e12
x1max = 5.565600e12
ix1_bc = user
ox1_bc = user
nx2 = 256
x2min = 1.0471975511965976
x2max = 2.0943951023931953
ix2_bc = periodic
ox2_bc = periodic
nx3 = 256
x3min = 0.0
x3max = 1.0471975511965976
ix3_bc = periodic
ox3_bc = periodic
use_spherical_polar = true
use_grid_stretch_r_poly = true
f_stretch_r_p_amp = -0.66666666666666667
f_stretch_r_p_xa = 0.1875
f_stretch_r_p_xb = 0.6875
f_stretch_r_p_w = 1.0e-12
layout_tile = 128

<meshblock>
nx1 = 256
nx2 = 128
nx3 = 128

<time>
nlim = -1
tlim = 4.9248e6
ndiag = 50

<units>
length_cgs = 1.0
mass_cgs = 1.0
time_cgs = 1.0
mu = 0.62

<hydro>
merge_lat_rc = 2.43495e12,3.82635e12,5.5656e12
merge_lat_f = 2,1,2
merge_lat_diag = 1000
eos = general
gamma = 1.6666666666666667
dfloor = 6.15245e-14
pfloor = 8.9014e-3
vceil = 3.0e8
floor_audit = 1
tfloor = 134104228155.32465
wb_rmax = 4.231839e+12

<rad_vet>
floorcap_report = 25
floorcap_v = 3e7
floorcap_lz = true
floorcap_lz_spin = true
floorcap_rho = 1e-14
vet_gd_halo_ipc = true
c_light = 2.99792458e10
arad = 2.3392742567e-47
temp_unit_kelvin = 7.4568864364e-9
e_floor = 1.0e-4
implicit_flux_x1min = 2.2942145641e+13
vet_gd_band_ring = true            # band slabs lent per shell: bitwise, less GPU memory
clean_verbose = 1                   # the per-solve CLEAN diagnostic lines (scorers, reports)
clean_pc_sweep = rb

<problem>
star_seed_band = old
star_seed = 0.0
star_ic_profile = true
star_ic_profile_file = TABLES/bsg/bsg_profile.txt
star_ic_profile_rho_thr = 6.15245e-7
star_ic_profile_seed_group = true
star_ic_profile_gext = invsq
star_ic_rad = file
star_ic_eint_from_t = false
user_srcs = true
user_hist = true
star_gm = 2.62502e27
star_ic_file = TABLES/bsg/ic_ma2026_f0.txt
star_opac_table = TABLES/bsg/rosseland_mesakap_gs98_x0.70_z0.008.txt
star_planck_table = TABLES/bsg/planck_ext2_gs98_x0.70_z0.008.txt
star_nfine = 262144
star_ic_cols = 5
star_grid_dump = true
star_bc_outer = copy
star_bc_outer_r2 = true

<output1>
file_type = hst
dt = 0
dcycle = 1
data_format = %24.16e

<output2>
bin_double = true
file_type = bin
variable = hydro_w
dt = 4.32e4

<output3>
bin_double = true
file_type = bin
variable = vet
dt = 4.32e4

<output4>
file_type = log
dt = 1.0e4

<output5>
file_type = rst
dt = 8.64e4

<output6>
bin_double = true
file_type = bin
variable = vet_vet
dt = 172800

<output7>
bin_double = true
file_type = bin
variable = vet_face
dt = 172800
