# Production star deck template: blue supergiant envelope (fresh start from a 1-D profile file; GL 7x18 rays).
# The scheme keys are those of the production runs of 2026-11-24 (commit 465aff485), tile
# layout mode (layout_tile = the lateral MeshBlock size; change both together).
# Before running: replace TABLES/ in the he_* table / profile / IC file keys by the
# directory of your copies (the files are not in the repository), and set the run
# length and outputs.
# Needs a binary built with -D PROBLEM=star_vet (docs/vet_clean/BUILD.md).
# Key meanings: docs/vet_clean/KEYS.md.  Restart rule: docs/vet_clean/RUN.md.

<job>
basename = bsg3d

<mesh>
nghost = 3
nx1 = 256
x1min = 1.391400e12
x1max = 5.565600e12
ix1_bc = user
ox1_bc = user
nx2 = 256
x2min = 1.0471975511965976
x2max = 2.0943951023931953
ix2_bc = periodic
ox2_bc = periodic
nx3 = 256
x3min = 0.0
x3max = 1.0471975511965976
ix3_bc = periodic
ox3_bc = periodic
use_spherical_polar = true
use_grid_stretch_r_poly = true
f_stretch_r_p_amp = -0.66666666666666667
f_stretch_r_p_xa = 0.1875
f_stretch_r_p_xb = 0.6875
f_stretch_r_p_w = 1.0e-12
layout_invariant = true
layout_invariant_mode = tile
layout_tile = 128

<meshblock>
nx1 = 256
nx2 = 128
nx3 = 128

<time>
dt_retry = true
evolution = dynamic
integrator = rk2
cfl_number = 0.3
nlim = -1
tlim = 4.9248e6
ndiag = 50
restart_refill_ghosts = false
dt_retry_fac = 0.5
dt_retry_fac_t2 = 0.9
dt_retry_grow = 1.1
dt_retry_host = false
dt_retry_ngood = 20
dt_retry_views = minimal
dt_retry_t2_be = 0
nan_check_cycles = 100

<units>
length_cgs = 1.0
mass_cgs = 1.0
time_cgs = 1.0
mu = 0.62

<hydro>
dt_floor_courant = 0.6
rad_signal_speed_phase = true
merge_lat_rc = 2.43495e12,3.82635e12,5.5656e12
merge_lat_f = 2,1,2
merge_lat_diag = 1000
split_c2p_once = true
am_transport = true
sp_x2_periodic_image = true
eos = general
rad_signal_speed = true
rad_signal_speed_diff = true
gamma = 1.6666666666666667
reconstruct = plm
rsolver = hllc
fofc = true
fofc_retest = true
etotgrav = true
wellbalance_dynamic = true
dfloor = 6.15245e-14
pfloor = 8.9014e-3
dfloor_keep_velocity = true
vceil = 3.0e8
wall_wb_onesided = true
floor_pay = rad_column
floor_pay_skip = true
dfloor_flux_limit = true
floor_audit = 1
general_eos = gamma
tfloor = 134104228155.32465
wb_x1 = true
wb_option = polytropic
wb_rmax = 4.231839e+12

<rad_vet>
clean_stag_mg_levels = 2
floorcap_report = 25
floorcap_v = 3e7
floorcap_lz = true
floorcap_lz_spin = true
floorcap_rho = 1e-14
clean_stag_flim = false
clean_init_dtfac = 1.0e6
vet_gd_gl_nmu = 7
vet_gd_gl_nphi = 18
vet_gd_gl_stagger = true
clean_stag_thinf = false
time2_enth_be = true
time2_fref_wacc = true
vet_interp = auto
vet_col_lat_cut_thin = 1.0
vet_bc_inner = auto
vet_bc_reflect = auto
vet_source = relaxed_esc
time2_vet_col_source = blend
implicit_gas_src = conservative2
vet_seg = jump
vet_bc_diff = face
vet_source_noesrc_h2be = true
vet_gd_allow_clamp = false
vet_gd_halo_ipc = true
vet_scatter_form = ma
vet_scatter_j = relaxed
vet_scatter_kappa_e = const
c_light = 2.99792458e10
arad = 2.3392742567e-47
chat_over_c = 1.0
closure = vet_col
vet_gd = true
vet_scatter = true
vet_gd_replace = true
vet_col_lat_offdiag = operator
vet_gd_tangential = true
vet_gd_wall_interp = true
vet_gd_wall_sym = true
vet_gd_theta_seam_sym = true
vet_gd_halo_compact = 2
opacity = table
temp_unit_kelvin = 7.4568864364e-9
rho_unit_cgs = 1.0
kappa_unit = 1.0
e_floor = 1.0e-4
coupling = true
gas_feedback = true
force_reference = wb_arad
transport = implicit
implicit_lin_maxit = 200
implicit_resid_fatal = 1.0e-2
implicit_maxit = 200
implicit_enthalpy = plm
implicit_predictor = step
implicit_pos_gas = true
implicit_pos_floor = true
time_scheme = hesdirk2
vet_col_every = 1
marshak_q = 0.5
implicit_bc_x1min = flux
implicit_flux_x1min = 2.2942145641e+13
implicit_bc_x1max = marshak
implicit_flux_x1max = 0.0
scheme = clean
vet_gd_band_ring = true            # band slabs lent per shell: bitwise, less GPU memory
clean_verbose = 1                   # the per-solve CLEAN diagnostic lines (scorers, reports)
clean_layout = staggered
clean_rays = sc
time2_face_fct = true
zalesak_active = true
clean_xt_exact = cons
implicit_pos_floor_cons = true
implicit_pos_floor_gas_keep = 1
implicit_pos_gas_cons = true
clean_stag_xdonor = lag
clean_stag_xsrc = true
clean_stag_mg_color = mirror
time2_k1_redist = 0
time2_auto_be = 16
implicit_predictor_tcap = 1.1
time2_k1_stiff = 0
clean_conv_kappa = 1.0
cs_vertex_mono = true
clean_init = steady
vet_rotate_avg_ema = 0
clean_cs_lz_tel = false
vet_rotate_avg = 0
vet_gd_rotate_dt = 0
force_reference_work = split
clean_maxit = 200
clean_conv_max = 1.0e-5
time2_tableau = sdirk2
time2_gtime_mom = true
clean_stag_xdonor_freeze = 4
time2_cfl_post = true
clean_w_fse = true
clean_w_fse_tau = true
clean_pred_stage = false
clean_stag_central = true
clean_stag_eicarry = true
clean_gas_secant = max_stage2
clean_pred_xch = true
clean_stag_fcone_gas = false
clean_wb_exch_local = true
clean_face_hctau = true
clean_face_jse = true
clean_face_jse_cell = false
clean_bc_area = true
clean_stag_upwind_central = true
vet_seg_plateau = false
clean_rot_ring_fill_rst = true
clean_rst_mshare = true
clean_bc = halfrange
clean_bicg_stall_fac = 0.99
clean_bicg_stall_its = 0
clean_closure = extrap1
clean_consistency = 1
clean_conv = budget
clean_conv_est_f = 0
clean_face_area = 0
clean_face_opac = harmonic
clean_fill_cs_remap = 0
clean_fill_passes = 8
clean_gas_newton_switch = 4
clean_gas_newton_switch_min = 6
clean_halo_direct = 1
clean_init_cnorm = 1e-10
clean_lin_cnorm = 1e-10
clean_lin_pass = true
clean_maxnl = 200
clean_maxpic = 12
clean_nl_norm = global
clean_pass_damp = 0
clean_pc_sweep = rb
clean_predict = 1
clean_ray_cut_margin = 10
clean_ray_cut_r = 0.01
clean_ray_cut_taumin = 0
clean_ray_cut_wait = 10
clean_ray_min = 0.001
clean_retry_budget = 0
clean_ring_jmin = 1
clean_rot_fuse = true
clean_rot_ring = off
clean_source_convex = 1
clean_stag_fcone = true
clean_stag_fwb = true
clean_stag_fwb_ring = 1
clean_stag_fwb_stage = false
clean_stag_fwb_t2 = false
clean_stag_lat_sums = 0
clean_stag_opac_drag = 0
clean_stag_opac_passes = 3
clean_stag_opac_update = true
clean_stag_pcr = 1
clean_stag_rayratio = 0
clean_stag_tie_gid = 0
clean_stall_fac = 0.5
clean_tol = 1e-10
clean_tol_nl = 1e-11
clean_troot_rtol = 1e-13
clean_w_c0 = 0.3
clean_w_c1 = 0.6
clean_w_face_min = 0
clean_wb_fct = true
vet_gd_rotate_xfade = true
vet_rotate_advance = true
clean_stag_fs_line = pcr
floorcap_mesh_vol = true

<problem>
star_seed_band = old
star_seed = 0.0
star_ic_profile = true
star_ic_profile_file = TABLES/bsg/linhao_profile_full.txt
star_ic_profile_amp = 0.05
star_ic_profile_rho_thr = 6.15245e-7
star_ic_profile_seed_group = true
star_ic_profile_rng = 0
star_ic_profile_gconst = 6.67408e-8
star_ic_profile_gext = invsq
star_ic_rad = file
star_ic_eint_from_t = false
user_srcs = true
user_hist = true
star_gm = 2.62502e27
star_gravity = wb
star_ic_file = TABLES/bsg/ic_ma2026_f0.txt
star_opac_table = TABLES/bsg/rosseland_mesakap_gs98_x0.70_z0.008.txt
star_planck_table = TABLES/bsg/planck_ext2_gs98_x0.70_z0.008.txt
star_nfine = 262144
star_tau_int = 1.0
star_ic_cols = 5
star_wall_zero_flux = true
star_ic_balance = false
mlt_flux_frozen = false
star_wall_closed = true
mlt_closure = frozen
star_grid_dump = true
star_bc_outer = copy
star_bc_outer_r2 = true
star_bc_inner = wall

<output1>
file_type = hst
dt = 0
dcycle = 1
data_format = %24.16e

<output2>
bin_double = true
file_type = bin
variable = hydro_w
dt = 4.32e4

<output3>
bin_double = true
file_type = bin
variable = vet
dt = 4.32e4

<output4>
file_type = log
dt = 1.0e4

<output5>
file_type = rst
dt = 8.64e4

<output6>
bin_double = true
file_type = bin
variable = vet_vet
dt = 172800

<output7>
bin_double = true
file_type = bin
variable = vet_face
dt = 172800
