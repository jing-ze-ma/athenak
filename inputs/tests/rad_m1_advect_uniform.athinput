# AthenaK input file for the grey M1 UNIFORM ADVECTED MEDIUM (design note T4b)
#
# QUOKKA AP paper (arXiv:2404.08247) Sect. 5.5: a uniform medium moving at v = 0.01 c
# with tau_cell = rho kappa dx = 1e5, i.e. beta tau_cell = 1e3.  The state is the EXACT
# fixed point of the design sect. 1 source terms (F0_i = 0 and E0 = arad T^4, solved for
# in the problem generator), so a correct scheme moves nothing: the gas temperature must
# not drift.  The O(v/c) truncation, rad_m1/source_form=ovc, is the failing control and
# must show the spurious heating ~ (4/3) c rho kappa beta^2 E of design sect. 1.
#
# Units as in rad_m1_advect_pulse.athinput: cgs with T_code = k T_K/(mu m_H), mu = 2.33.
# rho = 1.2, T = 1e7 K, dx = 1 cm, kappa_s = 1e5/(1.2*1) = 83333.33.
# tlim = 1.23e-7 s is about 100 hydro steps (dt is set by v, not by the sound speed).

<comment>
problem = grey M1 uniform advected medium

<job>
basename = m1_advect_uniform

<mesh>
nghost    = 2
nx1       = 64
x1min     = 0.0
x1max     = 64.0
ix1_bc    = periodic
ox1_bc    = periodic

nx2       = 1
x2min     = -0.5
x2max     = 0.5
ix2_bc    = periodic
ox2_bc    = periodic

nx3       = 1
x3min     = -0.5
x3max     = 0.5
ix3_bc    = periodic
ox3_bc    = periodic

<meshblock>
nx1       = 64
nx2       = 1
nx3       = 1

<time>
evolution  = dynamic
integrator = rk2
cfl_number = 0.4
nlim       = -1
tlim       = 1.23e-7
ndiag      = 100000

<hydro>
eos         = ideal
reconstruct = plm
rsolver     = hllc
gamma       = 1.666666666666667

<rad_m1>
c_light      = 2.99792458e10
chat_over_c  = 1.0
cfl_rad      = 0.4
reconstruct  = plm
thick_flux   = ap_hll
scaled_prefactor = 20.0
ap_form      = alpha2   # alpha2 | unified
advect_split = true
split_vel    = recon    # recon | cell: the velocity that builds A = v E + v.P
source_form  = full     # full | ovc (the FAILING CONTROL)
closure      = m1
e_floor      = 1.0e-10
subcycle     = true
opacity      = const
kappa_p      = 83333.33333333333  # ABSORPTION (kappa_e, kappa_f default to it): the
kappa_s      = 0.0      # gas and the radiation are locked to one temperature
arad         = 4.8032223745536764e-45
coupling     = true
gas_feedback = true

<problem>
pgen_name   = rad_m1_beam
m1_test     = advect_uniform
gas_rho     = 1.2
gas_temp    = 3.5426608899723244e14
pulse_v     = 2.99792458e8

<output1>
file_type   = tab
variable    = m1
data_format = %26.17e
dt          = 1.23e-7

<output2>
file_type   = tab
variable    = hydro_w
data_format = %26.17e
dt          = 1.23e-7
