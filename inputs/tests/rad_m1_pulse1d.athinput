# AthenaK input file for the grey M1 1-D FREE-STREAMING PULSE (design note T1, the
# convergence half)
#
# Periodic unit box, c = 1, no opacity.  The initial state is a Gaussian in E with
# f = |F|/(cE) = 1 EXACTLY.  At f = 1 the Levermore closure gives chi = 1, P = E, the
# two eigenvalues merge at +c, and the M1 system reduces to dE/dt + c dE/dx = 0: the
# pulse translates rigidly at c and the exact solution after one box crossing is the
# initial condition.  That is the only free-streaming case M1 solves exactly, which is
# why f = 1 is used here rather than 0.9.
#
# Used for the reconstruction convergence table (tests_m1/t1_pulse.py): run at
# mesh/nx1 = 32 ... 512 for each <rad_m1>/reconstruct and fit the order of the L1 error
# of the final dump against the initial one.  ppm4, ppmx and wenoz need mesh/nghost = 3.
# The output is `tab` in double precision: the bin writer is single precision, which is
# not enough for the L1 errors this test reaches at 512 cells.

<comment>
problem = grey M1 1-D free-streaming pulse

<job>
basename = m1_pulse1d

<mesh>
nghost    = 3
nx1       = 128
x1min     = 0.0
x1max     = 1.0
ix1_bc    = periodic
ox1_bc    = periodic

nx2       = 1
x2min     = -0.5
x2max     = 0.5
ix2_bc    = periodic
ox2_bc    = periodic

nx3       = 1
x3min     = -0.5
x3max     = 0.5
ix3_bc    = periodic
ox3_bc    = periodic

<meshblock>
nx1       = 128
nx2       = 1
nx3       = 1

<time>
evolution  = dynamic
integrator = rk2
cfl_number = 0.4
nlim       = -1
tlim       = 1.0
ndiag      = 100000

<rad_m1>
c_light     = 1.0
chat_over_c = 1.0
cfl_rad     = 0.4
reconstruct = plm       # dc | plm | ppm4 | ppmx | wenoz
thick_flux  = none
closure     = m1
e_floor     = 1.0e-15
subcycle    = true

# ---- MILESTONE 3a: implicit x1 transport (docs/dev/rad_m1_implicit_design.md).  Listed
# here at their DEFAULTS so that the gate scripts can override them on the command line
# (AthenaK only accepts a command-line override of a parameter the input file names).
transport             = explicit  # explicit | implicit_x1
implicit_cfl          = -1.0      # implicit_x1 only: dt = implicit_cfl*dx/c (<=0: off)
implicit_tol          = 1.0e-8
implicit_maxit        = 30
implicit_opac_update  = false
implicit_allow_multid = false
implicit_flux         = central   # central | ap_hll | berthon | blend
implicit_recon        = dc        # dc | plm_dc       (milestone 3a2, LIMIT 1)
implicit_blend        = tau_f     # tau | f | tau_f   (milestone 3c, blend weight)
implicit_blend_fmode  = max       # max | mean        (3c: f_face from the two cells)
implicit_blend_mode   = flux      # flux | dissipation (3c: what is blended)
implicit_blend_tau0   = 1.0       # 3c: w = exp(-(tau_face/tau0)^2)
implicit_blend_flo    = 0.6       # 3c: smoothstep lower edge in the reduced flux
implicit_blend_fhi    = 0.9       # 3c: smoothstep upper edge in the reduced flux
implicit_partition    = none      # none | gather (gather is NOT implemented yet)
implicit_recon_w      = -1.0      # plm_dc weight; <=0 = auto 1/(1+chat dt/dx)
implicit_recon_lag    = picard     # step | picard (when the plm correction is re-made)
implicit_recon_npass  = -1        # 3c: freeze the plm correction after N passes
implicit_res_floor    = 0.0       # Picard residual scale (0 = the 3a pure |dE|/E)
implicit_bmom_half    = false     # boundary momentum (milestone 3a2, LIMIT 3)
marshak_q             = 0.5
implicit_bc_x1min     = auto      # auto|marshak|flux|reflect|periodic|efix
implicit_bc_x1max     = auto
implicit_flux_x1min   = 0.0
implicit_flux_x1max   = 0.0
implicit_ebath_x1min   = 0.0
implicit_ebath_x1max   = 0.0

<problem>
pgen_name   = rad_m1_beam
m1_test     = pulse1d
pulse_amp   = 1.0
pulse_width = 0.1
pulse_x0    = 0.5
pulse_bg    = 1.0e-4

<output1>
file_type   = tab
variable    = m1
data_format = %26.17e
dt          = 1.0
