# OPTICALLY THICK 1-D SPHERICAL unit test of the grey two-stream (tests_r2/thick).
#
# The transparent gate (inputs-adjacent tests_r2/rg1d) checks the r^2 dilution the
# spherical two-stream was built for.  This one checks the opposite limit.  Commit
# 1159a8f3 transports J = A I against a source A B (A ~ r^2), so in the DIFFUSION limit
# the sweep returns
#    F_2s = -(mu/(kappa rho)) d(A B)/dr / A = -(mu/(kappa rho)) [dB/dr + 2 B/r],
# i.e. a factor
#    F_2s / F_exact = 1 + (2 B/r)/(dB/dr) = 1 - H_T/(2 r),   H_T = T/|dT/dr|
# too much (or, for shallow temperature gradients, the WRONG SIGN).
#
# The state is supplied EXACTLY through problem/ic_profile: rho = rho_in (r_in/r)^n and
# the T that solves d(T^4)/dr = -3 kappa rho L/(16 pi sigma r^2) with T(r_out) = Teff and
# L = 4 pi r_out^2 sigma Teff^4, i.e. the exact radiative-equilibrium diffusion solution
# for a CONSTANT kappa (problem/kappa_const, which replaces the opacity table).  On that
# state the correct radiative flux at every face is F_req = L/(4 pi r^2), and deep in the
# shell T^4 ~ r^-(n+1), so H_T/(2r) -> 2/(n+1) and the prediction is
#    F_2s/F_req = 1 - 2/(n+1):   n=0 -> -1,  n=1 -> 0,  n=3 -> +0.5,  n=7 -> +0.75.
#
# The BLEND IS OFF (rad_tau_lo/hi far deeper than the domain), so the two-stream is the
# only carrier and L is injected on its own lower boundary (problem/rt_bottom_flux).
# Run with time/nlim = 1: hydro never moves, the measurement is the t = 0 face dump
# problem/mlt_dump (columns "i r T_f p_f grad grad_ad x F_mlt F_rad F_used F_req
# F_raddiff w_blend F_rad_col0 F_conv_res grad_rad D F_2s"; F_raddiff must come back at
# F_req, since the state IS the exact diffusion solution).
#
# Per-case knobs (n, tau_tot, r_out/r_in) come from the command line -- see
# tests_r2/thick/run_thick.sh and tests_r2/thick/make_ic_thick.py.

<comment>
problem   = optically thick 1-D spherical two-stream diffusion-limit test

<job>
basename  = rgthick

<mesh>
nghost    = 2
nx1       = 128              # RADIAL, uniform
x1min     = 1.0e12
x1max     = 2.0e12           # r_out/r_in = 2 by default; overridden per case
ix1_bc    = user
ox1_bc    = user
nx2       = 4
x2min     = -1.0
x2max     = 1.0
ix2_bc    = panel
ox2_bc    = panel
nx3       = 4
x3min     = -1.0
x3max     = 1.0
ix3_bc    = panel
ox3_bc    = panel
use_cubed_sphere = true

<meshblock>
nx1       = 128
nx2       = 4
nx3       = 4

<time>
evolution  = dynamic
integrator = rk2
cfl_number = 0.3
nlim       = 1
tlim       = 1.0e30
ndiag      = 1
nan_check_cycles = 100

<units>
length_cgs = 1.0
mass_cgs   = 1.0
time_cgs   = 1.0
mu         = 1.0

<hydro>
eos         = ideal
gamma       = 1.6666666667
reconstruct = plm
rsolver     = hllc
etotgrav    = true
wellbalance_dynamic = false
isotropic_conduction = radiative
rad_kappa_src        = table_rho
rad_flux_inner       = 1.4188435e6    # L/(4 pi rin^2); overridden per case
rad_flux_limit       = true
rad_tau_lo           = 1.0e5          # the blend is OFF over the whole domain:
rad_tau_hi           = 1.0e6          # w = 0 everywhere, the two-stream carries all of L
dfloor = 1.0e-18
pfloor = 1.0e-12

<problem>
user_srcs   = true
mstar       = 1.0e33
lstar       = 1.7832e37      # 4 pi rout^2 sigma Teff^4; overridden per case
teff        = 5000.0
ptop        = 3.0
mu          = 1.0
vpert       = 0.0
kappa_fac   = 1.0
kappa_const = 2.6666667e-4   # set from tau_tot per case
inner_bc    = wall
ic_profile  = ic_thick.txt
mlt_alpha   = 1.5
mlt_dump    = mltfaces.txt
rt_grey     = true
rt_implicit_column = 3
rt_impl_solver = pcr
# WHOSE flux is F_2s?  Fb -- column 17 of the dump -- is written by the EXPLICIT sweep
# unless the column solve is told to own it.  With rt_col3_skip_sweep = false (the value
# here, and the one the first measurement of this directory ran with) the test therefore
# reports MODE 0's flux whatever rt_implicit_column says; pass
# problem/rt_col3_skip_sweep=true on the command line to gate the mode-3 solve itself.
rt_col3_skip_sweep = false
rt_col3_ex_iter    = true        # required by rt_col3_skip_sweep
rt_src_direct      = true        # required by rt_col3_skip_sweep
ck_nquad    = 2
rt_strang   = true
rt_bottom_flux = true
rt_de_max   = 0.5
met         = 0.0
opac_table  = /viper/u2/jinma/ATHENAK/bench/hestar_fecz/rosseland_he_x0.0_z0.02.txt
column_dump =

<output1>
file_type  = hst
dt         = 1.0e30
