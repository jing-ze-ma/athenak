# Plane-parallel hydrostatic column (pgen wb_column): the dynamic well-balanced scheme
# along x1 (default) or x3.  Build with -D PROBLEM=wb_column.

<comment>
problem   = well-balanced column

<job>
basename  = wbcol

<mesh>
nghost    = 2
nx1       = 64
x1min     = 0.0
x1max     = 2.0
ix1_bc    = user
ox1_bc    = user
nx2       = 8
x2min     = 0.0
x2max     = 0.25
ix2_bc    = periodic
ox2_bc    = periodic
nx3       = 8
x3min     = 0.0
x3max     = 0.25
ix3_bc    = periodic
ox3_bc    = periodic

<meshblock>
nx1       = 64
nx2       = 8
nx3       = 8

<time>
evolution  = dynamic
integrator = rk2
cfl_number = 0.3
nlim       = 200
tlim       = 100.0
ndiag      = 50

<hydro>
eos         = ideal
reconstruct = plm
rsolver     = hllc
gamma       = 1.4
etotgrav    = true
wellbalance_dynamic = false
wb_x1       = false
wb_x3       = false
wb_option   = polytropic
wb_cache_every = 0

<problem>
user_srcs = true
user_bcs  = true
axis      = 1
g0        = 1.0
ap        = 4.0
rho0      = 1.0
t0        = 1.0
tgrad     = -0.3
b0        = 0.0
gsrc_fac  = 1.0     # source gravity = gsrc_fac x the potential gravity (a test body force)

<output1>
file_type = hst
dt        = 0.5

<output2>
file_type = bin
variable  = hydro_w
dt        = 5.0
