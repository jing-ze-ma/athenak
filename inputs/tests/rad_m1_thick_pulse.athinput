# AthenaK input file for the grey M1 static thick pulse (design note T3, the AP gate)
#
# 1-D periodic Gaussian in E in a scattering-dominated STATIC medium: rho = 1, a pure
# scattering opacity kappa_s, and <rad_m1>/gas_feedback = false so the gas is never
# pushed or heated.  The variance of E must grow at 2D with D = c/(3 rho kappa).
#
# tau_cell = rho kappa_s dx = kappa_s/128 with the numbers below, so
#   tau_cell = 0.1   1e1   1e3   1e6   <->   kappa_s = 12.8  1280  1.28e5  1.28e8
# and the gate is run at each of those for thick_flux = ap_hll | scaled | none, e.g.
#   athena -i rad_m1_thick_pulse.athinput rad_m1/kappa_s=1280 rad_m1/thick_flux=ap_hll
#
# The odd-even (Nyquist) variant adds problem/nyquist_amp=1e-3; the top-hat of T3c is
# problem/m1_test=tophat.  The gas internal energy is deliberately small so that the
# HYDRO timestep is ~10x the radiation one and the sub-cycle loop runs with nsub ~ 10.

<comment>
problem = grey M1 static thick pulse

<job>
basename = m1_thick_pulse

<mesh>
nghost    = 2
nx1       = 128
x1min     = 0.0
x1max     = 1.0
ix1_bc    = periodic
ox1_bc    = periodic

nx2       = 1
x2min     = -0.5
x2max     = 0.5
ix2_bc    = periodic
ox2_bc    = periodic

nx3       = 1
x3min     = -0.5
x3max     = 0.5
ix3_bc    = periodic
ox3_bc    = periodic

<meshblock>
nx1       = 128
nx2       = 1
nx3       = 1

<time>
evolution  = dynamic
integrator = rk2
cfl_number = 0.4
nlim       = -1
tlim       = 1.0
ndiag      = 10000

<hydro>
eos         = ideal
reconstruct = plm
rsolver     = hllc
gamma       = 1.666666666666667

<rad_m1>
c_light      = 1.0
chat_over_c  = 1.0
cfl_rad      = 0.4
reconstruct  = plm      # dc | plm
thick_flux   = ap_hll   # none | ap_hll | scaled
scaled_prefactor = 20.0
closure      = m1
e_floor      = 1.0e-30
subcycle     = true
opacity      = const
kappa_p      = 0.0      # pure scattering: no emission, no absorption
kappa_e      = 0.0
kappa_f      = 0.0
kappa_s      = 12.8
coupling     = true
gas_feedback = false    # static medium

<problem>
pgen_name   = rad_m1_beam
m1_test     = thick_pulse
gas_rho     = 1.0
gas_eint    = 0.01
pulse_amp   = 1.0
pulse_width = 0.05
pulse_x0    = 0.5
pulse_bg    = 1.0e-3
nyquist_amp = 0.0

<output1>
file_type   = bin
variable    = m1
dt          = 0.1
