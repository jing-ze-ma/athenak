# ohmdrag-1029 (TEST): Ohmic drag, steep eta(r), cubed sphere, kinematic, exact walls.
# reference: python3 ohm_drag_ref1d.py --eta_bot 0.1 --ndec 4 --rt 1.6 --w 0.08 --om0 0.25 --T 2.0
<job>
basename = od

<mesh>
nghost   = 2
nx1      = 32
x1min    = 1.0
x1max    = 2.0
ix1_bc   = user
ox1_bc   = user
nx2      = 32
x2min    = -1.0
x2max    = 1.0
ix2_bc   = panel
ox2_bc   = panel
nx3      = 32
x3min    = -1.0
x3max    = 1.0
ix3_bc   = panel
ox3_bc   = panel
use_cubed_sphere = true

<meshblock>
nx1      = 32
nx2      = 16
nx3      = 16

<time>
evolution  = dynamic
integrator = rk2
cfl_number = 0.3
nlim       = -1
tlim       = 2.0
ndiag      = 1000

<mhd>
eos         = ideal
reconstruct = plm
rsolver     = hlld
gamma       = 1.666666666666667
ohmic_resistivity = constant
eta_ohm_const     = 0.1
use_rkg_sts = false

<problem>
m_dip    = 1.0
om0      = 0.25
eta_bot  = 0.1
ndec     = 4.0
rt       = 1.6
w        = 0.08
d0       = 1.0
p0       = 1.0
kinematic = true
ref_file = none   # table from ohm_drag_ref1d.py at t = tlim (none: no errors)
err_file = ohm_drag-errs.dat
user_srcs = true
user_hist = true
radial_profile = true

<output1>
file_type = hst
dt        = 0.02
data_format = %24.16e
