# AthenaK input for gate G5 (T3 pulse, 2-D mesh), g5fix-1011.  Replaces the battery's
# pulse2d.athinput (generated from rad_m1_thick_pulse.athinput with nx2 = 4), which had
#   - an ISOTROPIC 2-D Gaussian of width 0.05 on dx2 = 0.25: the resolved peak was
#     exp(-6.25) = 1.9e-3 on a 1e-3 floor, so the variance hinged on the background
#     treatment (--subtract-min);
#   - at kappa_s = 12.8 a pulse 0.64 mean free paths wide that filled the periodic box
#     by t = 1; at kappa_s = 128 a fit through the free-streaming transient.
# Here the pulse is 1-D in x1 (problem/pulse_1d = true) on the same 2-D mesh, the floor
# is 1e-8 and is subtracted as the KNOWN background, and the box/width/tlim are set PER
# KAPPA on the command line so that (D = c/(3 rho kappa), sigma0^2 = w^2/2):
#   rho kappa w >= 5          (the pulse is diffusive: many mean free paths wide)
#   sigma^2(tlim) ~ 3 sigma0^2 (a fixed growth factor)
#   4 sigma(tlim) < half box   (the pulse never reaches the periodic edge)
# and the fit skips t < 10/(c rho kappa) (t3_pulse.py --tau-skip 10).
#
#  kappa_s  box x1     nx1  w     tlim  output1/dt  rho kappa w  sigma^2: 0 -> tlim
#  12.8     [0,4]      512  0.40  3.0   0.15        5.1          0.080 -> 0.232
#  128      [0,1]      128  0.05  0.5   0.025       6.4          1.25e-3 -> 3.81e-3
#  1280     [0,1]      128  0.05  5.0   0.25        64           1.25e-3 -> 3.85e-3
#  12800    [0,1]      128  0.05  50    2.5         640          1.25e-3 -> 3.85e-3
# dx1 = 1/128 (tau_cell = kappa/128 = 0.1 1 10 100) at every kappa.  kappa_s = 12.8
# cannot be diffusive in the [0,1] box (w >= 5/kappa = 0.39 > box/4), hence the [0,4] box.
# The defaults below are the kappa_s = 128 row.
#
# Analysis (per run):
#   python tests_m1/t3_pulse.py bin/*.bin --c 1 --rho 1 --kappa $k --background 1e-8 \
#          --tau-skip 10 --reduce mean --quiet

<comment>
problem = grey M1 static thick pulse, gate G5 (1-D pulse on a 2-D mesh)

<job>
basename = m1_thick_pulse

<mesh>
nghost    = 2
nx1       = 128
x1min     = 0.0
x1max     = 1.0
ix1_bc    = periodic
ox1_bc    = periodic

nx2       = 4
x2min     = -0.5
x2max     = 0.5
ix2_bc    = periodic
ox2_bc    = periodic

nx3       = 1
x3min     = -0.5
x3max     = 0.5
ix3_bc    = periodic
ox3_bc    = periodic

<meshblock>
nx1       = 128
nx2       = 4
nx3       = 1

<time>
evolution  = dynamic
integrator = rk2
cfl_number = 0.4
nlim       = -1
tlim       = 0.5
ndiag      = 10000

<hydro>
eos         = ideal
reconstruct = plm
rsolver     = hllc
gamma       = 1.666666666666667

<rad_m1>
c_light      = 1.0
chat_over_c  = 1.0
cfl_rad      = 0.4
reconstruct  = plm      # dc | plm
thick_flux   = ap_hll   # none | ap_hll | scaled
scaled_prefactor = 20.0
ap_form      = alpha2   # alpha2 | unified (design sect. 10)
advect_split = false    # moving-media split: no velocity in this test
source_form  = full     # full | ovc (the O(v/c) control of T4/T4b)
f_source     = cell    # cell | wb (the interface F source, sect. 13)
closure      = m1
e_floor      = 1.0e-30
subcycle     = true
opacity      = const
kappa_p      = 0.0      # pure scattering: no emission, no absorption
kappa_e      = 0.0
kappa_f      = 0.0
kappa_s      = 128.0
coupling     = true
gas_feedback = false    # static medium

# ---- MILESTONE 3a: implicit x1 transport (docs/dev/rad_m1_implicit_design.md).  Listed
# here at their DEFAULTS so that the gate scripts can override them on the command line
# (AthenaK only accepts a command-line override of a parameter the input file names).
transport             = explicit  # explicit | implicit_x1 | implicit
implicit_cfl          = -1.0      # implicit_x1 only: dt = implicit_cfl*dx/c (<=0: off)
implicit_tol          = 1.0e-8
implicit_maxit        = 30
implicit_opac_update  = false
implicit_allow_multid = false
implicit_flux         = central
implicit_flux_faces   = x1
implicit_flux_beam    = closure
implicit_blend_alpha  = 1.0
implicit_blend_r0     = 1.5
implicit_blend_xthin = 0.0
implicit_blend_xthin_mode = all
implicit_blend_xthin_wmin = 0.0
implicit_hr_recon = dc
implicit_hr_recon_fresh = 2
implicit_hr_damp = 0.0
implicit_hr_recon_qs = 0.0
implicit_hr_recon_qs_rel = 0.0
implicit_hr_pos = kill
implicit_accel = none
vet_nmu      = 8
vet_nphi     = 32
vet_source_noesrc = false
vet_tensor   = full
implicit_hr_recon_qs_mode = pass
implicit_hr_recon_pred = false   # central | ap_hll | berthon | blend
implicit_recon        = dc        # dc | plm_dc       (milestone 3a2, LIMIT 1)
implicit_blend        = tau_f     # tau | f | tau_f   (milestone 3c, blend weight)
implicit_blend_fmode  = max       # max | mean        (3c: f_face from the two cells)
implicit_blend_mode   = flux      # flux | dissipation (3c: what is blended)
implicit_blend_tau0   = 1.0       # 3c: w = exp(-(tau_face/tau0)^2)
implicit_blend_flo    = 0.6       # 3c: smoothstep lower edge in the reduced flux
implicit_blend_fhi    = 0.9       # 3c: smoothstep upper edge in the reduced flux
implicit_partition    = none      # none | gather
implicit_solver       = bicgstab  # 3b phase B: line_jacobi (bicgstab n/a)
implicit_lin_tol      = 1.0e-10   # 3b phase B: residual of the 7-point system
implicit_recon_w      = -1.0      # plm_dc weight; <=0 = auto 1/(1+chat dt/dx)
implicit_recon_lag    = picard     # step | picard (when the plm correction is re-made)
implicit_recon_npass  = -1        # 3c: freeze the plm correction after N passes
implicit_res_floor    = 0.0       # Picard residual scale (0 = the 3a pure |dE|/E)
implicit_bmom_half    = false     # boundary momentum (milestone 3a2, LIMIT 3)
marshak_q             = 0.5
implicit_bc_x1min     = auto      # auto|marshak|flux|reflect|periodic|efix
implicit_bc_x1max     = auto
implicit_flux_x1min   = 0.0
implicit_flux_x1max   = 0.0
implicit_ebath_x1min   = 0.0
implicit_ebath_x1max   = 0.0

<problem>
pgen_name   = rad_m1_beam
m1_test     = thick_pulse
gas_rho     = 1.0
gas_eint    = 0.01
pulse_amp   = 1.0
pulse_width = 0.05
pulse_x0    = 0.5
pulse_y0    = 0.0
pulse_z0    = 0.0
pulse_bg    = 1.0e-8
pulse_1d    = true
nyquist_amp = 0.0

<output1>
file_type   = bin
variable    = m1
dt          = 0.025
