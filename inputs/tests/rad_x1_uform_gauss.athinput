<comment>
problem = UNIFIED super-time-stepped radiative diffusion of a 3D anisotropic Gaussian
# THE SPLIT OPERATOR (rad_implicit_x1 + rad_implicit_ang) on the test problem of
# <hydro>/rad_sts_all, which is where <hydro>/rad_x1_uform and rad_x1_kiter live.
# Everything below is that input with the three operator switches flipped; see
# tst/test_suite/rad/test_rad_x1_uform_cpu.py.
#
# The test problem of <hydro>/rad_sts_all (conduction_transverse.cpp,
# Conduction::StsConductionUpdate): ONE RKL1 loop over x1, x2 and x3, replacing the split
# of an implicit tridiagonal x1 solve (rad_implicit_x1) and the RKL1 transverse operator
# (rad_implicit_ang).
#
# A Cartesian box at rest with a 1e-4 Gaussian temperature perturbation spread in BOTH x1
# and x2, with DIFFERENT widths (sig1 = 1.5 sig0), and uniform in x3 -- so both directions
# the split would have treated separately carry flux, and a different amount of it.  At
# that amplitude the radiative conductivity is constant to a few parts in 1e4, so the
# perturbation obeys dT/dt = D grad^2 T and the exact solution is the product of two
# spreading Gaussians.  x2/x3 are periodic; x1 is closed by ZERO-FLUX (reflecting) walls,
# and a blob centred on the midpoint of a symmetric interval has its Neumann images at
# exactly the periodic positions, so the reference is exact there too.
#
# THE TIMESTEP.  rad_sts_all drops the conduction constraint in all three directions, so
# dt is the hydro CFL: the test harness scales cfl_number with 1/n, which holds
# dt proportional to dx^2 -- what makes a first-order-in-time RKL1 super-step converge at
# the 2nd order of the spatial stencil -- and sets the step at ~100x the explicit
# diffusion limit at nx = 32.  The same input with rad_sts_all = false,
# rad_implicit_x1 = true, rad_implicit_ang = true runs the SPLIT operator at exactly the
# same timestep, which is the comparison the regression test makes.
# Errors against the analytic solution go to sts3d-errs.dat.

<job>
basename = sts3d

<mesh>
nghost   = 2
nx1      = 32
x1min    = -0.5
x1max    = 0.5
ix1_bc   = reflect
ox1_bc   = reflect
nx2      = 32
x2min    = -0.5
x2max    = 0.5
ix2_bc   = periodic
ox2_bc   = periodic
nx3      = 4
x3min    = -0.0625
x3max    = 0.0625
ix3_bc   = periodic
ox3_bc   = periodic

<meshblock>
nx1      = 32
nx2      = 32
nx3      = 4

<time>
evolution  = dynamic
integrator = rk2
cfl_number = 0.00465
nlim       = -1
tlim       = 0.00045

<hydro>
eos         = ideal
reconstruct = plm
rsolver     = hllc
gamma       = 1.666667
isotropic_conduction = radiative
rad_pcut_bar     = 0.0
rad_flux_limit   = false
rad_kappa_fac    = 0.002
rad_flux_inner   = 0.0
rad_met          = 0.0
rad_sts_all      = false
# the three switches ON the super-time-stepped operator, at their defaults here so the
# regression test can flip them from the command line: rad_sts_split moves the part of
# each face conductance the step can carry explicitly into the ordinary face fluxes,
# rad_sts_once applies the RKL1 operator once per cycle over the full dt instead of once
# per stage, and rad_sts_margin is the round-off margin on its substage count.
rad_sts_split    = false
rad_sts_once     = false
rad_sts_margin   = 0.10
rad_implicit_x1  = true
rad_implicit_ang = true
rad_ang_verbose  = false
# THE TWO SWITCHES UNDER TEST, at their defaults so that the regression test can flip
# them from the command line: rad_x1_uform solves the radial column for du = d(T^4)
# instead of dT, and rad_x1_kiter re-evaluates kappa_R (and c_v, and the face T^3) at the
# updated state and re-solves, that many times.
rad_x1_uform     = false
rad_x1_kiter     = 1
rad_x1_verbose   = false
rad_x1_every     = 1

<units>
length_cgs = 1.0e8
mass_cgs   = 1.0e18
time_cgs   = 527.0
mu         = 2.3

<problem>
pgen_name = rad_diff2d
d0    = 1.0
p0    = 1.0
amp   = 1.0e-4
sig0  = 0.09375
sig1  = 0.140625
nan_report = true
