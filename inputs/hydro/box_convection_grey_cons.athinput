# THE CONSERVATION TEST for the plane-parallel two-stream and its tau blend.
#
# Same physics as box_convection_grey_atm.athinput -- grey, constant kappa = 0.4 cm^2/g,
# g = 1e4, mu = 0.6, ideal gamma = 5/3, Teff = 5000 K -- but DEEPER (tau = 1000 at the
# bottom wall, column mass 2500 g/cm^2) so that all three regions the scheme distinguishes
# exist at once and are many cells wide:
#     tau > 100      radiative DIFFUSION alone (blend weight w = 1), 128 cells
#     tau 10 - 100   the HANDOVER, w ramping 1 -> 0, 74 cells
#     tau < 10       the TWO-STREAM alone (w = 0), 118 cells
# and it starts FROM the analytic steady state rather than relaxing to it:
#
#     python3 tools/box_convection/mk_eddington_column.py edd_column.txt
#
# writes the exact Eddington column and problem/ic_profile reads it.  The state is
# therefore already the answer, so d(E_column)/dt MUST be zero to the accuracy of the
# emergent flux, and anything else is the scheme's own book-keeping error -- which is how
# the handover bug was found and is what this input guards.  Measure
#     E(t) = sum (eint + rho v^2/2 + rho g z) dz
# from the tab dumps and divide its time derivative by F = sigma Teff^4 = 3.544e10.
#
# WHAT IT SHOULD GIVE: |dE/dt| <~ 0.01 F once the first dump has passed (the thin layers
# relax off the Eddington profile onto the two-stream's own, slightly cooler, equilibrium
# in well under one dump interval), and NO persistent deposit in the tau 10-100 layer.
# Before the handover fix it gave +0.098 F, 68 % of it inside tau 10-100, for ever.
#
# Build:  cmake -B build -D PROBLEM=box_convection && make -C build -j
# Run:    python3 tools/box_convection/mk_eddington_column.py edd_column.txt
#         build/src/athena -i inputs/hydro/box_convection_grey_cons.athinput

<comment>
problem = grey plane-parallel atmosphere, two-stream RT conservation test

<job>
basename = grey_cons

<mesh>
nghost = 2
nx1    = 320
x1min  = 0.0
x1max  = 1.58528599e9
ix1_bc = user
ox1_bc = user
nx2    = 1
x2min  = 0.0
x2max  = 1.58528599e9
ix2_bc = periodic
ox2_bc = periodic
nx3    = 1
x3min  = 0.0
x3max  = 1.58528599e9
ix3_bc = periodic
ox3_bc = periodic

<meshblock>
nx1 = 320
nx2 = 1
nx3 = 1

<time>
evolution  = dynamic
integrator = rk2
cfl_number = 0.3
nlim       = -1
tlim       = 4.0e3
ndiag      = 2000

<units>
length_cgs = 1.0
mass_cgs   = 1.0
time_cgs   = 1.0
mu         = 0.6

<hydro>
eos         = ideal
gamma       = 1.6666666667
reconstruct = plm
rsolver     = hllc
dfloor      = 1.0e-16
pfloor      = 1.0e-8
# the opacity, the bottom flux and the deep handover to radiative diffusion
isotropic_conduction = radiative
rad_kappa_src        = table_rho
rad_kappa_fac        = 1.0
rad_flux_inner       = 3.543984012e10
rad_flux_limit       = true
rad_implicit_x1      = true
rad_tau_lo           = 10.0
rad_tau_hi           = 100.0

<problem>
rt_relax_sub   = 1                       # sub-cycled local relaxation of the RT source;
rt_relax_xcrit = 1.0                     # 1 = the single-step form, bit for bit.  Stated
rt_relax_submax = 32                     # here so the switch is reachable from the
                                         # command line on this test (an override of a
                                         # parameter absent from the input is fatal).
user_srcs    = true
g0           = 1.0e4
mu           = 0.6
rho_base     = 6.8936526e-6
t_base       = 26170.238
dgrad        = -0.20
vpert        = 0.0
bc_mode      = 2
opac_table   = inputs/hydro/kappa_const.txt
ic_profile   = edd_column.txt
rt_two_stream = true
rt_semi_implicit = true
rt_semi_lin   = false
rt_explicit   = false
rt_newton     = true
rt_rescue_eq  = true
rt_src_direct = true
rt_top_clamp  = true
rt_use_cons   = true
rt_bface      = true
rt_de_max     = 0.5
rt_int_at_cut = false
rt_top_vacuum = true
rt_nquad      = 2
column_dump   = cons_column.txt
rt_dump_file  = cons_rtcol.txt

<output1>
file_type = tab
variable  = hydro_w
data_format = %24.16e
dt        = 2.0e2
slice_x2  = 7.9264e8
slice_x3  = 7.9264e8

<output2>
file_type = hst
dt        = 1.0e2
