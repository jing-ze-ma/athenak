# ========================================================================================
# he4_presn on the CUBED SPHERE: the envelope of the 4 Msun presupernova HELIUM STAR of
# Woosley (2019) -- M = 3.15 Msun remaining, L = 60256 Lsun, Teff = 48978 K,
# R = 2.3717e11 cm -- from 0.50 R to the tau = 1e-2 level, with the iron-opacity-peak
# convection zone (FeCZ) resolved.  Build with -DPROBLEM=red_giant.
#
# Derived from inputs/hydro/red_giant_cs.athinput (the cubed-sphere template) with the
# star, EOS, opacity and boundary parameters of bench/hestar_presn/GAP_ANALYSIS.md
# sections C, D and E, and the RT switches of bench/hestar_fecz/box_w8/he_box_w8.athinput
# (the plane-parallel FeCZ box production).  EVERY line that differs from one of those two
# carries the reason.
#
# THE STRUCTURE (bench/hestar_presn/column_he4_presn.txt, columns z p T rho kappa nabla
# nabla_ad nabla_rad tau v_mlt Hp N2 Prad/Pgas):
#   r_in   = 1.18585e11 (0.50 R): the 0.40-0.50 R layer holds 6.6 Hp of strongly
#          stable 0.24-1.06 MK gas and only costs cells and timestep, so the inner wall
#          was moved out on 2026-09-17.  One Hp / two H_rho of stable buffer, with a
#          Brunt period of about one turnover, remain below the FeCZ base at 0.635 R.
#   FeCZ   = tau 349 .. 11.8; kappa peaks 0.839 at tau = 157.  On the SPHERICAL
#          column (column_he4_presn_sph.txt) its base is at 0.635 R = 1.506e11 cm,
#          not at the plane-parallel column's 1.006e11
#   photosphere tau = 2/3 at 2.3717e11; x1max = tau = 1e-2 at 2.4057e11, p = 7.51e3
#   MLT peak v = 1.25e7 cm/s (Ma 0.455), Prad/Pgas = 56, kappa F/(c g) = 1.23 -- the
#   envelope is SUPER-EDDINGTON, which is why rt_rad_force and an open top are mandatory
#   turnover Hp/v = 4.705e3 s ON THE SPHERE (the plane-parallel column's 6.06e3 is
#          not the right number for this geometry); this input runs 5 turnovers.
#
# THIS IS THE SMOKE GRID of GAP_ANALYSIS section E (one node, 2 MI300A, minutes), not the
# production grid: nx1 = 96, nx2 = nx3 = 32 per panel, 6*32^2*96 = 5.9e5 cells.

<comment>
problem   = 4 Msun presupernova He star envelope, cubed sphere
reference = Woosley 2019; bench/hestar_presn/GAP_ANALYSIS.md

<job>
basename  = he4

# WEDGE SIZING (2026-09-19, from the initial column): the MLT zone spans 0.635-0.967 R but only
# 2.9 Hp; Hp = 0.28 R (25 deg) at its base, 0.245 R (17 deg) at the opacity peak 0.82 R,
# 0.052 R (3.2 deg) at 0.93 R, 0.0039 R (0.22 deg) at tau = 2/3.  The deep cells are tens of
# degrees wide, so the wedge is 90 x 90 deg (3.5-5 Hp at the peak); 256^2 = 0.35 deg/cell gives
# 49 cells/Hp at the peak, 9 at 0.93 R, 0.6 at the photosphere (surface granulation unresolved).
<mesh>
nghost    = 3                # 3, not the red giant's 2: FOFC with plm reconstruction
                             # needs three ghost zones (src/hydro/hydro.cpp:287)
nx1       = 96               # RADIAL; nx1 + 2*nghost = 102 <= 520, the largest column
                             # tier the grey sweep dispatches on
x1min     = 1.18585e11       # 0.50 R (see the header): one Hp of stable buffer below
                             # the FeCZ base at 0.635 R
x1max     = 2.4057e11        # the tau = 1e-2 level (the column's own tau = 1e-3 top,
                             # 2.4180e11, leaves no room for the unresolved ghost column)
# The polynomial radial stretch refitted TO THIS STAR with
#   tools/grid/fit_radial_stretch.py \
#       bench/hestar_presn/column_he4_presn_sph.txt 1.18585e11 2.4057e11 --dumin 0.47 \
#       --nx 96
# REFIT on 2026-09-17 for the new r_in; the SPHERICAL column (r in column 0 already) is
# the right structure to fit here, not the plane-parallel one.  --dumin 0.47 keeps the
# SAME smallest cell as the 0.40 R grid did: 0.47*(x1max-x1min)/96 = 5.97e8 cm, i.e. the
# 6e8 cm floor, which is also the smallest min(Hp,H_rho) in the domain.  du/dxi now stays
# in [0.47, 1.81] -- far gentler than the [0.40, 5.24] of the 0.40 R fit, because the
# deep, strongly stratified layer that forced the stretch is gone -- so the map is
# monotonic and Mesh accepts it.  The domain spans 8.6 density scale heights; the fit
# delivers 23 cells per scale height at the median, 1.3 at the worst (the top few cells,
# where the floor binds).  REFIT if the star, the domain or nx1 changes.
use_grid_stretch_r_poly = true
f_stretch_r_c1 = +0.134559
f_stretch_r_c2 = +4.942505
f_stretch_r_c3 = -8.950106
f_stretch_r_c4 = +4.403042
ix1_bc    = user
ox1_bc    = user
nx2       = 256   # THETA: 90 deg wedge pi/2 +- 45 deg, periodic (both faces have the same sin theta)
x2min     = 0.7853981634
x2max     = 2.3561944902
ix2_bc    = periodic
ox2_bc    = periodic
nx3       = 256   # PHI: 90 deg, periodic
x3min     = 0.0
x3max     = 1.5707963268
ix3_bc    = periodic
ox3_bc    = periodic
use_spherical_polar = true   # WEDGE variant of he4_presn_cs.athinput (2026-09-19)

<meshblock>
nx1       = 96               # MUST equal mesh/nx1: the mode-3 column solve, the shell
nx2       = 32               # 8 blocks per line = the ADI limit NADIB
nx3       = 32               # 8*8 = 64 MeshBlocks of 96x32x32

<time>
evolution  = dynamic
integrator = rk2
cfl_number = 0.3
nlim       = -1
tlim       = 2.3525e4        # 5 turnovers at the SPHERICAL Hp/v = 4.705e3 s
ndiag      = 100
nan_check_cycles = 100

<units>
length_cgs = 1.0             # the two-stream and the opacity table are cgs throughout
mass_cgs   = 1.0
time_cgs   = 1.0
mu         = 1.0

<hydro>
eos             = general
general_eos     = table
gamma           = 1.6666666667   # unused by the table
# --- the He composition.  X = 0 (there is no hydrogen left), Y = 0.98, Z = 0.02, which is
# what the opacity table below is tabulated at.
eos_xh               = 0.0
eos_yhe              = 0.98
eos_h2               = false     # no hydrogen, so no H2
eos_metal_ionization = false     # dead code at X = 0 (the donor pool is gated on nh_tot)
eos_ionization       = true      # He I -> II -> III is the whole ionization budget
eos_radiation        = true      # Prad/Pgas = 56 at the MLT peak: the radiation field IS
                                 # the pressure here, unlike the red giant this file came
                                 # from (which sets it false)
eos_logd_min    = -13.0          # the domain spans log rho = -10.24 (top) .. -8.47 (r_in)
eos_logd_max    = -3.0
eos_logt_min    = 3.8            # and log T = 4.62 (top) .. 5.29 (r_in)
eos_logt_max    = 6.5
eos_dlog        = 0.02
# --- THE EOS RADIATION TAPER, the other half of problem/rt_rad_force.  w = 1 (full LTE
# aT^4 in the gas) at rho >= rad_rho_hi, w = 0 at rho <= rad_rho_lo.  The two densities are
# read off column_he4_presn.txt at tau = 3.00 and tau = 0.30, i.e. the taper is one
# half-decade wide, sits ENTIRELY ABOVE the FeCZ (which ends at tau 11.8) and straddles the
# photosphere, which is exactly where the two-stream takes the radiation over from the gas.
eos_rad_rho_hi       = 1.93e-9   # rho at tau = 3.00 (r = 2.3386e11)
eos_rad_rho_lo       = 4.97e-10  # rho at tau = 0.30 (r = 2.3823e11)
# --- THE TEMPERATURE GATE ON THAT TAPER (tests_r8).  w is raised to max(w_rho, w_T), with
# w_T = 1 at and above eos_rad_t_hi and 0 at and below eos_rad_t_lo, so that a cell hotter
# than the tau = 3 layer keeps the full LTE aT^4 in its EOS -- and the pressure gradient
# rather than kappa F/c as its radiative force -- WHATEVER its density does.
# WHY THIS IS NEEDED.  w(rho) alone is not the statement the taper means to make.  The FeCZ
# here has a DENSITY INVERSION whose minimum, 2.34e-9, sits only 1.21x above rad_rho_hi, so
# a cell that a panel-seam flux error thins by half a decade lands INSIDE the window at
# tau ~ 150 and is handed the optically-thin surface force, kappa F/(c g) = 1.23, in the
# middle of the convection zone; it then evacuates further.  That loop killed every 3-D arm
# of tests_r6 at 1.04-1.08 turnover and the 1-D column at 1.19 (11 of 11 collapses on a
# panel-seam row, tests_r7 sections 2 and 5), and rt_rad_force = false was the only switch
# that removed it.  T(r) is monotone through the inversion where rho(r) is not, which is
# what makes it the right gate variable; it is also the only stratification variable the
# EOS has in hand at every one of its ~150 evaluation sites (see rad_taper.hpp).
# The two temperatures are the run's OWN table T at the SAME two optical depths the density
# window came from, printed by hestar_presn/make_ic_sph.py, which builds the ic with this
# same w -- the gate must be identical in the EOS, in the force and in the ic.
eos_rad_t_hi         = 6.3281e4  # T_table at tau = 3.00 (r = 2.33866e11, T_col 6.3246e4)
eos_rad_t_lo         = 4.5213e4  # T_table at tau = 0.30 (r = 2.38258e11, T_col 4.5192e4)
reconstruct = plm
rsolver     = lhllc              # all-Mach HLLC: at Ma = 0.46 plain hllc's pressure
                                 # diffusion would eat the buoyancy forcing
etotgrav    = true
fofc        = true               # first-order flux correction; the cube vertices need it
wellbalance_dynamic = true
wellbalance_static  = false      # the alternative: background = the initial column (red_giant.cpp); needs dynamic = false
wellbalance_static_reconst = false
wb_x1               = true
wb_option           = polytropic # the stratification is radiative, not isentropic
wb_cache_every      = 0          # REBUILD EVERY STAGE.  A stale background numerically
                                 # drives the surface f-mode (2026-09-16); do not raise it.
isotropic_conduction = radiative
rad_kappa_src        = table_rho # the He Rosseland table is on (T, rho)
rad_kappa_fac        = 1.0
rad_flux_inner       = 0.0       # MUST be 0 with inner_bc = open: the luminosity enters as
                                 # the ENTROPY of the inflow, and both would double count.
                                 # (Under the 20/300 handover it becomes 1.305278e15 with
                                 # inner_bc = wall and rt_bottom_flux = false; see above.)
rad_flux_limit       = true
# --- THE OPTICAL-DEPTH HANDOVER.  20/300, NOT the He box's whole-column 1e5/1e6.
# The grey two-stream's spherical form (commit 1159a8f3) transports J = A I with source
# A B, which is EXACT in the transparent limit but adds a spurious term in the DIFFUSION
# limit: with J = A I the scheme's implied intensity equation is
#     mu dI/dr = -kappa rho (I - B) - 2 mu I/r,
# so its two-stream first moment gives F_2s = -(mu/(kappa rho)) [dB/dr + 2B/r] and
#     F_2s/F_exact = 1 - H_T/(2 r),     H_T = T/|dT/dr|,
# while the exact first moment (Eddington f = 1/3) has no such term.  Deep in this star
# H_T/r is 0.3-1.7, so the error is O(1) and can change sign; MEASURED on the arm-D t = 0
# budget (tests_3d/mlt/D/mltfaces_D.txt) the prediction matches F_2s/F_raddiff to 1-4 % at
# every face from 0.50 to 0.98 R.  With 1e5/1e6 the two-stream owned all 96 cells and
# carried only 0.10-0.74 of L over 0.55-0.90 R; arms A, B and D all died at r/R = 0.672,
# t = 1723 s, in the Schwarzschild-STABLE layer where that hole sat.
# 20/300 hands the interior back to Rosseland diffusion, which carries 0.85-1.07 of L on
# the same state.  MEASURED t = 0 budget (tests_3d/handover/H1): (F_cond + (1-w) F_2s)/F_req
# = 0.99 over 0.50-0.67 R -- the stable-layer hole is CLOSED -- and 0.74-0.91 over
# 0.72-0.90 R, which is a Schwarzschild-UNSTABLE layer, i.e. the residual is the convective
# flux the shell-mean MLT closure below exists to supply.  Above tau = 20, where the
# two-stream owns the column, 1 - H_T/(2r) is 0.96-0.97, so the spherical-form error there
# is 3-4 %.  5/50 and 50/1000 were both measured and are worse (tests_3d/handover/README):
# 5/50 pins w = 1 out to 0.94 R, into the regime where Rosseland is invalid (F_raddiff/F_req
# = 1.28); 50/1000 leaves w = 0.69 at the bottom face and the interior still on the sweep.
# rt_impl_mixed = 0 and ck_nquad = 4 were measured and change the face budget by nothing at
# all, so the deficit is the spherical form and not the column solver.
# STATUS 2026-09-17: 20/300 is NOT YET THE DEFAULT.  Its t = 0 budget is much better than
# the whole-column blend's, but the only DYNAMICAL test of it so far is WORSE: arm BH
# (tests_3d/handover/BH, 20/300 + inner_bc = wall + mlt_alpha = 0, the pure-transport test)
# dt-collapsed at t = 1242 s = 0.26 turnovers against arm B's 1723 s = 0.36, one node
# DEEPER (r/R = 0.633, the FeCZ base, vs 0.672), with 1.1e6 dfloor hits where arm B had
# none, and L_out/L falling monotonically 0.93 -> 0.34 with no floor where arm B recovered
# and held 0.66-0.72.  The reading is that the live conduction operator carries more flux
# INTO the FeCZ base while the top still cannot transport it away.  Arm DH (the same with
# mlt_alpha = 1.5, so the Schwarzschild-unstable residual is supplied) is the run that
# decided it, and it FAILED HARDER: DH died at t = 998 s = 0.21 turnovers, the worst of the
# four arms run on this grid (DH 0.21 < BH 0.26 < B 0.36 = D 0.36), by a one-cycle
# detonation at r/R = 0.662 -- dt 4.94 s -> 7.2e-15 s in a single step, the cell on BOTH
# floors with v1 = -9.4e22 cm/s, and the cut face passing 8.0e3 times its share of L.  So
# 20/300 has two dynamical tests against it and none for it, and this file keeps the
# whole-column blend.  The suspected mechanism, NOT confirmed: the MLT deficit closure
# subtracts the BLENDED conduction flux (F_cond = w*F_raddiff, verified in the t = 0 dumps)
# while the two-stream contributes its UNBLENDED flux at the same face, so around w ~ 0.94
# the same flux is handed in twice at the cut.  If the handover is retried, that double
# count is the first thing to fix.  See tests_3d/handover/README.md.
rad_tau_lo  = 1.0e5              # WHOLE-COLUMN TWO-STREAM, as in the He box: the deepest
rad_tau_hi  = 1.0e6              # cell has tau = 362, so w(tau) = 0 on every face, the
                                 # radial diffusion operator is inert and the grey
                                 # two-stream owns all 96 cells.  Its cost is the budget
                                 # hole documented above; its virtue is that it lives longer.
rad_implicit_x1      = true      # inert under that blend, but it is what makes the blend
rad_x1_uform         = true      # safe to move; u-form + one Picard correction for
rad_x1_kiter         = 2         # d ln kappa/d ln T (worst-face error 50 % -> 5 % on He)
rad_blend_transverse = false     # OPEN QUESTION, left as it was.  This value was chosen
                                 # for the WHOLE-COLUMN blend, where w = 0 everywhere and
                                 # true would have switched horizontal radiative transport
                                 # off entirely.  With the LIVE 20/300 blend above w is ~1
                                 # in the deep interior, so false now means the transverse
                                 # conductances are UNWEIGHTED there.  It does not affect
                                 # the radial face budget and was not changed, but the
                                 # right value for a live blend has not been measured.
rad_gate_rho         = 4.97e-10  # = eos_rad_rho_lo: no transverse diffusion below the
                                 # density at which the two-stream owns the radiation
# --- THE TRANSVERSE OPERATOR.  The IMPLICIT (ADI/lod2) transverse radiative diffusion,
# as the He box productions run it.  It was a startup fatal on the cubed sphere until the
# `cs-implicit-transverse` branch generalised BuildAngularCoeffs to the gnomonic metric
# (face area, arc length, 1/sin(alpha) and the explicit cross term through cap_g2/cap_g3,
# with the operator dividing by the cell volume); see docs/dev/cs_implicit_transverse.md.
# The ADI lines are an OPEN CHAIN of blocks per panel, not a periodic ring.
rad_implicit_ang = true
rad_ang_solver   = adi           # alternating-direction implicit, tridiagonal x2/x3 lines
rad_adi_scheme   = lod2          # Richardson-extrapolated LOD: second order in the step
rad_ang_maxit    = 400           # the cubed-sphere cross-term outer iteration cap
rad_sts_perplane = true
# (rad_cap_ang, the explicit stiffness cap of the old fallback, is REMOVED: it and
# rad_implicit_ang are two treatments of the same operator and the code refuses both.)
tfloor  = 5.0e3                  # rt_use_cons clamps a non-positive e to e(rho, tfloor).
                                 # 5e3 K is BELOW the table's own lowest row (10^3.8 =
                                 # 6310 K) and was therefore UNREACHABLE: every sub-table
                                 # inversion is clamped to 6310 K first, so the tfloor
                                 # counter read 0 for the whole of arm B'/E' while the
                                 # clamp fired throughout.  efloor_as_tfloor below raises
                                 # it to the table edge at startup and says so.
dfloor  = 1.0e-13                # the EOS table's own lower edge (eos_logd_min = -13); the
                                 # initial top cell is 5.71e-11, so this is 5.7e-3 of it
# THE FLOORED CELL KEEPS ITS VELOCITY, AND A VELOCITY CEILING SIZED TO THE FeCZ.
# Arms E''/F'' of tests_r5 both died on a cell that had been EVACUATED, not mis-inverted:
# F'''s collapsing cell sat at rho = dfloor = 1e-13 EXACTLY (local rho 2.3e-9, i.e. four
# decades down) with v1 = m/dfloor = 6.4e12 cm/s = 212 c.  dfloor is 5.7e-3 of the initial
# TOP cell but only 4.3e-5 of the FeCZ, so inside the layer a cell can be emptied by four
# decades before any floor notices, and the default (dfloor_keep_velocity = false) then
# raises rho and leaves the MOMENTUM alone -- which is what manufactures the 212 c.
# With this on the momentum is scaled with the density, so a floored cell keeps the
# velocity it had instead of acquiring m/dfloor.  Both switches are implemented for
# cubed-sphere hydro and both are DEFERRED to Coordinates::GnomonicEquiangleRaiseVel,
# where |v| and the kinetic energy are the metric ones (ConsToPrim only DECIDES).
dfloor_keep_velocity = true
# vceil = 1e8 cm/s = 1.4 c_s at the FeCZ (c_s ~ 7.7e7) = 7 v_MLT (1.45e7): above anything
# physical in this star, 60x below the 6.4e12 cm/s F'' reached, and 6x below v_esc.  The
# eos_vceil column of the event log says how often it fires; a LARGE count means the
# ceiling is doing physics rather than catching a numerical runaway, and is a warning.
vceil   = 1.0e8
# THE CLIPPED KINETIC ENERGY: deleted (false, the historical behaviour) or turned into
# internal energy (true).  With it off the ceiling is an uncounted energy SINK -- it took
# 9.7e40 erg, twice the envelope's internal energy, out of the arms that reached it, and
# d(tot-E)/dt then no longer matches L_in - L_out.  With it on the total energy is
# conserved through the ceiling and the clipped energy heats the cell it came from.  The
# vceil_de column of the event log gives the size of it either way.
vceil_thermalise = false
pfloor  = 1.0e-1                 # 1.3e-5 of the initial top-cell pressure; should not fire
# THE FLOORED STATE MADE CONSISTENT.  See the note on EOS_Data::efloor_as_tfloor.  Arm E'
# died at 0.78 turnover on a cell at r/R = 0.744 carrying rho = 3.5e-9, code T = 5.246e11
# and p = 459: that is NOT an EOS-inversion failure -- 5.246e11/8.314e7 = 6310 K is the
# table's lowest tabulated temperature exactly, and p = rho R T / mu with mu = 4.03 is
# neutral helium at that temperature.  The cell is at the CLAMP, and the hazard is that
# its p, Gamma_1 and sound speed are the clamp row's while its conserved energy is that
# of a colder gas.  With this on the energy is reset to e(rho,T) for the temperature that
# was settled on, so the cell re-inverts to the same T and every consumer agrees.
efloor_as_tfloor = true
# PAY FOR THE ENERGY FLOOR OUT OF THE KINETIC ENERGY, not out of nothing.  Off here so
# that the arm tables of tests_r5 mean what they say; it is the next thing to try, because
# arms E'/E'' both die on a cell whose |v1| has already reached 1e9-2e10 cm/s, i.e. one
# where e = E - e_kin is negative and the floor donates the cell's whole kinetic energy
# back into the acceleration that emptied it.  See EOS_Data::efloor_from_ekin.
efloor_from_ekin = false

<problem>
user_srcs   = true
# --- the star (GAP_ANALYSIS section C).  On the cubed sphere problem/rin is NOT read:
# the inner radius IS mesh/x1min = 1.18585e11.
mstar       = 6.2651e33          # 3.15 Msun remaining
lstar       = 2.3066e38          # 60256 Lsun
teff        = 48978.0
ptop        = 7.51e3             # RESTORED to the column's own p(tau = 1e-2).  The
                                 # 9.00e3 this file carried until 2026-09-17 was a hack
                                 # to get past the pgen's "no gas solution at the outer
                                 # wall" refusal (a T^4/3 = 7.26e3 is 97 % of 7.51e3 at
                                 # the grey tau = 0 temperature, and the march refuses a
                                 # top with a T^4/3 > 0.9 ptop).  With problem/ic_profile
                                 # below the march and that check are both SKIPPED, so
                                 # ptop is now READ AND UNUSED -- it is kept at the honest
                                 # value so the file documents the star.
# --- THE INITIAL STRATIFICATION.  Three columns "r[cm] rho eint" ascending in r, built
# OFFLINE by bench/hestar_presn/make_ic_sph.py against THIS run's own table: at each node
# T solves p_gas_table(rho,T) + a T^4/3 = p_column(r) -- hydrostatic balance with the
# UNTAPERED radiation -- and eint is then e_gas(rho,T) + w(rho) a T^4 with the taper
# above applied at fixed (rho,T).  The (1-w) a T^4/3 the taper removes is carried by
# problem/rt_rad_force.  15999 nodes over 8.30e10 .. 2.43e11 cm, which covers this mesh
# and its radial ghosts with margin.  rho is NON-MONOTONE over 0.72-0.95 R (a physical
# density inversion, contrast 3.9); the reader searches on r, so that is fine.
ic_profile  = /viper/u2/jinma/ATHENAK/bench/hestar_presn/ic_he4_presn_sph.txt
mu          = 1.3423             # fully ionized He + Z; used only by the pgen's own march
opac_table  = /viper/u2/jinma/ATHENAK/bench/hestar_fecz/rosseland_he_x0.0_z0.02.txt
                                 # the X = 0, Z = 0.02 OPLIB He table, as in the He box
column_dump = column_he4_ic.txt  # the IC, for comparison against column_he4_presn.txt
# --- the initial column.  mlt_alpha = 0: convection is RESOLVED, not modelled.  But the
# column itself must be built with the mixing length, or it is adiabatic wherever the
# Schwarzschild criterion bites and carries no flux; alpha = 1.5 is the value the MESA
# model was computed with (column header).  ic_tau_rad is ESSENTIAL here: the pgen
# defaults it to rad_tau_hi, which the whole-column blend has pushed to 1e6, and the whole
# star would then be built RADIATIVE and have no convection zone at all.  10 is the usual
# handover, well above the FeCZ top (tau 11.8).
# With problem/ic_profile set, mlt_alpha_ic and ic_tau_rad no longer shape the initial
# structure at all -- they only enter the gradient and convective velocity REPORTED in
# column_dump (and problem/vpert_mlt, which is off).  They are kept at the values the
# MESA model was computed with so the report is meaningful.
mlt_alpha    = 0.0               # convection RESOLVED, not modelled.  Set to 1.5 TOGETHER
                                 # with the 20/300 handover (see the block above): the
                                 # residual that handover leaves at t = 0 (0.09-0.26 of L
                                 # over 0.72-0.90 R) is in Schwarzschild-UNSTABLE shells,
                                 # which is what the shell-mean deficit closure exists to
                                 # supply.  Under the whole-column blend the hole was in the
                                 # STABLE layer instead and no convective closure could
                                 # legally fill it -- see tests_3d/mlt/README.md, arm D.  MEASURED 2026-09-17: doing so on
                                 # the 20/300 handover (arm DH) is WORSE than not doing it
                                 # (arm BH) -- 0.21 turnovers against 0.26, with 19 FOFC
                                 # fallbacks and a one-cycle detonation at the handover
                                 # radius.  See tests_3d/handover/README.md.
mlt_alpha_ic = 1.5
ic_tau_rad   = 10.0
# The SUB-GRID convective flux (problem/mlt_alpha > 0) and its hand-over to the resolved
# flow.  Listed here, not left to their defaults, so tests_3d/mlt can switch them on from
# the command line.  mlt_alpha = 1.5 turns on the shell-mean closure (mlt_mean, the
# default): each radial face is asked for the DEFICIT L/(4 pi r^2) - F_conduction -
# F_two-stream - F_resolved, so it hands over to resolved convection on its own; the
# ramp-down withdraws it on a schedule regardless.
mlt_mean           = true
mlt_dump           = mltfaces.txt  # the t = 0 face budget: F_req, F_cond, F_2s,
                                 # F_resolved, the deficit D and F_used, per face
mlt_dump_dt        = 0.0         # > 0 [s]: APPEND that table to <mlt_dump>.ts on this
                                 # cadence (diagnostic; 0 = the t = 0 dump only)
cs_max             = 0.0         # cm/s; > 0: sound-speed ceiling as a density floor rho >= (10/9) e_int/cs_max^2
e_ledger           = 0           # cycles; > 0: per-operator energy ledger (single rank)
mlt_split_deposit  = false       # true (with rt_strang): div F_conv in the Strang half steps, with the two-stream
mlt_split_sync     = false       # true (with mlt_split_deposit): one [1 2 1]/4 pass over the
                                 # faces before the closure target enters the relaxed profile.
                                 # Kills the deposit/sweep grid-scale feedback that grows the
                                 # density zigzag at r/R 0.67-0.81 (red_giant.cpp)
mlt_sync_passes    = 1           # only read with mlt_split_sync: number of [1 2 1]/4
                                 # passes over the target.  n passes damp a mode of
                                 # wavelength lambda faces by cos^2n(pi/lambda), so
                                 # n = 1 kills only the face-to-face mode; the 3-6 face
                                 # standing F_2s/F_used oscillation seen in 3-D needs
                                 # n = 4-8 (red_giant.cpp)
mlt_relax_time     = 1.0e4       # 2 turnovers: follow the mean of the resolved flux,
                                 # not its flicker
mlt_ramp_time      = 0.0         # no ramp-UP: the ic was built with alpha = 1.5, so the
                                 # deficit at t = 0 is the flux the column already assumes
mlt_hold_time      = 0.0         # hand-over: full subgrid flux until this time ...
mlt_ramp_down_time = 0.0         # ... then linearly to zero over this time.  0 = held.
# --- THE SEED.  Chart-free (cubic harmonics + random plane waves in Cartesian position,
# so no panel, block or rank enters it) at Mach 1e-3 of the local sound speed, windowed on
# the FeCZ in OPTICAL DEPTH: tau 300 (just above the zone's 349 bottom) to tau 20 (just
# below its 11.8 top), which brackets the kappa peak at tau 157.  The angular band is the
# most unstable scale, ~2 layer thicknesses ~ 2.6e11 cm, i.e. global l ~ 2-6.
vpert       = 1.0e-3
vpert_var   = v1                 # VELOCITY seed (the entropy variant is vpert_var = eint)
vpert_tau_hi = 300.0             # the DEEP edge of the window
vpert_tau_lo = 20.0              # the shallow edge
vpert_cart  = true
vpert_sp_rand = false             # true: vpert_nrand random modes periodic over the wedge (red_giant.cpp)
vpert_sp_kmax = 8                 # |a|,|b| <= kmax waves across the wedge: 8 = 11 deg wavelength on 90 deg
vpert_nrand = 32
vpert_lmin  = 2.5e11             # 2 pi R / 6
vpert_lmax  = 7.4e11             # 2 pi R / 2
vpert_seed  = 1234
# --- BOUNDARIES (GAP_ANALYSIS section D).  Inner: Stein-Nordlund / CO5BOLD deep
# relaxation, so plumes pass through and the luminosity enters as the entropy of the
# inflow.  Outer: hydrostatic continuation at the top cell's own temperature, OUTFLOW ONLY
# -- at kappa F/(c g) = 1.23 the outer layers are unbound and a wall would build a
# standing jump.
inner_bc    = open               # Arms BH/DH use inner_bc = wall together with the 20/300
                                 # handover and hydro/rad_flux_inner (see the block above);
                                 # the deep relaxation s_relax_cs/cp below is inert at a wall.
s_relax_cs  = 0.1
s_relax_cp  = 0.3
outer_bc    = open
open_outer_lid = false           # true: mirror v1 at the top face (no mass crosses); see red_giant.cpp
open_outer_noinflow = true
open_conserve = true
face_budget = 1                  # log what leaves through both radial faces from cycle 0
# --- THE SPONGES.  The tau-based top sponge (ported from the He box) follows the
# photosphere; red_giant's own radius-based sponge stays on underneath the outer wall.
vdamp_top_tau  = 0.1             # f = 1 at tau <= 0.0333, 0 at tau >= 0.1
vdamp_top_time = 20.0
vdamp_bot_cells = 24             # the box uses 48 of its 134 cells; 48 of 96 would trip
                                 # the nx1/2 guard, and 24 is the same FRACTION of the
                                 # radial domain that 48 of the 192-cell production grid is
vdamp_bot_time  = 20.0
vdamp_all_until = 0.0            # > 0: damp v1 everywhere until this time (relaxed-start test)
vdamp_all_time  = 20.0
vdamp_all_mean_only = false      # true: damp only the shell mean of v1 (the radial mode), not the fluctuations
# --- THE GREY TWO-STREAM, mode 3 (the exact block-tridiagonal column solve) with the PCR
# partitioned solver and the warm/mixed accelerators, exactly as box_w8 runs them.  The
# five legacy switches (rt_use_cons, rt_src_direct, rt_top_re, rt_newton, rt_rescue_eq)
# are flipped by the pgen when rt_implicit_column = 3, because the mode-3 gate demands it.
rt_grey            = true
rt_implicit_column = 3
rt_impl_solver     = pcr
rt_impl_nseg       = 32          # segments per column = the Kokkos team size
rt_impl_warm       = 1           # warm-start Newton from the last converged B
rt_impl_mixed      = 2           # single-precision correction and stored factors
rt_impl_tol        = 1.0e-8
rt_impl_maxit      = 8           # the He box measures it_mean = 3
rt_col3_ex_iter    = true        # re-form the explicit source from the column's own flux
rt_ali_diag        = false       # irrelevant under mode 3, and measured worse on He
ck_nquad           = 2           # two-point Gauss-Legendre angular quadrature
rt_de_max          = 0.5
# THE RADIATIVE FORCE.  Mandatory: kappa F/(c g) = 1.23.  It is the momentum the EOS taper
# above took out of the gas, put back as (1-w) rho kappa F/c + Prad grad w; the gravity it
# works against is the pgen's own point mass, g(r) = GM/r^2.
rt_rad_force       = true
# problem/rt_bottom_flux: hand <hydro>/rad_flux_inner to the TWO-STREAM's own lower
# boundary instead of to the conduction wall face.  FALSE here, because inner_bc = open
# injects the luminosity as the entropy of the inflow and the two would double count.  It
# is listed (not left to its default) so that the 1-D relaxation run, which uses
# inner_bc = wall and must inject L somewhere, can switch it on from the command line.
rt_top_vacuum      = false       # top boundary of the two-stream: false = the unresolved
                                 # hydrostatic column above the domain radiating at the top
                                 # cell's T (never read by red_giant before 2026-09-18);
                                 # true = nothing above the domain (x1max sits at tau 1e-2)
rt_bottom_flux     = false       # FALSE, and now for a different reason: with the 20/300
                                 # handover w = 1 at the bottom face, so the two-stream's
                                 # own lower boundary is below its cut and the luminosity
                                 # enters at the conduction wall (hydro/rad_flux_inner)
rt_force_verbose   = 0
# problem/rt_force_tau_gate: gate the force by the OPTICAL DEPTH to the top instead of
# by the taper weight alone.  s = 1 below rt_force_tau_lo, 0 above rt_force_tau_hi, a
# smoothstep in log10 tau between; where s = 1 the force is rho kappa F/c + grad(w Prad)
# and where s = 0 it is the (1-w) form above, bitwise.  Listed (not left to its default)
# so that it can be overridden from the command line.
rt_force_tau_gate  = false
rt_force_tau_lo    = 0.3
rt_force_tau_hi    = 3.0
# OPERATOR SPLITTING: the radiation operator is Strang-split around the time integrator
# (dt/2 before, dt/2 after) instead of applied once per RK stage.
rt_strang          = true
# --- the two diagnostic dumps (see the record layouts in src/pgen/red_giant.cpp)
rt_surface_dt   = 94.1           # 0.02 turnover, the B/He production cadence
rt_surface_file = rt_surface.bin
rt_profile_dt   = 47.05          # 0.01 turnover
rt_profile_file = rt_profile.bin
nan_report  = false

<output1>
file_type  = hst
dt         = 47.0                # 0.01 turnover
data_format = %24.16e

<output2>
file_type  = bin
variable   = hydro_w
dt         = 470.0               # 0.1 turnover

<output3>
file_type  = rst
dt         = 940.0               # 0.2 turnover

<output4>
file_type      = cbin
variable       = hydro_w
coarsen_factor = 2               # 2, not 3: the coarsening must divide EVERY MeshBlock
                                 # dimension and meshblock/nx2 = nx3 = 16
dt             = 235.0           # 0.05 turnover, the movie frames

<output5>
file_type  = log                 # the EVENT LOG: eos_dfloor/efloor/tfloor/vceil,
dt         = 47.0                # eos_fail, the c2p iteration count and the FOFC
                                 # firing count, per 0.01 turnover.  The 3-D gate reads
                                 # eos_fail, the floors and fofc off this file.
