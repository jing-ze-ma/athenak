# AthenaXXX input file for convection test

<comment>
problem   = convection
reference = Leidi et al., A&A, 686, A34 (2024)

<job>
basename  = conv          # problem ID: basename of output filenames

<mesh>
nghost    = 3           # Number of ghost cells
nx1       = 512         # Number of zones in X1-direction
x1min     = -1.0        # minimum value of X1
x1max     = 1.0         # maximum value of X1
ix1_bc    = periodic    # inner-X1 boundary flag
ox1_bc    = periodic    # outer-X1 boundary flag

nx2       = 512         # Number of zones in X2-direction
x2min     = -1.0         # minimum value of X2
x2max     = 1.0        # maximum value of X2
ix2_bc    = periodic    # inner-X2 boundary flag
ox2_bc    = periodic    # outer-X2 boundary flag

nx3       = 512           # Number of zones in X3-direction
x3min     = 1.0        # minimum value of X3
x3max     = 3.0         # maximum value of X3
ix3_bc    = user    # inner-X3 boundary flag
ox3_bc    = user    # outer-X3 boundary flag

<meshblock>
nx1       = 128         # Number of cells in each MeshBlock, X1-dir
nx2       = 128         # Number of cells in each MeshBlock, X2-dir
nx3       = 128         # Number of cells in each MeshBlock, X3-dir

<time>
evolution  = dynamic     # dynamic/kinematic/static
integrator = rk2         # time integration algorithm
cfl_number = 0.3         # The Courant, Friedrichs, & Lewy (CFL) Number
nlim       = 1000000000    # cycle limit
tlim       = 4000.0       # time limit
ndiag      = 1           # cycles between diagostic output

<hydro>
eos             = ideal  # EOS type
reconstruct     = ppm4    # spatial reconstruction method
rsolver         = lhllc   # Riemann-solver to be used
gamma           = 1.666667         # gamma = C_p/C_v
etotgrav = true
wellbalance = true

<problem>
user_srcs = true

<output1>
file_type  = hst         # History data dump
dt         = 100.0        # time increment between outputs

<output2>
file_type  = bin         # Binary data dump
variable   = hydro_w     # variables to be output
dt         = 100.0         # time increment between outputs

