# red_giant (TABULATED EOS): a one-dimensional radial column through the envelope of a red giant branch
# star (1.5 Msun, 500 Lsun, Teff 4000 K, so R ~ 3.2e12 cm = 46 Rsun).  Cartesian x1 is
# r - rin; gravity is the point mass.  Build with -DPROBLEM=red_giant.
#
# This is the HYDROSTATIC + RADIATIVE test: in one dimension nothing can convect, so
# only a column that stays above the radiative-convective boundary has a steady state.
# Read the start-up report for where that boundary and tau = 2/3 sit, and put x1min
# above the former.

<comment>
problem   = red giant envelope column
reference = tools/stellar_opac/merge_rosseland.py for the opacity

<job>
basename  = rg

<mesh>
nghost    = 2
nx1       = 512
x1min     = 0.0
x1max     = 1.92e12          # 0.6 R above rin = 0.5 R
ix1_bc    = user
ox1_bc    = user
nx2       = 1
x2min     = -0.5
x2max     = 0.5
ix2_bc    = periodic
ox2_bc    = periodic
nx3       = 1
x3min     = -0.5
x3max     = 0.5
ix3_bc    = periodic
ox3_bc    = periodic

<meshblock>
nx1       = 512
nx2       = 1
nx3       = 1

<time>
evolution  = dynamic
integrator = rk2
cfl_number = 0.3
nlim       = 0
tlim       = 1.0e30
ndiag      = 100

<units>
length_cgs = 1.0
mass_cgs   = 1.0
time_cgs   = 1.0
mu         = 1.0

<hydro>
eos             = general
general_eos     = table
gamma           = 1.6666666667   # unused by the table
# composition matching the opacity table: X = 0.70, Z = 0.02 (GS98)
eos_h2               = true
eos_ionization       = true
eos_metal_ionization = true
eos_radiation        = false    # the radiation field is NOT thermalised in the thin layers,
                                 # and aT^4/3 is < 0.1 % of p below the photosphere here
eos_xh               = 0.70     # the opacity table is tabulated at X = 0.70
eos_yhe              = 0.286    # Y = 1 - X - Z with Z = 0.014, matching the opacity table
eos_logd_min    = -14.0
eos_logd_max    = 0.0
eos_logt_min    = 2.0
eos_logt_max    = 6.5
eos_dlog        = 0.05
reconstruct = plm
rsolver     = hllc
etotgrav    = true
isotropic_conduction = radiative
rad_kappa_src        = table_rho    # the merged stellar Rosseland table below
rad_flux_inner       = -1.0         # < 0: the pgen sets L/(4 pi rin^2)
rad_flux_limit       = true
rad_tau_lo           = 1.0          # REQUIRED: above tau_lo the pgen relaxes each cell toward
rad_tau_hi           = 10.0         # the grey Eddington T(tau) instead of diffusing (stiff)
dfloor = 1.0e-18
pfloor = 1.0e-12

<problem>
user_srcs   = true
mstar       = 2.983e33       # 1.5 Msun
lstar       = 1.914e36       # 500 Lsun
teff        = 4000.0
rin         = 1.6e12         # 0.5 R
ptop        = 3.0            # dyn/cm^2 at the outer wall; MUST exceed a T^4/3 at the top
                             # (0.32 at 3364 K) or a general EOS with radiation has no gas state
mu          = 1.3            # ideal gas only: a cool, mostly neutral atmosphere
vpert       = 0.0
kappa_fac   = 1.0            # TEST knob: scale kappa_R in the column and the operator
kappa_const = 0.0            # > 0: constant kappa_R [cm^2/g] instead of the table (grey test)
mlt_alpha   = 0.0            # > 0: mixing-length convective flux, l = alpha H_p (1-D needs it)
mlt_dump    =                # if set: dump one column's MLT faces at the first call
# --- the correlated-k two-stream.  OFF in the 1-D column tests: the solver takes its
# direction from the spherical geometry, and the grey relaxation is what makes the
# closed-form validation (problem/kappa_const) possible.  ON by default in
# red_giant_cs.athinput, which is the 3-D case.
rt_ck       = false
ck_table    = /orion/u/jinma/ATHENAK/athenak/data/exo_fms_ck/ck/Premixed_1x_g8_11.txt
ck_data_dir = /orion/u/jinma/ATHENAK/athenak/data/exo_fms_ck
ck_swflux   = sw_band_flux_W121_11.txt
ck_nquad    = 1
ck_pcut_bar = 1.0e30         # no pressure cut: the tau blend decides the handover
rt_de_max   = 0.5
met         = 0.0
ck_dump_file =               # if set: one column's RT solution at the first call
ck_dump_m   = 0
ck_dump_j   = -1             # -1 = the meshblock centre in that direction
ck_dump_k   = -1
ck_dump_t2  = -1.0           # >= 0: dump a SECOND column once t reaches this
ck_dump_file2 =
opac_compare  =              # if set: write the ck-derived Rosseland table for comparison
opac_table  = /orion/u/jinma/ATHENAK/athenak/data/stellar_opac/rosseland_gs98_x0.7_z0.014.txt
column_dump = column.txt

<output1>
file_type  = hst
dt         = 1.0e4

<output2>
file_type  = bin
variable   = hydro_w
dt         = 1.0e6
