# Lowrie & Edwards (2008, Shock Waves 18, 129) steady radiative shock, Mach 5 (supercritical),
# in its own frame, cgs units (T_code = k T / (mu m_H), arad = a / tunit^4); initialised from
# the semi-analytic profile ref/idort_radshock_m5.txt and held by Dirichlet hydro faces (user BC)
# and Marshak radiation faces at the far-field equilibria. Used by: radshock_m5.

<job>
basename = rs

<mesh>
nx1 = 256
x1min = 0.0
x1max = 3.35316086e-02
ix1_bc = user
ox1_bc = user
nx2 = 4
x2min = 0.0
x2max = 3.35316086e-02
ix2_bc = periodic
ox2_bc = periodic
nx3 = 1
x3min = -0.5
x3max = 0.5
ix3_bc = periodic
ox3_bc = periodic
layout_invariant_mode = tile
layout_tile = 4

<meshblock>
nx1 = 256
nx2 = 4
nx3 = 1

<time>
integrator = rk2
nlim = -1
tlim = 2.0e-10
ndiag = 1000000
dt_retry_fac_t2 = 0.9
dt_retry_grow = 1.1
dt_retry_ngood = 20

<hydro>
eos = ideal
gamma = 1.666666666666667
rad_signal_speed_diff = true
fofc = true
dfloor_flux_limit = true
dfloor_keep_velocity = true
rad_signal_speed_phase = true

<rad_vet>
closure = vet_sc
vet_scatter = true
vet_gd_rotate_every = 0
time2_reject = retry
# --- this test's physics ---
c_light = 2.99792458e10
arad = 1.6332399e-46
e_floor = 1.0e-30
opacity = powerlaw
kappa_p = 577.16
opac_a = -1.0
implicit_bc_x1min = marshak
implicit_ebath_x1min = 1.70873641e+11
implicit_ebath_x1max = 9.16223959e+14
clean_clos1_budget = true
clean_bud_maxnorm = true
clean_maxit = 200
clean_wb_exch_local = true

<problem>
pgen_name = rad_vet_beam
vet_test = radshock
vet_shock_tunit = 8.2499208e7
vet_shock_ref = ../tests/vet_clean/ref/idort_radshock_m5.txt
vet_shock_w = 2.0
vet_shock_rho_l = 5.69000000e+00
vet_shock_v_l = 8.65660331e+07
vet_shock_t_l = 2.18000000e+06
vet_shock_rho_r = 2.04721116e+01
vet_shock_v_r = 2.40600842e+07
vet_shock_t_r = 1.86546943e+07
vet_shock_xs = 3.31573616e-02

<output1>
file_type = bin
bin_double = true
variable = vet
dt = 5.0e-11

<output2>
file_type = bin
bin_double = true
variable = hydro_w
dt = 5.0e-11
