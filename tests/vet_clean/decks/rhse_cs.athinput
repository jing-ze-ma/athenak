# Grey scattering envelope in hydrostatic + radiative equilibrium (cubed sphere):
# must stay at rest (well-balancing). Used by: wb_cs.
#
# The <rad_vet> block starts with the scheme keys that production pins (the values of the
# production star decks); the rest are this test's physics, grid and solver set-up.

<job>
basename = rh

<mesh>
layout_invariant = true
nghost = 2
nx1 = 48
x1min = 1.0
x1max = 2.0
ix1_bc = reflect
ox1_bc = reflect
nx2 = 8
x2min = -1.0
x2max = 1.0
ix2_bc = panel
ox2_bc = panel
nx3 = 8
x3min = -1.0
x3max = 1.0
ix3_bc = panel
ox3_bc = panel
use_cubed_sphere = true

<meshblock>
nx1 = 48
nx2 = 8
nx3 = 8

<time>
evolution = dynamic
integrator = rk2
cfl_number = 0.3
nlim = -1
tlim = 2.5
ndiag = 1

<hydro>
eos = ideal
reconstruct = plm
rsolver = hllc
gamma = 1.666666666666667
rad_signal_speed = false
wellbalance_static = true
wellbalance_static_reconst = true

<rad_vet>
# --- production scheme keys ---
zalesak_active = true
clean_stag_xdonor = lag
clean_stag_xsrc = true
implicit_pos_floor_gas_keep = 1
implicit_pos_gas_cons = true
clean_stag_mg_color = mirror
time2_k1_redist = 0
time2_tableau = sdirk2
clean_face_hctau = true
clean_stag_upwind_central = true
clean_w_fse_tau = true
clean_stag_fwb_stage = false
clean_stag_fwb_t2 = false
time2_gtime_mom = true
time2_k1_stiff = 0
clean_pred_stage = false
clean_stag_central = true
clean_stag_kpat = false
clean_stag_eicarry = true
clean_gas_secant = max_stage2
clean_pred_xch = true
clean_stag_fcone_gas = false
# --- this test ---
clean_layout = staggered
c_light = 40.0
chat_over_c = 1.0
closure = vet_col
vet_col_lat = true
vet_gd = true
vet_gd_replace = true
vet_gd_rotate_dt = 0
vet_gd_gl_nmu = 8
vet_gd_gl_nphi = 16
vet_gd_allow_clamp = true
e_floor = 1.0e-30
opacity = const
kappa_p = 0.0
kappa_e = 0.0
kappa_f = 0.0
kappa_s = 500.0
arad = 1.0
coupling = true
gas_feedback = true
transport = implicit
implicit_cfl = 1.0e4
implicit_bc_x1min = marshak
implicit_bc_x1max = marshak
implicit_ebath_x1min = 0.0
implicit_ebath_x1max = 0.0
time_scheme = hesdirk2
scheme = clean
clean_closure = extrap1
clean_init = steady
clean_init_n = 50
clean_rays = sc
clean_tol = 1.0e-10
clean_tol_nl = 1.0e-11
clean_maxnl = 60
force_reference = clean

<problem>
pgen_name = rad_vet_beam
vet_test = rhse
user_srcs = true
user_hist = true
rh_gm = 1.0
rh_eddf = 0.3
rh_rho0 = 1.0
rh_temp = 0.1
rh_seed = 0.0

<output1>
file_type = hst
data_format = %24.16e
dt = 0.25
