# Closed absorbing + scattering shell with rotation and a radial flow on a cubed-sphere
# mesh (reflecting radial walls). Used by: conservation_cs, restart_cs.

<job>
basename = cs

<mesh>
nx1 = 16
x1min = 1.0
x1max = 3.0
ix1_bc = reflect
ox1_bc = reflect
nx2 = 8
x2min = -1.0
x2max = 1.0
ix2_bc = panel
ox2_bc = panel
nx3 = 8
x3min = -1.0
x3max = 1.0
ix3_bc = panel
ox3_bc = panel
use_cubed_sphere = true
layout_invariant_mode = tile
layout_tile = 8

<meshblock>
nx1 = 16
nx2 = 8
nx3 = 8

<time>
integrator = rk2
nlim = 12
tlim = 1e+30
ndiag = 1000000
dt_retry_grow = 1.1
dt_retry_ngood = 20

<hydro>
eos = ideal
gamma = 1.666666666666667
fofc = true
dfloor_flux_limit = true
dfloor_keep_velocity = true
rad_signal_speed_diff = true
rad_signal_speed_phase = true

<rad_vet>
c_light = 10.0
e_floor = 1.0e-30
kappa_p = 1.0
kappa_f = 0.0
kappa_s = 20.0
arad = 1.0
implicit_cfl = 4.0
implicit_bc_x1min = reflect
implicit_bc_x1max = reflect
vet_gd_gl_nmu = 10
vet_gd_rotate_dt = 0
clean_clos1_budget = true
clean_bud_maxnorm = true
clean_maxit = 200
clean_wb_exch_local = true

<problem>
pgen_name = rad_vet_beam
vet_test = sph_shell
gas_rho = 1.0
gas_temp = 0.5
e_out = 1.0
e_amp = 1.0
r0 = 2.0
width = 0.3
lat_amp = 0.5
lat_l = 1
lat_axis = vertex
gas_rot = 0.3
gas_vr = 0.2
rho_lat_amp = 0.4
user_hist = true
am_hist = true

<output1>
file_type = bin
bin_double = true
variable = vet
dt = 1.0e30

<output2>
file_type = bin
bin_double = true
variable = hydro_u
dt = 1.0e30

<output3>
file_type = hst
data_format = %24.16e
dt = 1.0e-12
