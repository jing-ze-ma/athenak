# Closed rotating absorbing + scattering shell with <mhd> on the cubed sphere (reflecting radial
# walls), an azimuthal field about an inclined axis, Ohmic and ambipolar diffusion, FOFC.
# Used by: mhd_vet.
#
# The <rad_vet> block starts with the scheme keys that production pins (the values of the
# production star decks); the rest are this test's physics, grid and solver set-up.

<job>
basename = cs

<mesh>
nx1 = 16
x1min = 1.0
x1max = 3.0
ix1_bc = reflect
ox1_bc = reflect
nx2 = 16
x2min = -1.0
x2max = 1.0
ix2_bc = panel
ox2_bc = panel
nx3 = 16
x3min = -1.0
x3max = 1.0
ix3_bc = panel
ox3_bc = panel
use_cubed_sphere = true
layout_invariant_mode = tile
layout_tile = 8

<meshblock>
nx1 = 16
nx2 = 16
nx3 = 16

<time>
nlim = 8
tlim = 1e+30
ndiag = 1000000

<mhd>
eos = ideal
reconstruct = plm
rsolver = hlld
gamma = 1.666666666666667
rad_signal_speed = true
fofc = true
ohmic_resistivity = constant
eta_ohm_const = 0.01
ambipolar = constant
eta_ad = 0.01

<rad_vet>
c_light = 10.0
e_floor = 1.0e-30
kappa_p = 1.0
kappa_f = 0.0
kappa_s = 20.0
kappa_e = 1.0
arad = 1.0
implicit_cfl = 4.0
implicit_bc_x1min = reflect
implicit_bc_x1max = reflect
vet_gd_gl_nmu = 10
vet_gd_gl_nphi = 12
vet_gd_rotate_dt = 0

<problem>
pgen_name = rad_vet_beam
vet_test = sph_shell
gas_rho = 1.0
gas_temp = 0.5
e_out = 1.0
e_amp = 1.0
r0 = 2.0
width = 0.3
lat_amp = 0.5
lat_l = 1
lat_axis = vertex
gas_rot = 0.3
gas_vr = 0.2
b_azi = 0.3
b_azi_axis = 1,1,0
user_hist = true
am_hist = true

<output1>
file_type = bin
bin_double = true
variable = vet
dt = 1.0e30

<output2>
file_type = bin
bin_double = true
variable = mhd_u_bcc
dt = 1.0e30

<output3>
file_type = hst
data_format = %24.16e
dt = 1.0e-12

<output4>
file_type = bin
bin_double = true
variable = mhd_divb
dt = 1.0e30
