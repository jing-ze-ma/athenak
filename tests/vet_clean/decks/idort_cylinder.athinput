# Homogeneous emitting cylinder (Cartesian 2-D analogue of the homogeneous sphere, Ma et al. 2025
# IDORT sec. 4.1.2; Jiang 2021 sec. 4.6): r < 1 with rho kappa = 10 and a T^4 = 1 in vacuum, box
# [-4, 4]^2, x2 periodic (a row of cylinders, period 8). E and F along y = 0 against the exact
# transport solution (ref/idort_cylinder_exact.npz). Used by: idort_cylinder.

<job>
basename = shd

<mesh>
nx1 = 128
x1min = -4.0
x1max = 4.0
ix1_bc = outflow
ox1_bc = outflow
nx2 = 128
x2min = -4.0
x2max = 4.0
ix2_bc = periodic
ox2_bc = periodic
nx3 = 1
x3min = -0.5
x3max = 0.5
ix3_bc = periodic
ox3_bc = periodic
layout_invariant_mode = tile
layout_tile = 16

<meshblock>
nx1 = 128
nx2 = 128
nx3 = 1

<time>
dt_retry_fac_t2 = 0.9
dt_retry_grow = 1.1
dt_retry_ngood = 20
integrator = rk2
nlim = -1
tlim = 0.8

<hydro>
eos = ideal
gamma = 1.000001
fofc = true
dfloor_flux_limit = true
dfloor_keep_velocity = true
rad_signal_speed_diff = true
rad_signal_speed_phase = true

<rad_vet>
closure = vet_sc
vet_rotate_avg = 4
vet_scatter = true
time2_reject = retry
c_light = 100.0
arad = 1.0
e_floor = 1.0e-30
kappa_p = 1.0
gas_feedback = false
implicit_bc_x1min = marshak
implicit_bc_x1max = marshak
vet_nmu = 8
vet_nphi = 32
implicit_cfl = 100.0
clean_clos1_budget = true
clean_bud_maxnorm = true
clean_maxit = 200
clean_wb_exch_local = true

<problem>
pgen_name = rad_vet_beam
vet_test = cyl
user_srcs = true
cyl_n = 1
cyl_rho_bg = 1.0e-10
cyl_t_bg = 1.0e-3
cyl0_x = 0.0
cyl0_y = 0.0
cyl0_r = 1.0
cyl0_rho = 10.0
cyl0_t = 1.0

<output1>
file_type = bin
bin_double = true
variable = vet
dt = 0.8

<output3>
file_type = bin
bin_double = true
variable = vet_vsc
dt = 0.8

<output4>
file_type = bin
bin_double = true
variable = vet_vet
dt = 0.8
