# Closed rotating scattering shell on a 3-D spherical-polar wedge (reflecting radial walls,
# reflecting theta walls, periodic phi). Used by: conservation_sp, restart_sp, dt_retry, layout_tile.
#
# The <rad_vet> block starts with the scheme keys that production pins (the values of the
# production star decks); the rest are this test's physics, grid and solver set-up.

<job>
basename = sp

<mesh>
layout_invariant = true
nghost = 2
nx1 = 32
x1min = 1.0
x1max = 5.0
ix1_bc = reflect
ox1_bc = reflect
nx2 = 8
x2min = 1.1707963267948966
x2max = 1.9707963267948967
ix2_bc = reflect
ox2_bc = reflect
nx3 = 8
x3min = 0.0
x3max = 1.5707963267948966
ix3_bc = periodic
ox3_bc = periodic
use_spherical_polar = true

<meshblock>
nx1 = 32
nx2 = 8
nx3 = 8

<time>
evolution = dynamic
integrator = rk2
cfl_number = 0.3
nlim = 40
tlim = 580.8
ndiag = 1000000

<hydro>
eos = ideal
reconstruct = plm
rsolver = hllc
gamma = 1.666666666666667
rad_signal_speed = false

<rad_vet>
# --- production scheme keys ---
zalesak_active = true
clean_stag_xdonor = lag
clean_stag_xsrc = true
implicit_pos_floor_gas_keep = 1
implicit_pos_gas_cons = true
clean_stag_mg_color = mirror
time2_k1_redist = 0
time2_tableau = sdirk2
clean_face_hctau = true
clean_stag_upwind_central = true
clean_w_fse_tau = true
clean_stag_fwb_stage = false
clean_stag_fwb_t2 = false
time2_gtime_mom = true
time2_k1_stiff = 0
clean_pred_stage = false
clean_stag_central = true
clean_stag_kpat = false
clean_stag_eicarry = true
clean_gas_secant = max_stage2
clean_pred_xch = true
clean_stag_fcone_gas = false
clean_stag_fwb = true
clean_stag_fcone = true
clean_stag_fwb_ring = 1
# --- this test ---
clean_layout = staggered
c_light = 10.0
chat_over_c = 1.0
closure = vet_col
e_floor = 1.0e-30
opacity = const
kappa_p = 0.0
kappa_e = 0.0
kappa_f = 0.0
kappa_s = 1e-2
arad = 1.0
coupling = true
gas_feedback = true
transport = implicit
implicit_cfl = 226.875
implicit_bc_x1min = reflect
implicit_bc_x1max = reflect
implicit_ebath_x1min = 0.0
implicit_ebath_x1max = 4.5399929762484854e-05
time_scheme = hesdirk2
scheme = clean
vet_gd_gl_nmu = 16
vet_gd_gl_nphi = 32
vet_gd_allow_clamp = true
vet_col_lat = true
vet_gd = true
vet_gd_replace = true
vet_gd_rotate_dt = 0
clean_sphere_radius = 100.0

<problem>
pgen_name = rad_vet_beam
vet_test = sph_shell
gas_rho = 1e2
gas_temp = 1e-4
e_out = 4.5399929762484854e-05
e_amp = 1.0
r0 = 3.0
user_hist = true
am_hist = true
gas_rot = 2.0e-3
width = 0.15811388300841897
lat_amp = 0.5
lat_l2 = 1.0

<output1>
file_type = bin
bin_double = true
variable = vet
dt = 1.0e30

<output2>
file_type = bin
bin_double = true
variable = hydro_u
dt = 1.0e30

<output3>
file_type = hst
data_format = %24.16e
dt = 1.0e-12
