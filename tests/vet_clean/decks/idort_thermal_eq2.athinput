# Thermal equilibrium, hot gas cooling into radiation (Jiang 2021 sec. 4.1, the second case):
# uniform gas (e = 150) and radiation (E = 1) relax at constant total energy, kappa = 1, c = 100,
# large time steps (implicit_cfl 1.6). T(t) against the exact ODE. Used by: idort_thermal_eq2.

<job>
basename = eq2

<mesh>
nx1 = 32
x1min = 0.0
x1max = 1.0
ix1_bc = periodic
ox1_bc = periodic
nx2 = 32
x2min = 0.0
x2max = 1.0
ix2_bc = periodic
ox2_bc = periodic
nx3 = 1
x3min = -0.5
x3max = 0.5
ix3_bc = periodic
ox3_bc = periodic
layout_invariant_mode = tile
layout_tile = 16

<meshblock>
nx1 = 32
nx2 = 32
nx3 = 1

<time>
nlim = -1
tlim = 0.1

<hydro>
eos = ideal
gamma = 1.666666666666667

<rad_vet>
vet_scatter = true
vet_gd_rotate_every = 0
c_light = 100.0
arad = 1.0
e_floor = 1.0e-30
kappa_p = 1.0
implicit_bc_x1min = periodic
implicit_bc_x1max = periodic
vet_nmu = 8
vet_nphi = 32
implicit_cfl = 1.6
vet_x1_npass = 2

<problem>
pgen_name = rad_vet_beam
vet_test = equil
user_srcs = false
gas_rho = 1.0
gas_eint = 150.0
e_rad = 1.0
gas_vx = 0.0

<output1>
file_type = bin
bin_double = true
variable = vet
dt = 0.0025

<output4>
file_type = bin
bin_double = true
variable = hydro_w
dt = 0.0025
