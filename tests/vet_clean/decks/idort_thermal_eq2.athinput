# Thermal equilibrium, hot gas cooling into radiation (Jiang 2021 sec. 4.1, the second case):
# uniform gas (e = 150) and radiation (E = 1) relax at constant total energy, kappa = 1, c = 100,
# large time steps (implicit_cfl 1.6). T(t) against the exact ODE. Used by: idort_thermal_eq2.
#
# The <rad_vet> block starts with the scheme keys that production pins (the values of the
# production star decks); the rest are this test's physics, grid and solver set-up.

<job>
basename = eq2

<mesh>
layout_invariant = true
nghost = 2
nx1 = 32
x1min = 0.0
x1max = 1.0
ix1_bc = periodic
ox1_bc = periodic
nx2 = 32
x2min = 0.0
x2max = 1.0
ix2_bc = periodic
ox2_bc = periodic
nx3 = 1
x3min = -0.5
x3max = 0.5
ix3_bc = periodic
ox3_bc = periodic

<meshblock>
nx1 = 32
nx2 = 32
nx3 = 1

<time>
dt_retry = true
dt_retry_fac_t2 = 0.9
dt_retry_grow = 1.1
dt_retry_ngood = 20
evolution = dynamic
integrator = rk2
cfl_number = 0.4
nlim = -1
tlim = 0.1
ndiag = 1

<hydro>
eos = ideal
reconstruct = plm
rsolver = hllc
gamma = 1.666666666666667

<rad_vet>
# --- production scheme keys ---
zalesak_active = true
clean_stag_xdonor = lag
clean_stag_xsrc = true
implicit_pos_floor_gas_keep = 1
implicit_pos_gas_cons = true
clean_stag_mg_color = mirror
time2_k1_redist = 0
time2_tableau = sdirk2
clean_face_hctau = true
clean_stag_upwind_central = true
clean_w_fse_tau = true
clean_stag_fwb_stage = false
clean_stag_fwb_t2 = false
time2_gtime_mom = true
time2_k1_stiff = 0
clean_pred_stage = false
clean_stag_central = true
clean_stag_eicarry = true
clean_gas_secant = max_stage2
clean_pred_xch = true
clean_stag_fcone_gas = false
# --- this test ---
clean_layout = staggered
scheme = clean
clean_cs_lz_abs = 2
clean_stag_csvec_radial = true
closure = vet_sc
vet_tensor = full
time_scheme = hesdirk2
vet_rotate_avg = 0
vet_source_noesrc = true
vet_scatter = true
vet_scatter_form = ma
vet_scatter_j = relaxed
vet_gd_rotate_every = 0
vet_gd_rotate_dt = 0
implicit_resid_fatal = 1.0e-2
implicit_pos_gas = true
implicit_pos_floor = true
time2_reject = retry
time2_enth_be = true
c_light = 100.0
chat_over_c = 1.0
arad = 1.0
e_floor = 1.0e-30
opacity = const
kappa_p = 1.0
kappa_e = 1.0
kappa_f = 1.0
kappa_s = 0.0
coupling = true
gas_feedback = true
transport = implicit
implicit_bc_x1min = periodic
implicit_bc_x1max = periodic
marshak_q = 0.5
implicit_ebath_x1min = 0.0
implicit_ebath_x1max = 0.0
vet_nmu = 8
vet_nphi = 32
implicit_cfl = 1.6
vet_x1_periodic = true
vet_x1_npass = 2

<problem>
pgen_name = rad_vet_beam
vet_test = equil
user_srcs = false
gas_rho = 1.0
gas_eint = 150.0
e_rad = 1.0
gas_vx = 0.0

<output1>
file_type = bin
bin_double = true
variable = vet
dt = 0.0025

<output4>
file_type = bin
bin_double = true
variable = hydro_w
dt = 0.0025
