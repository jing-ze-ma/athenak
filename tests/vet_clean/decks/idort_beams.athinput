# Crossing beams in vacuum (Ma et al. 2025 IDORT sec. 4.1.1; Jiang 2021 ApJS 253 49 sec. 4.2), rotated:
# the beams enter at x1min (the paper y) at +-45 deg; x2 (the paper x) is periodic; ring of 4 rays
# per beam direction (vet_ring = 4). E against the exact straight beams. Used by: idort_beams,
# idort_beams_mb.
#
# The <rad_vet> block starts with the scheme keys that production pins (the values of the
# production star decks); the rest are this test's physics, grid and solver set-up.

<job>
basename = cb

<mesh>
layout_invariant = true
nghost = 3
nx1 = 256
x1min = -2.0
x1max = 2.0
ix1_bc = outflow
ox1_bc = outflow
nx2 = 64
x2min = -0.5
x2max = 0.5
ix2_bc = periodic
ox2_bc = periodic
nx3 = 1
x3min = -0.5
x3max = 0.5
ix3_bc = periodic
ox3_bc = periodic

<meshblock>
nx1 = 256
nx2 = 64
nx3 = 1

<time>
dt_retry = true
dt_retry_fac_t2 = 0.9
dt_retry_grow = 1.1
dt_retry_ngood = 20
evolution = dynamic
integrator = rk2
cfl_number = 0.4
nlim = -1
tlim = 0.08
ndiag = 1

<hydro>
eos = ideal
reconstruct = plm
rsolver = hllc
gamma = 1.000001

<rad_vet>
# --- production scheme keys ---
zalesak_active = true
clean_stag_xdonor = lag
clean_stag_xsrc = true
implicit_pos_floor_gas_keep = 1
implicit_pos_gas_cons = true
clean_stag_mg_color = mirror
time2_k1_redist = 0
time2_tableau = sdirk2
clean_face_hctau = true
clean_stag_upwind_central = true
clean_w_fse_tau = true
clean_stag_fwb_stage = false
clean_stag_fwb_t2 = false
time2_gtime_mom = true
time2_k1_stiff = 0
clean_pred_stage = false
clean_stag_central = true
clean_stag_kpat = false
clean_stag_eicarry = true
clean_gas_secant = max_stage2
clean_pred_xch = true
clean_stag_fcone_gas = false
# --- this test ---
clean_layout = staggered
scheme = clean
clean_cs_lz_abs = 2
clean_stag_csvec_radial = true
closure = vet_sc
vet_tensor = full
time_scheme = hesdirk2
time2_start = be
vet_rotate_avg = 0
vet_ring = 4
vet_source_noesrc = true
vet_scatter = true
vet_scatter_form = ma
vet_scatter_j = relaxed
vet_gd_rotate_every = 0
vet_gd_rotate_dt = 0
implicit_resid_fatal = 1.0e-2
implicit_pos_gas = true
implicit_pos_floor = true
time2_reject = retry
time2_enth_be = true
c_light = 1.0e3
chat_over_c = 1.0
arad = 1.0
e_floor = 1.0e-30
opacity = const
kappa_p = 1.0
kappa_e = 1.0
kappa_f = 1.0
kappa_s = 0.0
coupling = true
gas_feedback = false
transport = implicit
implicit_bc_x1min = marshak
implicit_bc_x1max = marshak
marshak_q = 0.5
implicit_ebath_x1min = 0.0
implicit_ebath_x1max = 0.0
vet_nmu = 8
vet_nphi = 32
implicit_cfl = 256
implicit_beam_n = 2
implicit_beam0_e = 1.0
implicit_beam0_ang = -45.0
implicit_beam0_y0 = -0.109375
implicit_beam0_y1 = -0.09375
implicit_beam1_e = 1.0
implicit_beam1_ang = 45.0
implicit_beam1_y0 = 0.09375
implicit_beam1_y1 = 0.109375

<problem>
pgen_name = rad_vet_beam
vet_test = cyl
user_srcs = true
cyl_n = 1
cyl_rho_bg = 1.0e-8
cyl_t_bg = 1.0e-3
cyl0_x = 1.9
cyl0_y = 0.4
cyl0_r = 0.0
cyl0_rho = 1.0e-8
cyl0_t = 1.0e-3

<output1>
file_type = bin
bin_double = true
variable = vet
dt = 0.08

<output3>
file_type = bin
bin_double = true
variable = vet_vsc
dt = 0.08
