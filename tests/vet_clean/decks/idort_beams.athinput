# Crossing beams in vacuum (Ma et al. 2025 IDORT sec. 4.1.1; Jiang 2021 ApJS 253 49 sec. 4.2), rotated:
# the beams, 4 cells wide, enter at x1min (the paper y) at +-45 deg; x2 (the paper x) is
# periodic; ring of 4 rays per beam direction (vet_ring = 4). E against the exact straight
# beams. Used by: idort_beams, idort_beams_mb.

<job>
basename = cb

<mesh>
nx1 = 256
x1min = -2.0
x1max = 2.0
ix1_bc = outflow
ox1_bc = outflow
nx2 = 64
x2min = -0.5
x2max = 0.5
ix2_bc = periodic
ox2_bc = periodic
nx3 = 1
x3min = -0.5
x3max = 0.5
ix3_bc = periodic
ox3_bc = periodic
layout_invariant_mode = tile
layout_tile = 16

<meshblock>
nx1 = 256
nx2 = 64
nx3 = 1

<time>
dt_retry_fac_t2 = 0.9
dt_retry_grow = 1.1
dt_retry_ngood = 20
integrator = rk2
nlim = -1
tlim = 0.08

<hydro>
eos = ideal
gamma = 1.000001
fofc = true
dfloor_flux_limit = true
dfloor_keep_velocity = true
rad_signal_speed_diff = true
rad_signal_speed_phase = true

<rad_vet>
closure = vet_sc
vet_ring = 4
vet_scatter = true
time2_reject = retry
c_light = 1.0e3
arad = 1.0
e_floor = 1.0e-30
kappa_p = 1.0
gas_feedback = false
implicit_bc_x1min = marshak
implicit_bc_x1max = marshak
vet_nmu = 8
vet_nphi = 32
implicit_cfl = 256
implicit_beam_n = 2
implicit_beam0_e = 1.0
implicit_beam0_ang = -45.0
implicit_beam0_y0 = -0.109375
implicit_beam0_y1 = -0.046875
implicit_beam1_e = 1.0
implicit_beam1_ang = 45.0
implicit_beam1_y0 = 0.09375
implicit_beam1_y1 = 0.15625
clean_clos1_budget = true
clean_bud_maxnorm = true
clean_maxit = 200
clean_wb_exch_local = true

<problem>
pgen_name = rad_vet_beam
vet_test = cyl
user_srcs = true
cyl_n = 1
cyl_rho_bg = 1.0e-8
cyl_t_bg = 1.0e-3
cyl0_x = 1.9
cyl0_y = 0.4
cyl0_r = 0.0
cyl0_rho = 1.0e-8
cyl0_t = 1.0e-3

<output1>
file_type = bin
bin_double = true
variable = vet
dt = 0.08

<output3>
file_type = bin
bin_double = true
variable = vet_vsc
dt = 0.08
