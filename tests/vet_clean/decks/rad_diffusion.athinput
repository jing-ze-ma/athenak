# Diffusion of a Gaussian radiation pulse in a static pure scatterer (rho = 1, kappa_s, c = 1,
# gas_feedback = false): the variance of E grows at 2 D t, D = c / (3 rho kappa_s), and the
# profile stays the Gaussian of the diffusion equation; periodic x1, the gas held fixed
# (kinematic). tau_cell = rho kappa_s dx = 10 here; the suite also runs tau_cell = 1, 1e3,
# 1e5, a 2-D isotropic Gaussian and a top-hat (problem/vet_test = tophat). Used by: diffusion.

<job>
basename = dp

<mesh>
nx1 = 128
x1min = 0.0
x1max = 1.0
ix1_bc = periodic
ox1_bc = periodic
nx2 = 4
x2min = -0.5
x2max = 0.5
ix2_bc = periodic
ox2_bc = periodic
nx3 = 1
x3min = -0.5
x3max = 0.5
ix3_bc = periodic
ox3_bc = periodic
layout_invariant_mode = tile
layout_tile = 4

<meshblock>
nx1 = 128
nx2 = 4
nx3 = 1

<time>
evolution = kinematic
integrator = rk2
nlim = -1
tlim = 1.0
ndiag = 1000000
dt_fixed = 0.01

<hydro>
eos = ideal
rsolver = advect
gamma = 1.666666666666667
rad_signal_speed_diff = true
fofc = true
dfloor_flux_limit = true
dfloor_keep_velocity = true
rad_signal_speed_phase = true

<rad_vet>
closure = vet_sc
vet_scatter = true
vet_gd_rotate_every = 0
time2_reject = retry
# --- this test's physics ---
c_light = 1.0
arad = 1.0
e_floor = 1.0e-30
kappa_s = 1280.0
gas_feedback = false
implicit_bc_x1min = periodic
implicit_bc_x1max = periodic
vet_x1_npass = 2
clean_clos1_budget = true
clean_bud_maxnorm = true
clean_maxit = 200
clean_wb_exch_local = true

<problem>
pgen_name = rad_vet_beam
vet_test = thick_pulse
gas_rho = 1.0
gas_eint = 0.01
pulse_amp = 1.0
pulse_width = 0.05
pulse_x0 = 0.5
pulse_bg = 1.0e-3
pulse_1d = true
nyquist_amp = 0.0

<output1>
file_type = bin
bin_double = true
variable = vet
dt = 1.0e30

<output2>
file_type = bin
bin_double = true
variable = hydro_w
dt = 1.0e30
