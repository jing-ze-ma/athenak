# Diffusion of a Gaussian radiation pulse in a static pure scatterer (rho = 1, kappa_s, c = 1,
# gas_feedback = false): the variance of E grows at 2 D t, D = c / (3 rho kappa_s), and the
# profile stays the Gaussian of the diffusion equation; periodic x1, the gas held fixed
# (kinematic). tau_cell = rho kappa_s dx = 10 here; the suite also runs tau_cell = 1, 1e3,
# 1e5, a 2-D isotropic Gaussian and a top-hat (problem/vet_test = tophat). Used by: diffusion.
#
# The <rad_vet> block starts with the scheme keys that production pins (the values of the
# production star decks); the rest are this test's physics, grid and solver set-up.

<job>
basename = dp

<mesh>
layout_invariant = true
nghost = 3
nx1 = 128
x1min = 0.0
x1max = 1.0
ix1_bc = periodic
ox1_bc = periodic
nx2 = 4
x2min = -0.5
x2max = 0.5
ix2_bc = periodic
ox2_bc = periodic
nx3 = 1
x3min = -0.5
x3max = 0.5
ix3_bc = periodic
ox3_bc = periodic
layout_invariant_mode = tile
layout_tile = 4

<meshblock>
nx1 = 128
nx2 = 4
nx3 = 1

<time>
evolution = kinematic
integrator = rk2
cfl_number = 0.3
nlim = -1
tlim = 1.0
ndiag = 1000000
dt_fixed = 0.01

<hydro>
eos = ideal
reconstruct = plm
rsolver = advect
gamma = 1.666666666666667
rad_signal_speed = true
rad_signal_speed_diff = true
fofc = true
dfloor_flux_limit = true
dfloor_keep_velocity = true
rad_signal_speed_phase = true

<rad_vet>
# --- production scheme keys ---
zalesak_active = true
clean_stag_xdonor = lag
clean_stag_xsrc = true
implicit_pos_floor_gas_keep = 1
implicit_pos_gas_cons = true
clean_stag_mg_color = mirror
time2_k1_redist = 0
time2_tableau = sdirk2
clean_face_hctau = true
clean_stag_upwind_central = true
clean_w_fse_tau = true
clean_stag_fwb_stage = false
clean_stag_fwb_t2 = false
time2_gtime_mom = true
time2_k1_stiff = 0
clean_pred_stage = false
clean_stag_central = true
clean_stag_eicarry = true
clean_gas_secant = max_stage2
clean_pred_xch = true
clean_stag_fcone_gas = false
# --- this test ---
clean_layout = staggered
scheme = clean
clean_cs_lz_abs = 2
clean_stag_csvec_radial = true
closure = vet_sc
time2_vet_col_source = blend
time_scheme = hesdirk2
vet_rotate_avg = 0
vet_col_lat_cut_thin = 1.0
vet_gd_rotate_t0 = 0.0
vet_gd_rotate_align = true
vet_source_noesrc = true
vet_scatter = true
vet_scatter_form = ma
vet_scatter_j = relaxed
vet_gd_gl_nmu = 10
vet_gd_gl_nphi = 12
vet_gd_gl_stagger = true
vet_gd_rotate_every = 0
vet_gd_rotate_dt = 0
vet_col_lat_offdiag = operator
vet_gd_tangential = false
vet_gd_wall_interp = true
vet_gd_halo_compact = 2
implicit_resid_fatal = 1.0e-2
implicit_pos_gas = true
implicit_pos_floor = true
vet_col_every = 1
time2_reject = retry
vet_col_ncore = 8
vet_col_nsub = 1
vet_col_nmu = 4
vet_col_fk_min = 0
vet_col_reflect_top = 1
vet_col_surface_face = 1
vet_col_surface_q = 1
vet_col_surface_qmin = 0.001
vet_col_surface_qmax = 1
vet_col_axis = radial
time2_enth_be = true
implicit_tol_rel_max = 1.0e-4
# --- this test's physics ---
c_light = 1.0
chat_over_c = 1.0
arad = 1.0
e_floor = 1.0e-30
opacity = const
kappa_p = 0.0
kappa_e = 0.0
kappa_f = 0.0
kappa_s = 1280.0
coupling = true
gas_feedback = false
transport = implicit
implicit_cfl = -1.0
implicit_bc_x1min = periodic
implicit_bc_x1max = periodic
vet_x1_periodic = true
vet_x1_npass = 2
vet_nmu = 4
vet_nphi = 8
clean_clos1_budget = true
clean_bud_maxnorm = true
clean_maxit = 200
clean_wb_exch_local = true

<problem>
pgen_name = rad_vet_beam
vet_test = thick_pulse
gas_rho = 1.0
gas_eint = 0.01
pulse_amp = 1.0
pulse_width = 0.05
pulse_x0 = 0.5
pulse_bg = 1.0e-3
pulse_1d = true
nyquist_amp = 0.0

<output1>
file_type = bin
bin_double = true
variable = vet
dt = 1.0e30

<output2>
file_type = bin
bin_double = true
variable = hydro_w
dt = 1.0e30
