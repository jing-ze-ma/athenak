# Radiation-hydrodynamic wave along the diagonal of a periodic 3-D Cartesian box with <mhd>, a
# uniform oblique field, Ohmic and ambipolar diffusion, FOFC.  Used by: mhd_vet.
#
# The <rad_vet> block starts with the scheme keys that production pins (the values of the
# production star decks); the rest are this test's physics, grid and solver set-up.

<job>
basename = rw

<mesh>
nx1 = 16
x1min = 0.0
x1max = 1.0
ix1_bc = periodic
ox1_bc = periodic
nx2 = 16
x2min = 0.0
x2max = 1.0
ix2_bc = periodic
ox2_bc = periodic
nx3 = 16
x3min = 0.0
x3max = 1.0
ix3_bc = periodic
ox3_bc = periodic
layout_invariant_mode = tile
layout_tile = 8

<meshblock>
nx1 = 16
nx2 = 16
nx3 = 16

<time>
nlim = 8
tlim = 1e30
ndiag = 1000000

<mhd>
eos = ideal
reconstruct = plm
rsolver = hlld
gamma = 1.666666666666667
rad_signal_speed = true
fofc = true
ohmic_resistivity = constant
eta_ohm_const = 0.01
ambipolar = constant
eta_ad = 0.01

<rad_vet>
c_light = 10
e_floor = 1.0e-30
kappa_p = 0.10000000000000001
kappa_e = 0.10000000000000001
kappa_f = 0.10000000000000001
arad = 0.99999899999999997
implicit_cfl = 3.9270160713661184
implicit_maxit = 200
implicit_lin_maxit = 400
vet_gd_rotate_dt = 0
vet_x1_npass = 30

<problem>
pgen_name = rad_vet_beam
vet_test = radwave
radwave_dir = xyz
radwave_amp = 0.01
radwave_eig = false
vet_b0_1 = 0.5
vet_b0_2 = 0.3
vet_b0_3 = 0.2
radwave_rho = 1.0
radwave_t = 1.0

<output1>
file_type = bin
bin_double = true
variable = vet
dt = 1.0e30

<output2>
file_type = bin
bin_double = true
variable = mhd_u_bcc
dt = 1.0e30

<output4>
file_type = bin
bin_double = true
variable = mhd_divb
dt = 1.0e30

<output3>
file_type = hst
data_format = %24.16e
dt = 1.0e-12
