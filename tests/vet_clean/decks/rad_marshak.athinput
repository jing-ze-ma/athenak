# Non-equilibrium Marshak wave: a cold static slab (rho = 1, constant c_v, absorption
# kappa = 300, total optical depth 300) heated from x1min by a radiation bath E_b = 1e-10
# (Marshak face, implicit_ebath_x1min); arad T_b^4 = E_b and the gas heat capacity at T_b is
# comparable to E_b, so the wave is retarded, not equilibrium diffusion. Constant c_v, so not
# Su & Olson (1997). Used by: marshak.

<job>
basename = mw

<mesh>
nx1 = 128
x1min = 0.0
x1max = 1.0
ix1_bc = outflow
ox1_bc = outflow
nx2 = 4
x2min = -0.5
x2max = 0.5
ix2_bc = periodic
ox2_bc = periodic
nx3 = 1
x3min = -0.5
x3max = 0.5
ix3_bc = periodic
ox3_bc = periodic
layout_invariant_mode = tile
layout_tile = 4

<meshblock>
nx1 = 128
nx2 = 4
nx3 = 1

<time>
integrator = rk2
nlim = -1
tlim = 200.0
ndiag = 1000000
dt_fixed = 0.5

<hydro>
eos = ideal
gamma = 1.666666666666667
rad_signal_speed_diff = true
fofc = true
dfloor_flux_limit = true
dfloor_keep_velocity = true
rad_signal_speed_phase = true

<rad_vet>
vet_scatter = true
vet_gd_rotate_every = 0
time2_reject = retry
# --- this test's physics ---
c_light = 1.0
arad = 1e+30
e_floor = 1.0e-30
kappa_p = 300.0
implicit_bc_x1min = marshak
implicit_bc_x1max = marshak
implicit_ebath_x1min = 1.0e-10
clean_clos1_budget = true
clean_bud_maxnorm = true
clean_maxit = 200
clean_wb_exch_local = true

<problem>
pgen_name = rad_vet_beam
vet_test = marshak
gas_rho = 1.0
gas_temp = 1.0e-12

<output1>
file_type = bin
bin_double = true
variable = vet
dt = 50.0

<output2>
file_type = bin
bin_double = true
variable = hydro_w
dt = 50.0
