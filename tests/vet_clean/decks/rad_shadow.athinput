# Shadow test (Hayes & Norman 2003, ApJS 147, 197; Jiang et al. 2012, ApJS 199, 14): a
# dense elliptical clump (1000 x ambient, Fermi edge, opacity 0.1 (T/T0)^-3.5 (rho/rho0)^2
# per cm) in a thin ambient gas at T0 = 290 K, illuminated from x1min by a T_r = 1740 K
# bath (Marshak face; vacuum Marshak faces elsewhere). The gas is a
# prescribed static background (user source, gas_feedback = false); run for 3 light-crossing
# times (steady after ~2). cgs, T in kelvin.
# Used by: shadow.

<job>
basename = sh

<mesh>
nx1 = 140
x1min = 0.0
x1max = 1.0
ix1_bc = outflow
ox1_bc = outflow
nx2 = 80
x2min = -0.12
x2max = 0.12
ix2_bc = outflow
ox2_bc = outflow
nx3 = 1
x3min = -0.5
x3max = 0.5
ix3_bc = periodic
ox3_bc = periodic
layout_invariant_mode = tile
layout_tile = 16

<meshblock>
nx1 = 140
nx2 = 80
nx3 = 1

<time>
integrator = rk2
nlim = -1
tlim = 1.0007e-10
ndiag = 1000000
dt_retry_fac_t2 = 0.9
dt_retry_grow = 1.1
dt_retry_ngood = 20

<hydro>
eos = ideal
gamma = 1.666666666666667
rad_signal_speed_diff = true
fofc = true
dfloor_flux_limit = true
dfloor_keep_velocity = true
rad_signal_speed_phase = true

<rad_vet>
vet_scatter = true
vet_gd_rotate_every = 0
time2_reject = retry
# --- this test's physics ---
c_light = 2.99792458e10
arad = 7.5657e-15
e_floor = 1.0e-30
opacity = powerlaw
kappa_p = 0.1
t_ref = 290.0
opac_a = 1.0
opac_b = -3.5
gas_feedback = false
implicit_cfl = 4.0
implicit_bc_x1min = marshak
implicit_bc_x1max = marshak
implicit_ebath_x1min = 6.93499432e-02
implicit_bc_x2min = marshak
implicit_bc_x2max = marshak
clean_clos1_budget = true
clean_bud_maxnorm = true
clean_maxit = 200
clean_wb_exch_local = true

<problem>
pgen_name = rad_vet_beam
vet_test = shadow
user_srcs = true
shadow_rho0 = 1.0
shadow_ratio = 1.0e3
shadow_t0 = 290.0
shadow_tr = 1740.0
shadow_x0 = 0.5
shadow_y0 = 0.0
shadow_ax = 0.1
shadow_ay = 0.06
shadow_delta = 10.0

<output1>
file_type = bin
bin_double = true
variable = vet
dt = 1.0e30

<output2>
file_type = bin
bin_double = true
variable = hydro_w
dt = 1.0e30
