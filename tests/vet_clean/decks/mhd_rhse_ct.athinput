# Grey scattering envelope in hydrostatic + radiative equilibrium (2-D Cartesian, uniform gravity) with <mhd>:
# must stay at rest, without and with a force-free field (rh_b1 ...), well-balanced
# statically or (from the test) dynamically. Used by: mhd_wb.

<job>
basename = rh

<mesh>
nx1 = 48
x1min = 1.0
x1max = 2.0
ix1_bc = reflect
ox1_bc = reflect
nx2 = 4
x2min = 0.0
x2max = 0.25
ix2_bc = periodic
ox2_bc = periodic
nx3 = 1
x3min = 0.0
x3max = 0.25
ix3_bc = periodic
ox3_bc = periodic
layout_invariant_mode = tile
layout_tile = 4

<meshblock>
nx1 = 48
nx2 = 4
nx3 = 1

<time>
nlim = -1
tlim = 2.5

<mhd>
eos = ideal
reconstruct = plm
rsolver = hlld
gamma = 1.666666666666667
rad_signal_speed = true
wellbalance_static = true
wellbalance_static_reconst = true
fofc = true

<rad_vet>
c_light = 40.0
e_floor = 1.0e-30
kappa_s = 500.0
kappa_p = 0.0
kappa_e = 0.0
kappa_f = 0.0
arad = 1.0
implicit_cfl = 1.0e4
implicit_bc_x1min = marshak
implicit_bc_x1max = marshak
steady_init = steady
force_reference = clean
closure_w_c0 = 0.1
closure_w_c1 = 0.5

<problem>
pgen_name = rad_vet_beam
vet_test = rhse
user_srcs = true
user_hist = true
rh_gm = 1.0
rh_eddf = 0.3
rh_rho0 = 1.0
rh_temp = 0.1
rh_seed = 0.0

<output1>
file_type = hst
data_format = %24.16e
dt = 0.25
