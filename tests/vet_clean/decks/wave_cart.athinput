# Linear radiation-hydrodynamic wave (absorption opacity 0.1, c = 10, Cartesian, periodic),
# run for one wave period; the space ladder doubles mesh/nx1 (dt follows the CFL). Used by: order_space,
# momentum_box (8^3 3-D box along the xyz diagonal, see run_tests.py).

<job>
basename = rw

<mesh>
nx1 = 128
x1min = 0.0
x1max = 1.0
ix1_bc = periodic
ox1_bc = periodic
nx2 = 4
x2min = 0.0
x2max = 1.0
ix2_bc = periodic
ox2_bc = periodic
nx3 = 1
x3min = 0.0
x3max = 1.0
ix3_bc = periodic
ox3_bc = periodic
layout_invariant_mode = tile
layout_tile = 4

<meshblock>
nx1 = 128
nx2 = 4
nx3 = 1

<time>
integrator = rk2
nlim = -1
tlim = 0.78540321427322368
ndiag = 1000000
dt_retry_grow = 1.1
dt_retry_ngood = 20

<hydro>
eos = ideal
gamma = 1.666666666666667
fofc = true
dfloor_flux_limit = true
dfloor_keep_velocity = true
rad_signal_speed_diff = true
rad_signal_speed_phase = true

<rad_vet>
c_light = 10
closure = vet_sc
e_floor = 1.0e-30
kappa_p = 0.10000000000000001
arad = 0.99999899999999997
implicit_cfl = 3.9270160713661184
vet_gd_rotate_dt = 0
vet_x1_ptol = 1e-14
vet_x1_npass = 134
clean_clos1_budget = true
clean_bud_maxnorm = true
clean_maxit = 200
clean_wb_exch_local = true

<problem>
pgen_name = rad_vet_beam
vet_test = radwave
radwave_dir = x1
radwave_amp = 0.001
radwave_rho = 1.0
radwave_t = 1.0
radwave_eig = true
radwave_eig_e_im = -0.032155385993023734
radwave_eig_e_re = 0.018340471605928423
radwave_eig_f_im = -0.043031774358025882
radwave_eig_f_re = -0.0105636070755267
radwave_eig_t_im = -0.20649942415320247
radwave_eig_t_re = 0.61384761086627249
radwave_eig_v_im = -0.082219710533449439
radwave_eig_v_re = 1.2732313566164284

<output1>
file_type = bin
bin_double = true
variable = vet
dt = 1.0e30

<output2>
file_type = bin
bin_double = true
variable = hydro_w
dt = 1.0e30
