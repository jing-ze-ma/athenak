# Thermal relaxation of a uniform gas + radiation box (Jiang 2021 ApJS 253 49, sec. 4.1):
# E(t), T(t) against the exact ODE. Used by: thermal_eq.

<job>
basename = eq1

<mesh>
nx1 = 32
x1min = 0.0
x1max = 1.0
ix1_bc = periodic
ox1_bc = periodic
nx2 = 32
x2min = 0.0
x2max = 1.0
ix2_bc = periodic
ox2_bc = periodic
nx3 = 1
x3min = -0.5
x3max = 0.5
ix3_bc = periodic
ox3_bc = periodic
layout_invariant_mode = tile
layout_tile = 16

<meshblock>
nx1 = 32
nx2 = 32
nx3 = 1

<time>
integrator = rk2
nlim = -1
tlim = 2.0e-5
dt_fixed = 2.5e-7

<hydro>
eos = ideal
gamma = 1.666666666666667
fofc = true
dfloor_flux_limit = true
dfloor_keep_velocity = true
rad_signal_speed_diff = true
rad_signal_speed_phase = true

<rad_vet>
closure = vet_sc
vet_scatter = true
vet_gd_rotate_every = 0
time2_reject = retry
c_light = 100.0
arad = 1.0
e_floor = 1.0e-30
kappa_p = 100.0
implicit_bc_x1min = periodic
implicit_bc_x1max = periodic
vet_nmu = 8
vet_nphi = 32
implicit_cfl = 0.016
vet_x1_npass = 2
clean_clos1_budget = true
clean_bud_maxnorm = true
clean_maxit = 200
clean_wb_exch_local = true

<problem>
pgen_name = rad_vet_beam
vet_test = equil
user_srcs = false
gas_rho = 1.0
gas_eint = 1.5
e_rad = 100.0
gas_vx = 0.0

<output1>
file_type = bin
bin_double = true
variable = vet
dt = 1.0e-6

<output2>
file_type = bin
bin_double = true
variable = hydro_w
dt = 1.0e-6
