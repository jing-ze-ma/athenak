# Closed rotating scattering shell with <mhd> on a 3-D spherical-polar wedge (reflecting radial
# and theta walls, periodic phi), an azimuthal field, Ohmic and ambipolar diffusion, FOFC.
# Used by: mhd_vet.
#
# The <rad_vet> block starts with the scheme keys that production pins (the values of the
# production star decks); the rest are this test's physics, grid and solver set-up.

<job>
basename = sp

<mesh>
nx1 = 32
x1min = 1.0
x1max = 5.0
ix1_bc = reflect
ox1_bc = reflect
nx2 = 16
x2min = 1.1707963267948966
x2max = 1.9707963267948967
ix2_bc = reflect
ox2_bc = reflect
nx3 = 16
x3min = 0.0
x3max = 1.0471975511965976
ix3_bc = periodic
ox3_bc = periodic
use_spherical_polar = true
layout_invariant_mode = tile
layout_tile = 8

<meshblock>
nx1 = 32
nx2 = 16
nx3 = 16

<time>
nlim = 8
tlim = 580.8
ndiag = 1000000

<mhd>
eos = ideal
reconstruct = plm
rsolver = hlld
gamma = 1.666666666666667
rad_signal_speed = true
fofc = true
ohmic_resistivity = constant
eta_ohm_const = 1.0e-3
ambipolar = constant
eta_ad = 1.0e-3

<rad_vet>
c_light = 10.0
e_floor = 1.0e-30
kappa_s = 1e-2
arad = 1.0
implicit_cfl = 226.875
implicit_bc_x1min = reflect
implicit_bc_x1max = reflect
implicit_ebath_x1max = 4.5399929762484854e-05
vet_gd_rotate_dt = 0

<problem>
pgen_name = rad_vet_beam
vet_test = sph_shell
gas_rho = 1e2
gas_temp = 1e-4
e_out = 4.5399929762484854e-05
e_amp = 1.0
r0 = 3.0
user_hist = true
am_hist = true
gas_rot = 2.0e-3
gas_vth = 2.0e-3
b_azi = 0.05
width = 0.15811388300841897
lat_amp = 0.5
lat_l2 = 1.0

<output1>
file_type = bin
bin_double = true
variable = vet
dt = 1.0e30

<output2>
file_type = bin
bin_double = true
variable = mhd_u_bcc
dt = 1.0e30

<output3>
file_type = hst
data_format = %24.16e
dt = 1.0e-12

<output4>
file_type = bin
bin_double = true
variable = mhd_divb
dt = 1.0e30
