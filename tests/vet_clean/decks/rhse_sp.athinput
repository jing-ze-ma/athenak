# Grey scattering envelope in hydrostatic + radiative equilibrium (2-D spherical polar):
# must stay at rest (well-balancing). Used by: wb_sp.

<job>
basename = rh

<mesh>
nx1 = 48
x1min = 1.0
x1max = 2.0
ix1_bc = reflect
ox1_bc = reflect
nx2 = 4
x2min = 1.3707963267948966
x2max = 1.7707963267948966
ix2_bc = reflect
ox2_bc = reflect
nx3 = 1
x3min = 0.0
x3max = 1.0471975511965976
ix3_bc = periodic
ox3_bc = periodic
use_spherical_polar = true
layout_invariant_mode = tile
layout_tile = 4

<meshblock>
nx1 = 48
nx2 = 4
nx3 = 1

<time>
integrator = rk2
nlim = -1
tlim = 10.0
dt_retry_grow = 1.1
dt_retry_ngood = 20

<hydro>
eos = ideal
gamma = 1.666666666666667
wellbalance_static = true
wellbalance_static_reconst = true
fofc = true
dfloor_flux_limit = true
dfloor_keep_velocity = true
rad_signal_speed_diff = true
rad_signal_speed_phase = true

<rad_vet>
c_light = 40.0
e_floor = 1.0e-30
kappa_s = 500.0
arad = 1.0
implicit_cfl = 1.0e4
implicit_bc_x1min = marshak
implicit_bc_x1max = marshak
clean_init = steady
force_reference = clean
clean_w_c0 = 0.1
clean_w_c1 = 0.5
clean_maxit = 200
clean_clos1_budget = true
clean_bud_maxnorm = true
clean_wb_exch_local = true
vet_gd_gl_nmu = 7
vet_gd_gl_nphi = 18
vet_gd_wall_interp = true
vet_gd_wall_sym = true

<problem>
pgen_name = rad_vet_beam
vet_test = rhse
user_srcs = true
user_hist = true
rh_gm = 1.0
rh_eddf = 0.3
rh_rho0 = 1.0
rh_temp = 0.1
rh_seed = 0.0

<output1>
file_type = hst
data_format = %24.16e
dt = 0.25
