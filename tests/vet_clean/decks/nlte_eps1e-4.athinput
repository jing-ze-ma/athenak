# Two-level-atom non-LTE atmosphere, eps = 1e-4 (Jiang 2021 ApJS 253 49, sec. 4.5):
# J against the exact transport solution in ref/. Used by: nlte_eps1e-4.

<job>
basename = nlte4

<mesh>
nx1 = 1280
x1min = -10.0
x1max = 10.0
ix1_bc = outflow
ox1_bc = outflow
nx2 = 4
x2min = -0.5
x2max = 0.5
ix2_bc = periodic
ox2_bc = periodic
nx3 = 1
x3min = -0.5
x3max = 0.5
ix3_bc = periodic
ox3_bc = periodic
layout_invariant_mode = tile
layout_tile = 4

<meshblock>
nx1 = 1280
nx2 = 4
nx3 = 1

<time>
evolution = kinematic
nlim = 60
tlim = 1.0e30

<hydro>
eos = ideal
rsolver = advect
gamma = 1.000001

<rad_vet>
vet_rotate_avg = 4
vet_scatter = true
c_light = 1.0
arad = 1.0
e_floor = 1.0e-30
kappa_p = 0.0001
kappa_s = 0.9999
gas_feedback = false
implicit_bc_x1min = marshak
implicit_bc_x1max = marshak
implicit_ebath_x1min = 1.0
vet_nmu = 8
vet_nphi = 32
implicit_cfl = 1.0e6

<problem>
pgen_name = rad_vet_beam
vet_test = atmosphere
user_srcs = true
atm_rho_top = 1.0e-3
atm_scale_h = 1.0
atm_flux = 1.0e-8
atm_temp = 1.0

<output1>
file_type = bin
bin_double = true
variable = vet
dt = 1.0e30
