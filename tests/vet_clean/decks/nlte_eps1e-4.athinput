# Two-level-atom non-LTE atmosphere, eps = 1e-4 (Jiang 2021 ApJS 253 49, sec. 4.5):
# J against the exact transport solution in ref/. Used by: nlte_eps1e-4.
#
# The <rad_vet> block starts with the scheme keys that production pins (the values of the
# production star decks); the rest are this test's physics, grid and solver set-up.

<job>
basename = nlte4

<mesh>
layout_invariant = true
nghost = 2
nx1 = 1280
x1min = -10.0
x1max = 10.0
ix1_bc = outflow
ox1_bc = outflow
nx2 = 4
x2min = -0.5
x2max = 0.5
ix2_bc = periodic
ox2_bc = periodic
nx3 = 1
x3min = -0.5
x3max = 0.5
ix3_bc = periodic
ox3_bc = periodic

<meshblock>
nx1 = 1280
nx2 = 4
nx3 = 1

<time>
dt_retry = true
dt_retry_fac_t2 = 0.9
dt_retry_grow = 1.1
dt_retry_ngood = 20
evolution = kinematic
integrator = rk2
cfl_number = 0.4
nlim = 60
tlim = 1.0e30
ndiag = 1

<hydro>
eos = ideal
reconstruct = plm
rsolver = advect
gamma = 1.000001

<rad_vet>
# --- production scheme keys ---
zalesak_active = true
clean_stag_xdonor = lag
clean_stag_xsrc = true
implicit_pos_floor_gas_keep = 1
implicit_pos_gas_cons = true
clean_stag_mg_color = mirror
time2_k1_redist = 0
time2_tableau = sdirk2
clean_face_hctau = true
clean_stag_upwind_central = true
clean_w_fse_tau = true
clean_stag_fwb_stage = false
clean_stag_fwb_t2 = false
time2_gtime_mom = true
time2_k1_stiff = 0
clean_pred_stage = false
clean_stag_central = true
clean_stag_kpat = false
clean_stag_eicarry = true
clean_gas_secant = max_stage2
clean_pred_xch = true
clean_stag_fcone_gas = false
# --- this test ---
clean_layout = staggered
scheme = clean
clean_cs_lz_abs = 2
clean_stag_csvec_radial = true
closure = vet_sc
time2_vet_col_source = blend
time_scheme = hesdirk2
time2_start = be
vet_rotate_avg = 4
vet_col_lat_cut_thin = 1.0
vet_gd_rotate_t0 = 0.0
vet_gd_rotate_align = true
vet_source_noesrc = true
vet_scatter = true
vet_scatter_form = ma
vet_scatter_j = relaxed
implicit_pos_floor_solve = true
vet_col_lat_taucut = 30.0
vet_gd_gl_nmu = 10
vet_gd_gl_nphi = 12
vet_gd_gl_stagger = true
vet_gd_rotate_every = 10
vet_col_lat_offdiag = operator
vet_gd_tangential = false
vet_gd_wall_interp = true
vet_gd_halo_compact = 2
implicit_resid_fatal = 1.0e-2
implicit_pos_gas = true
implicit_pos_floor = true
vet_col_every = 1
time2_reject = retry
vet_col_ncore = 8
vet_col_nsub = 1
vet_col_nmu = 4
vet_col_fk_min = 0
vet_col_reflect_top = 1
vet_col_surface_face = 1
vet_col_surface_q = 1
vet_col_surface_qmin = 0.001
vet_col_surface_qmax = 1
vet_col_axis = radial
time2_enth_be = true
implicit_tol_rel_max = 1.0e-4
c_light = 1.0
chat_over_c = 1.0
arad = 1.0
e_floor = 1.0e-30
opacity = const
kappa_p = 0.0001
kappa_e = 0.0001
kappa_f = 0.0001
kappa_s = 0.9999
coupling = true
gas_feedback = false
transport = implicit
implicit_bc_x1min = marshak
implicit_bc_x1max = marshak
implicit_ebath_x1min = 1.0
implicit_ebath_x1max = 0.0
vet_nmu = 8
vet_nphi = 32
implicit_cfl = 1.0e6

<problem>
pgen_name = rad_vet_beam
vet_test = atmosphere
user_srcs = true
atm_rho_top = 1.0e-3
atm_scale_h = 1.0
atm_flux = 1.0e-8
atm_temp = 1.0

<output1>
file_type = bin
bin_double = true
variable = vet
dt = 1.0e30
