# Uniform optically thick medium (tau_cell = 1e5) moving at v = 0.01 c, initialised at the
# fixed point of the radiation-matter coupling (comoving F0 = 0, E0 = arad T^4; He, Wibking
# & Krumholz 2024, MNRAS 531, 1228, sec. 5.5): the gas temperature and E must not move.
# cgs, periodic. Used by: advect_uniform.

<job>
basename = au

<mesh>
nx1 = 64
x1min = 0.0
x1max = 64.0
ix1_bc = periodic
ox1_bc = periodic
nx2 = 4
x2min = -0.5
x2max = 0.5
ix2_bc = periodic
ox2_bc = periodic
nx3 = 1
x3min = -0.5
x3max = 0.5
ix3_bc = periodic
ox3_bc = periodic
layout_invariant_mode = tile
layout_tile = 4

<meshblock>
nx1 = 64
nx2 = 4
nx3 = 1

<time>
integrator = rk2
nlim = -1
tlim = 1.23e-7
ndiag = 1000000
dt_retry_fac_t2 = 0.9
dt_retry_grow = 1.1
dt_retry_ngood = 20

<hydro>
eos = ideal
gamma = 1.666666666666667
rad_signal_speed_diff = true
fofc = true
dfloor_flux_limit = true
dfloor_keep_velocity = true
rad_signal_speed_phase = true

<rad_vet>
closure = vet_sc
vet_scatter = true
vet_gd_rotate_every = 0
time2_reject = retry
# --- this test's physics ---
c_light = 2.99792458e10
arad = 4.8032223745536764e-45
e_floor = 1.0e-30
kappa_p = 83333.33333333333
implicit_bc_x1min = periodic
implicit_bc_x1max = periodic
vet_x1_npass = 2
clean_clos1_budget = true
clean_bud_maxnorm = true
clean_maxit = 200
clean_wb_exch_local = true

<problem>
pgen_name = rad_vet_beam
vet_test = advect_uniform
gas_rho = 1.2
gas_temp = 3.5426608899723244e14
pulse_v = 2.99792458e8

<output1>
file_type = bin
bin_double = true
variable = vet
dt = 2.0e-8

<output2>
file_type = bin
bin_double = true
variable = hydro_w
dt = 2.0e-8
