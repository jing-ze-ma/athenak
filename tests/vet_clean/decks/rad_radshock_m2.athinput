# Lowrie & Edwards (2008, Shock Waves 18, 129) steady radiative shock, Mach 2 (subcritical),
# in its own frame, cgs units (T_code = k T / (mu m_H), arad = a / tunit^4); initialised from
# the semi-analytic profile ref/idort_radshock_m2.txt and held by Dirichlet hydro faces (user BC)
# and Marshak radiation faces at the far-field equilibria. Used by: radshock.
#
# The <rad_vet> block starts with the scheme keys that production pins (the values of the
# production star decks); the rest are this test's physics, grid and solver set-up.

<job>
basename = rs

<mesh>
layout_invariant = true
nghost = 3
nx1 = 256
x1min = 0.0
x1max = 1.52978124e-02
ix1_bc = user
ox1_bc = user
nx2 = 4
x2min = 0.0
x2max = 1.52978124e-02
ix2_bc = periodic
ox2_bc = periodic
nx3 = 1
x3min = -0.5
x3max = 0.5
ix3_bc = periodic
ox3_bc = periodic
layout_invariant_mode = tile
layout_tile = 4

<meshblock>
nx1 = 256
nx2 = 4
nx3 = 1

<time>
evolution = dynamic
integrator = rk2
cfl_number = 0.3
nlim = -1
tlim = 2.0e-10
ndiag = 1000000
dt_retry = true
dt_retry_fac_t2 = 0.9
dt_retry_grow = 1.1
dt_retry_ngood = 20

<hydro>
eos = ideal
reconstruct = plm
rsolver = hllc
gamma = 1.666666666666667
rad_signal_speed = true
rad_signal_speed_diff = true
fofc = true
dfloor_flux_limit = true
dfloor_keep_velocity = true
rad_signal_speed_phase = true

<rad_vet>
# --- production scheme keys ---
zalesak_active = true
clean_stag_xdonor = lag
clean_stag_xsrc = true
implicit_pos_floor_gas_keep = 1
implicit_pos_gas_cons = true
clean_stag_mg_color = mirror
time2_k1_redist = 0
time2_tableau = sdirk2
clean_face_hctau = true
clean_stag_upwind_central = true
clean_w_fse_tau = true
clean_stag_fwb_stage = false
clean_stag_fwb_t2 = false
time2_gtime_mom = true
time2_k1_stiff = 0
clean_pred_stage = false
clean_stag_central = true
clean_stag_eicarry = true
clean_gas_secant = max_stage2
clean_pred_xch = true
clean_stag_fcone_gas = false
# --- this test ---
clean_layout = staggered
scheme = clean
clean_cs_lz_abs = 2
clean_stag_csvec_radial = true
closure = vet_sc
time2_vet_col_source = blend
time_scheme = hesdirk2
vet_rotate_avg = 0
vet_col_lat_cut_thin = 1.0
vet_gd_rotate_t0 = 0.0
vet_gd_rotate_align = true
vet_source_noesrc = true
vet_scatter = true
vet_scatter_form = ma
vet_scatter_j = relaxed
vet_gd_gl_nmu = 10
vet_gd_gl_nphi = 12
vet_gd_gl_stagger = true
vet_gd_rotate_every = 0
vet_gd_rotate_dt = 0
vet_col_lat_offdiag = operator
vet_gd_tangential = false
vet_gd_wall_interp = true
vet_gd_halo_compact = 2
implicit_resid_fatal = 1.0e-2
implicit_pos_gas = true
implicit_pos_floor = true
vet_col_every = 1
time2_reject = retry
vet_col_ncore = 8
vet_col_nsub = 1
vet_col_nmu = 4
vet_col_fk_min = 0
vet_col_reflect_top = 1
vet_col_surface_face = 1
vet_col_surface_q = 1
vet_col_surface_qmin = 0.001
vet_col_surface_qmax = 1
vet_col_axis = radial
time2_enth_be = true
implicit_tol_rel_max = 1.0e-4
# --- this test's physics ---
c_light = 2.99792458e10
chat_over_c = 1.0
arad = 1.6332399e-46
e_floor = 1.0e-30
opacity = powerlaw
kappa_p = 577.16
kappa_e = 577.16
kappa_f = 577.16
kappa_s = 0.0
rho_ref = 1.0
t_ref = 1.0
opac_a = -1.0
opac_b = 0.0
coupling = true
gas_feedback = true
transport = implicit
implicit_cfl = -1.0
implicit_bc_x1min = marshak
implicit_bc_x1max = marshak
implicit_ebath_x1min = 1.70873641e+11
implicit_ebath_x1max = 3.18344778e+12
vet_nmu = 4
vet_nphi = 8
clean_clos1_budget = true
clean_bud_maxnorm = true
clean_maxit = 200
clean_wb_exch_local = true

<problem>
pgen_name = rad_vet_beam
vet_test = radshock
vet_shock_tunit = 8.2499208e7
vet_shock_ref = ../tests/vet_clean/ref/idort_radshock_m2.txt
vet_shock_w = 2.0
vet_shock_rho_l = 5.69000000e+00
vet_shock_v_l = 3.46264132e+07
vet_shock_t_l = 2.18000000e+06
vet_shock_rho_r = 1.30077662e+01
vet_shock_v_r = 1.51466661e+07
vet_shock_t_r = 4.52910259e+06
vet_shock_xs = 1.00251232e-02

<output1>
file_type = bin
bin_double = true
variable = vet
dt = 5.0e-11

<output2>
file_type = bin
bin_double = true
variable = hydro_w
dt = 5.0e-11
