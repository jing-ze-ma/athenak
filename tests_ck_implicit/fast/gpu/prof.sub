#!/bin/bash -l
#SBATCH -o /viper/ptmp2/jinma/ckfast_0923/prof/log.out.%j
#SBATCH -e /viper/ptmp2/jinma/ckfast_0923/prof/log.err.%j
#SBATCH -J ckfast_p
#SBATCH -p apudev
#SBATCH --ntasks=2
#SBATCH --constraint="apu"
#SBATCH --gres=gpu:2
#SBATCH --cpus-per-task=24
#SBATCH --time=00:14:50
# ck-fast rocprofv3 kernel+kokkos+memcpy+hip-runtime traces, ~45 cycles per arm
# usage: sbatch prof.sub <tag> <rst> <arms...>
source /viper/ptmp2/jinma/ckfast_0923/common.sh
TAG=$1; RST=$2; shift 2
T0=$(head -c 300000 $RST | strings | sed -n '/<output4>/,/<output5>/p' | grep last_time | head -1 | awk '{print $3}')
TL=$(python3 -c "print($T0+700.0)")
echo "RST $RST T0=$T0 BIN md5=$(md5sum $BIN | cut -c1-32)"
for a in "$@"; do
  d=$P/prof/$TAG/$a; mkdir -p $d; cd $d
  srun -n 2 rocprofv3 --kernel-trace --kokkos-trace --memory-copy-trace --hip-runtime-trace --stats \
      --output-format csv -d $d/out -- $BIN -r $RST -i $INP -t 00:03:00 \
      output3/dt=1e30 output4/dt=1e30 time/ndiag=1 time/tlim=$TL $(args $a) > run.log 2>run.err
  echo "rc_$a=$?"
  rm -rf rst bin 2>/dev/null
done
echo CKFAST_PROF_DONE
