# AthenaK input file for the magnetized Gresho vortex at low Mach number

<comment>
problem   = magnetized Gresho vortex
reference = Gresho & Chan, Int. J. Numer. Methods Fluids, 11, 621 (1990)

<job>
basename  = gresho     # problem ID: basename of output filenames

<mesh>
nghost    = 3          # Number of ghost cells
nx1       = 64         # Number of zones in X1-direction
x1min     = -0.5       # minimum value of X1
x1max     = 0.5        # maximum value of X1
ix1_bc    = periodic   # inner-X1 boundary flag
ox1_bc    = periodic   # outer-X1 boundary flag

nx2       = 64         # Number of zones in X2-direction
x2min     = -0.5       # minimum value of X2
x2max     = 0.5        # maximum value of X2
ix2_bc    = periodic   # inner-X2 boundary flag
ox2_bc    = periodic   # outer-X2 boundary flag

nx3       = 1          # Number of zones in X3-direction
x3min     = -0.5       # minimum value of X3
x3max     = 0.5        # maximum value of X3
ix3_bc    = periodic   # inner-X3 boundary flag
ox3_bc    = periodic   # outer-X3 boundary flag

<meshblock>
nx1       = 32         # Number of cells in each MeshBlock, X1-dir
nx2       = 32         # Number of cells in each MeshBlock, X2-dir
nx3       = 1          # Number of cells in each MeshBlock, X3-dir

<time>
evolution  = dynamic   # dynamic/kinematic/static
integrator = rk2       # time integration algorithm
cfl_number = 0.4       # The Courant, Friedrichs, & Lewy (CFL) Number
nlim       = -1        # cycle limit (no limit if <0)
tlim       = 1.2566370614  # one turnover of the rigidly rotating core, 2 pi/5
ndiag      = 100000    # cycles between diagostic output

<mhd>
eos         = ideal    # EOS type
reconstruct = plm      # spatial reconstruction method
rsolver     = hlld     # Riemann-solver to be used
gamma       = 1.666666666666667  # gamma = C_p/C_v

<problem>
pgen_name = gresho_mhd  # problem generator name
d0        = 1.0         # background density
mach      = 0.01        # peak rotation speed / sound speed
beta      = 100.0       # plasma beta of the uniform x1-field

<output1>
file_type   = hst       # History data dump
dt          = 0.0628318530  # time increment between outputs
data_format = %20.13e   # Optional data format string
