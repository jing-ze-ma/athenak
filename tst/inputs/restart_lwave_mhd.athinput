# AthenaK input file: 1D Cartesian MHD linear wave, restart-bitwise regression test.
#
# MHD twin of restart_lwave_hydro.athinput.  What it adds is the FACE-CENTRED field:
# the restart file has to carry b0.x1f/x2f/x3f as well as u0, and the restarted run has
# to rebuild the cell-centred field from exactly those faces, or the two final dumps
# differ in bcc (and, one cycle later, everywhere).  See that file for the output
# layout and for how the test drives the two runs.

<comment>
problem = 1D MHD linear wave, restart-bitwise regression test

<job>
basename = restart_lwave_mhd

<mesh>
nghost = 2
nx1    = 64
x1min  = 0.0
x1max  = 1.0
ix1_bc = periodic
ox1_bc = periodic

nx2    = 1
x2min  = -0.5
x2max  = 0.5
ix2_bc = periodic
ox2_bc = periodic

nx3    = 1
x3min  = -0.5
x3max  = 0.5
ix3_bc = periodic
ox3_bc = periodic

<meshblock>
nx1 = 32
nx2 = 1
nx3 = 1

<time>
evolution  = dynamic
integrator = rk2
cfl_number = 0.3
nlim       = 20
tlim       = 100.0
ndiag      = 100000

<mhd>
eos         = ideal
reconstruct = plm
rsolver     = hlld
gamma       = 1.66666666667

<problem>
pgen_name = linear_wave
wave_flag = 1          # fast magnetosonic wave
amp       = 1.0e-3
dens      = 1.0
pgas      = 0.6
vx0       = 0.0
vy0       = 0.0
vz0       = 0.0
bx0       = 1.0
by0       = 1.4142136
bz0       = 0.5
along_x1  = true
along_x2  = false
along_x3  = false

<output1>
file_type = rst
dcycle    = 10

<output2>
file_type   = bin
variable    = mhd_u_bcc
ghost_zones = true
dcycle      = 1000000

<output3>
file_type   = tab
variable    = mhd_u_bcc
data_format = %26.17e
ghost_zones = true
dcycle      = 1000000
