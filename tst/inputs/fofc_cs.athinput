# AthenaK input file: strong RADIAL double-rarefaction shock tube on the CUBED SPHERE,
# used to regression-test first-order flux correction (FOFC) on that grid.
#
# WHY THIS EXISTS.  <hydro>/fofc used to be a startup FATAL on the cubed sphere: the
# trial update divided by the Cartesian mb_size.dx1/2/3 rather than forming the
# area/volume divergence, the single-state LLF fallback applied none of the gnomonic
# rotations, and the floor-TEST pass never ran the DEFERRED floors that this grid
# applies in Coordinates::GnomonicEquiangleRaiseVel.  All three are fixed; this is the
# gate.
#
# The two rarefactions open a near-vacuum in the middle of the shell, which is what the
# first-order fallback exists for.  Both radial walls are REFLECTING and the angular
# directions are panel seams, so the domain is CLOSED and total mass is conserved to
# round-off -- comparable between the fofc=true and fofc=false runs.
# <hydro>/fofc is set from the command line by the test script.

<comment>
problem = cubed-sphere radial double rarefaction, FOFC regression test

<job>
basename = fofc_cs

<mesh>
nghost = 3             # FOFC with PLM requires nghost >= 3
nx1    = 32            # RADIAL
x1min  = 0.5
x1max  = 1.5
ix1_bc = reflect
ox1_bc = reflect

nx2    = 16            # xi; nx2 must equal nx3
x2min  = -1.0
x2max  = 1.0
ix2_bc = panel
ox2_bc = panel

nx3    = 16            # eta
x3min  = -1.0
x3max  = 1.0
ix3_bc = panel
ox3_bc = panel

use_cubed_sphere = true

<meshblock>
nx1 = 32
nx2 = 16
nx3 = 16

<time>
evolution  = dynamic
integrator = rk2
cfl_number = 0.3
nlim       = -1
tlim       = 0.02
ndiag      = 100000

<hydro>
eos         = ideal
reconstruct = plm
rsolver     = hllc
gamma       = 1.4
dfloor      = 1.0e-4
pfloor      = 1.0e-4
fofc        = true

<problem>
pgen_name = shock_tube
shock_dir = 1
xshock    = 1.0

dl = 1.0
pl = 0.4
ul = -20.0
vl = 0.0
wl = 0.0

dr = 1.0
pr = 0.4
ur = 20.0
vr = 0.0
wr = 0.0

<output1>
file_type = log
dt        = 0.002

<output2>
file_type   = hst
data_format = %24.16e
dt          = 0.002

<output3>
file_type = bin
variable  = hydro_w
dt        = 0.02
