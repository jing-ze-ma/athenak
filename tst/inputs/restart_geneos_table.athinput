# AthenaK input file: 1D hydro linear wave with the TABULATED general EOS,
# restart-bitwise regression test.
#
# WHY THIS CASE EXISTS.  The general EOS carries a temperature CACHE (w0's wtemp slot),
# the warm start for the e->T inversion in ConsToPrim.  The inversion is iterative, so
# the state it converges to depends, in the last bits, on where it started: if the
# cache is not written to and read back from the restart file, the restarted run starts
# its first inversion from a default guess, lands a few ULP away, and the run diverges
# from the continuous one.  That is exactly what commit 6740fae3 fixed, and this case
# is its gate.
#
# NOTE ON PRECISION.  The test compares this case on the 32-bit BINARY dump only.  At
# full double precision the restart is still an ulp away even with the cache restored,
# because Driver::Initialize runs a ConsToPrim the continuous run does not and the
# table's temperature root find is not exactly idempotent; see the test docstring.  The
# table output below is written anyway, so that the residual can be measured by hand.
#
# The run is in physical cgs (length_cgs = mass_cgs = time_cgs = 1) because a general
# EOS is not scale free; the background sits in the hydrogen partial-ionization zone,
# where the table (H2 dissociation + H/He Saha) is doing real work.

<comment>
problem = 1D hydro linear wave, tabulated general EOS, restart-bitwise test

<job>
basename = restart_geneos_table

<mesh>
nghost = 2
nx1    = 32
x1min  = 0.0
x1max  = 1.0e9
ix1_bc = periodic
ox1_bc = periodic

nx2    = 1
x2min  = 0.0
x2max  = 1.0e9
ix2_bc = periodic
ox2_bc = periodic

nx3    = 1
x3min  = 0.0
x3max  = 1.0e9
ix3_bc = periodic
ox3_bc = periodic

<meshblock>
nx1 = 32
nx2 = 1
nx3 = 1

<units>
length_cgs = 1.0
mass_cgs   = 1.0
time_cgs   = 1.0
mu         = 1.0

<time>
evolution  = dynamic
integrator = rk2
cfl_number = 0.3
nlim       = 20
tlim       = 1.0e30
ndiag      = 100000

<hydro>
eos         = general
general_eos = table
reconstruct = plm
rsolver     = hllc
gamma       = 1.66666666667   # unused when general_eos = table
dfloor      = 1.0e-12
pfloor      = 1.0e-2

eos_xh         = 0.7381
eos_yhe        = 0.2485
eos_h2         = true
eos_ionization = true
eos_radiation  = false
eos_logd_min   = -14.0
eos_logd_max   = 2.0
eos_logt_min   = 1.5
eos_logt_max   = 8.0
eos_dlogd      = 0.05
eos_dlogt      = 0.01

<problem>
pgen_name = linear_wave
wave_flag = 0
amp       = 1.0e-10     # absolute density perturbation: amp/dens = 1e-4
dens      = 1.0e-6      # g/cm^3
pgas      = 6.5e5       # erg/cm^3, about 10^4 K
vx0       = 0.0
along_x1  = true
along_x2  = false
along_x3  = false

<output1>
file_type = rst
dcycle    = 10

<output2>
file_type   = bin
variable    = hydro_u
ghost_zones = true
dcycle      = 1000000

<output3>
file_type   = tab
variable    = hydro_u
data_format = %26.17e
ghost_zones = true
dcycle      = 1000000
