<comment>
problem   = MHD Alfven wave damped by ambipolar diffusion (ambipolar-1101)
reference = tst/test_suite/mhd/test_ambipolar_alfven_cpu.py

<job>
basename  = AdAlfven

<mesh>
nghost    = 2
nx1       = 64
x1min     = 0.0
x1max     = 1.0
ix1_bc    = periodic
ox1_bc    = periodic
nx2       = 1
x2min     = 0.0
x2max     = 1.0
ix2_bc    = periodic
ox2_bc    = periodic
nx3       = 1
x3min     = 0.0
x3max     = 1.0
ix3_bc    = periodic
ox3_bc    = periodic

<meshblock>
nx1       = 64
nx2       = 1
nx3       = 1

<time>
evolution  = dynamic
integrator = rk2
cfl_number = 0.3
nlim       = -1
tlim       = 1.0      # wave periods (linear_wave rescales by lx/v_A)
ndiag      = 1000

<mhd>
eos         = ideal
reconstruct = plm
rsolver     = hlld
gamma       = 1.66666666667
ambipolar   = constant
eta_ad      = 0.02     # eta_A = eta_ad |B|^2
use_rkg_sts = false

<problem>
pgen_name = linear_wave
wave_flag = 5          # Alfven
amp       = 1.0e-6
dens      = 1.0
pgas      = 0.6
bx0       = 1.0
by0       = 1.4142136
bz0       = 0.5

<output1>
file_type   = tab
variable    = mhd_w_bcc
data_format = %.17e
dt          = 1.0
