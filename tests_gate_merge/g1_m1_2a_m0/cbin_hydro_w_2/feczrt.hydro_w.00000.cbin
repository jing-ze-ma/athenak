#------------------------- PAR_DUMP -------------------------
<comment>
problem = 3 Msun He-star iron convection zone, 3-D local box, mode-3 + PCR two-stream 
<job>
basename = feczrt 
<mesh>
nghost                    = 3            # fofc + plm needs >= 3
nx1                       = 134          # CHANGED from the B star's 336: the He column is 134 cells
x1min                     = -3.1410310e8 # CHANGED: the He box bottom (../he3_2turn)
x1max                     = 4.1290910e7  # CHANGED: the He box top, tau = 1e-2
ix1_bc                    = user         
ox1_bc                    = user         
nx2                       = 16           # UNCHANGED (W4 widens the EXTENT, not the count)
x2min                     = 0.0          
x2max                     = 1.10331276e9 # W4: 4 x the box_m3 width 2.7582819e8.  nx2 = 104 is
ix2_bc                    = periodic     
ox2_bc                    = periodic     
nx3                       = 16           # UNCHANGED, as nx2
x3min                     = 0.0          
x3max                     = 1.10331276e9 # W4: as x2max
ix3_bc                    = periodic     
ox3_bc                    = periodic     
use_cubed_sphere          = 0            # Default value added at run time
use_spherical_polar       = 0            # Default value added at run time
use_grid_stretch_r        = 0            # Default value added at run time
use_grid_stretch_r_poly   = 0            # Default value added at run time
use_grid_stretch_theta    = 0            # Default value added at run time
use_polar_boundary        = 0            # Default value added at run time
polar_quadratic_recon     = 0            # Default value added at run time
polar_x3_shift            = rotate       # Default value added at run time
use_polar_average_b       = 0            # Default value added at run time
use_polar_average_eresist = 1            # Default value added at run time
<meshblock>
nx1 = 134 # MUST equal <mesh>/nx1: rad_implicit_x1 solves a tridiagonal
nx2 = 8   # CHANGED from the B star's 108: 104/52 = 2 ...
nx3 = 8   # CHANGED from 54: 104/26 = 4 -> 2 x 4 = 8 MeshBlocks for
<time>
evolution             = dynamic  
integrator            = rk2      
cfl_number            = 0.3      
nlim                  = 50       
tlim                  = 1.5044e5 # CHANGED: 40 He turnovers x 3.761e3 s
dt_min                = 1.0e-6   # CHANGED from the B star's 1e-4: the He dt is ~0.1 s, 15x
ndiag                 = 500      
nan_check_cycles      = 50       
start_time            = 0        # Default value added at run time
restart_refill_ghosts = 0        # Default value added at run time
<units>
length_cgs = 1.0 
mass_cgs   = 1.0 
time_cgs   = 1.0 
mu         = 1.0 
<hydro>
eos_rad_rho_hi             = 6.0e-8       # CHANGED from the B star's 1e-8.  THE EOS RADIATION
eos_rad_rho_lo             = 6.0e-9       # TAPER, verbatim from ../qual_m3/Q2p.athinput: w = 1
eos                        = general      
general_eos                = table        
gamma                      = 1.6666666667 # unused by the table
eos_h2                     = false        # CHANGED from true: X = 0, there is no hydrogen
eos_ionization             = true         # He I -> II -> III is the whole ionization budget
eos_metal_ionization       = false        # CHANGED from true: dead code at X = 0 (the donor
eos_radiation              = true         # Prad/Pgas = 0.59 (bottom) .. 6.32 (top)
eos_xh                     = 0.0          # CHANGED from 0.70: the He opacity table is X = 0
eos_yhe                    = 0.98         # CHANGED from 0.286: Z = 1 - Y = 0.02
eos_logd_min               = -13.0        # CHANGED from -14: the box spans log rho
eos_logd_max               = -3.0         # = -8.68 .. -5.82
eos_logt_min               = 3.8          # the box spans log T = 4.84 .. 5.51
eos_logt_max               = 6.5          
eos_dlog                   = 0.02         # 501 x 676 nodes, 41 MB
reconstruct                = plm          
rsolver                    = lhllc        # all-Mach HLLC: the He convective Mach number is
etotgrav                   = true         
wellbalance_dynamic        = true         
wb_x1                      = true         
wb_option                  = polytropic   # the stratification is RADIATIVE, not isentropic
wb_cache_every             = 0            # BOX_W8: REBUILD THE WB BACKGROUND EVERY STAGE.
isotropic_conduction       = radiative    
rad_kappa_src              = table_rho    # the stellar Rosseland table is on (T, rho)
rad_kappa_fac              = 1.0          # NO BOOST
rad_flux_inner             = 2.475202e15  # CHANGED from the B star's 4.214e13: F = sigma
rad_flux_limit             = true         
rad_tau_lo                 = 1.0e5        # WHOLE-COLUMN TWO-STREAM (unchanged from the B
rad_tau_hi                 = 1.0e6        # star and from ../qual_m3): w(tau) = 0 on every
rad_implicit_x1            = true         # MANDATORY: chi_rad ~ 1e17-1e18 cm^2/s here, so
rad_x1_uform               = true         # U-FORM radial conduction (../qual_m3 Q1p2/Q2p)
rad_x1_kiter               = 2            # one Picard correction for d ln kappa/d ln T
rad_cap_ang                = 0            # OFF: replaced by the RKL1 transverse operator
rad_implicit_ang           = true         # IMPLICIT (RKL1) transverse radiative diffusion
rad_blend_transverse       = false        # MUST BE false HERE, as in the B star: with
rad_gate_rho               = 6.0e-9       # CHANGED from the B star's 1e-9.  Same RULE as
rad_ang_maxit              = 400          # RKL1 stage cap
rad_ang_verbose            = true         
rad_sts_perplane           = true         # per-plane RKL1 substage counts
rad_tr_tau_lo              = 0            # W4: TAPER OFF (0/0 = no taper): the
rad_tr_tau_hi              = 0            # transverse operator now runs EVERYWHERE, at
rad_ang_solver             = adi          # W4: DIRECT alternating-direction solve of the
rad_adi_scheme             = lod2         # W4: the symmetrised two-sub-step LOD splitting
rad_kappa_rmax             = 0.0          # MUST stay 0: it indexes x1v, never allocated on
tfloor                     = 5.0e3        # rt_use_cons clamps a non-positive e to e(rho,tfloor)
dfloor                     = 2.3206e-12   # CHANGED from the B star's 1e-12: 1e-3 x the
pfloor                     = 1.0e0        # 1.5e-5 of the top-cell pressure; should not fire
fofc                       = true         # first-order flux correction; dumped below
sp_wellbalanced_src        = 0            # Default value added at run time
sp_cart_polar_momentum     = 0            # Default value added at run time
sp_cart_all_momentum       = 0            # Default value added at run time
sp_face_avg                = 0            # Default value added at run time
sp_face_avg_terms          = 3            # Default value added at run time
cs_cart_momentum           = 0            # Default value added at run time
dfloor_keep_velocity       = 0            # Default value added at run time
dfloor_keep_temperature    = 0            # Default value added at run time
vceil                      = 0            # Default value added at run time
vceil_thermalise           = 0            # Default value added at run time
eos_floor_consistent       = 0            # Default value added at run time
efloor_from_ekin           = 0            # Default value added at run time
efloor_as_tfloor           = 0            # Default value added at run time
sfloor                     = 1.17549e-38  # Default value added at run time
eos_a_metal                = 16           # Default value added at run time
eos_metal_mh               = 0            # Default value added at run time
eos_metal_condensation     = 0            # Default value added at run time
eos_metal_tcond            = 0            # Default value added at run time
eos_rad_t_hi               = 0            # Default value added at run time
eos_rad_t_lo               = 0            # Default value added at run time
eos_dlogd                  = 0.02         # Default value added at run time
eos_dlogt                  = 0.004        # Default value added at run time
eos_table_dump             =              # Default value added at run time
nscalars                   = 0            # Default value added at run time
kappa_iso_limit            = 3.40282e+38  # Default value added at run time
rad_met                    = 0            # Default value added at run time
rad_pcut_bar               = 0            # Default value added at run time
rad_flim_legacy            = 0            # Default value added at run time
rad_tmax_kappa             = 0            # Default value added at run time
rad_cs_exact               = 1            # Default value added at run time
rad_kappa_above            = 0            # Default value added at run time
rad_gate_dex               = 0.5          # Default value added at run time
rad_blend_radial           = 1            # Default value added at run time
rad_blend_use_2s           = 0            # Default value added at run time
rad_sts_all                = 0            # Default value added at run time
