# AthenaK input file for the grey M1 ADVECTED THICK PULSE (design note T4)
#
# Krumholz, Klein & McKee (2007) Sect. 4.3 / QUOKKA AP paper (arXiv:2404.08247) Sect. 5:
# a Gaussian temperature pulse in radiative equilibrium, in a medium that is either at
# rest (static case) or moving uniformly at v (dynamic case), periodic box.
#
#   T(x)   = T0 + (T1 - T0) exp(-(x - x0)^2/(2 w^2))
#   rho(x) = [P_tot - arad T^4/3]/T,  P_tot = rho0 T0 + arad T0^4/3   (TOTAL pressure
#            uniform: gas + radiation, which is what Krumholz et al. prescribe; a pulse
#            at uniform GAS pressure is pushed apart by the radiation pressure gradient)
#   E      = arad T^4,   F = (4/3) v E - (c/(3 rho kappa)) dE/dx
#
# UNITS.  cgs, except that the code temperature is T_code = k T_K/(mu m_H) with
# mu = 2.33 (the QUOKKA value), so that P = rho T_code.  Hence
#   T0 = 1e7 K   -> 3.5426608899723244e14
#   T1 = 2e7 K   -> 7.0853217799446490e14
#   arad = a_cgs (mu m_H/k)^4 = 4.8032223745536764e-45
# and arad T0^4 = 7.5657e13 erg/cm^3 = a_cgs (1e7 K)^4, as it must.
#
# STATIC case (the defaults here): kappa = 100, v = 0, tau = rho0 kappa w = 2.88e3.
# DYNAMIC case:  rad_m1/kappa_p=500 problem/pulse_v=3.0e7
#                (tau = 1.44e4, beta = 1.0e-3, beta tau = 14).
# Run both at mesh/nx1 = 512 and 1024 with the same tlim and compare the profiles
# (tests_m1/t4_advect.py).
#
# The domain is 512 cm wide, w = 24 cm, and tlim = 4.8e-6 s moves the dynamic pulse
# 144 cm = 6 w.

<comment>
problem = grey M1 advected thick pulse

<job>
basename = m1_t8

<mesh>
nghost    = 2
nx1       = 512
x1min     = -256.0
x1max     = 256.0
ix1_bc    = periodic
ox1_bc    = periodic

nx2       = 1
x2min     = -0.5
x2max     = 0.5
ix2_bc    = periodic
ox2_bc    = periodic

nx3       = 1
x3min     = -0.5
x3max     = 0.5
ix3_bc    = periodic
ox3_bc    = periodic

<meshblock>
nx1       = 512
nx2       = 1
nx3       = 1

<time>
evolution  = dynamic
integrator = rk2
cfl_number = 0.4
nlim       = -1
tlim       = 4.8e-6
ndiag      = 100000

<hydro>
eos         = ideal
reconstruct = plm
rsolver     = hllc
gamma       = 1.666666666666667

<rad_m1>
c_light      = 2.99792458e10
chat_over_c  = 1.0
cfl_rad      = 0.4
reconstruct  = plm
thick_flux   = ap_hll   # none | ap_hll | scaled
scaled_prefactor = 20.0
ap_form      = alpha2   # alpha2 | unified
advect_split = true     # the moving-media enthalpy-flux split (design sect. 3)
source_form  = full     # full | ovc  (ovc is the FAILING CONTROL)
closure      = m1
e_floor      = 1.0e-10
subcycle     = true
opacity      = const
kappa_p      = 500.0    # ABSORPTION (kappa_e and kappa_f default to it), so gas and
kappa_s      = 0.0      # radiation are locked to one temperature, as the test assumes
arad         = 4.8032223745536764e-45
coupling     = true
gas_feedback = true

<problem>
pgen_name   = rad_m1_beam
m1_test     = advect_pulse
gas_rho     = 1.2
pulse_t0    = 3.5426608899723244e14
pulse_t1    = 7.0853217799446490e14
pulse_width = 24.0
pulse_x0    = 0.0
pulse_v     = 3.0e7

<output1>
file_type   = tab
variable    = m1
data_format = %26.17e
dt          = 4.8e-6

<output2>
file_type   = tab
variable    = hydro_w
data_format = %26.17e
dt          = 4.8e-6

<output3>
file_type   = rst
dt          = 2.4e-6

<output4>
file_type   = hst
dt          = 4.8e-7
