#!/bin/bash -l
#SBATCH -J wgG13
#SBATCH -p apudev
#SBATCH -N 1
#SBATCH --constraint="apu"
#SBATCH --gres=gpu:2
#SBATCH --ntasks-per-node=2
#SBATCH --cpus-per-task=24
#SBATCH --time=00:10:00
#SBATCH -o /viper/ptmp2/jinma/sprhd_0926/gpu/log/g13.%j.out
# sponge-default gate on the He sph_wedge (84x32x32, seed 1e-3, 40 cycles, rst at 20, 2 GPUs):
#  A: b5 + wg_sponge_rate 0.02 explicit  vs  n5 without the key (new default)
#  B: b5 without the key (old default 0) vs  n5 + wg_sponge_rate 0.0 explicit
#  n5 restart 20 -> 40 of arm A
module purge
module load gcc/14 rocm/6.3 openmpi_gpu/5.0
export HSA_XNACK=1
export HSA_NO_SCRATCH_RECLAIM=1
export OMP_NUM_THREADS=1
W=/viper/ptmp2/jinma/sprhd_0926; R=$W/gpu/g13
G="time/nlim=40 time/ndiag=20 problem/wg_seed=1.0e-3 output1/dt=0.5 output2/dt=3.0 output3/dt=3.0 output4/dcycle=20"
run() { local d=$1 b=$2; shift 2; mkdir -p $R/$d; cd $R/$d
  srun --export=ALL -n 2 --exact --cpus-per-task=24 bash -c \
    'export ROCR_VISIBLE_DEVICES=$SLURM_LOCALID; exec "$0" "$@"' $W/bin/athena_${b}_none_gpu "$@" -d $R/$d -t 00:02:00 > $R/$d/run.log 2>&1
  echo "$d rc=$? $(date +%T) $(grep -c 'cycle limit' $R/$d/run.log)"; }
run Ab5 b5 -i $W/inp/he_bc.athinput $G problem/wg_sponge_rate=0.02
run An5 n5 -i $W/inp/he_nosp.athinput $G
run Bb5 b5 -i $W/inp/he_nosp.athinput $G
run Bn5 n5 -i $W/inp/he_bc.athinput $G
run An5rr n5 -r $R/An5/rst/hw.00001.rst time/nlim=40
echo "done $(date +%T)"
