#!/bin/bash -l
#SBATCH -J wgGB
#SBATCH -p apudev
#SBATCH -N 1
#SBATCH --constraint="apu"
#SBATCH --gres=gpu:2
#SBATCH --ntasks-per-node=2
#SBATCH --cpus-per-task=24
#SBATCH --time=00:14:30
#SBATCH -o /viper/ptmp2/jinma/sprhd_0926/gpu/log/gb.%j.out
# usage: sbatch gate.sub <prob: dhj|box|cs|wedge>   [arms] runs arms (default old46 new46 old44 new44): fresh N cycles
# (rst every N/2), then a restart from the mid rst to N, each on 2 ranks / 2 GPUs
module purge
module load gcc/14 rocm/6.3 openmpi_gpu/5.0 cmake/4.0
export HSA_XNACK=1
export HSA_NO_SCRATCH_RECLAIM=1
export OMP_NUM_THREADS=1
P=/viper/ptmp2/jinma/sprhd_0926; I=/viper/ptmp2/jinma/hipgate_0926
PB=$1
ARMS=${2:-"base n1"}
case $PB in
 dhj) EXE=deep_hot_jupiter_rt; N=12
   source $I/inp/grid_w121_1x.env
   O="time/start_time=0.0 output1/dt=1.10154e3 output3/dt=5.50768e4 output4/dt=5.50768e4"
   T4="problem/ck_implicit=true problem/ck_impl_arat=1e30 problem/ck_impl_frozen_op=true problem/ck_impl_lin=true problem/ck_impl_lin_thr=1 problem/ck_impl_fuse=true problem/ck_impl_jac_lin=true problem/ck_impl_cvsec=true"
   C2="problem/ck_impl_once=true problem/ck_impl_xstep=8 problem/ck_impl_jreuse=0.2 problem/ck_impl_pred=true problem/ck_impl_pred_fac=0.5 problem/ck_impl_nosync=true"
   ARG="-i $I/inp/dhj.athinput $G $O time/tlim=1.101535e7 $T4 $C2 problem/ck_impl_every=4 problem/sponge_top=true problem/sponge_bottom=true problem/ck_impl_verbose=false time/nlim=$N" ;;
 box) EXE=box_convection; N=12
   ARG="-i $I/inp/box.athinput time/nlim=$N" ;;
 cs) EXE=none; N=20
   ARG="-i $I/inp/cs.athinput time/nlim=$N" ;;
 wedge) EXE=none; N=12
   ARG="-i $I/inp/wedge.athinput time/nlim=$N output9/dcycle=6" ;;
esac
run() { # dir, args...
  local d=$1; shift; mkdir -p $d; cd $d
  srun --export=ALL -n 2 --exact --cpus-per-task=24 bash -c \
    'export ROCR_VISIBLE_DEVICES=$SLURM_LOCALID; exec "$0" "$@"' "$@" -d $d > $d/run.log 2>&1
  echo "$d rc=$? $(date +%T) $(grep -c 'cycle limit' $d/run.log)"; }
echo "start $(date +%T) $PB"
for A in $ARMS; do run $P/gpu/gb/$PB/$A/fresh $P/bin/athena_${A}_${EXE}_gpu $ARG -t 00:04:00; done
for A in $ARMS; do
  R=$(ls $P/gpu/gb/$PB/$A/fresh/rst/*.00001.rst 2>/dev/null); [ -n "$R" ] || { echo "$A: no mid rst, restart skipped"; continue; }
  run $P/gpu/gb/$PB/$A/rr $P/bin/athena_${A}_${EXE}_gpu -r $R -t 00:04:00
done
echo "done $(date +%T)"
