#!/bin/bash -l
#SBATCH -J wgG9
#SBATCH -p apu
#SBATCH -N 1
#SBATCH --constraint="apu"
#SBATCH --gres=gpu:2
#SBATCH --ntasks-per-node=2
#SBATCH --cpus-per-task=24
#SBATCH --time=00:30:00
#SBATCH -o /viper/ptmp2/jinma/sprhd_0926/gpu/log/g9.%j.out
# m1-wedge ringing: top sponge (0.02/s above r(tau=1)) arm, 84x32x32, grid seed 1e-3, cfl 0.3,
# 2 GPUs (the side-by-side 1-GPU launch of g7b stalled), 25 min; compare with g7_n3/w3
module purge
module load gcc/14 rocm/6.3 openmpi_gpu/5.0
export HSA_XNACK=1
export HSA_NO_SCRATCH_RECLAIM=1
export OMP_NUM_THREADS=1
W=/viper/ptmp2/jinma/sprhd_0926; B=$W/bin/athena_$1_none_gpu; R=$W/gpu/g9_$1/sp; IN=$W/inp/he_bc.athinput
mkdir -p $R; cd $R; md5sum $B
srun --export=ALL -n 2 --exact --cpus-per-task=24 bash -c \
  'export ROCR_VISIBLE_DEVICES=$SLURM_LOCALID; exec "$0" "$@"' $B -i $IN -d $R -t 00:25:00 \
  time/nlim=-1 time/ndiag=5000 problem/wg_seed=1.0e-3 problem/wg_sponge_rate=0.02 \
  output1/dt=2.0 output2/dt=2000.0 output3/dt=2000.0 output4/dcycle=50000 > $R/run.log 2>&1
echo "rc=$? $(date +%T)"
