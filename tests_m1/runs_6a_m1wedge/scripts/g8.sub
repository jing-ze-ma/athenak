#!/bin/bash -l
#SBATCH -J wgG8
#SBATCH -p apudev
#SBATCH -N 1
#SBATCH --constraint="apu"
#SBATCH --gres=gpu:2
#SBATCH --ntasks-per-node=2
#SBATCH --cpus-per-task=24
#SBATCH --time=00:14:00
#SBATCH -o /viper/ptmp2/jinma/sprhd_0926/gpu/log/g8.%j.out
# m1-wedge: why was the sponge arm (g7b sp) 40x slower?  84x32x32, fresh, 400 cycles, 2 GPUs,
# arms: ref, sponge 0.02, open, open + sponge; then ref and sponge on 1 GPU each side by side (GPU 0/1)
module purge
module load gcc/14 rocm/6.3 openmpi_gpu/5.0
export HSA_XNACK=1
export HSA_NO_SCRATCH_RECLAIM=1
export OMP_NUM_THREADS=1
W=/viper/ptmp2/jinma/sprhd_0926; B=$W/bin/athena_$1_none_gpu; R=$W/gpu/g8_$1; IN=$W/inp/he_bc.athinput
G="time/nlim=400 time/ndiag=50 problem/wg_seed=1.0e-3 output1/dt=2.0 output2/dt=1.0e9 output3/dt=1.0e9 output4/dcycle=1000000000"
md5sum $B
run() { local d=$1; shift; mkdir -p $R/$d; cd $R/$d
  srun --export=ALL -n 2 --exact --cpus-per-task=24 bash -c \
    'export ROCR_VISIBLE_DEVICES=$SLURM_LOCALID; exec "$0" "$@"' $B -i $IN $G "$@" -d $R/$d -t 00:02:00 > $R/$d/run.log 2>&1
  echo "$d rc=$? $(date +%T) $(grep -c 'cycle limit' $R/$d/run.log)"; }
run ref
run sp problem/wg_sponge_rate=0.02
run op problem/wg_bc_top=open
run ops problem/wg_bc_top=open problem/wg_sponge_rate=0.02
run1() { local d=$1 g=$2; shift 2; mkdir -p $R/$d; cd $R/$d
  srun --export=ALL -n 1 --exact --cpus-per-task=24 bash -c \
    "export ROCR_VISIBLE_DEVICES=$g; exec \"\$0\" \"\$@\"" $B -i $IN $G "$@" -d $R/$d -t 00:02:00 > $R/$d/run.log 2>&1
  echo "$d rc=$? $(date +%T)"; }
run1 g0ref 0 &
run1 g1sp 1 problem/wg_sponge_rate=0.02 &
wait
run1 g0sp 0 problem/wg_sponge_rate=0.02 &
run1 g1ref 1 &
wait
echo "done $(date +%T)"
