#!/bin/bash -l
#SBATCH -J wgG2
#SBATCH -p apudev
#SBATCH -N 1
#SBATCH --constraint="apu"
#SBATCH --gres=gpu:2
#SBATCH --ntasks-per-node=2
#SBATCH --cpus-per-task=24
#SBATCH --time=00:14:30
#SBATCH -o /viper/ptmp2/jinma/sprhd_0926/gpu/log/g2.%j.out
# m1-wedge GPU lever timings, He wedge at 84x64x64 (box-like horizontal resolution), 2 GPUs,
# fresh start, 120 cycles, arms interleaved, 2 repeats.  usage: sbatch g2.sub <bin tag>
module purge
module load gcc/14 rocm/6.3 openmpi_gpu/5.0
export HSA_XNACK=1
export HSA_NO_SCRATCH_RECLAIM=1
export OMP_NUM_THREADS=1
W=/viper/ptmp2/jinma/sprhd_0926; B=$W/bin/athena_$1_none_gpu; R=$W/gpu/g2_$1; IN=$W/inp/he.athinput
G="mesh/nx2=64 mesh/nx3=64 meshblock/nx2=32 meshblock/nx3=32 time/nlim=120 time/ndiag=20"
md5sum $B
declare -A A
A[ref]=""
A[rbgs]="rad_m1/implicit_precond=rbgs_fwd"
A[chunk4]="rad_m1/vet_col_chunk=4"
A[teamred0]="rad_m1/implicit_op_team_red=false"
A[pred0]="rad_m1/implicit_predictor=none rad_m1/implicit_one_pass=0"
A[onep0]="rad_m1/implicit_one_pass=0"
A[ew0]="rad_m1/implicit_lin_ew_max=0.0"
A[v4]="rad_m1/vet_col_every=4 rad_m1/time2_vet_col=lag"
A[h9]="time/cfl_number=0.9"
run() { local d=$1; shift; mkdir -p $R/$d; cd $R/$d
  srun --export=ALL -n 2 --exact --cpus-per-task=24 bash -c \
    'export ROCR_VISIBLE_DEVICES=$SLURM_LOCALID; exec "$0" "$@"' $B -i $IN $G "$@" -d $R/$d -t 00:00:50 > $R/$d/run.log 2>&1
  echo "$d rc=$? $(date +%T) $(grep 'cycle=120 ' $R/$d/run.log | head -1)"; }
echo "start $(date +%T)"
for rep in 1 2; do
  for a in ref rbgs chunk4 teamred0 pred0 onep0 ew0 v4 h9; do run ${a}_r$rep ${A[$a]}; done
done
echo "done $(date +%T)"
