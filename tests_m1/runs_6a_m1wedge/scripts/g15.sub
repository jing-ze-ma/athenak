#!/bin/bash -l
#SBATCH -J wgG15
#SBATCH -p apudev
#SBATCH -N 1
#SBATCH --constraint="apu"
#SBATCH --gres=gpu:2
#SBATCH --ntasks-per-node=2
#SBATCH --cpus-per-task=24
#SBATCH --time=00:14:00
#SBATCH -o /viper/ptmp2/jinma/sprhd_0926/gpu/log/g15.%j.out
# sponge-default gate on the He sph_wedge (84x32x32, seed 1e-3, 40 cycles, rst at 20, 2 GPUs):
#  A: b5 + wg_sponge_rate 0.02 explicit  vs  n6 without the key (new default)
#  B: b5 without the key (old default 0) vs  n6 + wg_sponge_rate 0.0 explicit
#  n6 restart 20 -> 40 of arm A
module purge
module load gcc/14 rocm/6.3 openmpi_gpu/5.0
export HSA_XNACK=1
export HSA_NO_SCRATCH_RECLAIM=1
export OMP_NUM_THREADS=1
W=/viper/ptmp2/jinma/sprhd_0926; R=$W/gpu/g15
G="time/nlim=40 time/ndiag=20 problem/wg_seed=1.0e-3 output1/dt=0.5 output2/dt=3.0 output3/dt=3.0 output4/dcycle=20"
run() { local d=$1 b=$2; shift 2; mkdir -p $R/$d; cd $R/$d
  srun --export=ALL -n 2 --exact --cpus-per-task=24 bash -c \
    'export ROCR_VISIBLE_DEVICES=$SLURM_LOCALID; exec "$0" "$@"' $W/bin/athena_${b}_none_gpu "$@" -d $R/$d > $R/$d/run.log 2>&1
  echo "$d rc=$? $(date +%T) $(grep -c 'cycle limit' $R/$d/run.log)"; }
run Ab5 b5 -i $W/inp/he_bc.athinput $G problem/wg_sponge_rate=0.02 -t 00:02:00
run An6 n6 -i $W/inp/he_nosp.athinput $G problem/wg_wall_zero_flux=false -t 00:02:00
run Dn6 n6 -i $W/inp/he_nosp.athinput $G -t 00:02:00
run Bb5 b5 -i $W/inp/he_nosp.athinput $G -t 00:02:00
run Bn6 n6 -i $W/inp/he_bc.athinput $G problem/wg_wall_zero_flux=false -t 00:02:00
run Dn6rr n6 -r $R/Dn6/rst/hw.00001.rst time/nlim=40 -t 00:02:00
# mass conservation at L x 1 (84x16x16, 1.5 min each): default (sponge + zero-flux wall), open top
L="mesh/nx2=16 mesh/nx3=16 meshblock/nx2=16 meshblock/nx3=8 time/nlim=-1 time/ndiag=2000 problem/wg_seed=1.0e-3 output1/dt=2.0 output2/dt=1.0e9 output3/dt=1.0e9 output4/dcycle=1000000000"
run l1W n6 -i $W/inp/he_nosp.athinput $L -t 00:01:30
run l1O n6 -i $W/inp/he_nosp.athinput $L problem/wg_bc_top=open -t 00:01:30
run l1Wold n6 -i $W/inp/he_nosp.athinput $L problem/wg_wall_zero_flux=false -t 00:01:30
echo "done $(date +%T)"
