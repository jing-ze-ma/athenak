#!/bin/bash -l
#SBATCH -J wgG6
#SBATCH -p apudev
#SBATCH -N 1
#SBATCH --constraint="apu"
#SBATCH --gres=gpu:2
#SBATCH --ntasks-per-node=2
#SBATCH --cpus-per-task=24
#SBATCH --time=00:14:50
#SBATCH -o /viper/ptmp2/jinma/sprhd_0926/gpu/log/g6.%j.out
# m1-wedge convergence order (coordinator task 5): gate-(A) grey atmosphere + a small smooth
# hot spot (amp 1e-2, w 0.04 at r = 1.1), production sp settings (vet_col, hesdirk2, predict),
# t = 0.2.  SPACE: 48x16x16 / 96x32x32 / 192x64x64 at cfl 0.1 (+ spot-free twins).
# TIME: 96x32x32, cfl 0.8/0.4/0.2/0.1 vs 0.025, vet_col_every 1 and 4 + lag.
# usage: sbatch g6.sub <bin tag>
module purge
module load gcc/14 rocm/6.3 openmpi_gpu/5.0
export HSA_XNACK=1
export HSA_NO_SCRATCH_RECLAIM=1
export OMP_NUM_THREADS=1
W=/viper/ptmp2/jinma/sprhd_0926; B=$W/bin/athena_$1_none_gpu; R=$W/gpu/g6_$1; IN=$W/inp/gateC.athinput
P="time/nlim=-1 time/tlim=0.2 time/ndiag=200 output1/dt=0.01 output2/dt=0.2 output3/dt=0.2 problem/wg_spot_amp=1.0e-2 problem/wg_spot_w=0.04"
md5sum $B
run() { local d=$1; shift; mkdir -p $R/$d; cd $R/$d
  srun --export=ALL -n 2 --exact --cpus-per-task=24 bash -c \
    'export ROCR_VISIBLE_DEVICES=$SLURM_LOCALID; exec "$0" "$@"' $B -i $IN $P "$@" -d $R/$d -t 00:04:00 > $R/$d/run.log 2>&1
  echo "$d rc=$? $(date +%T) $(grep -m1 'cycle=' $R/$d/run.log | head -1) $(grep 'time limit' -c $R/$d/run.log) $(grep -o 'NON-CONVERGED=[^ ]*' $R/$d/run.log)"; }
echo "start $(date +%T)"
S1="mesh/nx1=48 mesh/nx2=16 mesh/nx3=16 meshblock/nx1=48 meshblock/nx2=8 meshblock/nx3=16"
S2="mesh/nx1=96 mesh/nx2=32 mesh/nx3=32 meshblock/nx1=96 meshblock/nx2=16 meshblock/nx3=32"
S3="mesh/nx1=192 mesh/nx2=64 mesh/nx3=64 meshblock/nx1=192 meshblock/nx2=32 meshblock/nx3=64"
for c in 0.8 0.4 0.2 0.1 0.025; do run t_c$c $S2 time/cfl_number=$c; done
for c in 0.8 0.4 0.2 0.1; do run t4_c$c $S2 time/cfl_number=$c rad_m1/vet_col_every=4 rad_m1/time2_vet_col=lag; done
run s1 $S1 time/cfl_number=0.1
run s1ns $S1 time/cfl_number=0.1 problem/wg_spot_amp=0.0
run s2ns $S2 time/cfl_number=0.1 problem/wg_spot_amp=0.0
run s3 $S3 time/cfl_number=0.1
run s3ns $S3 time/cfl_number=0.1 problem/wg_spot_amp=0.0
echo "done $(date +%T)"
