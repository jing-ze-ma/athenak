#!/bin/bash -l
#SBATCH -J wgG5b
#SBATCH -p apudev
#SBATCH -N 1
#SBATCH --constraint="apu"
#SBATCH --gres=gpu:2
#SBATCH --ntasks-per-node=2
#SBATCH --cpus-per-task=24
#SBATCH --time=00:14:50
#SBATCH -o /viper/ptmp2/jinma/sprhd_0926/gpu/log/g5b.%j.out
# m1-wedge lever timings on MOVING gas: restart of g4 (job 11984805, 84x64x64, t = 27590 s,
# cycle 171550, Mach_rms 1.1e-2), 2 GPUs, 180 cycles per arm, arms interleaved, 2 repeats;
# then the restart-bitwise gate on the evolved state (straight 200 vs 100 + 100).
# usage: sbatch g5.sub <bin tag>
module purge
module load gcc/14 rocm/6.3 openmpi_gpu/5.0
export HSA_XNACK=1
export HSA_NO_SCRATCH_RECLAIM=1
export OMP_NUM_THREADS=1
W=/viper/ptmp2/jinma/sprhd_0926; B=$W/bin/athena_$1_none_gpu; R=$W/gpu/g5b_$1
RST=$W/gpu/g4_n2/run/rst/hw.00002.rst; C0=171550
O="time/ndiag=20 output1/dt=1.0e9 output2/dt=1.0e9 output3/dt=1.0e9 output4/dcycle=1000000000"
md5sum $B
declare -A A
A[ref]=""
A[pred0]="rad_m1/implicit_predictor=none"
A[pord1]="rad_m1/implicit_predictor_order=1"
A[onep0]="rad_m1/implicit_one_pass=0"
A[rbgs]="rad_m1/implicit_precond=rbgs_fwd"
A[chunk4]="rad_m1/vet_col_chunk=4"
A[teamred0]="rad_m1/implicit_op_team_red=false"
A[ew0]="rad_m1/implicit_lin_ew_max=0.0"
A[h9]="time/cfl_number=0.9"
A[v4]="rad_m1/vet_col_every=4 rad_m1/time2_vet_col=lag"
run() { local d=$1 n=$2; shift 2; mkdir -p $R/$d; cd $R/$d
  srun --export=ALL -n 2 --exact --cpus-per-task=24 bash -c \
    'export ROCR_VISIBLE_DEVICES=$SLURM_LOCALID; exec "$0" "$@"' $B "$@" -d $R/$d -t 00:01:30 > $R/$d/run.log 2>&1
  echo "$d rc=$? $(date +%T) $(grep -c 'cycle limit' $R/$d/run.log)"; }
echo "start $(date +%T)"
for rep in 1 2 3; do
  for a in ref pord1 rbgs pred0; do
    run ${a}_r$rep 0 -r $RST $O time/nlim=$((C0+180)) ${A[$a]}
  done
done
echo "done $(date +%T)"
