#!/bin/bash -l
#SBATCH -J wgG16
#SBATCH -p apudev
#SBATCH -N 1
#SBATCH --constraint="apu"
#SBATCH --gres=gpu:2
#SBATCH --ntasks-per-node=2
#SBATCH --cpus-per-task=24
#SBATCH --time=00:14:30
#SBATCH -o /viper/ptmp2/jinma/sprhd_0926/gpu/log/g16.%j.out
# SUPER-EDDINGTON He sph_wedge: F_in x 1.5 (Gamma_max 0.75 -> 1.13 in the Fe bump), 84x16x16, 2 GPUs,
# 2.8 min per arm, zero-flux walls (n6): open (no sponge) / wall + sponge / wall / open + sponge  usage: sbatch g14.sub <bin tag>
module purge
module load gcc/14 rocm/6.3 openmpi_gpu/5.0
export HSA_XNACK=1
export HSA_NO_SCRATCH_RECLAIM=1
export OMP_NUM_THREADS=1
W=/viper/ptmp2/jinma/sprhd_0926; B=$W/bin/athena_$1_none_gpu; R=$W/gpu/g16_$1; IN=$W/inp/he_bc.athinput
G="mesh/nx2=16 mesh/nx3=16 meshblock/nx2=16 meshblock/nx3=8 time/nlim=-1 time/ndiag=2000 problem/wg_seed=1.0e-3 output1/dt=2.0 output2/dt=500.0 output3/dt=500.0 output4/dcycle=1000000000"
SE="rad_m1/implicit_flux_x1min=3.754743680e+15"
md5sum $B
run() { local d=$1; shift; mkdir -p $R/$d; cd $R/$d
  srun --export=ALL -n 2 --exact --cpus-per-task=24 bash -c \
    'export ROCR_VISIBLE_DEVICES=$SLURM_LOCALID; exec "$0" "$@"' $B -i $IN $G "$@" -d $R/$d -t 00:02:50 > $R/$d/run.log 2>&1
  echo "$d rc=$? $(date +%T) $(grep -E '^time=.*cycle' $R/$d/run.log) $(grep -o 'NON-CONVERGED=[^ ]*' $R/$d/run.log)"; }
run seO $SE problem/wg_bc_top=open problem/wg_sponge_rate=0.0
run seS $SE problem/wg_sponge_rate=0.02
run seW $SE problem/wg_sponge_rate=0.0
run seOS $SE problem/wg_bc_top=open problem/wg_sponge_rate=0.02
echo "done $(date +%T)"
