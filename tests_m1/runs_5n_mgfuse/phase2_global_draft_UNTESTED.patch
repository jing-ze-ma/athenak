+  // block LU: Dp_0 = D_0, Dp_gi = D_gi - L_gi Dp_{gi-1}^{-1} U_{gi-1}; keep Dp^{-1}
+  auto &A = mg_hga;
+  auto &Di = mg_hdinv;
+  std::vector<Real> w(2*nb*nb);
+  mg_gok = true;
+  for (int gi = 0; gi < N1 && mg_gok; ++gi) {
+    Real *dp = w.data(), *inv = w.data() + nb*nb;
+    for (int r = 0; r < nb; ++r) {
+      for (int c = 0; c < nb; ++c) {
+        dp[r*nb + c] = A(gi, r*nb + c);
+        if (gi > 0) {
