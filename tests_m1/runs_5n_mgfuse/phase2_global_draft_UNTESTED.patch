+  pmy_pack->pmb->mb_gid.sync_host();
+  int nseg = 1;
+  for (int m = 0; m < nmb; ++m) {
+    auto &ll = pm->lloc_eachmb[pmy_pack->pmb->mb_gid.h_view(m)];
+    hoff(m,0) = static_cast<int>(ll.lx1)*n1;
+    hoff(m,1) = static_cast<int>(ll.lx2)*n2;
+    hoff(m,2) = static_cast<int>(ll.lx3)*n3;
+    hoff(m,3) = MGBand(hoff(m,1), N2, gb2);
+    nseg = std::max(nseg, MGBand(hoff(m,1) + n2 - 1, N2, gb2) - hoff(m,3) + 1);
+  }
+  if (mg_gn1 != N1 || mg_goff.extent_int(0) != nmb || mg_gnseg != nseg) {
+    mg_gn1 = N1;
+    mg_gnseg = nseg;
+    mg_goff = DvceArray2D<int>("m1_mg_goff", nmb, 4);
+    mg_gpart = DvceArray5D<Real>("m1_mg_gpart", nmb, n3, nseg, n1, nq);
+    mg_ga = DvceArray2D<Real>("m1_mg_ga", N1, nb*nb + 2*nb);
+    mg_gv = DvceArray2D<Real>("m1_mg_gv", N1, nb);
+    mg_hga = HostArray2D<Real>("m1_mg_hga", N1, nb*nb + 2*nb);
+    mg_hgv = HostArray2D<Real>("m1_mg_hgv", N1, nb);
+    mg_hdinv = HostArray2D<Real>("m1_mg_hdinv", N1, nb*nb);
+  }
+  Kokkos::deep_copy(mg_goff, hoff);
