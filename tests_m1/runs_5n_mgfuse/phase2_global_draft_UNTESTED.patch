+  auto off_ = mg_goff;
+  auto pt_ = mg_gpart;
+  auto ga_ = mg_ga;
+  Kokkos::deep_copy(pt_, 0.0);
+  // per (m, x3 row k, x1 i): the row sums of the rows along x2, by band
+  par_for("m1_mg_gbuild", DevExeSpace(), 0, nmb-1, 0, n3-1, 0, n1-1,
+  KOKKOS_LAMBDA(const int m, const int k, const int i) {
+    const int kg = off_(m,2) + k;
+    const int b3 = MGBand(kg, N3, gb3);
+    const int kk = k + ks, ii = i + is;
+    int b3m = b3, b3p = b3;
+    if (thrd) {
+      b3m = MGBand((kg - 1 + N3) % N3, N3, gb3);
+      b3p = MGBand((kg + 1) % N3, N3, gb3);
+    }
+    for (int j = 0; j < n2; ++j) {
+      const int jg = off_(m,1) + j;
+      const int b2 = MGBand(jg, N2, gb2);
+      const int s = b2 - off_(m,3);
+      const int b = b3*gb2 + b2;
+      const int jj = j + js;
+      pt_(m,k,s,i,nb) += iw_(m,M1_IW_TA,kk,jj,ii);
+      pt_(m,k,s,i,nb+1) += iw_(m,M1_IW_TC,kk,jj,ii);
+      pt_(m,k,s,i,b) += iw_(m,M1_IW_TB,kk,jj,ii);
+      const int bjm = b3*gb2 + MGBand((jg - 1 + N2) % N2, N2, gb2);
+      const int bjp = b3*gb2 + MGBand((jg + 1) % N2, N2, gb2);
+      pt_(m,k,s,i,bjm) += iw_(m,M1_IW_CJM,kk,jj,ii);
+      pt_(m,k,s,i,bjp) += iw_(m,M1_IW_CJP,kk,jj,ii);
+      if (thrd) {
+        pt_(m,k,s,i,b3m*gb2 + b2) += iw_(m,M1_IW_CKM,kk,jj,ii);
