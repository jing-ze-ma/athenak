+//! \fn void RadiationM1::ImplicitMGGlobalBuild
+//! \brief implicit_mg_global = 1: the coarse space of piecewise-constant fields over
+//! gb2 x gb3 global (x2,x3) bands, one unknown per band and GLOBAL x1 index (the
+//! sideways band means).  The coarse rows P^T A7 P, over all ranks: at every global x1
+//! index gi an nb x nb block D (band to band) and the diagonal x1 couplings L (to gi-1)
+//! and U (to gi+1).  Sums are per (block, x3 row, band, x1) partials reduced in a fixed
+//! order (deterministic), then one MPI_Allreduce; the block-tridiagonal factorisation
+//! (the inverses of the pivot blocks) is done redundantly on every rank on the host.
+//! A coupling towards a physical face is identically zero in the row, so neighbour
+//! bands wrap periodically without harm.
+
+void RadiationM1::ImplicitMGGlobalBuild() {
+  auto *pm = pmy_pack->pmesh;
+  auto &indcs = pm->mb_indcs;
+  const int is = indcs.is, js = indcs.js, ks = indcs.ks;
+  const int n1 = indcs.nx1, n2 = indcs.nx2;
+  const bool thrd = trans_x3;
+  const int n3 = thrd ? indcs.nx3 : 1;
+  const int nmb = pmy_pack->nmb_thispack;
+  if (ibc_x1min == M1_IBC_PERIODIC) {
+    MGFatal("<rad_m1>/implicit_mg_global does not take a periodic x1 boundary");
+  }
+  const int N1 = pm->mesh_indcs.nx1, N2 = pm->mesh_indcs.nx2;
+  const int N3 = thrd ? pm->mesh_indcs.nx3 : 1;
+  const int gb2 = mg_gb2, gb3 = thrd ? mg_gb3 : 1;
+  const int nb = gb2*gb3;
+  const int nq = nb + 2;
+  // the blocks' global offsets and first x2 band
