+//! \fn void RadiationM1::ImplicitMGGlobalSolve
+//! \brief the band sums in mg_gv (this rank's) -> all ranks' sum (one MPI_Allreduce of
+//! N1 x nb numbers) -> the coarse solution, redundantly on every rank, back in mg_gv
+
+void RadiationM1::ImplicitMGGlobalSolve() {
+  const int N1 = mg_gn1;
+  const int nb = mg_gb2*(trans_x3 ? mg_gb3 : 1);
+  auto &g = mg_hgv;
+  Kokkos::deep_copy(g, mg_gv);
+#if MPI_PARALLEL_ENABLED
+  MPI_Allreduce(MPI_IN_PLACE, g.data(), N1*nb, MPI_ATHENA_REAL, MPI_SUM, MPI_COMM_WORLD);
+#endif
+  auto &A = mg_hga;
+  auto &Di = mg_hdinv;
+  std::vector<Real> t(nb), y(nb);
+  if (!mg_gok) {
+    for (int gi = 0; gi < N1; ++gi) {for (int b = 0; b < nb; ++b) g(gi,b) = 0.0;}
+  } else {
+    // forward: y_gi = g_gi - L_gi Dp_{gi-1}^{-1} y_{gi-1} (in place in g)
+    for (int gi = 1; gi < N1; ++gi) {
+      for (int r = 0; r < nb; ++r) {
+        Real s = 0.0;
+        for (int c = 0; c < nb; ++c) s += Di(gi-1, r*nb + c)*g(gi-1, c);
+        t[r] = s;
+      }
+      for (int r = 0; r < nb; ++r) g(gi, r) -= A(gi, nb*nb + r)*t[r];
+    }
+    // back: x_gi = Dp_gi^{-1} (y_gi - U_gi x_{gi+1})
+    for (int gi = N1 - 1; gi >= 0; --gi) {
+      for (int r = 0; r < nb; ++r) {
+        y[r] = g(gi, r);
+        if (gi < N1 - 1) y[r] -= A(gi, nb*nb + nb + r)*g(gi+1, r);
+      }
+      for (int r = 0; r < nb; ++r) {
+        Real s = 0.0;
+        for (int c = 0; c < nb; ++c) s += Di(gi, r*nb + c)*y[c];
+        t[r] = s;
+      }
+      for (int r = 0; r < nb; ++r) g(gi, r) = t[r];
+    }
+  }
+  Kokkos::deep_copy(mg_gv, g);
 }
 
