+
+void RadiationM1::ImplicitMGInit(ParameterInput *pin) {
+  mg_nlev = 0;
+  mg_halo = true;
+  mg_fuse = true;
+  mg_glob = 0;
+  mg_gb2 = 1;
+  mg_gb3 = 1;
+  mg_gn1 = 0;
+  mg_gnseg = 0;
+  mg_gok = false;
+  if (impl_prec != 3) {return;}
+  mg_nlev = pin->GetOrAddInteger("rad_m1","implicit_mg_levels",2);
+  mg_halo = pin->GetOrAddBoolean("rad_m1","implicit_mg_halo",true);
+  mg_fuse = pin->GetOrAddBoolean("rad_m1","implicit_mg_fuse",true);
+  mg_glob = pin->GetOrAddInteger("rad_m1","implicit_mg_global",0);
+  if (mg_glob < 0 || mg_glob > 1) {MGFatal("<rad_m1>/implicit_mg_global must be 0 or 1");}
+  if (mg_glob == 1) {
+    mg_gb2 = pin->GetOrAddInteger("rad_m1","implicit_mg_gbands2",1);
+    mg_gb3 = pin->GetOrAddInteger("rad_m1","implicit_mg_gbands3",1);
+    auto *pm = pmy_pack->pmesh;
+    if (mg_gb2 < 1 || mg_gb2 > pm->mesh_indcs.nx2 || mg_gb3 < 1
+        || mg_gb3 > std::max(pm->mesh_indcs.nx3, 1)) {
+      MGFatal("<rad_m1>/implicit_mg_gbands2/3 must be in 1..mesh nx2 / nx3");
+    }
+    if (pm->multilevel) {
+      MGFatal("<rad_m1>/implicit_mg_global needs a single-level mesh");
+    }
+    if (mg_nlev < 1) {MGFatal("<rad_m1>/implicit_mg_levels must be >= 1");}
+  } else if (mg_nlev < 2) {
+    MGFatal("<rad_m1>/implicit_mg_levels must be >= 2 (>= 1 with implicit_mg_global)");
+  }
+}
