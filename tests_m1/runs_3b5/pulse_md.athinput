# Milestone 3b phase D gates (tests_m1/runs_3b5): the phase-C pulse input with the
# implicit_offdiag / implicit_closure_* keys named so the driver can override them.
# Milestone 3b phase B gates (tests_m1/runs_3b3): the thick pulse in 1-D / 2-D / 3-D
# with <rad_m1>/transport = implicit.  Same physics as
# inputs/tests/rad_m1_thick_pulse.athinput, with the 1-D-only <output2> table dropped
# and implicit_maxit raised to the transport = implicit default.
#
# 1-D periodic Gaussian in E in a scattering-dominated STATIC medium: rho = 1, a pure
# scattering opacity kappa_s, and <rad_m1>/gas_feedback = false so the gas is never
# pushed or heated.  The variance of E must grow at 2D with D = c/(3 rho kappa).
#
# tau_cell = rho kappa_s dx = kappa_s/128 with the numbers below, so
#   tau_cell = 0.1   1e1   1e3   1e6   <->   kappa_s = 12.8  1280  1.28e5  1.28e8
# and the gate is run at each of those for thick_flux = ap_hll | scaled | none, e.g.
#   athena -i rad_m1_thick_pulse.athinput rad_m1/kappa_s=1280 rad_m1/thick_flux=ap_hll
#
# The odd-even (Nyquist) variant adds problem/nyquist_amp=1e-3; the top-hat of T3c is
# problem/m1_test=tophat.  The gas internal energy is deliberately small so that the
# HYDRO timestep is ~10x the radiation one and the sub-cycle loop runs with nsub ~ 10.

<comment>
problem = grey M1 static thick pulse

<job>
basename = m1_thick_pulse

<mesh>
nghost    = 2
nx1       = 128
x1min     = 0.0
x1max     = 1.0
ix1_bc    = periodic
ox1_bc    = periodic

nx2       = 1
x2min     = -0.5
x2max     = 0.5
ix2_bc    = periodic
ox2_bc    = periodic

nx3       = 1
x3min     = -0.5
x3max     = 0.5
ix3_bc    = periodic
ox3_bc    = periodic

<meshblock>
nx1       = 128
nx2       = 1
nx3       = 1

<time>
evolution  = dynamic
integrator = rk2
cfl_number = 0.4
nlim       = -1
tlim       = 1.0
ndiag      = 10000

<hydro>
eos         = ideal
reconstruct = plm
rsolver     = hllc
gamma       = 1.666666666666667

<rad_m1>
c_light      = 1.0
chat_over_c  = 1.0
cfl_rad      = 0.4
reconstruct  = plm      # dc | plm
thick_flux   = ap_hll   # none | ap_hll | scaled
scaled_prefactor = 20.0
ap_form      = alpha2   # alpha2 | unified (design sect. 10)
advect_split = false    # moving-media split: no velocity in this test
source_form  = full     # full | ovc (the O(v/c) control of T4/T4b)
f_source     = cell    # cell | wb (the interface F source, sect. 13)
closure      = m1
e_floor      = 1.0e-30
subcycle     = true
opacity      = const
kappa_p      = 0.0      # pure scattering: no emission, no absorption
kappa_e      = 0.0
kappa_f      = 0.0
kappa_s      = 12.8
coupling     = true
gas_feedback = false    # static medium

# ---- MILESTONE 3a: implicit x1 transport (docs/dev/rad_m1_implicit_design.md).  Listed
# here at their DEFAULTS so that the gate scripts can override them on the command line
# (AthenaK only accepts a command-line override of a parameter the input file names).
transport             = explicit  # explicit | implicit_x1 | implicit
implicit_cfl          = -1.0      # implicit_x1 only: dt = implicit_cfl*dx/c (<=0: off)
implicit_tol          = 1.0e-8
implicit_maxit        = 200
implicit_opac_update  = false
implicit_allow_multid = false
implicit_flux         = central   # central | ap_hll | berthon | blend
implicit_recon        = dc        # dc | plm_dc       (milestone 3a2, LIMIT 1)
implicit_blend        = tau_f     # tau | f | tau_f   (milestone 3c, blend weight)
implicit_blend_fmode  = max       # max | mean        (3c: f_face from the two cells)
implicit_blend_mode   = flux      # flux | dissipation (3c: what is blended)
implicit_blend_tau0   = 1.0       # 3c: w = exp(-(tau_face/tau0)^2)
implicit_blend_flo    = 0.6       # 3c: smoothstep lower edge in the reduced flux
implicit_blend_fhi    = 0.9       # 3c: smoothstep upper edge in the reduced flux
implicit_partition    = none      # none | gather
implicit_solver       = line_jacobi  # 3b phase C: line_jacobi | bicgstab
implicit_lin_maxit    = 200       # 3b phase C: the BiCGStab iteration cap
implicit_offdiag      = auto      # auto | lagged | operator | none (3b phase D)
implicit_closure_relax = 1.0      # 3b D: chi,n relaxation between Picard passes
implicit_closure_relax_thin = false
implicit_closure_lag  = pass      # pass | step (3b D: closure frozen for a step)
implicit_lin_tol      = 1.0e-10   # 3b phase B: residual of the 7-point system
implicit_recon_w      = -1.0      # plm_dc weight; <=0 = auto 1/(1+chat dt/dx)
implicit_recon_lag    = picard     # step | picard (when the plm correction is re-made)
implicit_recon_npass  = -1        # 3c: freeze the plm correction after N passes
implicit_res_floor    = 0.0       # Picard residual scale (0 = the 3a pure |dE|/E)
implicit_bmom_half    = true     # boundary momentum (milestone 3a2, LIMIT 3)
marshak_q             = 0.5
implicit_bc_x1min     = auto      # auto|marshak|flux|reflect|periodic|efix
implicit_bc_x1max     = auto
implicit_flux_x1min   = 0.0
implicit_flux_x1max   = 0.0
implicit_ebath_x1min   = 0.0
implicit_ebath_x1max   = 0.0

<problem>
pgen_name   = rad_m1_beam
m1_test     = thick_pulse
gas_rho     = 1.0
gas_eint    = 0.01
pulse_amp   = 1.0
pulse_width = 0.05
pulse_x0    = 0.5
pulse_y0    = 0.0
pulse_z0    = 0.0
pulse_bg    = 1.0e-3
pulse_1d    = false
nyquist_amp = 0.0

<output1>
file_type   = bin
variable    = m1
dt          = 0.1


# A 1-D x2 SLICE in DOUBLE precision.  The bin writer above is single precision, which
# is enough for the diffusion-rate fits of G1/G2 but not for the 1e-14 comparisons of
# G3 (implicit vs implicit_x1 on an x2-uniform problem) and G4 (1 vs 2x2 MeshBlocks).
<output3>
file_type   = tab
variable    = m1
data_format = %26.17e
slice_x2    = 0.5
dt          = 1.0e30

# The restart file, for the bitwise restart gate G5.
<output4>
file_type   = rst
dt          = 1.0e30
