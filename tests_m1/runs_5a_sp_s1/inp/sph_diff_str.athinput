<comment>
problem = S1 T-S1: steady spherical diffusion (Eddington, constant rho kappa, thick)

<job>
basename = sd

<mesh>
nghost    = 2
nx1       = 64
x1min     = 1.0
x1max     = 3.0
ix1_bc    = outflow
ox1_bc    = outflow
nx2       = 4
x2min     = 1.4707963267948966     # pi/2 - 0.1 (a wedge clear of the poles)
x2max     = 1.6707963267948966     # pi/2 + 0.1
ix2_bc    = reflect
ox2_bc    = reflect
nx3       = 4
x3min     = 0.0
x3max     = 0.2
ix3_bc    = periodic
ox3_bc    = periodic
use_spherical_polar = true
use_grid_stretch_r_poly = true   # the he4_presn_sp coefficients
f_stretch_r_c1 = +0.134559
f_stretch_r_c2 = +4.942505
f_stretch_r_c3 = -8.950106
f_stretch_r_c4 = +4.403042

<meshblock>
nx1       = 64
nx2       = 4
nx3       = 4

<time>
evolution  = dynamic
integrator = rk2
cfl_number = 0.3
nlim       = 20
tlim       = 1.0e30
ndiag      = 1

<hydro>
eos         = ideal
reconstruct = plm
rsolver     = hllc
gamma       = 1.666666666666667

<rad_m1>
c_light      = 1.0
chat_over_c  = 1.0
closure      = eddington
e_floor      = 1.0e-30
opacity      = const
kappa_p      = 0.0
kappa_f      = 0.0
kappa_s      = 100.0      # rho kappa = 100: tau(shell) = 200
arad         = 1.0
coupling     = true
gas_feedback = false
transport    = implicit
implicit_cfl = 1.0e6
implicit_solver = bicgstab
implicit_maxit  = 200
implicit_tol = 1.0e-12
implicit_lin_tol = 1.0e-13
implicit_bc_x1min   = flux
implicit_flux_x1min = 1.0e-2
implicit_bc_x1max   = efix

<problem>
pgen_name  = rad_m1_beam
m1_test    = sph_shell
gas_rho    = 1.0
gas_temp   = 1.0e-16
e_out      = 1.0

<output1>
file_type   = tab
variable    = m1
data_format = %24.16e
slice_x2    = 1.5707963267948966
slice_x3    = 0.1
dcycle      = 20
