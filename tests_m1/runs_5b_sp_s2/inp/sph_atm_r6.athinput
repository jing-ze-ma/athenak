<comment>
problem = S2 T-S4 risk 6: static scattering atmosphere, radiation force vs wb_arad

<job>
basename = r6

<mesh>
nghost    = 2
nx1       = 64
x1min     = 1.0
x1max     = 5.0
ix1_bc    = outflow
ox1_bc    = outflow
nx2       = 4
x2min     = 1.4707963267948966     # pi/2 - 0.1
x2max     = 1.6707963267948966
ix2_bc    = periodic
ox2_bc    = periodic
nx3       = 4
x3min     = 0.0
x3max     = 0.2
ix3_bc    = periodic
ox3_bc    = periodic
use_spherical_polar = true

<meshblock>
nx1       = 64
nx2       = 4
nx3       = 4

<time>
evolution  = dynamic
integrator = rk2
cfl_number = 0.3
nlim       = 1000
tlim       = 1.0e30
ndiag      = 50

<hydro>
eos         = ideal
reconstruct = plm
rsolver     = hllc
gamma       = 1.666666666666667
sp_wellbalanced_src = true

<rad_m1>
c_light      = 100.0
chat_over_c  = 1.0
closure      = m1
e_floor      = 1.0e-30
opacity      = const
kappa_p      = 0.0        # pure scattering: the gas temperature stays uniform
kappa_e      = 0.0
kappa_f      = 0.0
kappa_s      = 25.0       # rho kappa_t = 25: tau(1..5) = 100
arad         = 1.0e8
coupling     = true
gas_feedback = true
dbg_gas_force = false     # the gas is held (atm_hold): no momentum, no work
transport    = implicit
implicit_cfl = 1.0e6
implicit_solver = bicgstab
implicit_maxit  = 100
implicit_tol = 1.0e-10
implicit_lin_tol = 1.0e-10
implicit_offdiag = auto
implicit_closure_lag = step     # the closure frozen within a step (converges; steady state unaffected)
implicit_bc_x1min   = flux
implicit_flux_x1min = 1.0
implicit_bc_x1max   = marshak
implicit_ebath_x1max = 0.0
marshak_q    = 0.5

<problem>
pgen_name  = rad_m1_beam
m1_test    = sph_atm
atm_rho0   = 1.0
atm_rho_n  = 0.0
atm_temp   = 1.0e-4
atm_init   = eddington
atm_seed   = 0.0
e_out      = 1.0e-6
user_srcs  = true

<output1>
file_type   = tab
variable    = m1
data_format = %24.16e
slice_x2    = 1.5707963267948966
slice_x3    = 0.1
dcycle      = 1000

<output2>
file_type   = tab
variable    = hydro_w
data_format = %24.16e
slice_x2    = 1.5707963267948966
slice_x3    = 0.1
dcycle      = 1000

<output3>
file_type   = rst
dcycle      = 1000

<output4>
file_type   = bin
variable    = hydro_w
dcycle      = 10
