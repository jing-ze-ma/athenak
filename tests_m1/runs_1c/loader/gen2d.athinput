<comment>
problem = loader selftest data

<job>
basename = m1_loader2d

<mesh>
nghost = 2
nx1 = 16
x1min = 0.0
x1max = 1.0
ix1_bc = periodic
ox1_bc = periodic
nx2 = 8
x2min = 0.0
x2max = 0.5
ix2_bc = periodic
ox2_bc = periodic
nx3 = 1
x3min = -0.5
x3max = 0.5
ix3_bc = periodic
ox3_bc = periodic

<meshblock>
nx1 = 8
nx2 = 4
nx3 = 1

<time>
evolution = dynamic
integrator = rk2
cfl_number = 0.4
nlim = 0
tlim = 1.0
ndiag = 100000

<hydro>
eos = ideal
reconstruct = plm
rsolver = hllc
gamma = 1.666666666666667

<rad_m1>
c_light = 1.0
thick_flux = none
e_floor = 1.0e-30
opacity = const
coupling = false

<problem>
pgen_name = rad_m1_beam
m1_test = thick_pulse
gas_rho = 1.0
gas_eint = 0.01
pulse_amp = 1.0
pulse_width = 0.05
pulse_x0 = 0.5
pulse_bg = 1.0e-3

<output1>
file_type = bin
variable = m1
dt = 1.0

